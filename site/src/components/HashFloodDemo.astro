---
// 해시 테이블을 공격하는 키(hash flooding)를 넣어 보는 데모.
//
// Aa와 BB는 호너 방식(R = 31)의 값이 같다. 65×31+97 = 66×31+66 = 2112이기 때문이다.
// 둘을 어떻게 이어 붙여도 값이 같으므로, 키 2^j개가 모두 한 칸으로 간다. 체이닝
// 표(M = 97)에 넣으며 비교 횟수를 세어 보통 키와 견주고, 비밀 키를 섞는 SipHash-1-3
// (Python 문자열과 Rust HashMap이 쓰는 것)으로 바꾸면 같은 키가 흩어지는 것을 본다.
import { defaultLang } from 'stack-site-builder/i18n/ui';
import algos from './hashAlgos.js?raw';

interface Props {
  /** 슬라이드용: 바깥 여백은 줄이고 글자와 칸은 키운다. */
  slide?: boolean;
}
const { slide = false } = Astro.props;
const id = `hf-${Math.random().toString(36).slice(2, 9)}`;
const sizes = [16, 64, 256, 1024];

const STRINGS: Record<string, Record<string, string>> = {
  ko: {
    title: '해시 테이블 공격하기',
    normal: '보통 키',
    attack: '공격 키',
    horner: '호너 R = 31',
    sip: 'SipHash-1-3 + 비밀 키',
    reroll: '비밀 키 다시 뽑기',
    compares: '넣는 동안 비교',
    perKey: '키 하나당',
    longest: '가장 긴 리스트',
    ratio: '보통 키의',
    times: '배',
    attackHorner: '65×31+97 = 66×31+66이라 Aa와 BB는 호너 값이 같습니다. 어떻게 이어 붙여도 같으니 키 {n}개가 모두 {s}번 칸으로 갑니다. 비교가 N²에 비례해, 키가 네 배면 비교는 열여섯 배입니다.',
    attackSip: '같은 공격 키가 고르게 흩어졌습니다. 공격자는 비밀 키를 모르니 한 칸에 몰리는 키를 미리 만들 수 없습니다.',
    normalHorner: '보통 키는 호너 방식으로도 고르게 퍼집니다. 평균 O(1)이 그대로입니다.',
    normalSip: '비밀 키를 섞어도 보통 키의 분포는 그대로 고릅니다. 계산이 조금 느려지는 값을 치르고 공격을 막습니다.',
  },
  en: {
    title: 'Attacking a hash table',
    normal: 'Normal keys',
    attack: 'Attack keys',
    horner: 'Horner R = 31',
    sip: 'SipHash-1-3 + secret key',
    reroll: 'Draw a new secret key',
    compares: 'compares while inserting',
    perKey: 'per key',
    longest: 'longest list',
    ratio: 'vs normal keys',
    times: '×',
    attackHorner: 'Aa and BB have the same Horner value (65×31+97 = 66×31+66). However they are joined the value stays equal, so all {n} keys go to slot {s}. Compares grow with N²: four times the keys means sixteen times the compares.',
    attackSip: 'The same attack keys are now spread evenly. Attackers do not know the secret key, so they cannot prepare keys that pile into one slot.',
    normalHorner: 'Normal keys spread evenly under Horner too. The average stays O(1).',
    normalSip: 'Mixing in a secret key leaves normal keys just as even. A little extra computation is the price of stopping the attack.',
  },
  zh: {
    title: '攻击哈希表',
    normal: '普通键',
    attack: '攻击键',
    horner: '霍纳 R = 31',
    sip: 'SipHash-1-3 + 秘密密钥',
    reroll: '重新抽取秘密密钥',
    compares: '插入时的比较',
    perKey: '每个键',
    longest: '最长的链表',
    ratio: '是普通键的',
    times: '倍',
    attackHorner: 'Aa 和 BB 的霍纳值相同（65×31+97 = 66×31+66）。无论怎样拼接都相同，所以 {n} 个键全部进入 {s} 号格。比较次数与 N² 成正比，键变成四倍，比较就变成十六倍。',
    attackSip: '同样的攻击键均匀地散开了。攻击者不知道秘密密钥，无法事先造出挤进同一格的键。',
    normalHorner: '普通键用霍纳法也能均匀分布。平均仍是 O(1)。',
    normalSip: '混入秘密密钥后，普通键依然均匀。计算稍慢一点，就是挡住攻击的代价。',
  },
};
const lang = Astro.currentLocale ?? defaultLang;
const t = STRINGS[lang] ?? STRINGS[defaultLang] ?? STRINGS.ko;
---

<script is:inline set:html={algos} />
<div class:list={['aas-hash-flood-demo', slide && 'is-slide']} id={id} data-hf-strings={JSON.stringify(t)}>
  <div class="hf-bar">
    <span class="hf-head"><strong>{t.title}</strong></span>
    <div class="hf-tabs">
      <button type="button" class="hf-tab" data-hf-kind="normal">{t.normal}</button>
      <button type="button" class="hf-tab" data-hf-kind="attack">{t.attack}</button>
    </div>
    <div class="hf-tabs">
      <button type="button" class="hf-tab" data-hf-hash="horner">{t.horner}</button>
      <button type="button" class="hf-tab" data-hf-hash="sip">{t.sip}</button>
    </div>
    <div class="hf-tabs">
      <span class="hf-n">N</span>
      {sizes.map((n) => <button type="button" class="hf-tab" data-hf-size={n}>{n}</button>)}
    </div>
  </div>

  <div class="hf-keys">
    <code data-hf-sample></code>
    <span class="hf-secret">
      <code data-hf-secret></code>
      <button type="button" class="hf-btn" data-hf-reroll>{t.reroll}</button>
    </span>
  </div>

  <div class="hf-stats">
    <span class="hf-big"><span>{t.compares}</span><strong data-hf-total></strong></span>
    <span class="hf-big"><span>{t.perKey}</span><strong class="is-plain" data-hf-per></strong></span>
    <span class="hf-big"><span>{t.longest}</span><strong class="is-plain" data-hf-long></strong></span>
    <span class="hf-big"><span>{t.ratio}</span><strong class="is-plain" data-hf-ratio></strong></span>
  </div>

  <div class="hf-plot"><div class="hf-bars" data-hf-bars></div></div>

  <p class="hf-note" data-hf-note></p>
</div>

<script is:inline define:vars={{ id }}>
  (() => {
    const root = document.getElementById(id);
    if (!root) return;

    /* 설명은 문장마다 줄을 바꾼다. 마침표 뒤 공백, 또는 중국어 마침표 뒤에서 끊는다. */
    const setLines = (node, text) => {
      const parts = String(text).split(/(?<=[.!?])\s+(?=\S)|(?<=[。！？])(?=\S)/);
      node.replaceChildren(...parts.flatMap((s, i) => (i ? [document.createElement('br'), s] : [s])));
    };
    const S = JSON.parse(root.dataset.hfStrings);
    const fill = (tpl, vars) => tpl.replace(/\{(\w+)\}/g, (_, k) => vars[k]);
    const { bytesOf, siphash, horner } = globalThis.aasHashAlgos;
    const M = 97;
    const fmt = (x) => x.toLocaleString('en-US');

    const randomKey = () => {
      const a = new Uint32Array(2);
      crypto.getRandomValues(a);
      return (BigInt(a[0]) << 32n) | BigInt(a[1]);
    };
    let k0 = randomKey();
    let k1 = randomKey();
    let kind = 'attack';
    let hash = 'horner';
    let N = 256;

    const normalKeys = (n) => Array.from({ length: n }, (_, i) => `user${i + 1}`);
    /* Aa·BB를 j번 이어 붙인 키 2^j개 */
    const attackKeys = (n) => {
      let out = [''];
      while (out.length < n) out = out.flatMap((x) => [`${x}Aa`, `${x}BB`]);
      return out;
    };
    const slotOf = (key) => (hash === 'horner' ? horner(key, M) : Number(siphash(bytesOf(key), k0, k1) % BigInt(M)));
    const countOf = (keys) => {
      const c = new Array(M).fill(0);
      for (const key of keys) c[slotOf(key)] += 1;
      return c;
    };
    /* 서로 다른 키라 넣을 때마다 그 칸의 리스트를 끝까지 비교한다: n(n-1)/2 */
    const comparesOf = (c) => c.reduce((a, n) => a + (n * (n - 1)) / 2, 0);

    function render() {
      const keys = kind === 'attack' ? attackKeys(N) : normalKeys(N);
      const c = countOf(keys);
      const total = comparesOf(c);
      const base = comparesOf(countOf(normalKeys(N)));
      const long = Math.max(...c);
      /* 평균의 네 배(최소 8개)까지 그린다. 그 위는 잘린다. */
      const cap = Math.max((4 * N) / M, 8);
      root.querySelector('[data-hf-bars]').innerHTML = c
        .map((n) => `<i style="height:${Math.min(n / cap, 1) * 100}%"${n > cap / 2 ? ' class="is-over"' : ''}></i>`)
        .join('');
      const totalEl = root.querySelector('[data-hf-total]');
      totalEl.textContent = fmt(total);
      totalEl.classList.toggle('is-bad', long === N);
      root.querySelector('[data-hf-per]').textContent = (total / N).toFixed(1);
      root.querySelector('[data-hf-long]').textContent = fmt(long);
      const ratio = base ? total / base : 1;
      root.querySelector('[data-hf-ratio]').textContent =
        S.times === '×' ? `×${ratio < 10 ? ratio.toFixed(1) : fmt(Math.round(ratio))}` : `${ratio < 10 ? ratio.toFixed(1) : fmt(Math.round(ratio))}${S.times}`;
      root.querySelector('[data-hf-sample]').textContent =
        keys.slice(0, 4).map((key) => `${key}→${slotOf(key)}`).join('  ') + '  …';
      const secret = root.querySelector('[data-hf-secret]');
      secret.textContent = hash === 'sip' ? `k = ${k0.toString(16).slice(0, 8)}…` : '';
      root.querySelector('[data-hf-reroll]').hidden = hash !== 'sip';
      root.querySelectorAll('[data-hf-kind]').forEach((b) => b.classList.toggle('is-on', b.dataset.hfKind === kind));
      root.querySelectorAll('[data-hf-hash]').forEach((b) => b.classList.toggle('is-on', b.dataset.hfHash === hash));
      root.querySelectorAll('[data-hf-size]').forEach((b) => b.classList.toggle('is-on', Number(b.dataset.hfSize) === N));
      const line = S[`${kind}${hash === 'sip' ? 'Sip' : 'Horner'}`];
      setLines(root.querySelector('[data-hf-note]'), fill(line, { n: fmt(N), s: slotOf(keys[0]) }));
    }

    root.querySelectorAll('[data-hf-kind]').forEach((b) =>
      b.addEventListener('click', () => {
        kind = b.dataset.hfKind;
        render();
      }),
    );
    root.querySelectorAll('[data-hf-hash]').forEach((b) =>
      b.addEventListener('click', () => {
        hash = b.dataset.hfHash;
        render();
      }),
    );
    root.querySelectorAll('[data-hf-size]').forEach((b) =>
      b.addEventListener('click', () => {
        N = Number(b.dataset.hfSize);
        render();
      }),
    );
    root.querySelector('[data-hf-reroll]').addEventListener('click', () => {
      k0 = randomKey();
      k1 = randomKey();
      render();
    });
    render();
  })();
</script>

<style is:global>
  .aas-hash-flood-demo {
    /* 안쪽 치수는 모두 이 값에 대한 em이다(다른 데모들과 같은 방식). */
    font-size: 1rem;
    margin: 1.5rem 0;
    padding: 1em;
    border: 1px solid var(--aas-border);
    border-radius: 0.9em;
    background: var(--aas-panel);
  }
  .aas-hash-flood-demo .hf-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em 0.9em;
    align-items: center;
    justify-content: space-between;
  }
  .aas-hash-flood-demo .hf-head {
    font-size: 0.95em;
  }
  .aas-hash-flood-demo .hf-tabs {
    display: flex;
    gap: 0.3em;
    align-items: center;
  }
  .aas-hash-flood-demo .hf-n {
    font-family: var(--aas-mono, monospace);
    font-size: 0.85em;
    color: var(--aas-muted);
  }
  .aas-hash-flood-demo .hf-tab {
    padding: 0.25em 0.7em;
    font-size: 0.85em;
    border: 1px solid var(--aas-border);
    border-radius: 999px;
    background: var(--aas-bg);
    color: var(--aas-text);
    cursor: pointer;
    white-space: nowrap;
  }
  .aas-hash-flood-demo .hf-tab:hover,
  .aas-hash-flood-demo .hf-btn:hover {
    border-color: var(--aas-accent);
  }
  .aas-hash-flood-demo .hf-tab.is-on {
    background: color-mix(in srgb, var(--aas-accent) 18%, var(--aas-bg));
    border-color: var(--aas-accent);
    font-weight: 700;
  }
  .aas-hash-flood-demo .hf-keys {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3em 1em;
    align-items: center;
    justify-content: space-between;
    min-height: 2em;
    margin: 0.4em 0;
    font-size: 0.8em;
  }
  .aas-hash-flood-demo .hf-keys code {
    padding: 0;
    background: none;
    font-family: var(--aas-mono, monospace);
    font-size: 1em;
    white-space: pre;
    color: var(--aas-muted);
  }
  .aas-hash-flood-demo .hf-secret {
    display: inline-flex;
    gap: 0.6em;
    align-items: center;
  }
  .aas-hash-flood-demo .hf-btn {
    padding: 0.25em 0.7em;
    font-size: 1em;
    border: 1px solid var(--aas-border);
    border-radius: 0.5em;
    background: var(--aas-bg);
    color: var(--aas-text);
    cursor: pointer;
  }
  .aas-hash-flood-demo .hf-btn[hidden] {
    display: none;
  }
  .aas-hash-flood-demo .hf-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2em 1.5em;
  }
  .aas-hash-flood-demo .hf-big {
    display: inline-flex;
    gap: 0.35em;
    align-items: baseline;
    font-size: 0.85em;
    color: var(--aas-muted);
  }
  .aas-hash-flood-demo .hf-big strong {
    font-family: var(--aas-mono, monospace);
    font-size: 2em;
    line-height: 1.1;
    color: var(--aas-role-focus);
  }
  .aas-hash-flood-demo .hf-big strong.is-plain {
    font-size: 1.5em;
    color: var(--aas-text);
  }
  .aas-hash-flood-demo .hf-big strong.is-bad {
    color: var(--aas-role-guard);
  }
  .aas-hash-flood-demo .hf-plot {
    height: 6em;
    margin-top: 0.4em;
    border-bottom: 1px solid var(--aas-border);
  }
  .aas-hash-flood-demo .hf-bars {
    display: flex;
    align-items: flex-end;
    gap: 1px;
    height: 100%;
  }
  .aas-hash-flood-demo .hf-bars i {
    flex: 1 1 0;
    min-width: 0;
    background: var(--aas-role-model);
    transition: height 0.25s;
  }
  .aas-hash-flood-demo .hf-bars i.is-over {
    background: var(--aas-role-guard);
  }
  .aas-hash-flood-demo .hf-note {
    margin: 0.6em 0 0;
    font-size: 0.85em;
    min-height: 3.6em;
  }

  /* 슬라이드용. 다른 데모와 같은 방식. vh 단위인 이유는 SearchDemo 참고 */
  .aas-hash-flood-demo.is-slide {
    font-size: clamp(1rem, 2.6vh, 1.8rem);
    margin: 0.5rem 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .aas-hash-flood-demo .hf-bars i {
      transition: none;
    }
  }
</style>
