---
// Kasai의 비용을 위치별로 그려 처음부터 비교하는 방법과 견주는 데모.
//
// 위치 i마다 막대 하나다. 회색이 건너뛴 글자 수(시작 h), 초록이 실제 글자 비교 수, 테두리가
// 이웃 쌍을 처음부터 비교할 때의 글자 비교 수다. 문자열을 고치거나 슬라이더로 a를 늘리면
// Kasai는 분석의 상한 3n(일치 2n + 불일치 n) 안에 머물고 처음부터 비교하는 쪽은 n²에 가깝게 커지는 것이 보인다. 막대를 누르면
// 그 위치의 접미사와 앞 이웃, h가 나온다. 수치는 04_lcp의 규칙으로 센 것이다(banana$ 9와 12,
// aaaaaaaa$ 15와 36).
import { defaultLang } from 'stack-site-builder/i18n/ui';
import algos from './suffixAlgos.js?raw';

interface Props {
  /** 슬라이드용: 바깥 여백은 줄이고 글자와 칸은 키운다. */
  slide?: boolean;
}
const { slide = false } = Astro.props;
const id = `kc-${Math.random().toString(36).slice(2, 9)}`;

const STRINGS: Record<string, Record<string, string>> = {
  ko: {
    title: 'h가 줄어드는 속도',
    text: '문자열',
    repeat: 'a의 개수',
    skipped: '건너뜀 (시작 h)',
    compared: '글자 비교',
    naive: '처음부터 비교할 때',
    kasai: 'Kasai',
    naiveName: '처음부터',
    bound: '상한 3n',
    pick: 'i = {i}: {s}의 앞 이웃은 {a}입니다. {h}글자를 건너뛰고 {c}번 비교해 LCP = {l}, 처음부터라면 {m}번입니다.',
    pickFirst: 'i = {i}: {s}는 정렬에서 맨 앞이라 앞 이웃이 없습니다. h를 0으로 둡니다.',
    sumNote: 'n = {n}에서 Kasai는 {a}번, 처음부터는 {b}번입니다. 상한 3n = {u}은 h의 증가 2n과 불일치 n을 더한 값입니다.',
    click: '막대를 눌러 보세요.',
  },
  en: {
    title: 'How fast h can shrink',
    text: 'String',
    repeat: 'Number of a',
    skipped: 'skipped (start h)',
    compared: 'char compares',
    naive: 'comparing from scratch',
    kasai: 'Kasai',
    naiveName: 'from scratch',
    bound: 'bound 3n',
    pick: 'i = {i}: the previous neighbor of {s} is {a}. Skip {h}, compare {c} time(s), LCP = {l}; from scratch it would take {m}.',
    pickFirst: 'i = {i}: {s} comes first in sorted order, so it has no previous neighbor. h is set to 0.',
    sumNote: 'At n = {n}, Kasai makes {a} compares; from scratch takes {b}. The bound 3n = {u} adds 2n increases of h and n mismatches.',
    click: 'Click a bar.',
  },
  zh: {
    title: 'h 减小的速度',
    text: '字符串',
    repeat: 'a 的个数',
    skipped: '跳过（起始 h）',
    compared: '字符比较',
    naive: '从头比较时',
    kasai: 'Kasai',
    naiveName: '从头比较',
    bound: '上界 3n',
    pick: 'i = {i}：{s} 的前一个邻居是 {a}。跳过 {h} 个字符，比较 {c} 次，LCP = {l}，从头比较要 {m} 次。',
    pickFirst: 'i = {i}：{s} 在排序中排第一，没有前一个邻居。h 置为 0。',
    sumNote: 'n = {n} 时，Kasai 比较 {a} 次，从头比较要 {b} 次。上界 3n = {u} 是 h 增加 2n 次加上不匹配 n 次。',
    click: '点一下条形。',
  },
};
const lang = Astro.currentLocale ?? defaultLang;
const t = STRINGS[lang] ?? STRINGS[defaultLang] ?? STRINGS.ko;
const presets = ['banana', 'aaaaaaaa', 'mississippi', 'aacaagtttacaagc', 'abababababab'];
---

<script is:inline set:html={algos} />
<div class:list={['aas-kasai-cost-demo', slide && 'is-slide']} id={id} data-kc-strings={JSON.stringify(t)}>
  <div class="kc-bar">
    <span class="kc-head"><strong>{t.title}</strong></span>
    <div class="kc-chips">
      {presets.map((p) => <button type="button" class="kc-chip" data-kc-preset={p}>{p}</button>)}
    </div>
  </div>
  <div class="kc-inputs">
    <label class="kc-input">
      <span>{t.text}</span>
      <input type="text" data-kc-in value={presets[0]} maxlength="60" spellcheck="false" autocomplete="off" />
    </label>
    <label class="kc-slider">
      <span>{t.repeat}: <b data-kc-mv></b></span>
      <input type="range" min="1" max="60" value="8" data-kc-m aria-label={t.repeat} />
    </label>
  </div>

  <div class="kc-chart" data-kc-chart></div>
  <div class="kc-legend">
    <i class="is-skip"></i>{t.skipped} <i class="is-cmp"></i>{t.compared} <i class="is-naive"></i>{t.naive}
  </div>

  <div class="kc-totals">
    <div class="kc-line"><span>{t.kasai}</span><div class="kc-track"><i data-kc-bar="a"></i></div><b data-kc-num="a"></b></div>
    <div class="kc-line"><span>{t.naiveName}</span><div class="kc-track"><i data-kc-bar="b"></i></div><b data-kc-num="b"></b></div>
    <div class="kc-line"><span>{t.bound}</span><div class="kc-track"><i data-kc-bar="u"></i></div><b data-kc-num="u"></b></div>
  </div>

  <p class="kc-note" data-kc-note></p>
</div>

<script is:inline define:vars={{ id }}>
  (() => {
    const root = document.getElementById(id);
    if (!root) return;

    /* 설명은 문장마다 줄을 바꾼다. 마침표 뒤 공백, 또는 중국어 마침표 뒤에서 끊는다. */
    const setLines = (node, text) => {
      const parts = String(text).split(/(?<=[.!?])\s+(?=\S)|(?<=[。！？])(?=\S)/);
      node.replaceChildren(...parts.flatMap((s, i) => (i ? [document.createElement('br'), s] : [s])));
    };
    /* 문장 잇기. 중국어 마침표 뒤에는 공백을 두지 않아야 setLines가 끊는다. */
    const join = (...parts) =>
      parts.filter(Boolean).reduce((a, b) => (/[。！？]$/.test(a) ? a + b : `${a} ${b}`), '');
    const S = JSON.parse(root.dataset.kcStrings);
    const fill = (tpl, vars) => tpl.replace(/\{(\w+)\}/g, (_, k) => vars[k]);
    const { buildSA, kasai, cleanWord } = globalThis.aasSuffixAlgos;

    const input = root.querySelector('[data-kc-in]');
    const mIn = root.querySelector('[data-kc-m]');
    const chart = root.querySelector('[data-kc-chart]');
    const note = root.querySelector('[data-kc-note]');
    let text = '';
    let rows = [];
    let naiveAt = [];
    let sel = 0;
    let totals = { a: 0, b: 0, u: 0 };

    const short = (s) => (s.length > 18 ? `${s.slice(0, 17)}…` : s);

    function recompute() {
      text = `${cleanWord(input.value, 60) || 'a'}$`;
      const sa = buildSA(text);
      const K = kasai(text, sa);
      rows = K.rows;
      const n = text.length;
      /* 처음부터 비교: 앞 이웃과 0번째 글자부터 비교한 횟수 */
      naiveAt = rows.map((r) => {
        if (r.j < 0) return 0;
        let c = 0;
        for (let k = 0; r.i + k < n && r.j + k < n; k++) {
          c += 1;
          if (text[r.i + k] !== text[r.j + k]) break;
        }
        return c;
      });
      totals = { a: K.compares, b: naiveAt.reduce((x, y) => x + y, 0), u: 3 * n };
      sel = Math.min(n > 2 ? 2 : 0, n - 1);
    }

    function draw() {
      const top = Math.max(...naiveAt, ...rows.map((r) => r.start + r.compares), 1);
      const n = rows.length;
      chart.style.setProperty('--kc-n', String(n));
      chart.innerHTML = rows
        .map((r, i) => {
          const pct = (v) => ((v / top) * 100).toFixed(1);
          const label = n <= 30 ? `<em>${text[i]}</em>` : '';
          return `<button type="button" class="kc-col${i === sel ? ' is-sel' : ''}" data-kc-i="${i}" aria-label="i = ${i}"><span class="kc-stack"><span class="kc-ghost" style="height:${pct(naiveAt[i])}%"></span><span class="kc-fill"><i class="is-cmp" style="height:${pct(r.compares)}%"></i><i class="is-skip" style="height:${pct(r.start)}%"></i></span></span>${label}</button>`;
        })
        .join('');
      const scale = Math.max(totals.a, totals.b, totals.u, 1);
      for (const key of ['a', 'b', 'u']) {
        root.querySelector(`[data-kc-bar="${key}"]`).style.width = `${((totals[key] / scale) * 100).toFixed(1)}%`;
        root.querySelector(`[data-kc-num="${key}"]`).textContent = String(totals[key]);
      }
      const r = rows[sel];
      const pick = r.j < 0
        ? fill(S.pickFirst, { i: r.i, s: short(text.slice(r.i)) })
        : fill(S.pick, { i: r.i, s: short(text.slice(r.i)), a: short(text.slice(r.j)), h: r.start, c: r.compares, l: r.lcp, m: naiveAt[sel] });
      setLines(note, join(pick, fill(S.sumNote, { n: text.length, a: totals.a, b: totals.b, u: totals.u })));
      root.querySelectorAll('[data-kc-preset]').forEach((b) => b.classList.toggle('is-on', b.dataset.kcPreset === input.value));
      const word = text.slice(0, -1);
      const allA = /^a+$/.test(word);
      root.querySelector('[data-kc-mv]').textContent = allA ? String(word.length) : '-';
      if (allA) mIn.value = String(word.length);
    }

    function update() {
      recompute();
      draw();
    }
    chart.addEventListener('click', (e) => {
      const col = e.target.closest('[data-kc-i]');
      if (!col) return;
      sel = Number(col.dataset.kcI);
      draw();
    });
    input.addEventListener('input', update);
    mIn.addEventListener('input', () => {
      input.value = 'a'.repeat(Number(mIn.value));
      update();
    });
    root.querySelectorAll('[data-kc-preset]').forEach((b) =>
      b.addEventListener('click', () => {
        input.value = b.dataset.kcPreset;
        update();
      }),
    );
    update();
  })();
</script>

<style is:global>
  .aas-kasai-cost-demo {
    /* 안쪽 치수는 모두 이 값에 대한 em이다(다른 데모들과 같은 방식). */
    font-size: 1rem;
    margin: 1.5rem 0;
    padding: 1em;
    border: 1px solid var(--aas-border);
    border-radius: 0.9em;
    background: var(--aas-panel);
  }
  .aas-kasai-cost-demo .kc-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em 0.9em;
    align-items: center;
    justify-content: space-between;
  }
  .aas-kasai-cost-demo .kc-head {
    font-size: 0.95em;
  }
  .aas-kasai-cost-demo .kc-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3em;
  }
  .aas-kasai-cost-demo .kc-chip {
    padding: 0.2em 0.6em;
    font-family: var(--aas-mono, monospace);
    font-size: 0.75em;
    border: 1px solid var(--aas-border);
    border-radius: 999px;
    background: var(--aas-bg);
    color: var(--aas-text);
    cursor: pointer;
  }
  .aas-kasai-cost-demo .kc-chip:hover {
    border-color: var(--aas-accent);
  }
  .aas-kasai-cost-demo .kc-chip.is-on {
    background: color-mix(in srgb, var(--aas-accent) 18%, var(--aas-bg));
    border-color: var(--aas-accent);
    font-weight: 700;
  }
  .aas-kasai-cost-demo .kc-inputs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3em 1.2em;
    align-items: center;
    margin: 0.4em 0;
  }
  .aas-kasai-cost-demo .kc-input {
    display: inline-flex;
    flex: 1 1 14em;
    gap: 0.45em;
    align-items: center;
    font-size: 0.85em;
    font-weight: 700;
  }
  .aas-kasai-cost-demo .kc-input input[type='text'] {
    flex: 1 1 auto;
    min-width: 0;
    padding: 0.18em 0.5em;
    font: inherit;
    font-family: var(--aas-mono, monospace);
    font-weight: 400;
    border: 1px solid var(--aas-border);
    border-radius: 0.45em;
    background: var(--aas-bg);
    color: var(--aas-text);
  }
  .aas-kasai-cost-demo .kc-input input:focus {
    outline: 2px solid var(--aas-accent);
    outline-offset: 1px;
  }
  .aas-kasai-cost-demo .kc-slider {
    flex: 1 1 11em;
    font-size: 0.85em;
  }
  .aas-kasai-cost-demo .kc-slider b {
    font-family: var(--aas-mono, monospace);
  }
  .aas-kasai-cost-demo .kc-slider input {
    display: block;
    width: 100%;
    accent-color: var(--aas-accent);
  }
  .aas-kasai-cost-demo .kc-chart {
    display: grid;
    grid-template-columns: repeat(var(--kc-n, 1), minmax(0, 1fr));
    gap: 1px;
    height: 7.6em;
  }
  .aas-kasai-cost-demo .kc-col {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 0;
    font: inherit;
    border: none;
    border-radius: 0.2em;
    background: none;
    color: var(--aas-text);
    cursor: pointer;
  }
  .aas-kasai-cost-demo .kc-col:hover,
  .aas-kasai-cost-demo .kc-col.is-sel {
    background: color-mix(in srgb, var(--aas-role-focus) 18%, transparent);
  }
  .aas-kasai-cost-demo .kc-stack {
    position: relative;
    display: block;
    flex: 1 1 auto;
    min-height: 0;
  }
  .aas-kasai-cost-demo .kc-col em {
    font-family: var(--aas-mono, monospace);
    font-size: 0.72em;
    font-style: normal;
    text-align: center;
    line-height: 1.3;
  }
  .aas-kasai-cost-demo .kc-fill {
    position: absolute;
    left: 18%;
    right: 18%;
    bottom: 0;
    height: 100%;
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-start;
  }
  .aas-kasai-cost-demo .kc-fill i {
    display: block;
    flex: none;
  }
  .aas-kasai-cost-demo .kc-ghost {
    position: absolute;
    left: 6%;
    right: 6%;
    bottom: 0;
    border: 1.5px dashed var(--aas-role-guard);
    border-bottom: none;
    border-radius: 0.2em 0.2em 0 0;
  }
  .aas-kasai-cost-demo .is-skip {
    background: color-mix(in srgb, var(--aas-muted) 45%, var(--aas-bg));
  }
  .aas-kasai-cost-demo .is-cmp {
    background: var(--aas-role-eval);
  }
  .aas-kasai-cost-demo .kc-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.1em 0.45em;
    align-items: center;
    margin-top: 0.15em;
    font-size: 0.72em;
    color: var(--aas-muted);
  }
  .aas-kasai-cost-demo .kc-legend i {
    display: inline-block;
    width: 0.8em;
    height: 0.8em;
    margin-left: 0.5em;
    border-radius: 0.15em;
  }
  .aas-kasai-cost-demo .kc-legend i.is-naive {
    border: 1.5px dashed var(--aas-role-guard);
  }
  .aas-kasai-cost-demo .kc-totals {
    margin-top: 0.3em;
  }
  .aas-kasai-cost-demo .kc-line {
    display: grid;
    grid-template-columns: 6em 1fr 3.2em;
    gap: 0.5em;
    align-items: center;
    font-size: 0.8em;
  }
  .aas-kasai-cost-demo .kc-line b {
    font-family: var(--aas-mono, monospace);
    text-align: right;
  }
  .aas-kasai-cost-demo .kc-track {
    height: 0.8em;
    border-radius: 0.2em;
    background: color-mix(in srgb, var(--aas-muted) 12%, var(--aas-bg));
    overflow: hidden;
  }
  .aas-kasai-cost-demo .kc-track i {
    display: block;
    height: 100%;
    background: var(--aas-role-eval);
    transition: width 0.25s;
  }
  .aas-kasai-cost-demo .kc-track i[data-kc-bar='b'] {
    background: var(--aas-role-guard);
  }
  .aas-kasai-cost-demo .kc-track i[data-kc-bar='u'] {
    background: var(--aas-muted);
  }
  .aas-kasai-cost-demo .kc-note {
    margin: 0.4em 0 0;
    font-size: 0.82em;
    min-height: 3em;
  }

  /* 슬라이드용. 다른 데모와 같은 방식. vh 단위인 이유는 SearchDemo 참고 */
  .aas-kasai-cost-demo.is-slide {
    font-size: clamp(1rem, 2.5vh, 1.7rem);
    margin: 0.5rem 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .aas-kasai-cost-demo .kc-track i {
      transition: none;
    }
  }
</style>
