---
// 단일 분기를 하나씩 접어 표준 트라이를 압축 트라이로 바꾸는 데모.
//
// 값이 없고 자식이 하나뿐인 노드(루트 제외)를 찾아 그 자식과 합친다. 한 걸음에
// 한 번 합친다. 합친 노드에는 문자열 조각이 붙는다. 더 합칠 노드가 없으면
// 갈라지는 곳과 값이 있는 노드만 남는다. 노드 수와, 노드마다 링크 배열 26칸을
// 둔다고 할 때의 링크 수를 함께 센다.
//
// 합치는 규칙은 TrieFigure의 kind="compressed"와 같다. 기본 키는 원본 자료의
// shells=1, shellfish=2다.
import { defaultLang } from 'stack-site-builder/i18n/ui';

interface Props {
  /** 넣을 키와 값 */
  words?: [string, number][];
  /** 슬라이드용: 글자와 칸을 키운다. */
  slide?: boolean;
}
const {
  words = [
    ['shells', 1],
    ['shellfish', 2],
  ],
  slide = false,
} = Astro.props;
const id = `tc-${Math.random().toString(36).slice(2, 9)}`;

const STRINGS: Record<string, Record<string, string>> = {
  ko: {
    title: '단일 분기 접기',
    back: '뒤로',
    step: '한 걸음',
    play: '자동 재생',
    stop: '멈춤',
    reset: '처음으로',
    root: '루트',
    nodes: '노드',
    links: '링크',
    single: '단일 분기',
    idle: '표준 트라이입니다. 값이 없고 자식이 하나뿐인 노드가 {k}개 있습니다. 이 노드들을 하나씩 아래 노드와 합칩니다.',
    merge: '"{a}" + "{b}" → "{ab}": 값이 없고 자식이 하나뿐이라 아래 노드와 합칩니다.',
    done: '더 합칠 노드가 없습니다. 갈라지는 곳과 값이 있는 노드만 남아 노드 {from}개가 {to}개가 되었습니다.',
  },
  en: {
    title: 'Folding one-way branches',
    back: 'Back',
    step: 'Step',
    play: 'Play',
    stop: 'Pause',
    reset: 'Reset',
    root: 'root',
    nodes: 'nodes',
    links: 'links',
    single: 'one-way nodes',
    idle: 'A standard trie. {k} nodes hold no value and have only one child. Merge them one at a time with the node below.',
    merge: '"{a}" + "{b}" → "{ab}": no value and only one child, so merge it with the node below.',
    done: 'Nothing left to merge. Only branching points and nodes with values remain, so {from} nodes became {to}.',
  },
  zh: {
    title: '折叠单分支',
    back: '后退',
    step: '单步',
    play: '播放',
    stop: '暂停',
    reset: '重置',
    root: '根',
    nodes: '节点',
    links: '链接',
    single: '单分支节点',
    idle: '这是标准字典树。没有值且只有一个子节点的节点有 {k} 个。把它们逐个与下面的节点合并。',
    merge: '"{a}" + "{b}" → "{ab}"：没有值且只有一个子节点，与下面的节点合并。',
    done: '没有可合并的节点了。只剩分叉处和存值的节点，{from} 个节点变成 {to} 个。',
  },
};
const lang = Astro.currentLocale ?? defaultLang;
const t = STRINGS[lang] ?? STRINGS[defaultLang] ?? STRINGS.ko;
---

<div
  class:list={['aas-trie-compress-demo', slide && 'is-slide']}
  id={id}
  data-tc-words={JSON.stringify(words)}
  data-tc-strings={JSON.stringify(t)}
>
  <div class="tc-bar">
    <span class="tc-head">
      <strong>{t.title}</strong>
      <span class="tc-chip">{words.map(([w, v]) => `${w}=${v}`).join(' ')}</span>
    </span>
    <div class="tc-controls">
      <button type="button" data-act="back" class="tc-btn">{t.back}</button>
      <button type="button" data-act="step" class="tc-btn">{t.step}</button>
      <button type="button" data-act="play" class="tc-btn tc-btn-primary">{t.play}</button>
      <button type="button" data-act="reset" class="tc-btn">{t.reset}</button>
    </div>
  </div>
  <div class="tc-body">
    <svg class="tc-svg" data-tc-svg role="img" aria-label={t.title}></svg>
    <div class="tc-side">
      <div class="tc-big">
        <span>{t.nodes}</span>
        <strong data-tc-nodes></strong>
      </div>
      <div class="tc-small">{t.links} <strong data-tc-links></strong></div>
      <div class="tc-small">{t.single} <strong data-tc-single></strong></div>
    </div>
  </div>
  <p class="tc-note" data-tc-note></p>
</div>

<script is:inline define:vars={{ id }}>
  (() => {
    const root = document.getElementById(id);
    if (!root) return;

    /* 설명은 문장마다 줄을 바꾼다. 마침표 뒤 공백, 또는 중국어 마침표 뒤에서 끊는다. */
    const setLines = (node, text) => {
      const parts = String(text).split(/(?<=[.!?])\s+(?=\S)|(?<=[。！？])(?=\S)/);
      node.replaceChildren(...parts.flatMap((s, i) => (i ? [document.createElement('br'), s] : [s])));
    };
    const S = JSON.parse(root.dataset.tcStrings);
    const words = JSON.parse(root.dataset.tcWords);
    const fill = (tpl, vars) => tpl.replace(/\{(\w+)\}/g, (_, key) => vars[key]);
    const R = 26;

    /* plan:start */
    /* 트라이를 만든다. 노드 id는 처음 만들 때의 경로 문자열, 합쳐도 위 노드의 id가 남는다. */
    const trie = new Map([['', { label: '', kids: [], value: null }]]);
    for (const [w, v] of words) {
      let cur = '';
      for (const ch of w) {
        const next = cur + ch;
        if (!trie.has(next)) {
          trie.set(next, { label: ch, kids: [], value: null });
          trie.get(cur).kids.push(next);
          trie.get(cur).kids.sort();
        }
        cur = next;
      }
      trie.get(cur).value = v;
    }
    const snapshot = () => new Map([...trie].map(([k, n]) => [k, { ...n, kids: [...n.kids] }]));
    const singles = () => [...trie].filter(([k, n]) => k !== '' && n.value === null && n.kids.length === 1).length;
    /* 앞에서부터(a부터 z 순서의 전위 순회) 처음 만나는 단일 분기 노드 */
    const findSingle = () => {
      let found = null;
      (function walk(k) {
        if (found !== null) return;
        const n = trie.get(k);
        if (k !== '' && n.value === null && n.kids.length === 1) {
          found = k;
          return;
        }
        n.kids.forEach(walk);
      })('');
      return found;
    };
    const first = trie.size;
    const steps = [{ snap: snapshot(), note: fill(S.idle, { k: singles() }), single: singles() }];
    for (;;) {
      const k = findSingle();
      if (k === null) break;
      const n = trie.get(k);
      const kid = trie.get(n.kids[0]);
      const a = n.label;
      const b = kid.label;
      trie.delete(n.kids[0]);
      n.label = a + b;
      n.value = kid.value;
      n.kids = kid.kids;
      steps.push({ snap: snapshot(), hot: k, note: fill(S.merge, { a, b, ab: a + b }), single: singles() });
    }
    steps.push({ snap: snapshot(), note: fill(S.done, { from: first, to: trie.size }), single: 0, done: true });
    /* plan:end */

    const NS = 'http://www.w3.org/2000/svg';
    const el = (name, attrs, text) => {
      const node = document.createElementNS(NS, name);
      for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, String(v));
      if (text !== undefined) node.textContent = text;
      return node;
    };
    const svg = root.querySelector('[data-tc-svg]');
    const UNIT = 70;
    const LEVEL = 32;
    const RAD = 14;
    const layout = (snap) => {
      const pos = new Map();
      let slot = 0;
      let maxD = 0;
      (function place(k, d) {
        const n = snap.get(k);
        maxD = Math.max(maxD, d);
        if (n.kids.length === 0) {
          pos.set(k, { x: slot * UNIT, y: d * LEVEL });
          slot += 1;
          return;
        }
        n.kids.forEach((c) => place(c, d + 1));
        pos.set(k, { x: (pos.get(n.kids[0]).x + pos.get(n.kids[n.kids.length - 1]).x) / 2, y: d * LEVEL });
      })('', 0);
      return { pos, slots: slot, maxD };
    };
    /* 그림의 틀은 처음(가장 큰) 트라이로 정해 두어 단계마다 크기가 바뀌지 않게 한다. */
    const big = layout(steps[0].snap);
    const maxLabel = Math.max(...[...steps[steps.length - 1].snap.values()].map((n) => n.label.length));
    const half = Math.max(RAD, 8 + maxLabel * 5.2);
    svg.setAttribute('viewBox', `${-half - 16} ${-RAD - 18} ${(big.slots - 1) * UNIT + 2 * half + 32} ${big.maxD * LEVEL + 2 * RAD + 22}`);

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function render(i) {
      const s = steps[i];
      const { pos } = layout(s.snap);
      svg.replaceChildren();
      const edges = el('g', {});
      const nodes = el('g', {});
      svg.append(edges, nodes);
      for (const [k, n] of s.snap) {
        const p = pos.get(k);
        n.kids.forEach((c) => {
          const q = pos.get(c);
          edges.appendChild(el('line', { class: 'tc-edge', x1: p.x, y1: p.y, x2: q.x, y2: q.y }));
        });
        const single = k !== '' && n.value === null && n.kids.length === 1;
        const g = el('g', {
          class: `tc-nd${k === '' ? ' is-root' : ''}${k === s.hot ? ' is-hot' : ''}${single ? ' is-single' : ''}${n.value !== null ? ' has-value' : ''}`,
          transform: `translate(${p.x} ${p.y})`,
        });
        if (k === '') {
          g.append(el('circle', { r: RAD * 0.8 }), el('text', { class: 'tc-root', y: -RAD - 4 }, S.root));
        } else {
          const w = n.label.length > 1 ? 8 + n.label.length * 5.2 : RAD;
          g.append(el('rect', { x: -w, y: -RAD, width: 2 * w, height: 2 * RAD, rx: RAD }), el('text', { class: 'tc-ch' }, n.label));
          if (n.value !== null) g.append(el('text', { class: 'tc-val', x: w + 3, y: RAD * 0.55 }, String(n.value)));
        }
        if (k === s.hot && !reduceMotion) g.classList.add('is-pop');
        nodes.appendChild(g);
      }
      root.querySelector('[data-tc-nodes]').textContent = String(s.snap.size);
      root.querySelector('[data-tc-links]').textContent = `${s.snap.size} × ${R} = ${s.snap.size * R}`;
      root.querySelector('[data-tc-single]').textContent = String(s.single);
      setLines(root.querySelector('[data-tc-note]'), s.note);
      root.classList.toggle('is-done', !!s.done);
    }

    let at = 0;
    let timer = null;
    const playBtn = root.querySelector('[data-act="play"]');
    const stop = () => {
      if (timer) clearInterval(timer);
      timer = null;
      playBtn.textContent = S.play;
    };
    const step = () => {
      if (at >= steps.length - 1) return stop();
      at += 1;
      render(at);
      if (at >= steps.length - 1) stop();
    };
    root.querySelector('[data-act="back"]').addEventListener('click', () => {
      stop();
      if (at > 0) at -= 1;
      render(at);
    });
    root.querySelector('[data-act="step"]').addEventListener('click', () => {
      stop();
      step();
    });
    root.querySelector('[data-act="reset"]').addEventListener('click', () => {
      stop();
      at = 0;
      render(0);
    });
    playBtn.addEventListener('click', () => {
      if (timer) return stop();
      if (at >= steps.length - 1) {
        at = 0;
        render(0);
      }
      playBtn.textContent = S.stop;
      timer = setInterval(step, 1100);
    });
    render(0);
  })();
</script>

<style is:global>
  .aas-trie-compress-demo {
    font-size: 1rem;
    margin: 1.5rem 0;
    padding: 1em;
    border: 1px solid var(--aas-border);
    border-radius: 0.9em;
    background: var(--aas-panel);
  }
  .aas-trie-compress-demo .tc-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6em 1em;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.6em;
  }
  .aas-trie-compress-demo .tc-head {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.7em;
    font-size: 0.95em;
  }
  .aas-trie-compress-demo .tc-chip {
    font-size: 0.85em;
    font-family: var(--aas-mono, monospace);
    border-radius: 0.5em;
    padding: 0.1em 0.5em;
    border: 1px solid color-mix(in srgb, var(--aas-role-model) 55%, transparent);
    background: color-mix(in srgb, var(--aas-role-model) 14%, transparent);
  }
  .aas-trie-compress-demo .tc-controls {
    display: flex;
    gap: 0.5em;
  }
  .aas-trie-compress-demo .tc-btn {
    padding: 0.35em 0.8em;
    font-size: 0.85em;
    border: 1px solid var(--aas-border);
    border-radius: 0.5em;
    background: var(--aas-bg);
    color: var(--aas-text);
    cursor: pointer;
  }
  .aas-trie-compress-demo .tc-btn:hover {
    border-color: var(--aas-accent);
  }
  .aas-trie-compress-demo .tc-btn-primary {
    background: var(--aas-accent);
    border-color: var(--aas-accent);
    color: #fff;
  }
  .aas-trie-compress-demo .tc-body {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8em 2em;
    align-items: center;
    justify-content: center;
  }
  .aas-trie-compress-demo .tc-svg {
    flex: 0 1 16em;
    min-width: 0;
    max-height: 22em;
  }
  .aas-trie-compress-demo .tc-side {
    flex: 0 0 auto;
  }
  .aas-trie-compress-demo .tc-big span {
    display: block;
    font-size: 0.85em;
    color: var(--aas-muted);
  }
  .aas-trie-compress-demo .tc-big strong {
    font-size: 2.4em;
    color: var(--aas-role-focus);
    font-family: var(--aas-mono, monospace);
  }
  .aas-trie-compress-demo .tc-small {
    font-size: 0.85em;
    color: var(--aas-muted);
    margin-top: 0.3em;
  }
  .aas-trie-compress-demo .tc-small strong {
    color: var(--aas-text);
    font-family: var(--aas-mono, monospace);
  }
  .aas-trie-compress-demo .tc-edge {
    stroke: var(--aas-muted);
    stroke-width: 1.6;
  }
  .aas-trie-compress-demo .tc-nd circle,
  .aas-trie-compress-demo .tc-nd rect {
    fill: var(--aas-text);
    stroke: var(--aas-text);
    stroke-width: 2;
  }
  .aas-trie-compress-demo .tc-nd.is-root circle {
    fill: var(--aas-role-trace);
    stroke: var(--aas-role-trace);
  }
  .aas-trie-compress-demo .tc-nd.is-single rect {
    fill: var(--aas-bg);
    stroke: var(--aas-role-guard);
    stroke-dasharray: 4 3;
  }
  .aas-trie-compress-demo .tc-nd.is-single .tc-ch {
    fill: var(--aas-text);
  }
  .aas-trie-compress-demo .tc-nd.is-hot rect {
    fill: var(--aas-role-eval);
    stroke: var(--aas-role-eval);
    stroke-dasharray: none;
  }
  .aas-trie-compress-demo .tc-nd.is-hot .tc-ch {
    fill: var(--aas-bg);
  }
  .aas-trie-compress-demo .tc-nd.is-pop {
    animation: tc-pop 0.35s ease;
  }
  @keyframes tc-pop {
    from {
      opacity: 0.3;
    }
    to {
      opacity: 1;
    }
  }
  .aas-trie-compress-demo .tc-ch {
    font-size: 14px;
    font-weight: 700;
    fill: var(--aas-bg);
    text-anchor: middle;
    dominant-baseline: central;
    font-family: var(--aas-mono, monospace);
  }
  .aas-trie-compress-demo .tc-root {
    font-size: 11px;
    fill: var(--aas-muted);
    text-anchor: middle;
  }
  .aas-trie-compress-demo .tc-val {
    font-size: 13px;
    font-weight: 700;
    fill: var(--aas-role-model);
    font-family: var(--aas-mono, monospace);
  }
  .aas-trie-compress-demo .tc-note {
    margin: 0.6em 0 0;
    font-size: 0.85em;
    color: var(--aas-muted);
    min-height: 2.4em;
  }
  .aas-trie-compress-demo.is-slide {
    font-size: clamp(1rem, 3.2vh, 2.1rem);
    margin: 0.5rem 0;
  }
  .aas-trie-compress-demo.is-slide .tc-body {
    flex-wrap: nowrap;
  }
  .aas-trie-compress-demo.is-slide .tc-svg {
    flex-basis: 22em;
    max-height: 52vh;
  }
  @media (prefers-reduced-motion: reduce) {
    .aas-trie-compress-demo .tc-nd.is-pop {
      animation: none;
    }
  }
</style>
