---
// 정렬된 접미사의 LCP를 위에서부터 훑어 LRS나 LCS를 찾는 데모.
//
// 표의 한 줄이 접미사 하나다(정렬 순). 한 걸음에 이웃 한 쌍(j-1, j)을 본다.
// 두 줄에서 공통 접두사(LCP[j]글자)를 칠하고, 지금까지의 최댓값보다 길면
// 최댓값을 바꾼다(초록). 끝나면 최댓값의 공통 접두사가 답이다.
//
// mode="lrs": 한 문자열 안에서 두 번 이상 나오는 가장 긴 부분 문자열.
//   이웃 쌍 전부가 후보다. algorithm-code 05_lrs와 같은 결과다.
// mode="lcs": 두 문자열 s1, s2를 '#'로 이어 붙인다. 어느 문자열에서 시작한
//   접미사인지(1, 2)를 표시하고, 서로 다른 문자열에서 시작한 이웃만 후보로
//   삼는다. 같은 문자열끼리의 쌍은 회색으로 건너뛴다. 06_lcs와 같은 결과다.
import { defaultLang } from 'stack-site-builder/i18n/ui';

interface Props {
  mode?: 'lrs' | 'lcs';
  /** lrs에서 쓸 문자열. '$'로 끝나야 한다. */
  text?: string;
  /** lcs에서 쓸 두 문자열 */
  s1?: string;
  s2?: string;
  /** 슬라이드용: 바깥 여백은 줄이고 글자와 칸은 키운다. */
  slide?: boolean;
}
const { mode = 'lrs', text: lrsText = 'banana$', s1 = 'mississippi', s2 = 'kiss', slide = false } = Astro.props;
const id = `lp-${Math.random().toString(36).slice(2, 9)}`;
const text = mode === 'lcs' ? `${s1}#${s2}$` : lrsText;
const n = text.length;
const len1 = s1.length;

/* 접미사 배열과 LCP는 서버에서 만든다(단순 정렬 + 처음부터 비교). 값은
   실습 코드의 Kasai 결과와 같다. 화면의 진행(훑기)은 스크립트가 만든다. */
const sa = [...Array(n).keys()].sort((a, b) => (text.slice(a) < text.slice(b) ? -1 : 1));
const lcp = sa.map((p, j) => {
  if (j === 0) return -1;
  const q = sa[j - 1];
  let h = 0;
  while (p + h < n && q + h < n && text[p + h] === text[q + h]) h += 1;
  return h;
});
const origin = (p: number) => (mode !== 'lcs' ? 1 : p < len1 ? 1 : p === len1 || p === n - 1 ? 0 : 2);

const STRINGS: Record<string, Record<string, string>> = {
  ko: {
    titleLrs: '가장 긴 반복 부분 문자열 (LRS)',
    titleLcs: '가장 긴 공통 부분 문자열 (LCS)',
    back: '뒤로',
    step: '한 걸음',
    play: '자동 재생',
    stop: '멈춤',
    reset: '처음으로',
    colJ: 'j',
    colSa: 'SA[j]',
    colFrom: '출처',
    colLcp: 'LCP[j]',
    colSuffix: '접미사',
    bestLabel: '최댓값',
    pairsLabel: '본 쌍',
    idleLrs: '정렬된 접미사에서 이웃한 두 줄의 공통 접두사가 반복되는 부분 문자열입니다. 위에서부터 LCP의 최댓값을 찾습니다.',
    idleLcs: '{a}와 {b}를 #로 이어 붙였습니다. 서로 다른 문자열에서 시작한 이웃만 공통 부분 문자열입니다.',
    pair: 'j = {j}: 공통 접두사 "{p}" (길이 {h}).',
    pairNone: 'j = {j}: 공통 접두사가 없습니다 (길이 0).',
    better: ' 지금까지 최댓값보다 깁니다. 최댓값 ← {h}',
    notBetter: ' 최댓값 {b}보다 길지 않습니다.',
    same: 'j = {j}: 두 접미사가 모두 문자열 {o}에서 시작합니다. 공통 접두사(길이 {h})는 그 문자열 안의 반복일 뿐이라 건너뜁니다.',
    sep: 'j = {j}: 구분자(#나 $)에서 시작하는 접미사가 끼어 있어 건너뜁니다.',
    done: '답은 "{ans}" (길이 {h})이고, j = {j}의 쌍에서 나왔습니다.',
    doneNone: '후보 LCP가 모두 0이라 답은 빈 문자열입니다.',
  },
  en: {
    titleLrs: 'Longest repeated substring (LRS)',
    titleLcs: 'Longest common substring (LCS)',
    back: 'Back',
    step: 'Step',
    play: 'Play',
    stop: 'Pause',
    reset: 'Reset',
    colJ: 'j',
    colSa: 'SA[j]',
    colFrom: 'from',
    colLcp: 'LCP[j]',
    colSuffix: 'suffix',
    bestLabel: 'best',
    pairsLabel: 'pairs',
    idleLrs: 'The common prefix of two neighboring sorted suffixes is a repeated substring. Scan from the top for the largest LCP.',
    idleLcs: '{a} and {b} are joined with #. Only neighbors that start in different strings give a common substring.',
    pair: 'j = {j}: common prefix "{p}" (length {h}).',
    pairNone: 'j = {j}: no common prefix (length 0).',
    better: ' Longer than the best so far. best ← {h}',
    notBetter: ' Not longer than the best, {b}.',
    same: 'j = {j}: both suffixes start in string {o}. Their common prefix (length {h}) is only a repeat inside it; skip.',
    sep: 'j = {j}: a suffix starting at a separator (# or $) is involved; skip.',
    done: 'The answer is "{ans}" (length {h}), from the pair at j = {j}.',
    doneNone: 'Every candidate LCP is 0, so the answer is the empty string.',
  },
  zh: {
    titleLrs: '最长重复子串 (LRS)',
    titleLcs: '最长公共子串 (LCS)',
    back: '后退',
    step: '单步',
    play: '播放',
    stop: '暂停',
    reset: '重置',
    colJ: 'j',
    colSa: 'SA[j]',
    colFrom: '来源',
    colLcp: 'LCP[j]',
    colSuffix: '后缀',
    bestLabel: '最大值',
    pairsLabel: '已看',
    idleLrs: '排序后相邻两个后缀的公共前缀就是重复出现的子串。从上往下找 LCP 的最大值。',
    idleLcs: '用 # 连接 {a} 和 {b}。只有起点在不同字符串中的相邻后缀才给出公共子串。',
    pair: 'j = {j}：公共前缀 "{p}"（长度 {h}）。',
    pairNone: 'j = {j}：没有公共前缀（长度 0）。',
    better: '比目前的最大值长。最大值 ← {h}',
    notBetter: '不比最大值 {b} 长。',
    same: 'j = {j}：两个后缀都从字符串 {o} 开始。公共前缀（长度 {h}）只是该字符串内部的重复，跳过。',
    sep: 'j = {j}：涉及从分隔符（# 或 $）开始的后缀，跳过。',
    done: '答案是 "{ans}"（长度 {h}），来自 j = {j} 这一对。',
    doneNone: '候选 LCP 全为 0，答案是空字符串。',
  },
};
const lang = Astro.currentLocale ?? defaultLang;
const t = STRINGS[lang] ?? STRINGS[defaultLang] ?? STRINGS.ko;
const isLcs = mode === 'lcs';
---

<div
  class:list={['aas-lcpscan-demo', slide && 'is-slide', isLcs && 'is-lcs', n > 10 && 'is-tall']}
  id={id}
  data-lp-text={text}
  data-lp-mode={mode}
  data-lp-len1={len1}
  data-lp-sa={JSON.stringify(sa)}
  data-lp-lcp={JSON.stringify(lcp)}
  data-lp-strings={JSON.stringify(t)}
  data-lp-s1={s1}
  data-lp-s2={s2}
>
  <div class="lp-bar">
    <span class="lp-head"><strong>{isLcs ? t.titleLcs : t.titleLrs}</strong></span>
    <div class="lp-controls">
      <button type="button" data-act="back" class="lp-btn">{t.back}</button>
      <button type="button" data-act="step" class="lp-btn">{t.step}</button>
      <button type="button" data-act="play" class="lp-btn lp-btn-primary">{t.play}</button>
      <button type="button" data-act="reset" class="lp-btn">{t.reset}</button>
    </div>
  </div>

  <div class="lp-scroll">
    <table class="lp-table">
      <thead>
        <tr>
          <th>{t.colJ}</th>
          <th>{t.colSa}</th>
          {isLcs && <th>{t.colFrom}</th>}
          <th>{t.colLcp}</th>
          <th class="lp-suf">{t.colSuffix}</th>
        </tr>
      </thead>
      <tbody>
        {sa.map((p, j) => (
          <tr data-lp-row={j} class={`lp-o${origin(p)}`}>
            <td>{j}</td>
            <td>{p}</td>
            {isLcs && <td class="lp-from"><span>{origin(p) === 0 ? '-' : origin(p)}</span></td>}
            <td class="lp-lcp">{j === 0 ? '-' : lcp[j]}</td>
            <td class="lp-suf">
              {text.slice(p).split('').map((ch, k) => <span class="lp-ch" data-lp-k={k}>{ch}</span>)}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="lp-foot">
    <p class="lp-note" data-lp-note></p>
    <span class="lp-count">
      {t.pairsLabel} <strong data-lp-pairs>0</strong>/{n - 1} · {t.bestLabel} <strong data-lp-best>0</strong>
    </span>
  </div>
</div>

<script is:inline define:vars={{ id }}>
  (() => {
    const root = document.getElementById(id);
    if (!root) return;

    /* 설명은 문장마다 줄을 바꾼다. 마침표 뒤 공백, 또는 중국어 마침표 뒤에서 끊는다. */
    const setLines = (node, text) => {
      const parts = String(text).split(/(?<=[.!?])\s+(?=\S)|(?<=[。！？])(?=\S)/);
      node.replaceChildren(...parts.flatMap((s, i) => (i ? [document.createElement('br'), s] : [s])));
    };

    const text = root.dataset.lpText;
    const isLcs = root.dataset.lpMode === 'lcs';
    const len1 = Number(root.dataset.lpLen1);
    const sa = JSON.parse(root.dataset.lpSa);
    const lcp = JSON.parse(root.dataset.lpLcp);
    const S = JSON.parse(root.dataset.lpStrings);
    const fill = (tpl, vars) => tpl.replace(/\{(\w+)\}/g, (_, key) => vars[key]);
    const n = text.length;
    const origin = (p) => (!isLcs ? 1 : p < len1 ? 1 : p === len1 || p === n - 1 ? 0 : 2);

    /* 절차는 lrs.pseudo, lcs.pseudo와 같다. 최댓값은 더 길 때만 바꾼다(앞의 것 우선). */
    function plan() {
      const steps = [];
      let best = isLcs ? 0 : -1;
      let bestAt = isLcs ? 0 : 1;
      for (let j = 1; j < n; j++) {
        const f = origin(sa[j]);
        const g = origin(sa[j - 1]);
        const h = lcp[j];
        let note;
        let cand = true;
        if (isLcs && (f === 0 || g === 0)) {
          cand = false;
          note = fill(S.sep, { j });
        } else if (isLcs && f === g) {
          cand = false;
          note = fill(S.same, { j, o: f, h });
        } else {
          note = h > 0 ? fill(S.pair, { j, p: text.slice(sa[j], sa[j] + h), h }) : fill(S.pairNone, { j });
          if (h > best) {
            note += fill(S.better, { h });
            best = h;
            bestAt = j;
          } else {
            note += fill(S.notBetter, { b: best });
          }
        }
        steps.push({ j, cand, best: Math.max(best, 0), bestAt, note });
      }
      const h = Math.max(best, 0);
      steps.push({
        j: null, best: h, bestAt, finished: true,
        note: h > 0
          ? fill(S.done, { ans: text.slice(sa[bestAt], sa[bestAt] + h), h, j: bestAt })
          : S.doneNone,
      });
      return steps;
    }

    const steps = plan();
    const rows = [...root.querySelectorAll('[data-lp-row]')];
    const note = root.querySelector('[data-lp-note]');
    const pairsEl = root.querySelector('[data-lp-pairs]');
    const bestEl = root.querySelector('[data-lp-best]');
    const box = root.querySelector('.lp-scroll');
    const table = box.querySelector('table');
    const windowed = root.classList.contains('is-slide') && root.classList.contains('is-tall');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* 창으로 보는 표: 지금 쌍(끝나면 답의 쌍)이 창 가운데 오도록 스크롤한다.
       offsetTop은 변환(슬라이드 축척)의 영향을 받지 않는다. */
    function follow(st) {
      if (!windowed) return;
      const focus = st ? (st.j ?? st.bestAt) : 0;
      const row = rows[focus];
      const top = st ? table.offsetTop + row.offsetTop - box.clientHeight / 2 : 0;
      box.scrollTo({ top: Math.max(0, top), behavior: reduceMotion ? 'auto' : 'smooth' });
    }

    function paint(row, len, cls) {
      row.querySelectorAll('[data-lp-k]').forEach((ch) => {
        ch.classList.toggle(cls, Number(ch.dataset.lpK) < len);
      });
    }

    function render(s) {
      const st = s >= 0 ? steps[s] : null;
      rows.forEach((row, r) => {
        const inPair = !!st && st.j !== null && (r === st.j || r === st.j - 1);
        row.classList.toggle('is-pair', inPair);
        row.classList.toggle('is-skip', inPair && !st.cand);
        row.classList.toggle('is-seen', !!st && (st.finished || (st.j !== null && r < st.j)));
        const isBest = !!st && st.best > 0 && (r === st.bestAt || r === st.bestAt - 1);
        row.classList.toggle('is-best', isBest);
        paint(row, inPair ? lcp[st.j] : 0, 'is-common');
        paint(row, isBest ? st.best : 0, 'is-answer');
      });
      pairsEl.textContent = String(st ? (st.finished ? n - 1 : st.j) : 0);
      bestEl.textContent = String(st ? st.best : 0);
      setLines(note, st
        ? st.note
        : isLcs
          ? fill(S.idleLcs, { a: root.dataset.lpS1, b: root.dataset.lpS2 })
          : S.idleLrs);
      root.classList.toggle('is-done', !!(st && st.finished));
      follow(st);
    }

    let at = -1;
    let timer = null;
    const playBtn = root.querySelector('[data-act="play"]');

    function stop() {
      if (timer) clearInterval(timer);
      timer = null;
      playBtn.textContent = S.play;
    }

    function step() {
      if (at >= steps.length - 1) return stop();
      at += 1;
      render(at);
      if (at >= steps.length - 1) stop();
    }

    root.querySelector('[data-act="back"]').addEventListener('click', () => {
      stop();
      if (at > -1) at -= 1;
      render(at);
    });
    root.querySelector('[data-act="step"]').addEventListener('click', () => {
      stop();
      step();
    });
    root.querySelector('[data-act="reset"]').addEventListener('click', () => {
      stop();
      at = -1;
      render(-1);
    });
    playBtn.addEventListener('click', () => {
      if (timer) return stop();
      if (at >= steps.length - 1) {
        at = -1;
        render(-1);
      }
      playBtn.textContent = S.stop;
      timer = setInterval(step, 1100);
    });

    render(-1);
  })();
</script>

<style is:global>
  .aas-lcpscan-demo {
    font-size: 1rem;
    margin: 1.5rem 0;
    padding: 1em;
    border: 1px solid var(--aas-border);
    border-radius: 0.9em;
    background: var(--aas-panel);
  }
  .aas-lcpscan-demo .lp-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75em;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.9em;
  }
  .aas-lcpscan-demo .lp-head {
    font-size: 0.95em;
  }
  .aas-lcpscan-demo .lp-controls {
    display: flex;
    gap: 0.5em;
  }
  .aas-lcpscan-demo .lp-btn {
    padding: 0.35em 0.8em;
    font-size: 0.85em;
    border: 1px solid var(--aas-border);
    border-radius: 0.5em;
    background: var(--aas-bg);
    color: var(--aas-text);
    cursor: pointer;
  }
  .aas-lcpscan-demo .lp-btn:hover {
    border-color: var(--aas-accent);
  }
  .aas-lcpscan-demo .lp-btn-primary {
    background: var(--aas-accent);
    border-color: var(--aas-accent);
    color: #fff;
  }

  .aas-lcpscan-demo .lp-scroll {
    overflow-x: auto;
  }
  .aas-lcpscan-demo.aas-lcpscan-demo table {
    width: auto;
    max-width: none;
    border: none;
    border-radius: 0;
    overflow: visible;
    margin: 0 auto;
    border-collapse: collapse;
    font-family: var(--aas-mono, monospace);
    font-size: 1em;
  }
  .aas-lcpscan-demo.aas-lcpscan-demo :is(th, td) {
    padding: 0.05em 0.5em;
    border: none;
    background: none;
    text-align: center;
    line-height: 1.4;
    white-space: nowrap;
  }
  .aas-lcpscan-demo.aas-lcpscan-demo thead th {
    font-family: var(--aas-sans, inherit);
    font-size: 0.75em;
    font-weight: 600;
    color: var(--aas-muted);
    border-bottom: 1px solid var(--aas-border);
  }
  .aas-lcpscan-demo.aas-lcpscan-demo .lp-suf {
    text-align: left;
  }
  .aas-lcpscan-demo.aas-lcpscan-demo tbody tr {
    background: none;
    transition: background-color 0.3s, opacity 0.3s;
  }
  .aas-lcpscan-demo.aas-lcpscan-demo tbody tr.is-pair {
    background: color-mix(in srgb, var(--aas-role-focus) 16%, transparent);
  }
  .aas-lcpscan-demo.aas-lcpscan-demo tbody tr.is-pair.is-skip {
    background: color-mix(in srgb, var(--aas-muted) 18%, transparent);
  }
  .aas-lcpscan-demo.aas-lcpscan-demo tbody tr.is-best:not(.is-pair) {
    background: color-mix(in srgb, var(--aas-role-eval) 14%, transparent);
  }
  .aas-lcpscan-demo.aas-lcpscan-demo .lp-lcp {
    font-weight: 700;
  }
  .aas-lcpscan-demo .lp-from span {
    display: inline-block;
    min-width: 1.3em;
    border-radius: 0.3em;
    font-size: 0.85em;
    color: #fff;
    background: var(--aas-muted);
  }
  .aas-lcpscan-demo .lp-o1 .lp-from span {
    background: var(--aas-role-model);
  }
  .aas-lcpscan-demo .lp-o2 .lp-from span {
    background: var(--aas-role-tool);
  }
  .aas-lcpscan-demo .lp-ch {
    display: inline-block;
    width: 0.8em;
    text-align: center;
    border-radius: 0.15em;
    transition: background-color 0.3s, color 0.3s;
  }
  .aas-lcpscan-demo .lp-ch.is-answer {
    background: color-mix(in srgb, var(--aas-role-eval) 45%, transparent);
  }
  .aas-lcpscan-demo .lp-ch.is-common {
    background: var(--aas-role-focus);
    color: #fff;
  }
  .aas-lcpscan-demo tr.is-skip .lp-ch.is-common {
    background: var(--aas-muted);
  }

  .aas-lcpscan-demo .lp-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em 1em;
    align-items: baseline;
    justify-content: space-between;
  }
  .aas-lcpscan-demo .lp-note {
    margin: 0.6em 0 0;
    font-size: 0.85em;
    color: var(--aas-muted);
    min-height: 2.4em;
    flex: 1 1 20em;
  }
  .aas-lcpscan-demo.is-done .lp-note {
    color: var(--aas-text);
  }
  .aas-lcpscan-demo .lp-count {
    font-size: 0.85em;
    color: var(--aas-muted);
    white-space: nowrap;
  }
  .aas-lcpscan-demo .lp-count strong {
    color: var(--aas-text);
    font-family: var(--aas-mono, monospace);
  }

  /* 슬라이드용. 줄이 많은 표라 다른 데모보다 한 단계 작게 키운다. */
  .aas-lcpscan-demo.is-slide {
    font-size: clamp(0.9rem, 2.6vh, 1.7rem);
    margin: 0.5rem 0;
  }
  /* 행이 많은 표(10행 초과)는 슬라이드에서 11행 남짓만 보이는 창으로 두고,
     지금 보는 쌍을 따라 스크롤한다. 글자 크기는 행이 적은 표와 같다. */
  .aas-lcpscan-demo.is-slide.is-tall .lp-scroll {
    position: relative;
    max-height: calc(1.6em + 11 * 1.5em);
    overflow-y: auto;
