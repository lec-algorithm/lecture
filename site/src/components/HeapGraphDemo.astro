    countDone: '确定',
    countClosed: '关闭',
    idle: '从 {s} 开始。',
    sep: '，',
    primStart: '从 {v} 开始。',
    primAdd: '取出 key 最小的 {v}（{k}），用边 {e} 接到树上。',
