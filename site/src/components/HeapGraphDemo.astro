---
// 우선순위 큐(최소 힙)로 그래프를 넓혀 가는 세 알고리즘을 한 걸음씩 보는 데모.
// mode로 고른다: prim, dijkstra, astar
//
// 세 알고리즘은 같은 틀이다. 힙에서 가장 작은 항목을 꺼내 그 정점을
// 확정하고(초록), 그 정점에서 나가는 간선으로 이웃의 값을 고쳐 힙에
// 새로 넣는다(파랑). 다른 것은 힙에 넣는 값 하나다.
//   prim:     key  = 트리에 붙는 간선 하나의 가중치
//   dijkstra: dist = 출발점부터 쌓인 거리
//   astar:    f    = g(쌓인 거리) + h(목표까지 남은 거리의 추정)
// 값을 고치면 예전 항목은 힙에 남는다. 꺼냈을 때 이미 확정한 정점이면
// 버린다(목록에서 흐리게 보인다). 같은 값이면 먼저 넣은 항목이 먼저다.
//
// 절차와 결과는 algorithm-code의 05_mst_prim, 06_dijkstra, 07_a_star와 같다.
import { defaultLang } from 'stack-site-builder/i18n/ui';
import GraphFigure from './GraphFigure.astro';
import { getGraph } from './GraphSamples';

interface Props {
  mode?: 'prim' | 'dijkstra' | 'astar';
  /** GraphSamples의 이름. 기본은 prim이면 mst, 나머지는 sp */
  graph?: string;
  start?: number;
  /** astar: 목표 정점 */
  goal?: number;
  /** astar: 정점마다 목표까지 남은 거리의 추정값 */
  h?: number[];
  /** astar: 닫힌 정점으로 가는 더 짧은 길을 찾으면 다시 연다. */
  reopen?: boolean;
  /** astar: 휴리스틱을 고르는 칩(예제 h, h = 0, h = h*, h = 2h*)을 보인다. 기본은 끔 */
  hChoices?: boolean;
  /** 처음에 보여 줄 단계 번호. 기본 -1은 시작 전 */
  initial?: number;
  /** 슬라이드용: 바깥 여백은 줄이고 글자와 칸은 키운다. */
  slide?: boolean;
}
const {
  mode = 'dijkstra',
  graph = mode === 'prim' ? 'mst' : 'sp',
  start = 0,
  goal = 6,
  h = [14, 10, 4, 2, 11, 6, 0, 8],
  reopen = true,
  hChoices = false,
  initial = -1,
  slide = false,
} = Astro.props;
const g = getGraph(graph);
const n = g.nodes.length;
const id = `hg-${Math.random().toString(36).slice(2, 9)}`;

const STRINGS: Record<string, Record<string, string>> = {
