---
// 같은 그래프에서 BFS와 재귀 DFS를 나란히 돌려 보는 데모.
//
// 그래프 모양(예제 g7, 별, 긴 줄), 이웃을 보는 순서(작은 번호부터, 큰 번호부터,
// 섞기), 시작 정점(정점을 누른다)을 바꾸면 두 탐색을 다시 돌린다. 볼 것은 셋이다.
//   - BFS 트리의 깊이는 곧 거리다. 이웃 순서를 바꿔도 달라지지 않는다.
//   - DFS 트리의 깊이는 거리가 아니고, 이웃 순서를 바꾸면 달라진다.
//   - 메모리: BFS는 큐의 최대 크기(한 층의 폭), DFS는 호출 스택의 최대 깊이.
//     별에서는 6 대 2, 긴 줄에서는 1 대 7이다.
//
// DFS는 재귀로 돌린다. 큰 번호부터 보면 방문 순서가 0 6 4 5 3 2 1로, 스택 DFS
// (작은 번호부터 넣음)와 같다. 예제의 BFS 순서는 01_bfs의 0 1 2 5 6 3 4다.
import { defaultLang } from 'stack-site-builder/i18n/ui';
import GraphFigure from './GraphFigure.astro';
import { getGraph } from './GraphSamples';

interface Props {
  /** 슬라이드용: 바깥 여백은 줄이고 글자와 칸은 키운다. */
  slide?: boolean;
}
const { slide = false } = Astro.props;
const id = `sc-${Math.random().toString(36).slice(2, 9)}`;
const SHAPES = ['g7', 'star', 'line'];
const edgesOf = Object.fromEntries(SHAPES.map((k) => [k, getGraph(k).edges]));
const N = 7;

const STRINGS: Record<string, Record<string, string>> = {
  ko: {
    title: 'BFS와 DFS 나란히',
    back: '뒤로',
    step: '한 걸음',
    play: '자동 재생',
    stop: '멈춤',
    reset: '처음으로',
    shape: '모양',
    g7: '예제',
    star: '별',
    line: '긴 줄',
    order: '이웃 순서',
    asc: '작은 번호부터',
    desc: '큰 번호부터',
    mix: '섞기',
    visit: '방문',
    queue: '큐',
    stack: '호출 스택',
    peak: '최대',
    empty: '비었음',
    dist: 'BFS 깊이',
    depth: 'DFS 깊이',
    vertex: '정점',
    same: 'BFS 깊이는 작은 번호부터 본 때와 모두 같습니다.',
    diff: 'DFS 깊이는 작은 번호부터 본 때와 {k}곳이 다릅니다.',
    nodiff: 'DFS 깊이도 작은 번호부터 본 때와 같습니다.',
    gap: 'DFS 트리로 가면 {k}곳에서 거리보다 깁니다.',
    nogap: '이 그래프에서는 DFS 트리의 깊이도 거리와 같습니다.',
    mem: '메모리는 큐 {b}칸, 호출 스택 {d}칸까지 썼습니다.',
    going: '{b}번째 방문입니다.',
    goingB: 'BFS는 {v}, DFS는 {w}.',
  },
  en: {
    title: 'BFS and DFS side by side',
    back: 'Back',
    step: 'Step',
    play: 'Play',
    stop: 'Pause',
    reset: 'Reset',
    shape: 'Shape',
    g7: 'Example',
    star: 'Star',
    line: 'Long line',
    order: 'Neighbour order',
    asc: 'Smallest first',
    desc: 'Largest first',
    mix: 'Shuffle',
    visit: 'Visits',
    queue: 'Queue',
    stack: 'Call stack',
    peak: 'peak',
    empty: 'empty',
    dist: 'BFS depth',
    depth: 'DFS depth',
    vertex: 'Vertex',
    same: 'Every BFS depth matches the smallest-first run.',
    diff: 'DFS depth differs from the smallest-first run at {k} vertices.',
    nodiff: 'DFS depth also matches the smallest-first run.',
    gap: 'Along the DFS tree, {k} vertices are farther than their distance.',
    nogap: 'On this graph the DFS tree depth equals the distance too.',
    mem: 'Memory peaked at queue {b}, call stack {d}.',
    going: 'Visit number {b}.',
    goingB: 'BFS is at {v}, DFS at {w}.',
  },
  zh: {
    title: 'BFS 与 DFS 并排',
    back: '后退',
    step: '单步',
    play: '播放',
    stop: '暂停',
    reset: '重置',
    shape: '形状',
    g7: '示例',
    star: '星形',
    line: '长链',
    order: '邻居顺序',
    asc: '从小到大',
    desc: '从大到小',
    mix: '打乱',
    visit: '访问',
    queue: '队列',
    stack: '调用栈',
    peak: '最大',
    empty: '空',
    dist: 'BFS 深度',
    depth: 'DFS 深度',
    vertex: '顶点',
    same: 'BFS 深度与从小到大时完全相同。',
    diff: 'DFS 深度与从小到大时有 {k} 处不同。',
    nodiff: 'DFS 深度也与从小到大时相同。',
    gap: '沿 DFS 树走，有 {k} 个顶点比实际距离更远。',
    nogap: '在这个图上，DFS 树的深度也等于距离。',
    mem: '内存用到队列 {b} 格、调用栈 {d} 层。',
    going: '第 {b} 次访问。',
    goingB: 'BFS 在 {v}，DFS 在 {w}。',
  },
};
const lang = Astro.currentLocale ?? defaultLang;
const t = STRINGS[lang] ?? STRINGS[defaultLang] ?? STRINGS.ko;
---

<div
  class:list={['aas-search-compare-demo', slide && 'is-slide']}
  id={id}
  data-sc-edges={JSON.stringify(edgesOf)}
  data-sc-n={N}
  data-sc-strings={JSON.stringify(t)}
>
  <div class="sc-bar">
    <span class="sc-head"><strong>{t.title}</strong></span>
    <div class="sc-tabs">
      <span class="sc-tablabel">{t.shape}</span>
      {SHAPES.map((k) => <button type="button" class="sc-chip" data-sc-shape={k}>{t[k]}</button>)}
      <span class="sc-tablabel">{t.order}</span>
      {['asc', 'desc', 'mix'].map((k) => <button type="button" class="sc-chip" data-sc-order={k}>{t[k]}</button>)}
    </div>
    <div class="sc-controls">
      <button type="button" data-act="back" class="sc-btn">{t.back}</button>
      <button type="button" data-act="step" class="sc-btn">{t.step}</button>
      <button type="button" data-act="play" class="sc-btn sc-btn-primary">{t.play}</button>
      <button type="button" data-act="reset" class="sc-btn">{t.reset}</button>
    </div>
  </div>

  <div class="sc-cols">
    {
      ['bfs', 'dfs'].map((a) => (
        <div class="sc-col" data-sc-col={a}>
          <div class="sc-figs">
            {SHAPES.map((k) => (
              <div class="sc-fig" data-sc-fig={k}>
                <GraphFigure graph={k} bare slide={slide} />
              </div>
            ))}
          </div>
          <div class="sc-side">
            <div class="sc-name">{a.toUpperCase()}</div>
            <div class="sc-line">
              {t.visit}: <strong data-sc-visit />
            </div>
            <div class="sc-line">
              {a === 'bfs' ? t.queue : t.stack}: <strong data-sc-mem />
            </div>
            <div class="sc-peak">
              <span>{t.peak}</span>
              <strong data-sc-peak />
            </div>
          </div>
        </div>
      ))
    }
  </div>

  <div class="sc-foot">
  <div class="sc-table" role="table" style={`--sc-n: ${N}`}>
    <span class="sc-rh">{t.vertex}</span>
    {Array.from({ length: N }, (_, v) => <b>{v}</b>)}
    <span class="sc-rh">{t.dist}</span>
    {Array.from({ length: N }, (_, v) => <span data-sc-b={v} />)}
    <span class="sc-rh">{t.depth}</span>
    {Array.from({ length: N }, (_, v) => <span data-sc-d={v} />)}
  </div>

  <p class="sc-note" data-sc-note></p>
  </div>
</div>

<script is:inline define:vars={{ id }}>
  (() => {
    const root = document.getElementById(id);
    if (!root) return;

    /* 설명은 문장마다 줄을 바꾼다. 마침표 뒤 공백, 또는 중국어 마침표 뒤에서 끊는다. */
    const setLines = (node, text) => {
      const parts = String(text).split(/(?<=[.!?])\s+(?=\S)|(?<=[。！？])(?=\S)/);
      node.replaceChildren(...parts.flatMap((s, i) => (i ? [document.createElement('br'), s] : [s])));
    };
    /* 문장 잇기. 중국어 마침표 뒤에는 공백을 두지 않아야 setLines가 끊는다. */
    const join = (...parts) =>
      parts.filter(Boolean).reduce((a, b) => (/[。！？]$/.test(a) ? a + b : `${a} ${b}`), '');
    const fill = (tpl, vars) => tpl.replace(/\{(\w+)\}/g, (_, k) => vars[k]);
    const S = JSON.parse(root.dataset.scStrings);
    const N = Number(root.dataset.scN);
    const EDGES = JSON.parse(root.dataset.scEdges);

    let shape = 'g7';
    let order = 'asc';
    let start = 0;
    let seed = 1;

    /* 섞기는 시드가 있는 난수로 한다. 같은 칩을 다시 누르면 새로 섞는다. */
    function shuffled(list, s0) {
      const a = list.slice();
      let x = s0 >>> 0 || 1;
      for (let i = a.length - 1; i > 0; i--) {
        x = (x * 1664525 + 1013904223) >>> 0;
        const j = x % (i + 1);
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    }
    function makeAdj(ord) {
      const adj = Array.from({ length: N }, () => []);
      EDGES[shape].forEach(([u, v]) => {
        adj[u].push(v);
        adj[v].push(u);
      });
      return adj.map((a, v) => {
        const up = a.slice().sort((x, y) => x - y);
        if (ord === 'desc') return up.reverse();
        if (ord === 'mix') return shuffled(up, seed * 31 + v * 7 + 1);
        return up;
      });
    }

    /* BFS는 꺼낼 때마다 한 단계, 재귀 DFS는 처음 들어갈 때마다 한 단계다. */
    function runBfs(adj) {
      const dist = new Array(N).fill(null);
      const from = new Array(N).fill(null);
      const q = [start];
      const steps = [];
      dist[start] = 0;
      let peak = 1;
      const seq = [];
      while (q.length) {
        const v = q.shift();
        seq.push(v);
        adj[v].forEach((w) => {
          if (dist[w] === null) {
            dist[w] = dist[v] + 1;
            from[w] = v;
            q.push(w);
          }
        });
        peak = Math.max(peak, q.length);
        steps.push({ cur: v, mem: q.slice(), peak, seq: seq.slice(), from: from.slice(), val: dist.slice() });
      }
      return { steps, val: dist, peak };
    }
    function runDfs(adj) {
      const depth = new Array(N).fill(null);
      const from = new Array(N).fill(null);
      const steps = [];
      const seq = [];
      const callStack = [];
      let peak = 0;
      const go = (v, d, p) => {
        depth[v] = d;
        from[v] = p;
        seq.push(v);
        callStack.push(v);
        peak = Math.max(peak, callStack.length);
        steps.push({ cur: v, mem: callStack.slice(), peak, seq: seq.slice(), from: from.slice(), val: depth.slice() });
        adj[v].forEach((w) => {
          if (depth[w] === null) go(w, d + 1, v);
        });
        callStack.pop();
      };
      go(start, 0, null);
      return { steps, val: depth, peak };
    }

    let bfs;
    let dfs;
    let baseB;
    let baseD;
    let at = 0;
    const last = () => Math.max(bfs.steps.length, dfs.steps.length) - 1;
    function plan() {
      const adj = makeAdj(order);
      bfs = runBfs(adj);
      dfs = runDfs(adj);
      const up = makeAdj('asc');
      baseB = runBfs(up).val;
      baseD = runDfs(up).val;
      at = last();
    }

    const chipShapes = [...root.querySelectorAll('[data-sc-shape]')];
    const chipOrders = [...root.querySelectorAll('[data-sc-order]')];
    const noteEl = root.querySelector('[data-sc-note]');
    const cols = { bfs: root.querySelector('[data-sc-col="bfs"]'), dfs: root.querySelector('[data-sc-col="dfs"]') };
    const bCells = [...root.querySelectorAll('[data-sc-b]')];
    const dCells = [...root.querySelectorAll('[data-sc-d]')];

    function paint(col, run, i) {
      const st = run.steps[Math.min(i, run.steps.length - 1)];
      col.querySelectorAll('[data-sc-fig]').forEach((fig) => {
        const on = fig.dataset.scFig === shape;
        fig.classList.toggle('is-off', !on);
        if (!on) return;
        fig.querySelectorAll('[data-gf-node]').forEach((el) => {
          const v = Number(el.dataset.gfNode);
          el.classList.toggle('is-focus', st.cur === v);
          el.classList.toggle('is-done', st.seq.includes(v) && st.cur !== v);
          el.classList.toggle('is-open', st.val[v] !== null && !st.seq.includes(v));
          el.classList.toggle('is-ring', v === start);
        });
        fig.querySelectorAll('[data-gf-badge]').forEach((el) => {
          const v = Number(el.dataset.gfBadge);
          el.textContent = st.val[v] === null ? '' : String(st.val[v]);
        });
        fig.querySelectorAll('[data-gf-edge]').forEach((el) => {
          const [a, b] = el.dataset.gfEdge.split('-').map(Number);
          el.classList.toggle('is-tree', st.from[b] === a || st.from[a] === b);
        });
      });
      col.querySelector('[data-sc-visit]').textContent = st.seq.join(' ');
      col.querySelector('[data-sc-mem]').textContent = st.mem.length ? `[${st.mem.join(' ')}]` : S.empty;
      col.querySelector('[data-sc-peak]').textContent = String(st.peak);
    }

    function render() {
      chipShapes.forEach((c) => c.classList.toggle('is-on', c.dataset.scShape === shape));
      chipOrders.forEach((c) => c.classList.toggle('is-on', c.dataset.scOrder === order));
      paint(cols.bfs, bfs, at);
      paint(cols.dfs, dfs, at);
      const stB = bfs.steps[Math.min(at, bfs.steps.length - 1)];
      const stD = dfs.steps[Math.min(at, dfs.steps.length - 1)];
      bCells.forEach((c, v) => (c.textContent = stB.val[v] === null ? '' : String(stB.val[v])));
      dCells.forEach((c, v) => {
        c.textContent = stD.val[v] === null ? '' : String(stD.val[v]);
        c.classList.toggle('is-far', stD.val[v] !== null && stD.val[v] !== bfs.val[v]);
      });
      const end = at >= last();
      root.classList.toggle('is-done', end);
      if (end) {
        const moved = dfs.val.filter((d, v) => d !== baseD[v]).length;
        const gap = dfs.val.filter((d, v) => d !== bfs.val[v]).length;
        const sameB = bfs.val.every((d, v) => d === baseB[v]);
        setLines(
          noteEl,
          join(
            order !== 'asc' && sameB ? S.same : '',
            order === 'asc' ? '' : moved ? fill(S.diff, { k: moved }) : S.nodiff,
            gap ? fill(S.gap, { k: gap }) : S.nogap,
            fill(S.mem, { b: bfs.peak, d: dfs.peak }),
          ),
        );
      } else {
        setLines(noteEl, join(fill(S.going, { b: at + 1 }), fill(S.goingB, { v: stB.cur, w: stD.cur })));
      }
    }

    let timer = null;
    const playBtn = root.querySelector('[data-act="play"]');
    function stop() {
      if (timer) clearInterval(timer);
      timer = null;
      playBtn.textContent = S.play;
    }
    function step() {
      if (at >= last()) return stop();
      at += 1;
      render();
      if (at >= last()) stop();
    }
    const replan = () => {
      stop();
      plan();
      render();
    };
    chipShapes.forEach((c) =>
      c.addEventListener('click', () => {
        shape = c.dataset.scShape;
        replan();
      }),
    );
    chipOrders.forEach((c) =>
      c.addEventListener('click', () => {
        if (c.dataset.scOrder === 'mix') seed += 1;
        order = c.dataset.scOrder;
        replan();
      }),
    );
    root.querySelectorAll('[data-gf-node]').forEach((el) => {
      const v = Number(el.dataset.gfNode);
      el.setAttribute('tabindex', '0');
      el.setAttribute('role', 'button');
      el.setAttribute('aria-label', String(v));
      const go = () => {
        start = v;
        replan();
      };
      el.addEventListener('click', go);
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          go();
        }
      });
    });
    root.querySelector('[data-act="back"]').addEventListener('click', () => {
      stop();
      if (at > 0) at -= 1;
      render();
    });
    root.querySelector('[data-act="step"]').addEventListener('click', () => {
      stop();
      step();
    });
    root.querySelector('[data-act="reset"]').addEventListener('click', () => {
      stop();
      at = 0;
      render();
    });
    playBtn.addEventListener('click', () => {
      if (timer) return stop();
      if (at >= last()) {
        at = 0;
        render();
      }
      playBtn.textContent = S.stop;
      timer = setInterval(step, 1200);
    });
    plan();
    render();
  })();
</script>

<style is:global>
  .aas-search-compare-demo {
    /* 안쪽 치수는 모두 이 값에 대한 em이다(다른 데모들과 같은 방식). */
    font-size: 1rem;
    margin: 1.5rem 0;
    padding: 1em;
    border: 1px solid var(--aas-border);
    border-radius: 0.9em;
    background: var(--aas-panel);
  }
  .aas-search-compare-demo .sc-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em 0.8em;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.6em;
  }
  .aas-search-compare-demo .sc-head {
    font-size: 0.95em;
  }
  .aas-search-compare-demo .sc-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25em;
    align-items: center;
  }
  .aas-search-compare-demo .sc-tablabel {
    margin-inline: 0.5em 0.1em;
    font-size: 0.75em;
    color: var(--aas-muted);
    white-space: nowrap;
  }
  .aas-search-compare-demo .sc-chip {
    padding: 0.15em 0.6em;
    font-size: 0.75em;
    border: 1px solid var(--aas-border);
    border-radius: 999px;
    background: var(--aas-bg);
    color: var(--aas-text);
    cursor: pointer;
    white-space: nowrap;
  }
  .aas-search-compare-demo .sc-chip:hover {
    border-color: var(--aas-accent);
  }
  .aas-search-compare-demo .sc-chip.is-on {
    background: var(--aas-accent);
    border-color: var(--aas-accent);
    color: #fff;
    font-weight: 700;
  }
  .aas-search-compare-demo .sc-controls {
    display: flex;
    gap: 0.4em;
  }
  .aas-search-compare-demo .sc-btn {
    padding: 0.3em 0.7em;
    font-size: 0.8em;
    border: 1px solid var(--aas-border);
    border-radius: 0.5em;
    background: var(--aas-bg);
    color: var(--aas-text);
    cursor: pointer;
  }
  .aas-search-compare-demo .sc-btn:hover {
    border-color: var(--aas-accent);
  }
  .aas-search-compare-demo .sc-btn-primary {
    background: var(--aas-accent);
    border-color: var(--aas-accent);
    color: #fff;
  }
  .aas-search-compare-demo .sc-cols {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6em 1.4em;
  }
  .aas-search-compare-demo .sc-col {
    flex: 1 1 20em;
    display: flex;
    gap: 0.9em;
    align-items: flex-start;
    min-width: 0;
  }
  .aas-search-compare-demo .sc-figs {
    flex: 0 0 auto;
    width: 12em;
  }
  .aas-search-compare-demo .sc-fig.is-off {
    display: none;
  }
  .aas-search-compare-demo .gf-node {
    cursor: pointer;
  }
  .aas-search-compare-demo .sc-side {
    flex: 1 1 0;
    min-width: 0;
    font-size: 0.8em;
  }
  .aas-search-compare-demo .sc-name {
    font-weight: 700;
    color: var(--aas-accent);
  }
  .aas-search-compare-demo .sc-line {
    margin-top: 0.25em;
    color: var(--aas-muted);
  }
  .aas-search-compare-demo .sc-line strong {
    font-family: var(--aas-mono, monospace);
    color: var(--aas-text);
  }
  .aas-search-compare-demo .sc-peak {
    display: flex;
    gap: 0.35em;
    align-items: baseline;
    margin-top: 0.25em;
    color: var(--aas-muted);
  }
  .aas-search-compare-demo .sc-peak strong {
    font-family: var(--aas-mono, monospace);
    font-size: 2em;
    line-height: 1.1;
    color: var(--aas-role-focus);
  }
  /* 표는 table 요소 대신 grid로 그린다. 테마의 문서 표 스타일이 덮지 않게 */
