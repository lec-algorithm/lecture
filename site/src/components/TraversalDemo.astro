---
// 트리 순회를 한 걸음씩 해 보는 데모. 중위·전위·후위·레벨 순서를 탭으로 바꾼다.
//
// 재귀 순회는 실제로 재귀를 돌려 단계를 만든다. 노드에 들어갈 때(주황) 한
// 걸음, 출력할 때 한 걸음이다. 출력한 노드에는 몇 번째로 나왔는지 번호가
// 붙고, 아래 출력 줄에 글자가 하나씩 채워진다. 호출 스택(루트에서 지금
// 노드까지의 길)도 함께 보여 준다. 전위는 들어가자마자 출력하므로 두 일이
// 한 걸음이다.
//
// 레벨 순서는 큐로 돈다. 한 걸음마다 큐 맨 앞을 꺼내 출력하고 자식을 뒤에 넣는다.
//
// 순서는 algorithm-code의 traversal.c · traversal.py와 같다. 기본 트리
// (D B F A C E G를 넣은 것)의 중위는 A B C D E F G다.
import { defaultLang } from 'stack-site-builder/i18n/ui';

type Key = number | string;
type Order = 'in' | 'pre' | 'post' | 'level';
interface Props {
  /** 넣는 순서. 문자열이면 글자 하나씩. 기본은 D B F A C E G */
  keys?: Key[] | string;
  /** 처음 보여 줄 순회 */
  order?: Order;
  /** 슬라이드용: 바깥 여백은 줄이고 글자와 칸은 키운다. */
  slide?: boolean;
}
const { keys: rawKeys = 'DBFACEG', order = 'in', slide = false } = Astro.props;
const keys = typeof rawKeys === 'string' ? [...rawKeys] : rawKeys;
const id = `td-${Math.random().toString(36).slice(2, 9)}`;
const ORDERS: Order[] = ['in', 'pre', 'post', 'level'];

const STRINGS: Record<string, Record<string, string>> = {
  ko: {
    title: '트리 순회',
    back: '뒤로',
    step: '한 걸음',
    play: '자동 재생',
    stop: '멈춤',
    reset: '처음으로',
    in: '중위',
    pre: '전위',
    post: '후위',
    level: '레벨 순서',
    ruleIn: '[왼쪽] [현재] [오른쪽]',
    rulePre: '[현재] [왼쪽] [오른쪽]',
    rulePost: '[왼쪽] [오른쪽] [현재]',
    ruleLevel: '위 레벨부터, 같은 레벨은 왼쪽부터',
    output: '출력',
    stack: '호출 스택',
    queue: '큐',
    empty: '비어 있음',
    idle: '루트에서 시작합니다. 규칙: {rule}',
    idleLevel: '큐에 루트 하나를 넣고 시작합니다. 규칙: {rule}',
    enterIn: '{v}: 들어왔습니다. 출력은 왼쪽 서브트리를 다 본 뒤입니다.',
    outIn: '{v}: 왼쪽이 끝났으니 출력합니다. 이제 오른쪽 차례입니다.',
    enterPre: '{v}: 들어오자마자 출력합니다. 그다음 왼쪽, 오른쪽 순서입니다.',
    enterPost: '{v}: 들어왔습니다. 출력은 두 서브트리를 다 본 뒤입니다.',
    outPost: '{v}: 왼쪽과 오른쪽이 끝났으니 출력합니다.',
    outLevel: '{v}: 큐 맨 앞에서 꺼내 출력하고, 자식을 큐 뒤에 넣습니다.',
    done: '끝. {list}',
  },
  en: {
    title: 'Tree traversal',
    back: 'Back',
    step: 'Step',
    play: 'Play',
    stop: 'Pause',
    reset: 'Reset',
    in: 'Inorder',
    pre: 'Preorder',
    post: 'Postorder',
    level: 'Level order',
    ruleIn: '[left] [current] [right]',
    rulePre: '[current] [left] [right]',
    rulePost: '[left] [right] [current]',
    ruleLevel: 'top level first, left to right within a level',
    output: 'output',
    stack: 'call stack',
    queue: 'queue',
    empty: 'empty',
    idle: 'Start at the root. Rule: {rule}',
    idleLevel: 'Start with just the root in the queue. Rule: {rule}',
    enterIn: '{v}: entered. It is printed only after its left subtree is done.',
    outIn: '{v}: the left side is done, so print it. The right side is next.',
    enterPre: '{v}: printed the moment we enter. Then left, then right.',
    enterPost: '{v}: entered. It is printed only after both subtrees are done.',
    outPost: '{v}: left and right are done, so print it.',
    outLevel: '{v}: take it off the front of the queue, print it, and add its children to the back.',
    done: 'Done. {list}',
  },
  zh: {
    title: '树的遍历',
    back: '后退',
    step: '单步',
    play: '播放',
    stop: '暂停',
    reset: '重置',
    in: '中序',
    pre: '前序',
    post: '后序',
    level: '层序',
    ruleIn: '[左] [当前] [右]',
    rulePre: '[当前] [左] [右]',
    rulePost: '[左] [右] [当前]',
    ruleLevel: '从上层到下层，同一层从左到右',
    output: '输出',
    stack: '调用栈',
    queue: '队列',
    empty: '空',
    idle: '从根开始。规则：{rule}',
    idleLevel: '队列中先放入根。规则：{rule}',
    enterIn: '{v}：进入。要等左子树全部看完才输出。',
    outIn: '{v}：左边结束了，输出。接下来轮到右边。',
    enterPre: '{v}：一进入就输出。然后是左、右。',
    enterPost: '{v}：进入。要等两棵子树都看完才输出。',
    outPost: '{v}：左右都结束了，输出。',
    outLevel: '{v}：从队首取出并输出，把它的子节点放到队尾。',
    done: '结束。{list}',
  },
};
const lang = Astro.currentLocale ?? defaultLang;
const t = STRINGS[lang] ?? STRINGS[defaultLang] ?? STRINGS.ko;
const ruleKey = { in: 'ruleIn', pre: 'rulePre', post: 'rulePost', level: 'ruleLevel' } as const;
---

<div
  class:list={['aas-traversal-demo', slide && 'is-slide']}
  id={id}
  data-td-keys={JSON.stringify(keys)}
  data-td-order={order}
  data-td-strings={JSON.stringify(t)}
>
  <div class="td-bar">
    <div class="td-tabs" role="tablist">
      {ORDERS.map((o) => (
        <button type="button" role="tab" class="td-tab" data-td-tab={o} title={t[ruleKey[o]]}>
          {t[o]}
        </button>
      ))}
    </div>
    <div class="td-controls">
      <button type="button" data-act="back" class="td-btn">{t.back}</button>
      <button type="button" data-act="step" class="td-btn">{t.step}</button>
      <button type="button" data-act="play" class="td-btn td-btn-primary">{t.play}</button>
      <button type="button" data-act="reset" class="td-btn">{t.reset}</button>
    </div>
  </div>

  <p class="td-rule" data-td-rule></p>

  <svg class="td-tree" data-td-svg role="img" aria-label={t.title}></svg>

  <div class="td-rows">
    <div class="td-row">
      <span class="td-row-label">{t.output}</span>
      <span class="td-out" data-td-out></span>
      <span class="td-count"><strong data-td-count>0</strong> / {new Set(keys).size}</span>
    </div>
    <div class="td-row">
      <span class="td-row-label" data-td-aux-label>{t.stack}</span>
      <span class="td-aux" data-td-aux></span>
    </div>
  </div>
  <p class="td-note" data-td-note></p>
</div>

<script is:inline define:vars={{ id }}>
  (() => {
    const root = document.getElementById(id);
    if (!root) return;

    const keys = JSON.parse(root.dataset.tdKeys);
    const S = JSON.parse(root.dataset.tdStrings);
    const fill = (tpl, vars) => tpl.replace(/\{(\w+)\}/g, (_, key) => vars[key]);
    const RULE = { in: S.ruleIn, pre: S.rulePre, post: S.rulePost, level: S.ruleLevel };

    /* 트리를 만든다. 노드 id는 키 자신이다. */
    const nodes = new Map();
    let top = null;
    for (const k of keys) {
      if (top === null) {
        top = k;
        nodes.set(k, { left: null, right: null, depth: 0 });
        continue;
      }
      let v = top;
      for (;;) {
        if (k === v) break;
        const node = nodes.get(v);
        const side = k < v ? 'left' : 'right';
        if (node[side] === null) {
          node[side] = k;
          nodes.set(k, { left: null, right: null, depth: node.depth + 1 });
          break;
        }
        v = node[side];
      }
    }
    const sorted = [...nodes.keys()].sort((a, b) => (a < b ? -1 : a > b ? 1 : 0));

    /* 순회 하나의 단계 배열을 만든다. 재귀 순회는 실제로 재귀를 돈다. */
    function plan(order) {
      const steps = [];
      const out = [];
      const snap = (extra) => steps.push({ out: out.slice(), ...extra });
      if (order === 'level') {
        const queue = top === null ? [] : [top];
        snap({ current: null, aux: queue.slice(), note: fill(S.idleLevel, { rule: RULE.level }) });
        while (queue.length) {
          const v = queue.shift();
          out.push(v);
          const node = nodes.get(v);
          if (node.left !== null) queue.push(node.left);
          if (node.right !== null) queue.push(node.right);
          snap({ current: v, aux: queue.slice(), note: fill(S.outLevel, { v }) });
        }
      } else {
        snap({ current: null, aux: [], note: fill(S.idle, { rule: RULE[order] }) });
        const stack = [];
        const visit = (v) => {
          if (v === null) return;
          stack.push(v);
          const node = nodes.get(v);
          if (order === 'pre') {
            out.push(v);
            snap({ current: v, aux: stack.slice(), note: fill(S.enterPre, { v }) });
          } else {
            snap({ current: v, aux: stack.slice(), note: fill(order === 'in' ? S.enterIn : S.enterPost, { v }) });
          }
          visit(node.left);
          if (order === 'in') {
            out.push(v);
            snap({ current: v, aux: stack.slice(), note: fill(S.outIn, { v }) });
          }
          visit(node.right);
          if (order === 'post') {
            out.push(v);
            snap({ current: v, aux: stack.slice(), note: fill(S.outPost, { v }) });
          }
          stack.pop();
        };
        visit(top);
      }
      snap({ current: null, aux: [], done: true, note: fill(S.done, { list: out.join(' ') }) });
      return steps;
    }

    /* 그림: x는 중위 순번, y는 깊이. 번호 배지는 노드 오른쪽 위. */
    const UNIT = 52;
    const LEVEL = 64;
    const R = 18;
    const PAD = 32;
    const maxDepth = Math.max(0, ...[...nodes.values()].map((n) => n.depth));
    const W = (sorted.length - 1) * UNIT + 2 * PAD;
    const H = maxDepth * LEVEL + 2 * R + 22;
    const X = (k) => PAD + sorted.indexOf(k) * UNIT;
    const Y = (k) => R + 16 + nodes.get(k).depth * LEVEL;
    const NS = 'http://www.w3.org/2000/svg';
    const svg = root.querySelector('[data-td-svg]');
    svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
    const el = (name, attrs, text) => {
      const node = document.createElementNS(NS, name);
      for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, String(v));
      if (text !== undefined) node.textContent = text;
      return node;
    };
    const nodeEls = new Map();
    const edgeLayer = el('g', {});
    const nodeLayer = el('g', {});
    svg.appendChild(edgeLayer);
    svg.appendChild(nodeLayer);
    for (const k of sorted) {
      const node = nodes.get(k);
      for (const c of [node.left, node.right]) {
        if (c !== null) edgeLayer.appendChild(el('line', { class: 'td-edge', x1: X(k), y1: Y(k), x2: X(c), y2: Y(c), 'data-td-edge': String(c) }));
      }
      const g = el('g', { class: 'td-node', transform: `translate(${X(k)} ${Y(k)})` });
      g.appendChild(el('circle', { r: R }));
      g.appendChild(el('text', { class: 'td-label' }, String(k)));
      const badge = el('g', { class: 'td-badge', transform: `translate(${R * 0.95} ${-R * 0.95})` });
      badge.appendChild(el('circle', { r: 11 }));
      const num = el('text', { class: 'td-num' }, '');
      badge.appendChild(num);
      g.appendChild(badge);
      nodeLayer.appendChild(g);
      nodeEls.set(k, { g, num });
    }

    const outEl = root.querySelector('[data-td-out]');
    const auxEl = root.querySelector('[data-td-aux]');
    const tabs = [...root.querySelectorAll('[data-td-tab]')];
    let order = root.dataset.tdOrder;
    let steps = plan(order);
    let at = 0;

    function chips(container, list, hot) {
      container.textContent = '';
      if (!list.length && container === auxEl) {
        const span = document.createElement('span');
        span.className = 'td-empty';
        span.textContent = S.empty;
        container.appendChild(span);
        return;
      }
      list.forEach((k, i) => {
        const span = document.createElement('span');
        span.className = 'td-chip' + (hot(i) ? ' is-hot' : '');
        span.textContent = String(k);
        container.appendChild(span);
      });
    }

    function render(s) {
      const step = steps[s];
      const rank = new Map(step.out.map((k, i) => [k, i + 1]));
      const onStack = new Set(order === 'level' ? [] : step.aux);
      const inQueue = new Set(order === 'level' ? step.aux : []);
      for (const [k, { g, num }] of nodeEls) {
        g.classList.toggle('is-current', step.current === k);
        g.classList.toggle('is-stack', onStack.has(k) && step.current !== k);
        g.classList.toggle('is-queued', inQueue.has(k));
        g.classList.toggle('is-out', rank.has(k));
        num.textContent = rank.has(k) ? String(rank.get(k)) : '';
      }
      for (const line of edgeLayer.children) {
        const child = line.dataset.tdEdge;
        const c = [...nodes.keys()].find((k) => String(k) === child);
        line.classList.toggle('is-stack', onStack.has(c));
      }
      const justOut = step.out.length && step.out[step.out.length - 1] === step.current;
      chips(outEl, step.out, (i) => justOut && i === step.out.length - 1);
      chips(auxEl, step.aux, (i) => order !== 'level' && i === step.aux.length - 1);
      root.querySelector('[data-td-count]').textContent = String(step.out.length);
      root.querySelector('[data-td-note]').textContent = step.note;
      root.querySelector('[data-td-rule]').textContent = RULE[order];
      root.querySelector('[data-td-aux-label]').textContent = order === 'level' ? S.queue : S.stack;
      tabs.forEach((tab) => {
        const on = tab.dataset.tdTab === order;
        tab.classList.toggle('is-active', on);
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      root.classList.toggle('is-done', !!step.done);
    }

    let timer = null;
    const playBtn = root.querySelector('[data-act="play"]');
    function stop() {
      if (timer) clearInterval(timer);
      timer = null;
      playBtn.textContent = S.play;
    }
    function step() {
      if (at >= steps.length - 1) return stop();
      at += 1;
      render(at);
      if (at >= steps.length - 1) stop();
    }
    tabs.forEach((tab) =>
      tab.addEventListener('click', () => {
        stop();
        order = tab.dataset.tdTab;
        steps = plan(order);
        at = 0;
        render(0);
      }),
    );
    root.querySelector('[data-act="back"]').addEventListener('click', () => {
      stop();
      if (at > 0) at -= 1;
      render(at);
    });
    root.querySelector('[data-act="step"]').addEventListener('click', () => {
      stop();
      step();
    });
    root.querySelector('[data-act="reset"]').addEventListener('click', () => {
      stop();
      at = 0;
      render(0);
    });
    playBtn.addEventListener('click', () => {
      if (timer) return stop();
      if (at >= steps.length - 1) {
        at = 0;
        render(0);
      }
      playBtn.textContent = S.stop;
      timer = setInterval(step, 900);
    });

    render(0);
  })();
</script>

<!-- 그림과 칩은 스크립트가 만들므로 Astro의 scoped 스타일 속성이 붙지 않는다.
     그래서 is:global로 두고, 선택자를 .aas-traversal-demo 아래로 한정한다. -->
<style is:global>
  .aas-traversal-demo {
    font-size: 1rem;
    margin: 1.5rem 0;
    padding: 1em;
    border: 1px solid var(--aas-border);
    border-radius: 0.9em;
    background: var(--aas-panel);
  }
  .aas-traversal-demo .td-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75em;
    align-items: center;
    justify-content: space-between;
  }
  .aas-traversal-demo .td-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3em;
  }
  .aas-traversal-demo .td-tab {
    padding: 0.3em 0.75em;
    font-size: 0.85em;
    font-weight: 600;
    border: 1px solid var(--aas-border);
    border-radius: 999px;
    background: var(--aas-bg);
    color: var(--aas-muted);
    cursor: pointer;
  }
  .aas-traversal-demo .td-tab.is-active {
    border-color: var(--aas-role-model);
    background: color-mix(in srgb, var(--aas-role-model) 16%, var(--aas-bg));
    color: var(--aas-text);
  }
  .aas-traversal-demo .td-controls {
    display: flex;
    gap: 0.5em;
  }
  .aas-traversal-demo .td-btn {
    padding: 0.35em 0.8em;
    font-size: 0.85em;
    border: 1px solid var(--aas-border);
    border-radius: 0.5em;
    background: var(--aas-bg);
    color: var(--aas-text);
    cursor: pointer;
  }
  .aas-traversal-demo .td-btn:hover,
  .aas-traversal-demo .td-tab:hover {
    border-color: var(--aas-accent);
  }
  .aas-traversal-demo .td-btn-primary {
    background: var(--aas-accent);
    border-color: var(--aas-accent);
    color: #fff;
  }
  .aas-traversal-demo .td-rule {
    margin: 0.6em 0 0;
    font-size: 0.85em;
    color: var(--aas-muted);
  }

  .aas-traversal-demo .td-tree {
    display: block;
    width: 100%;
    max-width: 30em;
    max-height: 20em;
    margin: 0.2em auto 0;
  }
  .aas-traversal-demo .td-edge {
    stroke: var(--aas-muted);
    stroke-width: 1.6;
    transition: stroke 0.2s;
  }
  .aas-traversal-demo .td-edge.is-stack {
    stroke: var(--aas-role-focus);
    stroke-width: 3;
  }
  .aas-traversal-demo .td-node circle {
    fill: var(--aas-text);
    stroke: var(--aas-text);
    stroke-width: 1.6;
    transition:
      fill 0.2s,
      stroke 0.2s;
  }
  .aas-traversal-demo .td-label {
    font-size: 14px;
    font-weight: 700;
    fill: var(--aas-bg);
    text-anchor: middle;
    dominant-baseline: central;
    font-family: var(--aas-mono, monospace);
  }
  /* 출력한 노드는 흐린 초록, 호출 스택(또는 큐)에 있는 노드는 주황 테두리, 지금 노드는 주황 */
  .aas-traversal-demo .td-node.is-out circle {
    fill: color-mix(in srgb, var(--aas-role-eval) 22%, var(--aas-bg));
    stroke: var(--aas-role-eval);
  }
  .aas-traversal-demo .td-node.is-out .td-label {
    fill: var(--aas-text);
  }
  .aas-traversal-demo .td-node.is-stack circle,
  .aas-traversal-demo .td-node.is-queued circle {
    stroke: var(--aas-role-focus);
    stroke-width: 3;
  }
  .aas-traversal-demo .td-node.is-current circle {
    fill: var(--aas-role-focus);
    stroke: var(--aas-role-focus);
  }
  .aas-traversal-demo .td-node.is-current .td-label {
    fill: #fff;
  }
  .aas-traversal-demo .td-badge {
    opacity: 0;
    transition: opacity 0.3s;
  }
  .aas-traversal-demo .td-node.is-out .td-badge {
    opacity: 1;
  }
  .aas-traversal-demo .td-badge circle {
    fill: var(--aas-role-eval);
    stroke: var(--aas-bg);
    stroke-width: 1.5;
  }
  .aas-traversal-demo .td-num {
    font-size: 13px;
    font-weight: 700;
    fill: #fff;
    text-anchor: middle;
    dominant-baseline: central;
    font-family: var(--aas-mono, monospace);
  }

  .aas-traversal-demo .td-rows {
    display: grid;
    gap: 0.35em;
    margin-top: 0.4em;
    font-size: 0.85em;
  }
  .aas-traversal-demo .td-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35em;
    align-items: center;
    min-height: 1.9em;
  }
  .aas-traversal-demo .td-row-label {
    min-width: 5.5em;
    color: var(--aas-muted);
