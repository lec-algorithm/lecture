---
// 코사인 유사도를 각도로 보여 주는 정지 그림. 스크립트 없이 서버에서 SVG로 그린다.
//
// 평점 두 칸짜리 벡터 두 개를 원점에서 화살표로 긋고, 사이의 각도를 호로
// 표시한다. 코사인 값은 이 컴포넌트가 벡터에서 직접 계산한다. 기본값은
// 슬라이드의 사용자 A (5, 3)와 B (4, 0)이고, 두 사용자 모두 아이템 3·4를
// 보지 않았으므로 네 칸 벡터의 코사인 0.857이 이 평면에서 그대로 나온다.
import { defaultLang } from 'stack-site-builder/i18n/ui';

interface Props {
  /** 첫 벡터 [x, y] */
  a?: [number, number];
  /** 둘째 벡터 [x, y] */
  b?: [number, number];
  /** 벡터 이름 */
  names?: [string, string];
  /** 슬라이드용: 칸 높이에 맞춰 크게 */
  slide?: boolean;
}
const { a = [5, 3], b = [4, 0], names = ['A', 'B'], slide = false } = Astro.props;

const STRINGS: Record<string, Record<string, string>> = {
  ko: {
    x: '아이템 1 평점',
    y: '아이템 2 평점',
    caption: '두 사용자의 평점 벡터. 사이 각도가 작을수록 코사인이 1에 가깝다.',
    user: '사용자',
  },
  en: {
    x: 'rating of item 1',
    y: 'rating of item 2',
    caption: 'Two users’ rating vectors. The smaller the angle between them, the closer the cosine is to 1.',
    user: 'user',
  },
  zh: {
    x: '物品 1 的评分',
    y: '物品 2 的评分',
    caption: '两位用户的评分向量。夹角越小，余弦越接近 1。',
    user: '用户',
  },
};
const lang = Astro.currentLocale ?? defaultLang;
const t = STRINGS[lang] ?? STRINGS[defaultLang] ?? STRINGS.ko;

const dot = a[0] * b[0] + a[1] * b[1];
const na = Math.hypot(a[0], a[1]);
const nb = Math.hypot(b[0], b[1]);
const cos = na && nb ? dot / (na * nb) : 0;

const MAX = Math.max(6, a[0], a[1], b[0], b[1]);
const U = 40; // 한 칸(평점 1)의 픽셀
const PADL = 46;
const PADB = 44;
const W = PADL + MAX * U + 70;
const H = 24 + MAX * U + PADB;
const X = (v: number) => PADL + v * U;
const Y = (v: number) => H - PADB - v * U;
const ticks = Array.from({ length: MAX + 1 }, (_, i) => i);

/* 각도 호: 두 벡터의 방향 사이를 반지름 R로 잇는다. */
const R = 64;
const angA = Math.atan2(a[1], a[0]);
const angB = Math.atan2(b[1], b[0]);
const lo = Math.min(angA, angB);
const hi = Math.max(angA, angB);
const arc = `M ${X(0) + R * Math.cos(lo)} ${Y(0) - R * Math.sin(lo)} A ${R} ${R} 0 0 0 ${X(0) + R * Math.cos(hi)} ${Y(0) - R * Math.sin(hi)}`;
const mid = (lo + hi) / 2;
const labelR = R + 14;
const vec = [
  { v: a, name: names[0], cls: 'cf-a' },
  { v: b, name: names[1], cls: 'cf-b' },
];
---

<figure class:list={['aas-cosine-figure', slide && 'is-slide']}>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={t.caption}>
    <defs>
      <marker id="cf-head-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="4" markerHeight="4" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" class="cf-head-a" />
      </marker>
      <marker id="cf-head-b" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="4" markerHeight="4" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" class="cf-head-b" />
      </marker>
    </defs>
    {ticks.map((i) => (
      <g class="cf-grid">
        <line x1={X(i)} y1={Y(0)} x2={X(i)} y2={Y(MAX)} />
        <line x1={X(0)} y1={Y(i)} x2={X(MAX)} y2={Y(i)} />
        <text x={X(i)} y={Y(0) + 18} class="cf-tick">{i}</text>
        {i > 0 && <text x={X(0) - 12} y={Y(i) + 5} class="cf-tick">{i}</text>}
      </g>
    ))}
    <line class="cf-axis" x1={X(0)} y1={Y(0)} x2={X(MAX)} y2={Y(0)} />
    <line class="cf-axis" x1={X(0)} y1={Y(0)} x2={X(0)} y2={Y(MAX)} />
    <text class="cf-axis-label" x={X(MAX / 2)} y={H - 6}>{t.x}</text>
    <text class="cf-axis-label" x={14} y={Y(MAX / 2)} transform={`rotate(-90 14 ${Y(MAX / 2)})`}>{t.y}</text>

    <path class="cf-arc" d={arc} />
    <text class="cf-theta" x={X(0) + labelR * Math.cos(mid)} y={Y(0) - labelR * Math.sin(mid) + 6}>θ</text>
    <text class="cf-theta cf-value" x={X(MAX / 2)} y={Y(MAX - 0.4)}>cos θ = {cos.toFixed(3)}</text>

    {vec.map(({ v, name, cls }) => (
      <g class={cls}>
        <line x1={X(0)} y1={Y(0)} x2={X(v[0])} y2={Y(v[1])} marker-end={`url(#cf-head-${cls.slice(3)})`} />
        <circle cx={X(v[0])} cy={Y(v[1])} r="4" />
        <text x={X(v[0]) + 10} y={Y(v[1]) - 10}>{`${t.user} ${name} (${v[0]}, ${v[1]})`}</text>
      </g>
    ))}
  </svg>
  <figcaption>{t.caption}</figcaption>
</figure>

<style>
  .aas-cosine-figure {
    margin: 1.5rem auto;
    text-align: center;
  }
  .aas-cosine-figure svg {
    display: block;
    margin-inline: auto;
    width: 100%;
    max-width: 26rem;
    height: auto;
    overflow: visible;
  }
  .aas-cosine-figure figcaption {
    margin-top: 0.4rem;
    font-size: 0.85em;
    color: var(--aas-muted);
  }
  .cf-grid line {
    stroke: var(--aas-border);
    stroke-width: 1;
  }
  .cf-tick {
    font-size: 13px;
    fill: var(--aas-muted);
    text-anchor: middle;
    font-family: var(--aas-mono, monospace);
  }
  .cf-axis {
    stroke: var(--aas-muted);
    stroke-width: 1.6;
  }
  .cf-axis-label {
    font-size: 14px;
    fill: var(--aas-muted);
    text-anchor: middle;
  }
  .cf-arc {
    fill: none;
    stroke: var(--aas-role-focus);
    stroke-width: 2.5;
  }
  .cf-theta {
    font-size: 15px;
    font-weight: 700;
    fill: var(--aas-role-focus);
    text-anchor: middle;
    font-family: var(--aas-mono, monospace);
  }
  .cf-value {
    font-size: 20px;
  }
  .cf-a line,
  .cf-b line {
    stroke-width: 3.5;
  }
  .cf-a line {
    stroke: var(--aas-role-model);
  }
  .cf-b line {
    stroke: var(--aas-role-source);
  }
  .cf-head-a,
  .cf-a circle {
    fill: var(--aas-role-model);
  }
  .cf-head-b,
  .cf-b circle {
    fill: var(--aas-role-source);
  }
  .cf-a text,
  .cf-b text {
    font-size: 15px;
    font-weight: 700;
    fill: var(--aas-text);
  }

  /* 슬라이드: 칸 높이에 맞춰 키운다. vh인 이유는 SearchDemo 참고 */
  .aas-cosine-figure.is-slide {
    margin: 0.5rem auto;
  }
  .aas-cosine-figure.is-slide svg {
    max-width: none;
    width: auto;
    height: 52vh;
  }
</style>
