---
// 이진 트리의 용어를 눌러 보며 익히는 데모.
//
// 위쪽 칩이 용어이고, 칩을 누르면 트리에서 그 용어가 가리키는 부분이 칠해지고
// 오른쪽에 뜻과 "이 트리에서는 무엇인지"가 나온다. 노드를 누르면 그 노드가
// 기준이 된다. 부모·자식, 서브트리, 레벨은 고른 노드를 기준으로 보여 준다.
//
// 트리는 노드 9개, 높이 4다. 일부러 full tree가 아니게 골랐다. 자식이 하나인
// 노드(C, F)와 더 얕은 잎(D)이 있어야 잎·레벨·높이·full tree의 차이가 보인다.
//
// 노드의 자리는 힙 번호로 정한다. 루트가 1, 번호 i의 왼쪽 자식이 2i, 오른쪽
// 자식이 2i+1이다. 그러면 full tree에서 비어 있는 자리도 같은 번호로 그릴 수
// 있다. 높이는 이 과목의 약속대로 레벨의 수로 센다.
import { defaultLang } from 'stack-site-builder/i18n/ui';

interface Props {
  /** 처음에 보여 줄 용어 */
  term?: 'node' | 'link' | 'root' | 'family' | 'leaf' | 'subtree' | 'level' | 'height' | 'full';
  /** 슬라이드용: 바깥 여백은 줄이고 글자와 칸은 키운다. */
  slide?: boolean;
}
const { term = 'family', slide = false } = Astro.props;
const id = `tt-${Math.random().toString(36).slice(2, 9)}`;

/** 힙 번호 → 노드 이름 */
const TREE: Record<number, string> = { 1: 'A', 2: 'B', 3: 'C', 4: 'D', 5: 'E', 7: 'F', 10: 'G', 11: 'H', 15: 'I' };
const TERMS = ['node', 'link', 'root', 'family', 'leaf', 'subtree', 'level', 'height', 'full'] as const;

const STRINGS: Record<string, Record<string, string>> = {
  ko: {
    title: '이진 트리의 용어',
    hint: '용어나 노드를 눌러 보세요.',
