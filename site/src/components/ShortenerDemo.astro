---
// URL 단축기의 안쪽: URL→코드 해시 테이블에 URL이 하나씩 들어가는 데모.
// 과제2 4단계에서 쓴다.
//
// 해시는 주제 08의 호너 방식 h = (31·h + code(c)) mod M, 충돌은 선형 탐지다.
// 코드는 일련번호를 base62로 바꾼 것이다. 같은 URL은 같은 코드를 돌려받고,
// http(s)가 아닌 주소는 들어가지 못한다. 크기 조정은 끄고 M = 11로 고정해
// 키 무리와 끝에서 0번 칸으로 넘어가는 탐지를 보인다.
// 계산은 hw2-sample-2026의 src/hash_table.py · src/shortener.py와 같다.
import { defaultLang } from 'stack-site-builder/i18n/ui';

interface Props {
  /** 차례로 넣을 URL */
  urls?: string[];
  /** 배열 크기 M(크기 조정 없음) */
  m?: number;
  /** 슬라이드용: 글자와 칸을 키운다. */
  slide?: boolean;
}
const {
  urls = [
    'https://www.yonsei.ac.kr',
    'https://github.com',
    'https://learnus.yonsei.ac.kr',
    'https://www.yonsei.ac.kr',
    'ftp://files.example.com',
    'https://lec-algorithm.github.io/lecture/',
    'https://docs.python.org/3/',
    'https://portal.yonsei.ac.kr',
    'https://www.python.org',
    'https://library.yonsei.ac.kr',
  ],
  m = 11,
  slide = false,
} = Astro.props;
const id = `sd-${Math.random().toString(36).slice(2, 9)}`;

const STRINGS: Record<string, Record<string, string>> = {
  ko: {
    title: 'URL→코드 테이블',
    back: '뒤로',
    step: '한 걸음',
    play: '자동 재생',
    stop: '멈춤',
    reset: '처음으로',
    codes: '발급한 코드',
    probes: '이번 탐지',
    idle: 'URL {n}개를 차례로 넣습니다. 크기 {m}으로 고정하고 크기 조정은 끕니다.',
    reject: 'http:// 또는 https://로 시작하지 않아 ValueError입니다. 번호를 쓰지 않습니다.',
    found: '{s}번 칸에서 같은 URL을 찾았습니다. 새 번호를 쓰지 않고 코드 {c}를 돌려줍니다.',
    put: '{h}번 칸이 비어 있어 바로 넣습니다. 코드 {c}를 발급합니다.',
    probe: '{h}번에서 시작해 {p}칸을 들여다보고 {s}번 칸에 넣습니다. 코드 {c}를 발급합니다.',
    wrap: '끝 칸을 지나 0번 칸으로 넘어갔습니다.',
  },
  en: {
    title: 'URL→code table',
    back: 'Back',
    step: 'Step',
    play: 'Play',
    stop: 'Pause',
    reset: 'Reset',
    codes: 'codes issued',
    probes: 'probes now',
    idle: 'Insert {n} URLs one by one. The size is fixed at {m}, with resizing off.',
    reject: 'It does not start with http:// or https://, so ValueError. No number is used.',
    found: 'Found the same URL in slot {s}. No new number; code {c} comes back.',
    put: 'Slot {h} is empty, so it goes straight in. Issue code {c}.',
    probe: 'Starting at {h}, probe {p} slots and put it in slot {s}. Issue code {c}.',
    wrap: 'It went past the last slot back to slot 0.',
  },
  zh: {
    title: 'URL→代码表',
    back: '后退',
    step: '单步',
    play: '播放',
    stop: '暂停',
    reset: '重置',
    codes: '已发代码',
    probes: '本次探查',
    idle: '依次放入 {n} 个 URL。大小固定为 {m}，关闭扩容。',
    reject: '不是以 http:// 或 https:// 开头，抛出 ValueError。不占用编号。',
    found: '在 {s} 号格找到相同的 URL。不用新编号，返回代码 {c}。',
    put: '{h} 号格为空，直接放入。发出代码 {c}。',
    probe: '从 {h} 号开始探查 {p} 格，放入 {s} 号格。发出代码 {c}。',
    wrap: '越过最后一格，回到了 0 号格。',
  },
};
const lang = Astro.currentLocale ?? defaultLang;
const t = STRINGS[lang] ?? STRINGS.ko;
const slots = Array.from({ length: m }, (_, i) => i);
---

<div
  class:list={['aas-shortener-demo', slide && 'is-slide']}
  id={id}
  data-sd-urls={JSON.stringify(urls)}
  data-sd-strings={JSON.stringify(t)}
  style={`--sd-m: ${m}`}
>
  <div class="sd-bar">
    <span class="sd-head"><strong>{t.title}</strong> · M = {m} · h = (31·h + c) mod {m}</span>
    <div class="sd-controls">
      <button type="button" data-act="back" class="sd-btn">{t.back}</button>
      <button type="button" data-act="step" class="sd-btn">{t.step}</button>
      <button type="button" data-act="play" class="sd-btn sd-btn-primary">{t.play}</button>
      <button type="button" data-act="reset" class="sd-btn">{t.reset}</button>
    </div>
  </div>

  <div class="sd-top">
    <ol class="sd-queue">
      {urls.map((u, i) => <li class="sd-url" data-sd-url={i}><span data-sd-out={i} class="sd-out"></span>{u}</li>)}
    </ol>
    <div class="sd-stats">
      <span class="sd-big"><span class="sd-big-label">{t.codes}</span><strong data-sd-codes>0</strong></span>
      <span class="sd-big"><span class="sd-big-label">{t.probes}</span><strong data-sd-probes>0</strong></span>
    </div>
  </div>

  <div class="sd-scroll">
    <div class="sd-grid">
      {
        slots.map((s) => (
          <div class="sd-slot" data-sd-slot={s}>
            <span class="sd-idx">{s}</span>
            <span class="sd-key" data-sd-key={s} />
            <span class="sd-code" data-sd-code={s} />
          </div>
        ))
      }
    </div>
  </div>

  <p class="sd-note" data-sd-note></p>
</div>

<script is:inline define:vars={{ id, m }}>
  (() => {
    const root = document.getElementById(id);
    if (!root) return;
    const urls = JSON.parse(root.dataset.sdUrls);
    const S = JSON.parse(root.dataset.sdStrings);
    const fill = (tpl, v) => tpl.replace(/\{(\w+)\}/g, (_, k) => v[k]);
    const A = '0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ';
    const encode = (n) => {
      let s = '';
      while (n > 0) {
        s = A[n % 62] + s;
        n = Math.floor(n / 62);
      }
      return s || '0';
    };
    const horner = (key) => {
      let h = 0;
      for (const c of key) h = (31 * h + c.charCodeAt(0)) % m;
      return h;
    };
    /* 칸에는 호스트의 첫 마디만 적는다. https://www.yonsei.ac.kr → yonsei */
    const short = (u) => u.replace(/^https?:\/\//, '').replace(/^www\./, '').split(/[./]/)[0];

    /* 단계마다 테이블 전체의 사본을 만들어 둔다. 뒤로 가기가 쉬워진다. */
    const steps = [];
    const keys = Array(m).fill(null);
    const codes = Array(m).fill(null);
    let next = 1;
    urls.forEach((url, i) => {
      const st = { i, path: [], slot: null, out: '', kind: '', note: '' };
      if (!/^https?:\/\/\S+$/.test(url)) {
        st.kind = 'reject';
        st.out = '✗';
        st.note = S.reject;
      } else {
        const h = horner(url);
        let s = h;
        let wrapped = false;
        for (let p = 0; p < m; p++) {
          st.path.push(s);
          if (keys[s] === null || keys[s] === url) break;
          s = (s + 1) % m;
          if (s === 0) wrapped = true;
        }
        st.slot = s;
        if (keys[s] === url) {
          st.kind = 'found';
          st.out = codes[s];
          st.note = fill(S.found, { s, c: codes[s] });
        } else {
          const c = encode(next++);
          keys[s] = url;
          codes[s] = c;
          st.kind = 'put';
          st.out = c;
          const v = { h, p: st.path.length, s, c };
          st.note = st.path.length === 1 ? fill(S.put, v) : fill(S.probe, v) + (wrapped ? ' ' + S.wrap : '');
        }
      }
      st.keys = keys.slice();
      st.codes = codes.slice();
      st.issued = next - 1;
      steps.push(st);
    });

    const urlEls = [...root.querySelectorAll('[data-sd-url]')];
    const outEls = [...root.querySelectorAll('[data-sd-out]')];
    const slotEls = [...root.querySelectorAll('[data-sd-slot]')];
    const keyEls = [...root.querySelectorAll('[data-sd-key]')];
    const codeEls = [...root.querySelectorAll('[data-sd-code]')];
    const codesEl = root.querySelector('[data-sd-codes]');
    const probesEl = root.querySelector('[data-sd-probes]');
    const note = root.querySelector('[data-sd-note]');

    function render(at) {
      const st = at >= 0 ? steps[at] : null;
      urlEls.forEach((el, i) => {
        el.classList.toggle('is-now', i === at);
        el.classList.toggle('is-done', i < at);
        el.classList.toggle('is-reject', i <= at && steps[i].kind === 'reject');
        outEls[i].textContent = i <= at ? steps[i].out : '';
      });
      slotEls.forEach((el, s) => {
        const k = st ? st.keys[s] : null;
        keyEls[s].textContent = k ? short(k) : '';
        codeEls[s].textContent = st && st.codes[s] ? st.codes[s] : '';
        el.classList.toggle('is-full', !!k);
        el.classList.toggle('is-path', !!st && st.path.includes(s) && s !== st.slot);
        el.classList.toggle('is-now', !!st && st.slot === s);
        el.classList.toggle('is-found', !!st && st.kind === 'found' && st.slot === s);
      });
      codesEl.textContent = String(st ? st.issued : 0);
      probesEl.textContent = String(st ? st.path.length : 0);
      note.textContent = st ? st.note : fill(S.idle, { n: urls.length, m });
    }

    let at = -1;
    let timer = null;
    const playBtn = root.querySelector('[data-act="play"]');
    function stop() {
      if (timer) clearInterval(timer);
      timer = null;
      playBtn.textContent = S.play;
    }
    function step() {
      if (at >= steps.length - 1) return stop();
      at += 1;
      render(at);
      if (at >= steps.length - 1) stop();
    }
    root.querySelector('[data-act="back"]').addEventListener('click', () => {
      stop();
      if (at > -1) at -= 1;
      render(at);
    });
    root.querySelector('[data-act="step"]').addEventListener('click', () => {
      stop();
      step();
    });
    root.querySelector('[data-act="reset"]').addEventListener('click', () => {
      stop();
      at = -1;
      render(-1);
    });
    playBtn.addEventListener('click', () => {
      if (timer) return stop();
      if (at >= steps.length - 1) {
        at = -1;
        render(-1);
      }
      playBtn.textContent = S.stop;
      timer = setInterval(step, 1400);
    });
    render(-1);
  })();
</script>

<style is:global>
  .aas-shortener-demo {
    font-size: 1rem;
    margin: 1.5rem 0;
    padding: 1em;
    border: 1px solid var(--aas-border);
    border-radius: 0.9em;
    background: var(--aas-panel);
  }
  .aas-shortener-demo .sd-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75em;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.7em;
  }
  .aas-shortener-demo .sd-head {
    font-size: 0.9em;
  }
  .aas-shortener-demo .sd-controls {
    display: flex;
    gap: 0.5em;
  }
  .aas-shortener-demo .sd-btn {
    padding: 0.35em 0.8em;
    font-size: 0.85em;
    border: 1px solid var(--aas-border);
    border-radius: 0.5em;
    background: var(--aas-bg);
    color: var(--aas-text);
    cursor: pointer;
  }
  .aas-shortener-demo .sd-btn:hover {
    border-color: var(--aas-accent);
  }
  .aas-shortener-demo .sd-btn-primary {
    background: var(--aas-accent);
    border-color: var(--aas-accent);
    color: #fff;
  }
  .aas-shortener-demo .sd-top {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6em 1.5em;
    align-items: flex-start;
    justify-content: space-between;
  }
  .aas-shortener-demo .sd-queue {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, auto));
    gap: 0.15em 1.2em;
    font-family: var(--aas-mono, monospace);
    font-size: 0.8em;
  }
  .aas-shortener-demo .sd-url {
    /* 슬라이드 테마가 li의 글자 크기를 따로 정하므로 부모 크기를 그대로 따르게 한다. */
    margin: 0;
    font-size: 1em;
    line-height: 1.45;
    color: var(--aas-muted);
    white-space: nowrap;
  }
  .aas-shortener-demo .sd-url.is-done {
    color: var(--aas-text);
  }
  .aas-shortener-demo .sd-url.is-now {
    color: var(--aas-text);
    font-weight: 700;
    box-shadow: 0 0 0 2px var(--aas-role-focus);
    border-radius: 0.3em;
  }
  .aas-shortener-demo .sd-url.is-reject {
    color: var(--aas-role-guard);
    text-decoration: line-through;
  }
  .aas-shortener-demo .sd-out {
    display: inline-block;
    min-width: 1.6em;
    margin-right: 0.4em;
    color: var(--aas-role-focus);
    font-weight: 700;
  }
  .aas-shortener-demo .sd-stats {
    display: flex;
    gap: 1.4em;
  }
  .aas-shortener-demo .sd-big {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35em;
  }
  .aas-shortener-demo .sd-big-label {
    font-size: 0.8em;
    color: var(--aas-muted);
  }
  .aas-shortener-demo .sd-big strong {
    font-family: var(--aas-mono, monospace);
    font-size: 2em;
    line-height: 1;
    color: var(--aas-role-focus);
  }
  .aas-shortener-demo .sd-scroll {
    overflow-x: auto;
    margin-top: 0.8em;
  }
  .aas-shortener-demo .sd-grid {
    display: grid;
    grid-template-columns: repeat(var(--sd-m), 4.2em);
    gap: 0.3em;
    width: max-content;
    margin: 0 auto;
  }
  .aas-shortener-demo .sd-slot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2em;
    min-height: 4em;
    padding: 0.3em 0.2em;
    border: 1.5px solid var(--aas-border);
    border-radius: 0.5em;
    background: var(--aas-bg);
    transition:
      background-color 0.3s,
      box-shadow 0.3s;
  }
  .aas-shortener-demo .sd-slot.is-full {
    border-color: var(--aas-role-model);
  }
  .aas-shortener-demo .sd-slot.is-path {
    background: color-mix(in srgb, var(--aas-role-guard) 14%, var(--aas-bg));
  }
  .aas-shortener-demo .sd-slot.is-now {
    box-shadow: 0 0 0 3px var(--aas-role-focus);
  }
  .aas-shortener-demo .sd-slot.is-found {
    background: color-mix(in srgb, var(--aas-role-eval) 18%, var(--aas-bg));
  }
  .aas-shortener-demo .sd-idx {
    font-family: var(--aas-mono, monospace);
    font-size: 0.75em;
    color: var(--aas-muted);
  }
  .aas-shortener-demo .sd-key {
    font-size: 0.6em;
    line-height: 1.2;
    text-align: center;
    word-break: break-all;
  }
  .aas-shortener-demo .sd-code {
    font-family: var(--aas-mono, monospace);
    font-weight: 700;
    color: var(--aas-role-model);
  }
  .aas-shortener-demo .sd-note {
    margin: 0.6em 0 0;
    font-size: 0.85em;
    min-height: 2.4em;
  }
  .aas-shortener-demo.is-slide {
    font-size: clamp(0.9rem, 2.4vh, 1.6rem);
    margin: 0.5rem 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .aas-shortener-demo .sd-slot {
      transition: none;
    }
  }
</style>
