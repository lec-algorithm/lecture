---
// 개별 체이닝과 선형 탐지를 나란히 두고 같은 연산을 함께 해 보는 놀이터.
//
// 글자 하나(A~Z)를 넣고 넣기 · 찾기 · 지우기를 누르면 두 표가 같은 연산을
// 받는다. 해시값은 글자의 ASCII 코드 mod M이다. 위는 선형 탐지(한 줄의 M칸과
// 그 아래 키 무리 막대), 아래는 개별 체이닝(칸마다 아래로 자라는 리스트)이고,
// 두 격자는 같은 열에 맞춰 놓인다. 방금 한 연산에서 들여다본 노드와 칸을
// 칠하고, 체이닝의 비교 횟수와 선형 탐지의 탐색 칸 수를 크게 띄운다.
//
// 체이닝은 새 키를 리스트 맨 앞에 붙이고, 지울 때는 연결 하나만 뺀다.
// 선형 탐지는 빈칸이 나올 때까지 오른쪽으로 가고(끝에서 0번으로), 지울 때는
// 칸을 비운 뒤 같은 무리에서 뒤따르던 키를 꺼냈다가 다시 넣는다(덱의 Delete
// 의사코드와 같다. 크기 조정은 하지 않는다). 선형 탐지에 빈칸이 하나는 남도록
// 키는 M - 1개까지만 받는다. M을 바꾸면 지금 키들을 넣은 순서대로 다시 넣는다.
import { defaultLang } from 'stack-site-builder/i18n/ui';

interface Props {
  /** 배열 크기 M (5~13) */
  m?: number;
  /** 처음에 넣어 둘 키. 비우면 예제(SEARCHXMPL)에서 M - 1개까지 넣는다. */
  keys?: string;
  /** 슬라이드용: 바깥 여백은 줄이고 글자와 칸은 키운다. */
  slide?: boolean;
}
const { m = 7, keys = '', slide = false } = Astro.props;
const id = `hp-${Math.random().toString(36).slice(2, 9)}`;
const M0 = Math.min(13, Math.max(5, Math.round(m)));
const sizes = Array.from({ length: 9 }, (_, i) => i + 5);

const STRINGS: Record<string, Record<string, string>> = {
