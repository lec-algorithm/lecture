    bad: 'Type a single letter from A to Z.',
    full: 'Linear probing needs at least one empty slot. With M = {m}, at most {max} keys fit.',
    chPutNew: 'Chaining: {c} compares in list {h}, then {k} goes to the front.',
    chPutEmpty: 'Chaining: list {h} is empty, so {k} goes in with no compares.',
    chPutDup: 'Chaining: found {k} in list {h} after {c} compares. It is already there, so nothing changes.',
    chHit: 'Chaining: found {k} in list {h} after {c} compares.',
    chMiss: 'Chaining: {c} compares reach the end of list {h}, and there is no {k}.',
    chEmpty: 'Chaining: list {h} is empty, so there is no {k}.',
    chDel: 'Chaining: found {k} in list {h} after {c} compares and unlinked it.',
    lpPutNew: 'Linear probing: start at slot {h} and land in empty slot {s} after {c} cells.',
    lpPutDup: 'Linear probing: start at slot {h} and find {k} in slot {s} after {c} cells. Nothing changes here either.',
    lpHit: 'Linear probing: start at slot {h} and find {k} in slot {s} after {c} cells.',
    lpMiss: 'Linear probing: start at slot {h} and stop at empty slot {s}, cell {c}. There is no {k}.',
    lpDel: 'Linear probing: find {k} in slot {s} after {c} cells and empty the slot.',
    lpReins: 'Then take out the keys that followed it, {list}, and put them back.',
    lpReinsNone: 'The next slot is empty, so nothing needs reinserting.',
    exampleNote: 'Inserted the example keys {list} in order. Chaining made {a} compares in total, linear probing looked at {b} cells.',
    cleared: 'Both tables are empty.',
    resized: 'Reinserted the keys in insertion order to fit M = {m}.',
    resizedCut: 'To keep one slot empty for linear probing, the later keys {list} were dropped.',
  },
  zh: {
    title: '哈希表游乐场',
    key: '键',
    put: '插入',
    get: '查找',
    del: '删除',
    example: '示例',
    random: '随机一个',
    clear: '清空',
    chain: '拉链法',
    probe: '线性探测',
    compares: '比较',
    timesUnit: ' 次',
    cellsUnit: ' 格',
    sum: '合计',
    longestList: '最长链表',
    longestRun: '最长簇',
    idle: '输入一个字母，再按插入、查找或删除。两张表执行同一个操作。',
    bad: '请输入 A 到 Z 之间的一个字母。',
    full: '线性探测至少要留一个空格。M = {m} 时最多放 {max} 个键。',
    chPutNew: '拉链法：在 {h} 号链表比较 {c} 次后，把 {k} 接到最前面。',
    chPutEmpty: '拉链法：{h} 号链表为空，不用比较就放入 {k}。',
    chPutDup: '拉链法：在 {h} 号链表比较 {c} 次找到 {k}。已经存在，保持不变。',
    chHit: '拉链法：在 {h} 号链表比较 {c} 次找到 {k}。',
    chMiss: '拉链法：把 {h} 号链表比较到末尾共 {c} 次，没有 {k}。',
    chEmpty: '拉链法：{h} 号链表为空，没有 {k}。',
    chDel: '拉链法：在 {h} 号链表比较 {c} 次找到 {k}，把它从链中摘下。',
    lpPutNew: '线性探测：从 {h} 号格出发，探测 {c} 格后放进 {s} 号空格。',
    lpPutDup: '线性探测：从 {h} 号格出发，探测 {c} 格后在 {s} 号格找到 {k}。同样保持不变。',
    lpHit: '线性探测：从 {h} 号格出发，探测 {c} 格后在 {s} 号格找到 {k}。',
    lpMiss: '线性探测：从 {h} 号格出发，第 {c} 格是 {s} 号空格，停下。没有 {k}。',
    lpDel: '线性探测：探测 {c} 格后在 {s} 号格找到 {k}，清空这一格。',
    lpReins: '再把跟在后面的 {list} 取出并重新插入。',
    lpReinsNone: '下一格就是空格，不用重新插入任何键。',
    exampleNote: '依次插入示例键 {list}。拉链法共比较 {a} 次，线性探测共看了 {b} 格。',
    cleared: '两张表都清空了。',
    resized: '按 M = {m} 把键按插入顺序重新插入。',
    resizedCut: '为了给线性探测留一个空格，去掉了后插入的 {list}。',
  },
};
const lang = Astro.currentLocale ?? defaultLang;
const t = STRINGS[lang] ?? STRINGS[defaultLang] ?? STRINGS.ko;
---

<div
  class:list={['aas-hash-play-demo', slide && 'is-slide']}
  id={id}
  data-hp-m={M0}
  data-hp-keys={keys}
  data-hp-strings={JSON.stringify(t)}
>
  <div class="hp-bar">
    <span class="hp-head"><strong>{t.title}</strong></span>
    <div class="hp-sizes" role="tablist">
      <span class="hp-mlabel">M</span>
      {sizes.map((s) => <button type="button" class="hp-pill" data-hp-size={s} role="tab">{s}</button>)}
    </div>
    <div class="hp-controls">
      <button type="button" class="hp-btn" data-act="example">{t.example}</button>
      <button type="button" class="hp-btn" data-act="random">{t.random}</button>
      <button type="button" class="hp-btn" data-act="clear">{t.clear}</button>
    </div>
  </div>

  <div class="hp-ops">
    <label class="hp-field">
      <span>{t.key}</span>
      <input type="text" maxlength="2" spellcheck="false" autocomplete="off" autocapitalize="characters" data-hp-in />
    </label>
    <button type="button" class="hp-btn hp-btn-primary" data-act="put">{t.put}</button>
    <button type="button" class="hp-btn" data-act="get">{t.get}</button>
    <button type="button" class="hp-btn" data-act="del">{t.del}</button>
    <span class="hp-formula" data-hp-formula></span>
  </div>

  <div class="hp-panel">
    <div class="hp-side">
      <strong class="hp-name">{t.probe}</strong>
      <span class="hp-big"><small data-hp-lp-sum></small><b data-hp-lp-count>-</b>{t.cellsUnit}</span>
      <span class="hp-stat">N/M <b data-hp-lp-load></b> · {t.longestRun} <b data-hp-lp-run></b>{t.cellsUnit}</span>
    </div>
    <div class="hp-grid-wrap">
      <div class="hp-grid hp-cells" data-hp-cells></div>
      <div class="hp-grid hp-bars" data-hp-bars></div>
      <div class="hp-grid hp-idx" data-hp-idx></div>
    </div>
  </div>

  <div class="hp-panel">
    <div class="hp-side">
      <strong class="hp-name">{t.chain}</strong>
      <span class="hp-big"><small data-hp-ch-sum></small>{t.compares} <b data-hp-ch-count>-</b>{t.timesUnit}</span>
      <span class="hp-stat">N/M <b data-hp-ch-load></b> · {t.longestList} <b data-hp-ch-long></b></span>
    </div>
    <div class="hp-grid-wrap">
      <div class="hp-grid hp-chains" data-hp-chains></div>
    </div>
  </div>

  <p class="hp-note" data-hp-note></p>
</div>

<script is:inline define:vars={{ id }}>
  (() => {
    const root = document.getElementById(id);
    if (!root) return;

    /* 설명은 문장마다 줄을 바꾼다. 마침표 뒤 공백, 또는 중국어 마침표 뒤에서 끊는다. */
    const setLines = (node, text) => {
      const parts = String(text).split(/(?<=[.!?])\s+(?=\S)|(?<=[。！？])(?=\S)/);
      node.replaceChildren(...parts.flatMap((s, i) => (i ? [document.createElement('br'), s] : [s])));
    };
    /* 문장 잇기. 중국어 마침표 뒤에는 공백을 두지 않아야 setLines가 끊는다. */
    const join = (...parts) =>
      parts.filter(Boolean).reduce((a, b) => (/[。！？]$/.test(a) ? a + b : `${a} ${b}`), '');
    const S = JSON.parse(root.dataset.hpStrings);
    const fill = (tpl, vars) => tpl.replace(/\{(\w+)\}/g, (_, k) => vars[k]);
    /* 한국어 조사: 영어 글자 이름이 받침으로 끝나는 것은 L(엘) M(엠) N(엔) R(알)뿐이다. */
    const josa = (k) => {
      const jong = /[LMNR]$/.test(k);
      return { eul: jong ? '을' : '를', eun: jong ? '은' : '는' };
    };
    const listOf = (ks) => ks.join(', ');
    const EXAMPLE = 'SEARCHXMPL';
    const LETTERS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';

    let M = Number(root.dataset.hpM);
    let order = []; /* 지금 있는 키를 넣은 순서대로 */
    let chains = [];
    let lp = [];
    let last = null;

    const hash = (k) => k.charCodeAt(0) % M;
    const maxKeys = () => M - 1;

    function reset() {
      order = [];
      chains = Array.from({ length: M }, () => []);
      lp = new Array(M).fill(null);
    }

    /* 체이닝. 리스트의 0번이 맨 앞 노드다. */
    function chPut(k) {
      const h = hash(k);
      const list = chains[h];
      for (let i = 0; i < list.length; i++) {
        if (list[i] === k) return { h, c: i + 1, dup: true, visit: i, hit: i };
      }
      const c = list.length;
      list.unshift(k);
      return { h, c, placed: true, visit: -1, hit: 0 };
    }
    function chGet(k) {
      const h = hash(k);
      const list = chains[h];
      for (let i = 0; i < list.length; i++) {
        if (list[i] === k) return { h, c: i + 1, found: true, visit: i, hit: i };
      }
      return { h, c: list.length, found: false, visit: list.length - 1, hit: -1 };
    }
    function chDel(k) {
      const r = chGet(k);
      if (!r.found) return r;
      chains[r.h].splice(r.hit, 1);
      return { ...r, ghost: r.hit, visit: r.hit - 1, hit: -1 };
    }

    /* 선형 탐지. path는 들여다본 칸(마지막이 멈춘 칸). 빈칸은 언제나 하나 이상 있다. */
    function lpPut(k) {
      const h = hash(k);
      const path = [];
      let i = h;
      while (lp[i] !== null) {
        path.push(i);
        if (lp[i] === k) return { h, c: path.length, s: i, path, dup: true };
        i = (i + 1) % M;
      }
      path.push(i);
      lp[i] = k;
      return { h, c: path.length, s: i, path, placed: true };
    }
    function lpGet(k) {
      const h = hash(k);
      const path = [];
      let i = h;
      while (lp[i] !== null) {
        path.push(i);
        if (lp[i] === k) return { h, c: path.length, s: i, path, found: true };
        i = (i + 1) % M;
      }
      path.push(i);
      return { h, c: path.length, s: i, path, found: false };
    }
    function lpDel(k) {
      const r = lpGet(k);
      if (!r.found) return r;
      lp[r.s] = null;
      const reins = [];
      let i = (r.s + 1) % M;
      while (lp[i] !== null) {
        const kk = lp[i];
        lp[i] = null;
        const to = lpPut(kk).s;
        reins.push({ k: kk, from: i, to });
        i = (i + 1) % M;
      }
      return { ...r, removed: true, reins };
    }

    function insertKey(k) {
      chPut(k);
      lpPut(k);
      order.push(k);
    }

    /* 원형 배열에서 차 있는 칸이 이어진 덩어리(키 무리). ProbingDemo와 같은 계산 */
    function clusters() {
      const len = new Array(M).fill(0);
      const startOf = new Array(M).fill(false);
      const endOf = new Array(M).fill(false);
      const empty = lp.indexOf(null);
      let longest = 0;
      let i = (empty + 1) % M;
      for (let c = 0; c < M; ) {
        if (lp[i] === null) {
          i = (i + 1) % M;
          c += 1;
          continue;
        }
        const members = [];
        while (lp[i] !== null) {
          members.push(i);
          i = (i + 1) % M;
          c += 1;
        }
        members.forEach((x) => (len[x] = members.length));
        startOf[members[0]] = true;
        endOf[members[members.length - 1]] = true;
        longest = Math.max(longest, members.length);
      }
      return { len, startOf, endOf, longest };
    }

    const input = root.querySelector('[data-hp-in]');
    const cellsEl = root.querySelector('[data-hp-cells]');
    const barsEl = root.querySelector('[data-hp-bars]');
    const idxEl = root.querySelector('[data-hp-idx]');
    const chainsEl = root.querySelector('[data-hp-chains]');
    const formula = root.querySelector('[data-hp-formula]');
    const note = root.querySelector('[data-hp-note]');
    const pills = [...root.querySelectorAll('[data-hp-size]')];
    const $ = (sel) => root.querySelector(sel);

    function showFormula() {
      const k = input.value || (last && last.key) || '';
      if (!k) {
        formula.textContent = ' ';
        return;
      }
      const c = k.charCodeAt(0);
      formula.textContent = `${k} (${c}) mod ${M} = ${c % M}`;
    }

    function render(text) {
      root.style.setProperty('--hp-m', String(M));
      pills.forEach((p) => p.classList.toggle('is-on', Number(p.dataset.hpSize) === M));

      const op = last && last.kind === 'op' ? last : null;
      const lr = op ? op.lp : null;
      const cr = op ? op.ch : null;

      /* 선형 탐지 칸 */
      const cl = clusters();
      const moved = new Set(lr && lr.reins ? lr.reins.map((x) => x.to) : []);
      cellsEl.innerHTML = lp
        .map((k, i) => {
          const cls = ['hp-cell'];
          if (k !== null) cls.push('is-full');
          if (lr && lr.path.includes(i)) {
            if (i !== lr.s) cls.push('is-probe');
            else if (lr.placed) cls.push('is-placed');
            else if (lr.removed) cls.push(moved.has(i) ? '' : 'is-hole');
            else if (lr.found || lr.dup) cls.push('is-hit');
            else cls.push('is-stop');
          }
          if (moved.has(i)) cls.push('is-moved');
          return `<span class="${cls.join(' ')}">${k ?? ''}</span>`;
        })
        .join('');
      barsEl.innerHTML = lp
        .map((_, i) => {
          const cls = ['hp-run'];
          if (cl.len[i] >= 2) cls.push('is-on');
          if (cl.len[i] >= 2 && cl.len[i] === cl.longest) cls.push('is-long');
          if (cl.startOf[i]) cls.push('is-start');
          if (cl.endOf[i]) cls.push('is-end');
          return `<span class="${cls.join(' ')}"></span>`;
        })
        .join('');
      idxEl.innerHTML = lp.map((_, i) => `<span>${i}</span>`).join('');

      /* 체이닝 리스트 */
      chainsEl.innerHTML = chains
        .map((list, slot) => {
          const mine = cr && cr.h === slot;
          const nodes = list.map((k, j) => {
            const cls = ['hp-node'];
            if (mine) {
              if (j === cr.hit && cr.placed) cls.push('is-placed');
              else if (j === cr.hit) cls.push('is-hit');
              else if (j <= cr.visit) cls.push('is-probe');
            }
            return `<span class="${cls.join(' ')}">${k}</span>`;
          });
          if (mine && cr.ghost !== undefined) {
            nodes.splice(cr.ghost, 0, `<span class="hp-node is-ghost">${op.key}</span>`);
          }
          return `<div class="hp-col"><span class="hp-slot${mine ? ' is-now' : ''}">${slot}</span>${nodes.join('')}</div>`;
        })
        .join('');

      /* 숫자 */
      const n = order.length;
      const load = (n / M).toFixed(2);
      $('[data-hp-lp-load]').textContent = load;
      $('[data-hp-ch-load]').textContent = load;
      $('[data-hp-lp-run]').textContent = String(cl.longest);
      $('[data-hp-ch-long]').textContent = String(Math.max(0, ...chains.map((l) => l.length)));
      const isSum = !!last && last.kind === 'example';
      $('[data-hp-lp-sum]').textContent = isSum ? `${S.sum} ` : '';
      $('[data-hp-ch-sum]').textContent = isSum ? `${S.sum} ` : '';
      $('[data-hp-lp-count]').textContent = op ? String(lr.c) : isSum ? String(last.b) : '-';
      $('[data-hp-ch-count]').textContent = op ? String(cr.c) : isSum ? String(last.a) : '-';

      showFormula();
      setLines(note, text || S.idle);
    }

    function fullNote() {
      return fill(S.full, { m: M, max: maxKeys() });
    }

    function run(kind, k) {
      const j = josa(k);
      const v = (r) => ({ k, h: r.h, c: r.c, s: r.s, ...j });
      if (kind === 'put' && !order.includes(k) && order.length >= maxKeys()) {
        last = null;
        return render(fullNote());
      }
      let cr;
      let lr;
      let text;
      if (kind === 'put') {
        cr = chPut(k);
        lr = lpPut(k);
        if (cr.placed) order.push(k);
        const chT = cr.dup ? S.chPutDup : cr.c === 0 ? S.chPutEmpty : S.chPutNew;
        text = join(fill(chT, v(cr)), fill(lr.dup ? S.lpPutDup : S.lpPutNew, v(lr)));
      } else if (kind === 'get') {
        cr = chGet(k);
        lr = lpGet(k);
        const chT = cr.found ? S.chHit : cr.c === 0 ? S.chEmpty : S.chMiss;
        text = join(fill(chT, v(cr)), fill(lr.found ? S.lpHit : S.lpMiss, v(lr)));
      } else {
        cr = chDel(k);
        lr = lpDel(k);
        if (cr.found) order = order.filter((x) => x !== k);
        const chT = cr.found ? S.chDel : cr.c === 0 ? S.chEmpty : S.chMiss;
        let lpT = fill(lr.found ? S.lpDel : S.lpMiss, v(lr));
        if (lr.found) {
          const ks = lr.reins.map((x) => x.k);
          lpT = join(lpT, ks.length ? fill(S.lpReins, { list: listOf(ks), ...josa(ks[ks.length - 1]) }) : S.lpReinsNone);
        }
        text = join(fill(chT, v(cr)), lpT);
      }
      last = { kind: 'op', key: k, ch: cr, lp: lr };
      render(text);
    }

    function loadExample() {
      reset();
      const ks = EXAMPLE.slice(0, maxKeys()).split('');
      let a = 0;
      let b = 0;
      ks.forEach((k) => {
        a += chPut(k).c;
        b += lpPut(k).c;
        order.push(k);
      });
      last = { kind: 'example', a, b };
      render(fill(S.exampleNote, { list: listOf(ks), a, b, ...josa(ks[ks.length - 1]) }));
    }

    function setM(next) {
      const keep = order.slice(0, next - 1);
      const cut = order.slice(next - 1);
      M = next;
      reset();
      keep.forEach(insertKey);
      last = null;
      const text = join(
        fill(S.resized, { m: M }),
        cut.length ? fill(S.resizedCut, { list: listOf(cut), ...josa(cut[cut.length - 1]) }) : '',
      );
      render(text);
    }

    function readKey() {
      const k = input.value.trim().toUpperCase();
      if (!/^[A-Z]$/.test(k)) {
        render(S.bad);
        input.focus();
        return null;
      }
      return k;
    }

    /* 입력은 언제나 대문자 한 글자. 새로 친 글자가 앞 글자를 바꾼다. */
    input.addEventListener('input', () => {
      input.value = input.value.slice(-1).toUpperCase();
      showFormula();
    });
    input.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      e.preventDefault();
      const k = readKey();
      if (k) run('put', k);
      input.select();
    });
    ['put', 'get', 'del'].forEach((kind) => {
      root.querySelector(`[data-act="${kind}"]`).addEventListener('click', () => {
        const k = readKey();
        if (!k) return;
        run(kind, k);
        input.select();
      });
    });
    root.querySelector('[data-act="example"]').addEventListener('click', loadExample);
    root.querySelector('[data-act="random"]').addEventListener('click', () => {
      const free = LETTERS.split('').filter((x) => !order.includes(x));
      if (order.length >= maxKeys() || !free.length) {
        last = null;
        return render(fullNote());
      }
      const k = free[Math.floor(Math.random() * free.length)];
      input.value = k;
      run('put', k);
    });
    root.querySelector('[data-act="clear"]').addEventListener('click', () => {
      reset();
      last = null;
      input.value = '';
      render(S.cleared);
    });
    pills.forEach((p) =>
      p.addEventListener('click', () => {
        const next = Number(p.dataset.hpSize);
        if (next !== M) setM(next);
      }),
    );

    /* 처음 상태: 키가 주어지면 그것을, 아니면 예제를 M - 1개까지 넣는다. */
    reset();
    const given = (root.dataset.hpKeys || '').toUpperCase().replace(/[^A-Z]/g, '');
    const start = [...new Set((given || EXAMPLE).split(''))].slice(0, maxKeys());
    start.forEach(insertKey);
    render();
  })();
</script>

