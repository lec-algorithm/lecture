---
// "마지막에 낸 동전"으로 쪼개는 일을 직접 해 보는 데모. 사람이 재귀와 메모를 대신한다.
//
// coin_change.py의 coin_change_memo와 같은 순서로 걷는다. 지금 금액 a에서 동전을 왼쪽부터
// 하나씩 마지막 동전으로 놓아 본다. 카드 한 장이 반복 한 번이다.
//   - 동전이 a보다 크면 쓸 수 없다.
//   - 남은 금액 a - c의 답이 memo에 있으면 꺼내 쓴다 (다시 풀지 않는다).
//   - 없으면 a는 잠시 두고 a - c로 내려가 먼저 푼다. 다 풀고 돌아오면 그 카드를 채운다.
// 카드를 다 보면 가장 적은 개수를 memo에 적고 한 단계 위로 돌아간다.
// "지금까지 최소"는 코드의 best 변수다. 카드 사이를 옮겨 다니지 않도록 오른쪽 칸에 고정하고,
// 기다리는 금액의 최소는 위쪽 경로에 남겨 둔다.
// 색: memo 띠의 초록은 적어 둔 답, 주황은 지금 푸는 금액, 점선은 기다리는 금액, 노랑은 방금 꺼낸 칸이다.
import { defaultLang } from 'stack-site-builder/i18n/ui';
import DpKit from './DpKit.astro';
interface Props {
  slide?: boolean;
}
const { slide = false } = Astro.props;
const id = `lc-${Math.random().toString(36).slice(2, 9)}`;
const STRINGS: Record<string, Record<string, string>> = {
  ko: {
