    n_up: 'memo에 적고 {p}원으로 돌아갑니다.',
    n_end: 'memo에 적으면 끝입니다.',
    n_done: '{a}원의 답은 {v}개입니다. 적어 둔 선택을 따라가면 {list}입니다. 금액 {n}개만 풀었습니다.',
  },
  en: {
    title: 'The last coin',
    memo: 'memo',
    q: 'To make {a} won, which coin was paid last?',
    first: 'the amount asked first',
    back: 'when solved, back to {p} won',
    won: '{a} won',
    chip: 'best {v}',
    coin: 'last coin',
    wait: 'not looked at yet',
    look: 'look at this card',
    big: 'too large',
    rest: '{r} won left',
    miss: 'no {r} in memo',
    go: 'go solve {r}',
    hit: 'from memo: {v}',
    solved: 'solved and back: {v}',
    no: '{r} cannot be made',
    cand: '{v} + this coin = {w}',
    best: 'fewest',
    sofar: 'best so far',
    none: 'none yet',
    sofarv: '{v} (coin {c})',
