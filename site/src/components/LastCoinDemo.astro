    lg_now: 'amount being solved',
    lg_wait: 'amount waiting',
    lg_hit: 'answer just read',
    auto: 'Next step',
    reset: 'Reset',
    count: 'amounts solved',
    n_start: 'Solve {a} won. Try each coin as the last coin, from left to right.',
    n_big: 'Coin {c} is larger than {a} won, so it cannot be used.',
    n_hit: 'The answer for the remaining {r} won is in memo, so read it instead of solving again.',
    n_miss: 'memo has no answer for the remaining {r} won. Set {a} won aside and solve {r} won first.',
    n_ret: '{r} won is solved; back to {a} won.',
