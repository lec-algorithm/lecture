  },
  zh: {
    title: '最后付的硬币',
    memo: 'memo',
    q: '凑 {a} 韩元时，最后付的是哪枚硬币？',
    first: '最初问的金额',
    back: '解完回到 {p} 韩元',
    won: '{a} 韩元',
    chip: '最少 {v}',
    coin: '最后的硬币',
    wait: '还没看',
    look: '看这张卡片',
    big: '比金额大',
    rest: '还剩 {r} 韩元',
    miss: 'memo 里没有 {r}',
    go: '去解 {r} 韩元',
    hit: '从 memo 取出：{v} 枚',
    solved: '解完回来：{v} 枚',
    no: '{r} 韩元凑不出',
    cand: '{v} 枚 + 这枚 = {w} 枚',
    best: '最少',
    sofar: '目前最少',
    none: '还没有',
    sofarv: '{v} 枚（硬币 {c}）',
    answer: '{a} 韩元的答案',
    write: '在 memo 记下 {a} 韩元 = {v}',
    write_inf: '在 memo 记下 {a} 韩元 = INF',
    lg_done: '已记下的答案',
    lg_now: '正在解的金额',
    lg_wait: '等待中的金额',
    lg_hit: '刚取出的答案',
    auto: '下一步',
    reset: '重置',
    count: '已解金额',
    n_start: '解 {a} 韩元。从左到右，把每枚硬币依次当作最后一枚试一试。',
    n_big: '硬币 {c} 比 {a} 韩元大，不能用。',
    n_hit: '剩下 {r} 韩元的答案在 memo 里，直接取出，不再重解。',
    n_miss: 'memo 里没有剩下 {r} 韩元的答案。先把 {a} 韩元放一放，去解 {r} 韩元。',
    n_ret: '{r} 韩元解完了，回到 {a} 韩元。',
    n_best: '目前最少是 {v} 枚。',
    n_nobest: '还没有凑得出的候选。',
    n_min: '卡片都看完了，最少的 {v} 枚就是 {a} 韩元的答案。',
    n_inf: '哪枚硬币都凑不出 {a} 韩元，所以是 INF。',
    n_up: '记进 memo，回到 {p} 韩元。',
    n_end: '记进 memo 就结束了。',
    n_done: '{a} 韩元的答案是 {v} 枚。沿着记下的选择走得到 {list}。只解了 {n} 个金额。',
  },
};
const lang = Astro.currentLocale ?? defaultLang;
const t = STRINGS[lang] ?? STRINGS.ko;
const SETS = ['2,3,5|6', '50,40,10|80', '1,3,4|6'];
---

<DpKit id={id} cls="aas-last-coin" title={t.title} strings={t} slide={slide} size={2.7}>
  <Fragment slot="controls">
    {SETS.map((s, i) => {
      const [c, a] = s.split('|');
      return (
        <button type="button" class:list={['dx-tab', i === 0 && 'is-on']} data-dx-tab="set" data-dx-val={s}>
          {`{${c.replaceAll(',', ', ')}} ${a}`}
        </button>
      );
    })}
    <span class="dx-sep"></span>
    <button type="button" class="dx-btn dx-primary" data-dx="auto">{t.auto}</button>
    <button type="button" class="dx-btn" data-dx="reset">{t.reset}</button>
  </Fragment>
  <div class="lc-memo">
    <span class="dx-lab">{t.memo}</span><div data-dx="memo"></div>
    <div class="lc-legend">
      <span><i class="dx-cell is-done"></i>{t.lg_done}</span>
      <span><i class="dx-cell is-now"></i>{t.lg_now}</span>
      <span><i class="dx-cell is-lazy"></i>{t.lg_wait}</span>
      <span><i class="dx-cell is-hit"></i>{t.lg_hit}</span>
    </div>
    <span class="lc-n dx-lab">{t.count} <b data-dx="n"></b></span>
  </div>
  <div class="lc-where"><b class="lc-q" data-dx="q"></b><span class="lc-path" data-dx="crumb"></span></div>
  <div class="lc-row">
    <div class="lc-cards" data-dx="cards"></div>
    <div class="lc-box" data-dx="box"></div>
  </div>
</DpKit>

<script is:inline define:vars={{ id }}>
  (() => {
    const K = aasDp;
    const { S, get, note, tabs } = K.root(id);
    const INF = Infinity;
    const show = (v) => (v === INF ? 'INF' : String(v));
    /* 프레임 하나가 재귀 호출 하나다. i는 다음에 볼 카드, how는 카드마다 본 결과, best는 코드의 best 변수 */
    let coins, top, unit, memo, choice, stack, done, msg, lastHit;
    const frame = (a) => ({ a, i: 0, how: coins.map(() => 'wait'), val: coins.map(() => undefined), best: { v: INF, c: 0 } });
    const cur = () => stack[stack.length - 1];
    function load(s) {
      const [c, a] = s.split('|');
      coins = c.split(',').map(Number);
      top = +a;
      const gcd = (x, y) => (y ? gcd(y, x % y) : x);
      unit = coins.reduce(gcd, top);
      memo = new Map([[0, 0]]);
      choice = new Map();
      stack = [frame(top)];
      done = false;
      lastHit = undefined;
      msg = [K.fill(S.n_start, { a: top })];
      draw();
    }
    const bestLine = (f) => (f.best.v === INF ? S.n_nobest : K.fill(S.n_best, { v: f.best.v }));
    const take = (f, v) => {
      f.val[f.i] = v;
      if (v !== INF && v + 1 < f.best.v) f.best = { v: v + 1, c: coins[f.i] };
      f.i += 1;
    };
    /* 카드 한 장을 본다: 쓸 수 없음 / memo에서 꺼냄 / memo에 없음 */
    function look() {
      const f = cur();
      const c = coins[f.i];
      const r = f.a - c;
      lastHit = undefined;
      if (c > f.a) {
        f.how[f.i] = 'big';
        f.i += 1;
        msg = [K.fill(S.n_big, { c, a: f.a })];
      } else if (memo.has(r)) {
        f.how[f.i] = 'hit';
        lastHit = r;
        take(f, memo.get(r));
        msg = [K.fill(S.n_hit, { r }), bestLine(f)];
      } else {
        f.how[f.i] = 'miss';
        msg = [K.fill(S.n_miss, { r, a: f.a })];
      }
      draw();
    }
    function descend() {
      const f = cur();
      const r = f.a - coins[f.i];
      lastHit = undefined;
      stack.push(frame(r));
      msg = [K.fill(S.n_start, { a: r })];
      draw();
    }
    function write() {
      const f = stack.pop();
      memo.set(f.a, f.best.v);
      choice.set(f.a, f.best.c);
      lastHit = undefined;
      if (!stack.length) {
        stack = [f];
        done = true;
      } else {
        const p = cur();
        p.how[p.i] = 'solved';
        take(p, f.best.v);
        msg = [K.fill(S.n_ret, { r: f.a, a: p.a }), bestLine(p)];
      }
      draw();
    }
    function auto() {
      if (done) return;
      const f = cur();
      if (f.i === coins.length) return write();
      if (f.how[f.i] === 'miss') return descend();
      look();
    }
    function draw() {
      const f = cur();
      const a = f.a;
      const end = f.i === coins.length;
      const amounts = stack.map((x) => x.a);
      const p = stack.length > 1 ? stack[stack.length - 2].a : undefined;
      const n = memo.size - 1;
      const cells = [];
      for (let k = 0; k <= top; k += unit) {
        const cls = k === lastHit ? 'is-hit' : memo.has(k) ? 'is-done' : k === a ? 'is-now' : amounts.includes(k) ? 'is-lazy' : '';
        cells.push(K.el('span', { cls: 'lc-col' }, K.el('i', {}, String(k)), K.el('span', { cls: `dx-cell ${cls}` }, memo.has(k) ? show(memo.get(k)) : amounts.includes(k) ? '?' : '')));
      }
      get('memo').replaceChildren(...cells);
      get('n').textContent = n;
      get('auto').disabled = done;
      get('q').textContent = K.fill(S.q, { a });
      /* 어디서 내려왔는지. 기다리는 금액에는 그 금액의 지금까지 최소를 남긴다. 길면 가운데를 … 로 접는다 */
      const L = stack.length;
      const chip = (x, i) =>
        K.el('b', { cls: i === L - 1 ? 'lc-here' : '' }, K.fill(S.won, { a: x.a }), i < L - 1 && x.best.v !== INF ? K.el('small', {}, K.fill(S.chip, { v: x.best.v })) : '');
      const path = stack.flatMap((x, i) =>
        L > 4 && i > 0 && i < L - 2
          ? i === 1
            ? [K.el('span', { cls: 'lc-step' }, '… →')]
            : []
          : [i && !(L > 4 && i === L - 2) ? K.el('span', { cls: 'lc-step' }, `−${stack[i - 1].a - x.a}→`) : '', chip(x, i)],
      );
      get('crumb').replaceChildren(...(p === undefined ? [K.el('span', { cls: 'dx-lab' }, S.first)] : [...path, K.el('span', { cls: 'dx-lab lc-back' }, K.fill(S.back, { p }))]));
      const cards = coins.map((c, j) => {
        const how = f.how[j];
        const r = a - c;
        const v = f.val[j];
        const isNext = !done && j === f.i;
        const isBest = end && f.best.v !== INF && f.best.c === c;
        const head = K.el('span', { cls: 'lc-head' }, K.el('span', { cls: 'dx-lab' }, S.coin), K.el('span', { cls: 'lc-coin' }, String(c)));
        const cls = `lc-card ${how === 'wait' ? 'lc-wait' : ''} ${how === 'big' ? 'is-off' : ''} ${isNext ? 'lc-next' : ''} ${isBest ? 'lc-best' : ''}`;
        let body;
        if (how === 'wait') body = isNext ? K.el('button', { type: 'button', cls: 'dx-btn', on: { click: look } }, S.look) : K.el('em', {}, S.wait);
        else if (how === 'big') body = K.el('em', {}, S.big);
        else if (how === 'miss')
          body = [K.el('span', { cls: 'lc-rest' }, K.fill(S.rest, { r })), K.el('span', { cls: 'lc-ans' }, K.fill(S.miss, { r })), K.el('button', { type: 'button', cls: 'dx-btn dx-primary', on: { click: descend } }, K.fill(S.go, { r }))];
        else
          body = [
            K.el('span', { cls: 'lc-rest' }, K.fill(S.rest, { r })),
            K.el('span', { cls: 'lc-ans' }, v === INF ? K.fill(S.no, { r }) : K.fill(how === 'hit' ? S.hit : S.solved, { v })),
            v === INF ? '' : K.el('b', { cls: 'lc-cand' }, K.fill(S.cand, { v, w: v + 1 })),
          ];
        return K.el('div', { cls }, head, body, isBest ? K.el('span', { cls: 'lc-tag' }, S.best) : '');
      });
      get('cards').replaceChildren(...cards);
      /* 오른쪽 칸: 코드의 best 변수. 카드를 다 보면 답이 되고 적기 버튼이 붙는다 */
      const bv = f.best.v === INF ? (end ? 'INF' : S.none) : K.fill(S.sofarv, { v: f.best.v, c: f.best.c });
      get('box').replaceChildren(
        K.el('span', { cls: 'dx-lab' }, end ? K.fill(S.answer, { a }) : S.sofar),
        K.el('b', { cls: `lc-best-v ${end ? 'is-end' : ''}` }, bv),
        end && !done ? K.el('button', { type: 'button', cls: 'dx-btn dx-primary', on: { click: write } }, K.fill(f.best.v === INF ? S.write_inf : S.write, { a, v: f.best.v })) : '',
      );
      if (done) {
        const list = [];
        for (let k = top; k > 0 && memo.get(top) !== INF; k -= choice.get(k)) list.push(choice.get(k));
        K.lines(note, K.fill(S.n_done, { a: top, v: show(memo.get(top)), list: list.join(' + '), n }));
      } else if (end) K.lines(note, K.fill(f.best.v === INF ? S.n_inf : S.n_min, { a, v: f.best.v }), p === undefined ? S.n_end : K.fill(S.n_up, { p }));
      else K.lines(note, ...msg);
    }
    get('auto').addEventListener('click', auto);
    let set = '2,3,5|6';
    get('reset').addEventListener('click', () => load(set));
    tabs('set', (v) => load((set = v)));
    load(set);
  })();
</script>

<style is:global>
  .aas-last-coin .lc-memo,
  .aas-last-coin .lc-where {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em 0.8em;
    align-items: center;
    margin-bottom: 0.5em;
  }
  .aas-last-coin .lc-memo > [data-dx='memo'] {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3em;
  }
  .aas-last-coin .lc-col {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .aas-last-coin .lc-col i {
    font-style: normal;
    font-size: 0.7em;
    color: var(--aas-muted);
    font-family: var(--aas-mono, monospace);
  }
  .aas-last-coin .lc-n {
    margin-left: auto;
  }
  .aas-last-coin .lc-legend {
    display: grid;
    grid-template-columns: auto auto;
    gap: 0.2em 1em;
    margin-left: 0.6em;
    font-size: 0.72em;
    color: var(--aas-muted);
  }
  .aas-last-coin .lc-legend span {
    display: inline-flex;
    gap: 0.4em;
    align-items: center;
  }
  .aas-last-coin .lc-legend .dx-cell {
    width: 1.2em;
    min-width: 0;
    height: 1.2em;
  }
  .aas-last-coin .lc-where {
    margin-top: 0.3em;
    gap: 0.4em 1.2em;
  }
  .aas-last-coin .lc-q {
    font-size: 1.1em;
  }
  .aas-last-coin .lc-path {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.3em;
    align-items: center;
    font-size: 0.85em;
  }
  .aas-last-coin .lc-path b {
    padding: 0.05em 0.4em;
    border: 1.5px dashed var(--dx-line);
    border-radius: 0.3em;
    font-weight: 600;
  }
  .aas-last-coin .lc-path b.lc-here {
    border: 1.5px solid var(--aas-role-focus);
    background: color-mix(in srgb, var(--aas-role-focus) 25%, var(--aas-bg));
  }
  .aas-last-coin .lc-step {
    white-space: nowrap;
    font-family: var(--aas-mono, monospace);
    color: var(--aas-muted);
  }
  .aas-last-coin .lc-back {
    margin-left: 0.4em;
  }
  .aas-last-coin .lc-cards {
