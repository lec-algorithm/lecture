---
// 뺄셈 두 방식을 같은 시계 위에 놓고 한 단계씩 돌려 보는 데모.
//
// 두 방식이 같은 답을 낸다는 것은 종이에서 이미 봤다. 여기서 보여 줄 것은
// 그 다음이다. 자리 내림은 한 단계에 한 자리밖에 못 한다. 앞 자리의 빌림이
// 정해져야 다음 자리를 시작할 수 있기 때문이다. 음수를 허용하면 세 자리를
// 한 단계에 동시에 끝낸다. 서로를 기다릴 이유가 없기 때문이다.
//
// 그래서 화면의 주인공은 결과가 아니라 **한 단계에 몇 자리가 동시에 일하는가**다.
// 세 자리짜리 예제에서는 단계 수가 3 대 3으로 같은데, 그것도 그대로 보여 준다.
// 병렬로 끝낸 뺄셈 뒤에 순차적인 정리가 붙기 때문이다. 이득은 자릿수가 늘거나
// 연산을 여러 번 이어 붙일 때 남는다.
//
// 셀은 전부 서버에서 그리고 스크립트는 class와 textContent만 바꾼다. 그래서
// Astro의 scoped 스타일이 그대로 먹는다. 표식은 테마의 덱 크롬과 부딪히지
// 않도록 `data-sb-*`로 접두를 붙였다.
import { defaultLang } from 'stack-site-builder/i18n/ui';

interface Props {
  /** 피감수. 자릿수는 감수와 같아야 한다. */
  a?: number;
  /** 감수. */
  b?: number;
  /** 슬라이드용: 글자와 칸을 슬라이드 크기에 맞춘다. */
  slide?: boolean;
}
const { a = 361, b = 192, slide = false } = Astro.props;

const A = String(a).split('').map(Number);
const B = String(b).split('').map(Number);
const n = A.length;

// ── 자리 내림: 한 단계에 한 자리. 빌림이 다음 자리의 피감수를 바꾼다 ──────
type BorrowStep = { col: number; top: number[]; res: (number | null)[]; borrowed: boolean };
const borrowSteps: BorrowStep[] = [];
{
  const top = [...A];
  const res: (number | null)[] = Array(n).fill(null);
  let carry = 0;
  for (let i = n - 1; i >= 0; i--) {
    let t = top[i] - carry;
    const borrowed = t < B[i];
    if (borrowed) t += 10;
    top[i] = t;
    res[i] = t - B[i];
    carry = borrowed ? 1 : 0;
    borrowSteps.push({ col: i, top: [...top], res: [...res], borrowed });
  }
}

// ── 음수 허용: 첫 단계에 전부 동시에. 그 뒤가 순차적인 정리다 ────────────
type SignedStep = { kind: 'parallel' | 'tidy'; cols: number[]; res: number[] };
const signedSteps: SignedStep[] = [];
{
  const s = A.map((x, i) => x - B[i]);
  signedSteps.push({ kind: 'parallel', cols: A.map((_, i) => i), res: [...s] });
  for (let i = n - 1; i >= 1; i--) {
    if (s[i] < 0) {
      s[i] += 10;
      s[i - 1] -= 1;
    }
    signedSteps.push({ kind: 'tidy', cols: [i, i - 1], res: [...s] });
  }
}

const total = Math.max(borrowSteps.length, signedSteps.length);
const answer = Number(a) - Number(b);

const STRINGS: Record<string, Record<string, string>> = {
  ko: {
    borrow: '자리 내림',
    signed: '음수 허용',
    step: '한 걸음',
    play: '자동 재생',
    stop: '멈춤',
    reset: '처음으로',
    stage: '단계',
    lanes: '동시에 계산한 자리',
    start: '두 방식으로 같은 뺄셈을 합니다. 한 걸음씩 눌러 보세요.',
    bStep: '{c}의 자리 하나만 합니다. 앞 자리의 빌림이 정해져야 시작할 수 있습니다.',
    bDone: '세 단계를 순서대로 밟아 {v}가 나왔습니다.',
    sPar: '{k}자리를 **한 단계에 동시에** 뺍니다. 서로를 기다리지 않습니다.',
    sTidy: '정리 단계입니다. 오른쪽 자리를 올려야 왼쪽 자리가 정해집니다.',
    sDone: '뺄셈 한 단계 + 정리 {t}단계로 {v}가 나왔습니다.',
    verdict:
      '같은 답, 같은 단계 수입니다. 다른 것은 **한 단계에 몇 자리가 일했는가**입니다.',
    ones: '일',
    tens: '십',
    huns: '백',
  },
  en: {
    borrow: 'Borrowing',
    signed: 'Negative digits',
    step: 'Step',
    play: 'Play',
    stop: 'Pause',
    reset: 'Reset',
    stage: 'step',
    lanes: 'columns computed at once',
    start: 'The same subtraction, two ways. Press step to follow along.',
    bStep: 'Only the {c} column. It cannot start until the borrow from the column to its right is known.',
    bDone: 'Three steps in order, and the answer is {v}.',
    sPar: 'All {k} columns subtracted **in one step**. None of them waits on another.',
    sTidy: 'A tidying step. The left digit settles only after the right one is carried.',
    sDone: 'One subtraction step plus {t} tidying steps, and the answer is {v}.',
    verdict:
      'Same answer, same number of steps. What differs is **how many columns worked in each one**.',
    ones: 'ones',
    tens: 'tens',
    huns: 'hundreds',
  },
  zh: {
    borrow: '借位',
    signed: '允许负数',
    step: '单步',
    play: '播放',
    stop: '暂停',
    reset: '重置',
    stage: '步',
    lanes: '同时计算的位数',
    start: '同一个减法，两种做法。请逐步查看。',
    bStep: '只做{c}位。要等右边一位的借位定下来才能开始。',
    bDone: '按顺序走了三步，得到 {v}。',
    sPar: '{k} 位**在一步之内同时**相减。彼此不用等待。',
    sTidy: '收尾步骤。右边一位进上去，左边一位才定得下来。',
    sDone: '减法一步加收尾 {t} 步，得到 {v}。',
    verdict: '答案相同，步数也相同。不同的是**每一步有几位在工作**。',
    ones: '个',
    tens: '十',
    huns: '百',
  },
};
const lang = Astro.currentLocale ?? defaultLang;
const t = STRINGS[lang] ?? STRINGS[defaultLang] ?? STRINGS.ko;

// 자리 이름은 오른쪽부터. 네 자리 이상이면 인덱스로 떨어진다.
const placeName = (i: number) => [t.huns, t.tens, t.ones][i - (n - 3)] ?? String(n - 1 - i);
const places = A.map((_, i) => placeName(i));

const payload = {
  borrow: borrowSteps.map((s) => ({ ...s, place: places[s.col] })),
  signed: signedSteps,
  total,
  answer: String(answer),
  n,
  tidy: signedSteps.length - 1,
};
---

<div
  class:list={['aas-subtraction-demo', slide && 'is-slide']}
  data-sb-strings={JSON.stringify(t)}
  data-sb-steps={JSON.stringify(payload)}
>
  <div class="sb-bar">
    <span class="sb-stage">{t.stage} <strong data-sb-stage>0</strong> / {total}</span>
    <span class="sb-controls">
      <button type="button" class="sb-btn" data-sb-step>{t.step}</button>
      <button type="button" class="sb-btn sb-btn-primary" data-sb-play>{t.play}</button>
      <button type="button" class="sb-btn" data-sb-reset>{t.reset}</button>
    </span>
  </div>

  <div class="sb-lanes">
    {
      (['borrow', 'signed'] as const).map((lane) => (
        <div class="sb-lane" data-sb-lane={lane}>
          <div class="sb-head">
            <h4>{lane === 'borrow' ? t.borrow : t.signed}</h4>
            <span class="sb-busy">
              <strong data-sb-busy={lane}>0</strong> / {n}
            </span>
          </div>

          <div class="sb-grid" style={`--sb-cols:${n}`}>
            {places.map((p) => (
              <span class="sb-place">{p}</span>
            ))}
            {A.map((d, i) => (
              <span class="sb-cell sb-top" data-sb-cell={`${lane}-top-${i}`}>
                {d}
              </span>
            ))}
            {B.map((d, i) => (
              <span class="sb-cell sb-sub">
                {i === 0 ? '−' : ''}
                {d}
              </span>
            ))}
            {A.map((_, i) => (
              <span class="sb-cell sb-res" data-sb-cell={`${lane}-res-${i}`} />
            ))}
          </div>

          <p class="sb-note" data-sb-note={lane} />
        </div>
      ))
    }
  </div>

  <p class="sb-verdict" data-sb-verdict></p>
</div>

<script>
  (() => {
    const md = (s: string) => s.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
    const fill = (tpl: string, vars: Record<string, string | number>) =>
      tpl.replace(/\{(\w+)\}/g, (_, k) => String(vars[k] ?? ''));

    document.querySelectorAll<HTMLElement>('.aas-subtraction-demo').forEach((root) => {
      if (root.dataset.sbWired) return;
      root.dataset.sbWired = '1';

      const t = JSON.parse(root.dataset.sbStrings || '{}');
      const data = JSON.parse(root.dataset.sbSteps || '{}');
      const cells = new Map<string, HTMLElement>();
      root.querySelectorAll<HTMLElement>('[data-sb-cell]').forEach((el) =>
        cells.set(el.dataset.sbCell!, el),
      );
      const noteOf = (lane: string) =>
        root.querySelector<HTMLElement>(`[data-sb-note="${lane}"]`)!;
      const busyOf = (lane: string) =>
        root.querySelector<HTMLElement>(`[data-sb-busy="${lane}"]`)!;
      const stageEl = root.querySelector<HTMLElement>('[data-sb-stage]')!;
      const verdictEl = root.querySelector<HTMLElement>('[data-sb-verdict]')!;
      const stepBtn = root.querySelector<HTMLButtonElement>('[data-sb-step]')!;
      const playBtn = root.querySelector<HTMLButtonElement>('[data-sb-play]')!;
      const resetBtn = root.querySelector<HTMLButtonElement>('[data-sb-reset]')!;

      let at = 0; // 0 = 시작 전
      let timer: number | null = null;

      // 매번 처음부터 다시 그린다. 되감기가 공짜가 되고 두 레인이 어긋날 수 없다.
      const render = () => {
        const bIdx = Math.min(at, data.borrow.length) - 1;
        const sIdx = Math.min(at, data.signed.length) - 1;
        const b = bIdx >= 0 ? data.borrow[bIdx] : null;
        const s = sIdx >= 0 ? data.signed[sIdx] : null;

        for (let i = 0; i < data.n; i++) {
          const bt = cells.get(`borrow-top-${i}`)!;
          const br = cells.get(`borrow-res-${i}`)!;
          bt.textContent = b ? String(b.top[i]) : bt.dataset.sbInit!;
          br.textContent = b && b.res[i] !== null ? String(b.res[i]) : '';
          const bActive = Boolean(b) && b.col === i;
          bt.classList.toggle('is-live', bActive);
          br.classList.toggle('is-live', bActive);
          br.classList.toggle('is-done', Boolean(b) && b.res[i] !== null && !bActive);

          const sr = cells.get(`signed-res-${i}`)!;
          sr.textContent = s ? String(s.res[i]) : '';
          const sActive = Boolean(s) && s.cols.includes(i);
          sr.classList.toggle('is-live', sActive);
          sr.classList.toggle('is-par', sActive && s.kind === 'parallel');
          sr.classList.toggle('is-done', Boolean(s) && !sActive);
        }

        busyOf('borrow').textContent = b ? '1' : '0';
        busyOf('signed').textContent = s ? String(s.cols.length) : '0';
        stageEl.textContent = String(at);

        if (at === 0) {
          noteOf('borrow').textContent = '';
          noteOf('signed').textContent = '';
          verdictEl.innerHTML = md(t.start);
        } else {
          noteOf('borrow').innerHTML =
            bIdx === data.borrow.length - 1
              ? md(fill(t.bDone, { v: data.answer }))
              : md(fill(t.bStep, { c: b.place }));
          noteOf('signed').innerHTML =
            s.kind === 'parallel'
              ? md(fill(t.sPar, { k: data.n }))
              : sIdx === data.signed.length - 1
                ? md(fill(t.sDone, { v: data.answer, t: data.tidy }))
                : md(t.sTidy);
          verdictEl.innerHTML = at >= data.total ? md(t.verdict) : '';
        }
        verdictEl.classList.toggle('is-done', at >= data.total);

        const finished = at >= data.total;
        stepBtn.disabled = finished;
        if (finished) stop();
      };

      const stop = () => {
        if (timer !== null) {
          clearInterval(timer);
          timer = null;
          playBtn.textContent = t.play;
        }
      };
      const step = () => {
        if (at < data.total) at++;
        render();
      };

      // 초기 피감수 값을 기억해 둔다. 되감을 때 되돌릴 자리다.
      root.querySelectorAll<HTMLElement>('.sb-top').forEach((el) => {
        el.dataset.sbInit = el.textContent!.trim();
      });

      stepBtn.addEventListener('click', () => {
        stop();
        step();
      });
      playBtn.addEventListener('click', () => {
        if (timer !== null) {
          stop();
          return;
        }
        if (at >= data.total) at = 0;
        playBtn.textContent = t.stop;
        timer = window.setInterval(step, 1100);
      });
      resetBtn.addEventListener('click', () => {
        stop();
        at = 0;
        render();
      });

      render();
    });
  })();
</script>

<style>
  .aas-subtraction-demo {
    /* 안쪽 치수는 모두 이 값에 대한 em이다. 루트 하나로 전체가 함께 커진다. */
    font-size: 1rem;
    margin: 1.5rem 0;
    padding: 1em;
    border: 1px solid var(--aas-border);
    border-radius: 0.9em;
    background: var(--aas-panel);
  }
  .sb-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75em;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1em;
  }
  .sb-stage {
    font-size: 0.9em;
    color: var(--aas-muted);
  }
  .sb-stage strong {
    color: var(--aas-text);
    font-family: var(--aas-mono, monospace);
  }
  .sb-controls {
    display: flex;
    gap: 0.5em;
  }
  .sb-btn {
    padding: 0.35em 0.8em;
    font-size: 0.85em;
    border: 1px solid var(--aas-border);
    border-radius: 0.5em;
    background: var(--aas-bg);
    color: var(--aas-text);
    cursor: pointer;
  }
  .sb-btn:hover:not(:disabled) {
    border-color: var(--aas-accent);
  }
  .sb-btn:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .sb-btn-primary {
    background: var(--aas-accent);
    border-color: var(--aas-accent);
    color: #fff;
  }

  .sb-lanes {
    display: grid;
    gap: 1.5em;
  }
  @media (min-width: 48rem) {
    .sb-lanes {
      grid-template-columns: 1fr 1fr;
    }
  }
  .sb-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5em;
    margin-bottom: 0.5em;
  }
  .sb-head h4 {
    margin: 0;
    font-size: 1em;
  }
  /* 이 데모의 요점이 되는 숫자. 한 단계에 몇 자리가 동시에 일했는가. */
  .sb-busy {
    font-size: 0.85em;
    color: var(--aas-muted);
  }
  .sb-busy strong {
    color: var(--aas-role-focus);
    font-family: var(--aas-mono, monospace);
    font-size: 1.15em;
  }

  .sb-grid {
    display: grid;
    grid-template-columns: repeat(var(--sb-cols), 3.2em);
    gap: 0.2em;
    justify-content: start;
    font-family: var(--aas-mono, monospace);
  }
  .sb-place {
    text-align: center;
    font-size: 0.6em;
    color: var(--aas-muted);
  }
  .sb-cell {
    padding: 0.25em 0;
    text-align: center;
    font-size: 0.95em;
    line-height: 1.4;
    border: 1px solid transparent;
    border-radius: 0.35em;
    transition:
      background-color 0.18s,
      border-color 0.18s,
      color 0.18s;
  }
  /* 결과 줄은 뺄셈 선 아래에 온다. */
  .sb-res {
    border-top: 1px solid var(--aas-border);
    border-radius: 0 0 0.35em 0.35em;
    min-height: 1.9em;
  }
  .sb-sub {
    color: var(--aas-muted);
  }

  /* 지금 계산 중인 자리. 두 레인이 같은 뜻에 같은 색을 쓴다. */
  .sb-cell.is-live {
    border-color: var(--aas-role-focus);
    background: color-mix(in srgb, var(--aas-role-focus) 22%, transparent);
    font-weight: 700;
  }
  /* 한 단계에 여러 자리가 동시에 켜지는 것이 이 데모가 말하려는 전부다. */
  .sb-cell.is-par {
    border-color: var(--aas-role-eval);
    background: color-mix(in srgb, var(--aas-role-eval) 26%, transparent);
  }
  .sb-cell.is-done {
    color: var(--aas-text);
  }

  .sb-note {
    margin: 0.6em 0 0;
    font-size: 0.85em;
    color: var(--aas-muted);
    min-height: 3.2em;
  }
  .sb-verdict {
    margin: 1em 0 0;
    font-size: 0.9em;
    color: var(--aas-muted);
    min-height: 1.6em;
  }
  .sb-verdict.is-done {
    color: var(--aas-text);
  }

  /* 슬라이드용. 근거는 SearchDemo의 같은 규칙과 같다: 슬라이드 폭은 뷰포트
     높이가 정하므로 vw가 아니라 vh로 잡는다. */
  .aas-subtraction-demo.is-slide {
    font-size: clamp(1rem, 2.8vh, 1.8rem);
    margin: 0.5rem 0;
  }
  .aas-subtraction-demo.is-slide .sb-note {
    min-height: 2.6em;
  }

  @media (prefers-reduced-motion: reduce) {
    .sb-cell {
      transition: none;
    }
  }
</style>
