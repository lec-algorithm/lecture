    okNote: '전체가 패턴에 속합니다.',
    repeat: '{p}가 먹은 덩어리: {w}',
    stuck: '{i}번째 칸부터 {p} ({m})에 맞지 않습니다.',
    short: '글자가 모자랍니다. {p} ({m})가 남았습니다.',
    extra: '패턴을 다 썼는데 {i}번째 칸부터 글자가 남았습니다.',
    eat: "'{c}': {p} ({m})가 먹습니다.",
    lparen: '여는 괄호',
    rparen: '닫는 괄호',
    d3: '숫자 3개',
    d34: '숫자 3∼4개',
    d4: '숫자 4개',
    space: '공백 한 칸',
    dash: '하이픈',
    lower: '소문자 1개 이상',
    at: '골뱅이',
