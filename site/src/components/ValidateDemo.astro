    tld: 'edu 또는 com',
    userWide: '영문·숫자·기호 1개 이상',
    hostWide: '영문·숫자·점·하이픈 1개 이상',
    dot: '실제 점',
    tldWide: '영문 2개 이상',
    scheme: 'http 또는 https',
