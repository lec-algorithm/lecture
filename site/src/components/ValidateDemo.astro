---
// 전화번호·이메일·URL 정규식을 조각별로 맞춰 보는 데모.
//
// 정규식을 조각으로 나눠 조각마다 기호와 뜻을 표로 보이고, 입력의 글자마다 어느 조각이
// 먹었는지 같은 색으로 칠한다. 전체가 맞지 않으면 어느 조각에서 막혔는지 알려 준다.
// 판정은 브라우저의 RegExp로 ^(조각1)(조각2)…$를 돌린 실제 결과다. 막힌 자리는 앞에서부터
// 조각을 가장 많이 맞춘 곳이다. 정규식은 슬라이드와 교안의 것을 그대로 썼다.
// 한 걸음마다 글자 하나와 그 글자를 먹은 조각을 칠한다.
import { defaultLang } from 'stack-site-builder/i18n/ui';

interface Props {
  /** 보일 탭. phone, mobile, email, wide, url */
  tabs?: ('phone' | 'mobile' | 'email' | 'wide' | 'url')[];
  /** 슬라이드용: 글자와 칸을 키운다. */
  slide?: boolean;
}
const { tabs = ['phone', 'mobile', 'email', 'wide', 'url'], slide = false } = Astro.props;
const id = `vd-${Math.random().toString(36).slice(2, 9)}`;

const STRINGS: Record<string, Record<string, string>> = {
  ko: {
