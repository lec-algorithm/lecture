---
// 정규식에서 만든 NFA를 상태 집합으로 돌려 보는 데모.
//
// 상태 i는 괄호로 감싼 정규식의 i번째 글자이고, 한 줄로 늘어놓는다. 검은
// 실선은 글자를 읽고 다음 상태로 가는 매치 전이, 파란 점선은 글자 없이
// 움직이는 ε 전이다(앞으로 가는 것은 위, 뒤로 가는 것은 아래로 돈다).
// 한 걸음마다 둘 중 하나를 한다.
//   - 글자 읽기: 지금 집합에서 그 글자와 맞는 상태만 한 칸 앞으로 간다.
//   - ε 닫힘: 거기서 ε 전이만 따라 갈 수 있는 상태를 모두 더한다.
// 텍스트를 다 읽었을 때 집합에 수락 상태(맨 오른쪽)가 있으면 수락이다.
//
// 그래프 만들기와 시뮬레이션은 algorithm-code의 nfaRegex.c · nfa_regex.py와
// 같다. 기본 입력 (0|1(01*0)*1)*와 1001은 출력의 집합 여덟 개를 그대로 지난다.
//
// mode="build"면 그래프를 만드는 과정(BuildNFA)을 한 걸음씩 보여 준다. 한 걸음에
// 정규식 글자 하나를 보고, ops 스택과 그 걸음에 더한 전이를 칠한다. 아직 더하지
// 않은 전이는 흐리게 둔다. 기본값 mode="run"은 예전과 똑같이 동작한다.
import { defaultLang } from 'stack-site-builder/i18n/ui';

interface Props {
  /** 글자, '.', '*', '|', 괄호로 된 정규식. 괄호 한 쌍 안에 '|'는 하나만 */
  regex?: string;
  /** 읽을 텍스트 */
  text?: string;
  /** 'run': 상태 집합으로 돌리기(기본), 'build': 그래프 만들기 */
  mode?: 'run' | 'build';
  /** 슬라이드용: 글자와 그림을 키운다. */
  slide?: boolean;
}
const { regex = '(0|1(01*0)*1)*', text = '1001', mode = 'run', slide = false } = Astro.props;
const id = `nd-${Math.random().toString(36).slice(2, 9)}`;

/* BuildNFA. nfaRegex.pseudo와 같은 순서로 ε 전이를 만든다. build 모드를 위해
   걸음마다 무엇을 했는지(꺼낸 것, 더한 전이, 스택)도 적어 둔다. */
const re = `(${regex})`;
const M = re.length;
const eps: [number, number][] = [];
type BuildStep = {
  i: number;
  kind: 'open' | 'or' | 'close' | 'closeOr' | 'lit' | 'star';
  popped: number[];
  lp: number;
  added: [number, number][];
  starAdded: [number, number][];
  ops: number[];
};
const buildSteps: BuildStep[] = [];
{
  const ops: number[] = [];
  for (let i = 0; i < M; i++) {
    const before = eps.length;
    let lp = i;
    let kind: BuildStep['kind'] = re[i] === '*' ? 'star' : 'lit';
    const popped: number[] = [];
    if (re[i] === '(' || re[i] === '|') {
      ops.push(i);
      kind = re[i] === '(' ? 'open' : 'or';
    } else if (re[i] === ')') {
      const or = ops.pop()!;
      popped.push(or);
      kind = 'close';
      if (re[or] === '|') {
        lp = ops.pop()!;
        popped.push(lp);
        kind = 'closeOr';
        eps.push([lp, or + 1]);
        eps.push([or, i]);
      } else lp = or;
    }
    const mid = eps.length;
    if (i < M - 1 && re[i + 1] === '*') {
      eps.push([lp, i + 1]);
      eps.push([i + 1, lp]);
    }
    const afterStar = eps.length;
    if (re[i] === '(' || re[i] === '*' || re[i] === ')') eps.push([i, i + 1]);
    buildSteps.push({
      i, kind, popped, lp,
      added: [...eps.slice(before, mid), ...eps.slice(afterStar)],
      starAdded: eps.slice(mid, afterStar),
      ops: [...ops],
    });
  }
}
const isLiteral = (c: string) => !'()*|'.includes(c);

const STRINGS: Record<string, Record<string, string>> = {
  ko: {
    title: 'NFA 시뮬레이션',
    back: '뒤로',
    step: '한 걸음',
    play: '자동 재생',
    stop: '멈춤',
    reset: '처음으로',
    setSize: '상태 ',
    setPost: '개',
    idle: '정규식 {r}의 NFA로 "{t}"를 읽습니다. 수락 상태는 {m}입니다.',
    start: '시작: 상태 0에서 ε 전이만 따라 갈 수 있는 곳 {set}',
    read: "'{c}' 읽기: 이 글자와 맞는 상태만 한 칸 앞으로 → {set}",
    dead: "'{c}' 읽기: 맞는 상태가 없습니다. 집합이 비었습니다.",
    close: 'ε 닫힘: ε 전이를 따라 넓히면 {set}',
    yes: '텍스트를 다 읽었고 집합에 수락 상태 {m}이 있습니다. 수락합니다.',
    no: '텍스트를 다 읽었는데 집합에 수락 상태 {m}이 없습니다. 거부합니다.',
    titleBuild: 'NFA 만들기',
    stack: 'ops 스택',
    epsPre: 'ε 전이 ',
    epsPost: '개',
    bIdle: '괄호로 감싼 정규식 {r}: 왼쪽부터 한 글자씩 보며 전이를 더합니다. 글자 하나가 상태 하나입니다.',
    bOpen: "상태 {i} '(': 스택에 넣습니다.",
    bOr: "상태 {i} '|': 스택에 넣습니다. 왼쪽 갈래가 여기서 끝납니다.",
    bClose: "상태 {i} ')': 스택에서 짝이 되는 '('를 꺼냅니다. 상태 {lp}입니다.",
    bCloseOr: "상태 {i} ')': 스택에서 '|'와 짝이 되는 '('를 꺼냅니다.",
    bOrEdges: "더하는 ε 전이: {lp}→{or1} ('('에서 오른쪽 갈래로), {or}→{i} ('|'에서 ')'로)",
    bLit: "상태 {i} '{c}': 글자 상태, 매치 전이 {i}→{i1}",
    bStar: "상태 {i} '*'",
    bSym: '더하는 ε 전이: {i}→{i1} (글자 없이 다음으로)',
    bStarAdd: "다음 글자가 '*' → 더하는 ε 전이: {lp}→{i1} (0번), {i1}→{lp} (한 번 더)",
    bDone: '다 만들었습니다. 상태는 0부터 {m}까지, ε 전이는 모두 {n}개입니다.',
  },
  en: {
    title: 'NFA simulation',
    back: 'Back',
    step: 'Step',
    play: 'Play',
    stop: 'Pause',
    reset: 'Reset',
    setSize: '',
    setPost: ' states',
    idle: 'Read "{t}" with the NFA of {r}. The accept state is {m}.',
    start: 'Start: everything reachable from state 0 by ε-transitions {set}',
    read: "Read '{c}': only states matching '{c}' move one ahead → {set}",
    dead: "Read '{c}': no state matches. The set is empty.",
    close: 'ε-closure: follow ε-transitions to widen it to {set}',
    yes: 'The text is used up and the set holds the accept state {m}. Accept.',
    no: 'The text is used up but the set lacks the accept state {m}. Reject.',
    titleBuild: 'Building the NFA',
    stack: 'ops stack',
    epsPre: '',
    epsPost: ' ε-transitions',
    bIdle: 'The wrapped regex {r}: scan it from the left one character at a time, adding transitions. Each character is one state.',
    bOpen: "State {i} '(': push it on the stack.",
    bOr: "State {i} '|': push it on the stack. The left branch ends here.",
    bClose: "State {i} ')': pop its matching '(' from the stack. That is state {lp}.",
    bCloseOr: "State {i} ')': pop the '|' and its matching '(' from the stack.",
    bOrEdges: "New ε-transitions: {lp}→{or1} (from '(' to the right branch), {or}→{i} (from '|' to ')')",
    bLit: "State {i} '{c}': a character state, match transition {i}→{i1}",
    bStar: "State {i} '*'",
    bSym: 'New ε-transition: {i}→{i1} (move on without reading)',
    bStarAdd: "Next comes '*' → new ε-transitions: {lp}→{i1} (zero times), {i1}→{lp} (once more)",
    bDone: 'Done. The states run from 0 to {m}, with {n} ε-transitions in all.',
  },
  zh: {
    title: 'NFA 模拟',
    back: '后退',
    step: '单步',
    play: '播放',
    stop: '暂停',
    reset: '重置',
    setSize: '状态 ',
    setPost: ' 个',
    idle: '用 {r} 的 NFA 读入 "{t}"。接受状态是 {m}。',
    start: '开始：从状态 0 仅经 ε 转移能到达的状态 {set}',
    read: "读入 '{c}'：只有与 '{c}' 匹配的状态前进一格 → {set}",
    dead: "读入 '{c}'：没有匹配的状态。集合为空。",
    close: 'ε 闭包：沿 ε 转移扩展为 {set}',
    yes: '文本已读完，集合中有接受状态 {m}。接受。',
    no: '文本已读完，集合中没有接受状态 {m}。拒绝。',
    titleBuild: 'NFA 构造',
    stack: 'ops 栈',
    epsPre: 'ε 转移 ',
    epsPost: ' 条',
    bIdle: '加上括号的正则 {r}：从左到右逐个查看字符并添加转移。每个字符就是一个状态。',
    bOpen: "状态 {i} '('：压入栈。",
    bOr: "状态 {i} '|'：压入栈。左分支在这里结束。",
    bClose: "状态 {i} ')'：从栈中弹出与之配对的 '('。它是状态 {lp}。",
    bCloseOr: "状态 {i} ')'：从栈中弹出 '|' 和与之配对的 '('。",
    bOrEdges: "新增 ε 转移：{lp}→{or1}（从 '(' 到右分支），{or}→{i}（从 '|' 到 ')'）",
    bLit: "状态 {i} '{c}'：字符状态，匹配转移 {i}→{i1}",
    bStar: "状态 {i} '*'",
    bSym: '新增 ε 转移：{i}→{i1}（不读字符直接前进）',
    bStarAdd: "下一个字符是 '*' → 新增 ε 转移：{lp}→{i1}（0 次），{i1}→{lp}（再来一次）",
    bDone: '构造完成。状态从 0 到 {m}，ε 转移共 {n} 条。',
  },
};
const lang = Astro.currentLocale ?? defaultLang;
const t = STRINGS[lang] ?? STRINGS[defaultLang] ?? STRINGS.ko;

/* 그림 좌표. 상태를 한 줄로 두고, 이웃 사이의 전이는 직선, 나머지 ε 전이는
   앞으로 가면 위로, 뒤로 가면 아래로 도는 호다. 호의 높이는 건너뛰는 거리에
   비례한다. */
const U = 46;
const R = 15;
const PAD = 26;
const spanOf = (v: number, w: number) => Math.abs(w - v);
const hOf = (v: number, w: number) => 18 + spanOf(v, w) * 7.5;
const arcs = eps.filter(([v, w]) => !(w === v + 1 && !isLiteral(re[v])));
const upH = Math.max(30, ...arcs.filter(([v, w]) => w > v).map(([v, w]) => hOf(v, w)));
const downH = Math.max(30, ...arcs.filter(([v, w]) => w < v).map(([v, w]) => hOf(v, w)));
const Y = upH + 18;
const W = 2 * PAD + M * U;
const H = Y + downH + 26;
const X = (i: number) => PAD + i * U;
const arcPath = (v: number, w: number) => {
  const up = w > v;
  const sx = X(v) + (up ? 4 : -4);
  const ex = X(w) + (up ? -4 : 4);
  const sy = Y + (up ? -R : R);
  const ey = Y + (up ? -R - 1 : R + 1);
  const c = (up ? -1 : 1) * hOf(v, w) * 1.3;
  return `M ${sx} ${sy} C ${sx} ${sy + c}, ${ex} ${ey + c}, ${ex} ${ey}`;
};
type Line = { key: string; d: string; kind: 'match' | 'eps' };
const lines: Line[] = [];
for (let i = 0; i < M; i++) {
  if (re[i] === '|') continue;
  lines.push({
    key: isLiteral(re[i]) ? `m${i}` : `e${i}-${i + 1}`,
    d: `M ${X(i) + R} ${Y} L ${X(i + 1) - R - 2} ${Y}`,
    kind: isLiteral(re[i]) ? 'match' : 'eps',
  });
}
for (const [v, w] of arcs) lines.push({ key: `e${v}-${w}`, d: arcPath(v, w), kind: 'eps' });
---

<div
  class:list={['aas-nfa-demo', slide && 'is-slide', mode === 'build' && 'is-build']}
  id={id}
  data-nd-mode={mode}
  data-nd-build={mode === 'build' ? JSON.stringify(buildSteps) : undefined}
  data-nd-re={re}
  data-nd-regex={regex}
  data-nd-eps={JSON.stringify(eps)}
  data-nd-text={text}
  data-nd-strings={JSON.stringify(t)}
>
  <div class="nd-bar">
    <span class="nd-head"><strong>{mode === 'build' ? t.titleBuild : t.title}</strong> <code>{regex}</code></span>
    <div class="nd-controls">
      <button type="button" data-act="back" class="nd-btn">{t.back}</button>
      <button type="button" data-act="step" class="nd-btn">{t.step}</button>
      <button type="button" data-act="play" class="nd-btn nd-btn-primary">{t.play}</button>
      <button type="button" data-act="reset" class="nd-btn">{t.reset}</button>
    </div>
  </div>

  <div class="nd-scroll">
    <svg class="nd-graph" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${t.title} ${regex}`}>
      <defs>
        <marker id={`${id}-m`} class="nd-tip-match" viewBox="0 0 10 10" refX="9" refY="5"
          markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" />
        </marker>
        <marker id={`${id}-e`} class="nd-tip-eps" viewBox="0 0 10 10" refX="9" refY="5"
          markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" />
        </marker>
        <marker id={`${id}-on`} class="nd-tip-on" viewBox="0 0 10 10" refX="9" refY="5"
          markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" />
        </marker>
      </defs>
      {lines.map((l) => (
        <path
          class:list={['nd-edge', `is-${l.kind}`]}
          d={l.d}
          data-nd-edge={l.key}
          data-nd-off={`url(#${id}-${l.kind === 'match' ? 'm' : 'e'})`}
          data-nd-on={`url(#${id}-on)`}
          marker-end={`url(#${id}-${l.kind === 'match' ? 'm' : 'e'})`}
        />
      ))}
      {Array.from({ length: M + 1 }, (_, i) => (
        <g class:list={['nd-state', i === M && 'is-final']} data-nd-state={i}>
          {i === M && <circle class="nd-ring" cx={X(i)} cy={Y} r={R + 4} />}
          <circle cx={X(i)} cy={Y} r={R} />
          <text class="nd-char" x={X(i)} y={Y}>{i < M ? re[i] : ''}</text>
          <text class="nd-num" x={X(i) + R - 2} y={Y + R + 12}>{i}</text>
        </g>
      ))}
    </svg>
  </div>

  {mode === 'build' ? (
    <div class="nd-ops">
      <span class="nd-ops-label">{t.stack}</span>
      <span class="nd-ops-cells" data-nd-ops></span>
    </div>
  ) : (
    <div class="nd-tape">
      {[...text].map((c, i) => (
        <span class="nd-cell" data-nd-cell={i}>{c}</span>
      ))}
    </div>
  )}

  <div class="nd-foot">
    <p class="nd-note" data-nd-note></p>
    <span class="nd-count">
      {mode === 'build' ? t.epsPre : t.setSize}<strong data-nd-count>0</strong>{mode === 'build' ? t.epsPost : t.setPost}
    </span>
  </div>
</div>

<script is:inline define:vars={{ id }}>
  (() => {
    const root = document.getElementById(id);
    if (!root) return;

    /* 설명은 문장마다 줄을 바꾼다. 마침표 뒤 공백, 또는 중국어 마침표 뒤에서 끊는다. */
    const setLines = (node, text) => {
      const parts = String(text).split(/(?<=[.!?])\s+(?=\S)|(?<=[。！？])(?=\S)/);
      node.replaceChildren(...parts.flatMap((s, i) => (i ? [document.createElement('br'), s] : [s])));
    };

    const re = root.dataset.ndRe;
    const M = re.length;
    const eps = JSON.parse(root.dataset.ndEps);
    const input = [...root.dataset.ndText];
    const S = JSON.parse(root.dataset.ndStrings);
    const fill = (tpl, vars) => tpl.replace(/\{(\w+)\}/g, (_, key) => vars[key]);
    const isLiteral = (c) => !'()*|'.includes(c);
    const show = (set) => `{${[...set].sort((a, b) => a - b).join(' ')}}`;

    /* Closure: set에서 ε 전이만 따라 갈 수 있는 상태 전부 (DFS) */
    function closure(set) {
      const out = new Set();
      const dfs = (v) => {
        out.add(v);
        for (const [a, b] of eps) if (a === v && !out.has(b)) dfs(b);
      };
      for (let v = 0; v <= M; v++) if (set.has(v) && !out.has(v)) dfs(v);
      return out;
    }

    /* Recognizes를 실제로 돌려 단계 배열을 만든다. 글자마다 두 걸음(읽기, 닫힘). */
    function plan() {
      const steps = [];
      let pc = closure(new Set([0]));
      steps.push({ set: pc, pos: 0, phase: 'close', note: fill(S.start, { set: show(pc) }) });
      for (let k = 0; k < input.length; k++) {
        const c = input[k];
        const match = new Set();
        const from = [];
        for (let i = 0; i < M; i++) {
          if (pc.has(i) && isLiteral(re[i]) && (re[i] === c || re[i] === '.')) {
            match.add(i + 1);
            from.push(i);
          }
        }
        steps.push({
          set: match, pos: k + 1, phase: 'read', from,
          note: match.size ? fill(S.read, { c, set: show(match) }) : fill(S.dead, { c }),
        });
        pc = closure(match);
        steps.push({ set: pc, pos: k + 1, phase: 'close', note: fill(S.close, { set: show(pc) }) });
      }
      const ok = pc.has(M);
      steps.push({ set: pc, pos: input.length, phase: 'close', done: ok ? 'accept' : 'reject',
        note: fill(ok ? S.yes : S.no, { m: M }) });
      return steps;
    }

    /* build 모드: BuildNFA가 글자마다 한 일을 단계로 둔다. 마지막은 다 만든 상태 */
    const mode = root.dataset.ndMode;
    function planBuild() {
      const raw = JSON.parse(root.dataset.ndBuild);
      const out = raw.map((b) => {
        const i = b.i;
        const c = re[i];
        const v = { i, i1: i + 1, c, lp: b.lp };
        const parts = [];
        if (b.kind === 'open') parts.push(fill(S.bOpen, v));
        else if (b.kind === 'or') parts.push(fill(S.bOr, v));
        else if (b.kind === 'close') parts.push(fill(S.bClose, v));
        else if (b.kind === 'closeOr') {
          const or = b.popped[0];
          parts.push(fill(S.bCloseOr, { ...v, or }));
          parts.push(fill(S.bOrEdges, { ...v, or, or1: or + 1 }));
        } else if (b.kind === 'lit') parts.push(fill(S.bLit, v));
        else parts.push(fill(S.bStar, v));
        if (c === '(' || c === '*' || c === ')') parts.push(fill(S.bSym, v));
        if (b.starAdded.length) parts.push(fill(S.bStarAdd, v));
        const keys = [...b.added, ...b.starAdded].map(([a, w]) => `e${a}-${w}`);
        if (isLiteral(c)) keys.push(`m${i}`);
        return { ...b, parts, keys, nEps: b.added.length + b.starAdded.length };
      });
      const total = out.reduce((a, b) => a + b.nEps, 0);
      out.push({ done: true, ops: [], keys: [], nEps: 0, parts: [fill(S.bDone, { m: M, n: total })] });
      return out;
    }
    const steps = mode === 'build' ? planBuild() : plan();
    const states = [...root.querySelectorAll('[data-nd-state]')];
    const edges = [...root.querySelectorAll('[data-nd-edge]')];
    const cells = [...root.querySelectorAll('[data-nd-cell]')];
    const note = root.querySelector('[data-nd-note]');
    const countEl = root.querySelector('[data-nd-count]');

    /* 문장 묶음을 줄마다 나눠 넣는다. 묶음 안에서도 문장마다 줄을 바꾼다. */
    const setParts = (node, parts) => {
      node.replaceChildren();
      parts.forEach((p, k) => {
        const span = document.createElement('span');
        setLines(span, p);
        if (k) node.appendChild(document.createElement('br'));
        node.appendChild(span);
      });
    };
    const addedAt = {};
    if (mode === 'build') {
      steps.forEach((st, j) => st.keys.forEach((key) => {
        if (!(key in addedAt)) addedAt[key] = j;
      }));
    }
    const opsEl = root.querySelector('[data-nd-ops]');

    function renderBuild(s) {
      const step = s >= 0 ? steps[s] : null;
      const done = !!step && !!step.done;
      states.forEach((g) => {
        const i = Number(g.dataset.ndState);
        g.classList.toggle('is-from', !!step && !done && step.i === i);
        g.classList.toggle('is-stack', !!step && step.ops.includes(i));
      });
      edges.forEach((p) => {
        const at = addedAt[p.dataset.ndEdge];
        const later = !step || (!done && (at === undefined || at > s));
        const on = !!step && !done && at === s;
        p.classList.toggle('is-later', later);
        p.classList.toggle('is-on', on);
        p.setAttribute('marker-end', on ? p.dataset.ndOn : p.dataset.ndOff);
      });
      opsEl.replaceChildren(...(step ? step.ops : []).map((i) => {
        const cell = document.createElement('span');
        cell.className = 'nd-op';
        const ch = document.createElement('b');
        ch.textContent = re[i];
        const num = document.createElement('small');
        num.textContent = String(i);
        cell.append(ch, num);
        return cell;
      }));
      let n = 0;
      for (let j = 0; j <= s && j < steps.length; j++) n += steps[j].nEps;
      countEl.textContent = String(n);
      if (step) setParts(note, step.parts);
      else setLines(note, fill(S.bIdle, { r: re }));
      root.classList.toggle('is-done', done);
    }

    function render(s) {
      if (mode === 'build') return renderBuild(s);
      const step = s >= 0 ? steps[s] : null;
      const set = step ? step.set : new Set();
      states.forEach((g) => {
        const i = Number(g.dataset.ndState);
        g.classList.toggle('is-in', set.has(i));
        g.classList.toggle('is-from', !!step && step.phase === 'read' && step.from.includes(i));
        g.classList.toggle('is-yes', !!step && step.done === 'accept' && i === M);
        g.classList.toggle('is-no', !!step && step.done === 'reject' && i === M);
      });
      edges.forEach((p) => {
        const key = p.dataset.ndEdge;
        let on = false;
        if (step && step.phase === 'read') {
          on = key[0] === 'm' && step.from.includes(Number(key.slice(1)));
        } else if (step && !step.done && key[0] === 'e') {
          const [a, b] = key.slice(1).split('-').map(Number);
          on = set.has(a) && set.has(b);
        }
        p.classList.toggle('is-on', on);
        p.setAttribute('marker-end', on ? p.dataset.ndOn : p.dataset.ndOff);
      });
      const pos = step ? step.pos : 0;
      const reading = !!step && step.phase === 'read';
      cells.forEach((cell, i) => {
        cell.classList.toggle('is-read', !!step && i < pos && !(reading && i === pos - 1));
        cell.classList.toggle('is-now', reading && i === pos - 1);
      });
      countEl.textContent = String(set.size);
      setLines(note, step ? step.note
        : fill(S.idle, { r: root.dataset.ndRegex, t: input.join(''), m: M }));
      root.classList.toggle('is-done', !!(step && step.done));
    }

    let at = -1;
    let timer = null;
    const playBtn = root.querySelector('[data-act="play"]');

    function stop() {
      if (timer) clearInterval(timer);
      timer = null;
      playBtn.textContent = S.play;
    }

    function step() {
      if (at >= steps.length - 1) return stop();
      at += 1;
      render(at);
      if (at >= steps.length - 1) stop();
    }

    root.querySelector('[data-act="back"]').addEventListener('click', () => {
      stop();
      if (at > -1) at -= 1;
      render(at);
    });
    root.querySelector('[data-act="step"]').addEventListener('click', () => {
      stop();
      step();
    });
    root.querySelector('[data-act="reset"]').addEventListener('click', () => {
      stop();
      at = -1;
      render(-1);
    });
    playBtn.addEventListener('click', () => {
      if (timer) return stop();
      if (at >= steps.length - 1) {
        at = -1;
        render(-1);
      }
      playBtn.textContent = S.stop;
      timer = setInterval(step, 1100);
    });

    render(-1);
  })();
</script>

