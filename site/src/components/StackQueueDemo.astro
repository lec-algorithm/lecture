---
// 스택과 큐에 직접 넣고 꺼내 보는 데모.
//
// 왼쪽은 위가 열린 통(스택)이라 넣는 곳과 꺼내는 곳이 같은 맨 위다.
// 오른쪽은 양쪽이 열린 관(큐)이라 뒤로 넣고 앞에서 꺼낸다. 버튼마다 한 번씩
// 동작하고, 아래에 넣은 순서와 꺼낸 순서를 적는다. 넣을 글자는 A, B, C, ...
// 순서로 정해진다. 자동 재생은 둘 다 비운 뒤 A B C D를 넣고 모두 꺼낸다.
// 결과는 07_stack_queue의 첫 네 줄(pop D C B A, dequeue A B C D)과 같다.
import { defaultLang } from 'stack-site-builder/i18n/ui';

interface Props {
  /** 통과 관에 들어가는 최대 개수 */
  capacity?: number;
  /** 슬라이드용: 바깥 여백은 줄이고 글자와 칸은 키운다. */
  slide?: boolean;
}
const { capacity = 5, slide = false } = Astro.props;
const id = `sq-${Math.random().toString(36).slice(2, 9)}`;

const STRINGS: Record<string, Record<string, string>> = {
  ko: {
    title: '스택과 큐',
    play: '자동 재생',
    stop: '멈춤',
    reset: '처음으로',
    stack: '스택 · LIFO',
    queue: '큐 · FIFO',
    top: '위',
    front: '앞',
    rear: '뒤',
    inLabel: '넣은 순서',
    outLabel: '꺼낸 순서',
    idle: '버튼을 눌러 넣고 꺼내 보세요. 자동 재생은 둘 다에 A B C D를 넣은 뒤 모두 꺼냅니다.',
    push: 'push {x}: 스택의 맨 위에 올렸습니다.',
    pop: 'pop → {x}: 맨 위에 있던, 가장 나중에 넣은 것이 나왔습니다.',
    enqueue: 'enqueue {x}: 큐의 맨 뒤에 섰습니다.',
    dequeue: 'dequeue → {x}: 맨 앞에 있던, 가장 먼저 넣은 것이 나왔습니다.',
    done: '둘 다 {in} 순서로 넣었습니다. 스택에서는 {s}, 큐에서는 {q} 순서로 나왔습니다.',
  },
  en: {
    title: 'Stack and queue',
    play: 'Play',
    stop: 'Pause',
    reset: 'Reset',
    stack: 'stack · LIFO',
    queue: 'queue · FIFO',
    top: 'top',
    front: 'front',
    rear: 'rear',
    inLabel: 'in',
    outLabel: 'out',
    idle: 'Press the buttons to put items in and take them out. Play puts A B C D into both and then takes everything out.',
    push: 'push {x}: placed on top of the stack.',
    pop: 'pop → {x}: the item on top, the one put in last, comes out.',
    enqueue: 'enqueue {x}: joined the rear of the queue.',
    dequeue: 'dequeue → {x}: the item at the front, the one put in first, comes out.',
    done: 'Both got {in} in that order. The stack gave back {s}, the queue {q}.',
  },
  zh: {
    title: '栈和队列',
    play: '播放',
    stop: '暂停',
    reset: '重置',
    stack: '栈 · LIFO',
    queue: '队列 · FIFO',
    top: '顶',
    front: '队头',
    rear: '队尾',
    inLabel: '放入顺序',
    outLabel: '取出顺序',
    idle: '按按钮放入、取出试试。播放会先向两者放入 A B C D，再全部取出。',
    push: 'push {x}：放到栈顶。',
    pop: 'pop → {x}：取出栈顶，也就是最后放入的那个。',
    enqueue: 'enqueue {x}：排到队尾。',
    dequeue: 'dequeue → {x}：取出队头，也就是最先放入的那个。',
    done: '两者都按 {in} 的顺序放入。栈的取出顺序是 {s}，队列是 {q}。',
  },
};
const lang = Astro.currentLocale ?? defaultLang;
const t = STRINGS[lang] ?? STRINGS[defaultLang] ?? STRINGS.ko;
---

<div
  class:list={['aas-stack-queue-demo', slide && 'is-slide']}
  id={id}
  data-sq-cap={capacity}
  data-sq-strings={JSON.stringify(t)}
  style={`--sq-cap: ${capacity}`}
>
  <div class="sq-bar">
    <span class="sq-head"><strong>{t.title}</strong></span>
    <div class="sq-controls">
      <button type="button" data-act="play" class="sq-btn sq-btn-primary">{t.play}</button>
      <button type="button" data-act="reset" class="sq-btn">{t.reset}</button>
    </div>
  </div>

  <div class="sq-body">
    <section class="sq-panel" data-sq-kind="stack">
      <div class="sq-ops">
        <span class="sq-title">{t.stack}</span>
        <button type="button" class="sq-btn" data-sq-op="in">push <span data-sq-next></span></button>
        <button type="button" class="sq-btn" data-sq-op="out">pop</button>
      </div>
      <div class="sq-main sq-main-row">
        <div class="sq-stage">
          <span class="sq-mark sq-mark-top">{t.top} ↕</span>
          <div class="sq-tube" data-sq-box></div>
        </div>
        <dl class="sq-log">
          <dt>{t.inLabel}</dt><dd data-sq-in>-</dd>
          <dt>{t.outLabel}</dt><dd data-sq-out>-</dd>
        </dl>
      </div>
    </section>

    <section class="sq-panel" data-sq-kind="queue">
      <div class="sq-ops">
        <span class="sq-title">{t.queue}</span>
        <button type="button" class="sq-btn" data-sq-op="in">enqueue <span data-sq-next></span></button>
        <button type="button" class="sq-btn" data-sq-op="out">dequeue</button>
      </div>
      <div class="sq-main">
        <div class="sq-stage">
          <div class="sq-pipe-wrap">
            <span class="sq-mark">← {t.front}</span>
            <div class="sq-pipe" data-sq-box></div>
            <span class="sq-mark">{t.rear} ←</span>
          </div>
        </div>
        <dl class="sq-log">
          <dt>{t.inLabel}</dt><dd data-sq-in>-</dd>
          <dt>{t.outLabel}</dt><dd data-sq-out>-</dd>
        </dl>
      </div>
    </section>
  </div>

  <p class="sq-note" data-sq-note></p>
</div>

<script is:inline define:vars={{ id }}>
  (() => {
    const root = document.getElementById(id);
    if (!root) return;

    /* 설명은 문장마다 줄을 바꾼다. 마침표 뒤 공백, 또는 중국어 마침표 뒤에서 끊는다. */
    const setLines = (node, text) => {
      const parts = String(text).split(/(?<=[.!?])\s+(?=\S)|(?<=[。！？])(?=\S)/);
      node.replaceChildren(...parts.flatMap((s, i) => (i ? [document.createElement('br'), s] : [s])));
    };

    const S = JSON.parse(root.dataset.sqStrings);
    const fill = (tpl, vars) => tpl.replace(/\{(\w+)\}/g, (_, key) => vars[key]);
    const cap = Number(root.dataset.sqCap);
    const LETTERS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
    const note = root.querySelector('[data-sq-note]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* 스택과 큐는 같은 모양의 상태를 갖는다. 다른 것은 꺼내는 쪽뿐이다.
       stack: items의 끝이 맨 위, 끝에서 꺼낸다. queue: items의 앞이 맨 앞, 앞에서 꺼낸다. */
    function makeBox(kind) {
      const panel = root.querySelector(`[data-sq-kind="${kind}"]`);
      const box = panel.querySelector('[data-sq-box]');
      const btnIn = panel.querySelector('[data-sq-op="in"]');
      const btnOut = panel.querySelector('[data-sq-op="out"]');
      const nextEl = panel.querySelector('[data-sq-next]');
      const inEl = panel.querySelector('[data-sq-in]');
      const outEl = panel.querySelector('[data-sq-out]');
      const st = { items: [], els: new Map(), next: 0, log: [], out: [] };

      const place = () => {
        st.items.forEach((x, k) => st.els.get(x).style.setProperty('--sq-slot', String(k)));
      };
      const sync = () => {
        nextEl.textContent = st.next < LETTERS.length ? LETTERS[st.next] : '';
        btnIn.disabled = st.items.length >= cap || st.next >= LETTERS.length;
        btnOut.disabled = st.items.length === 0;
        inEl.textContent = st.log.length ? st.log.join(' ') : '-';
        outEl.textContent = st.out.length ? st.out.join(' ') : '-';
      };
      const put = () => {
        if (st.items.length >= cap || st.next >= LETTERS.length) return null;
        const x = LETTERS[st.next++];
        const el = document.createElement('span');
        el.className = 'sq-item is-entering';
        el.textContent = x;
        el.style.setProperty('--sq-slot', String(st.items.length));
        box.appendChild(el);
        st.items.push(x);
        st.els.set(x, el);
        st.log.push(x);
        /* 들어오는 자리에서 한 프레임 쉬었다가 제자리로 옮겨 전환이 보이게 한다. */
        if (reduce) el.classList.remove('is-entering');
        else requestAnimationFrame(() => requestAnimationFrame(() => el.classList.remove('is-entering')));
        place();
        sync();
        return x;
      };
      const take = () => {
        if (!st.items.length) return null;
        const x = kind === 'stack' ? st.items.pop() : st.items.shift();
        const el = st.els.get(x);
        st.els.delete(x);
        st.out.push(x);
        el.classList.add('is-leaving');
        setTimeout(() => el.remove(), reduce ? 0 : 450);
        place();
        sync();
        return x;
      };
      const clear = () => {
        st.items = [];
        st.els.clear();
        st.next = 0;
        st.log = [];
        st.out = [];
        box.replaceChildren();
        sync();
      };
      sync();
      return { btnIn, btnOut, put, take, clear, st };
    }

    const stack = makeBox('stack');
    const queue = makeBox('queue');
    const playBtn = root.querySelector('[data-act="play"]');
    let timer = null;

    function stop() {
      if (timer) clearInterval(timer);
      timer = null;
      playBtn.textContent = S.play;
    }

    stack.btnIn.addEventListener('click', () => { stop(); const x = stack.put(); if (x) setLines(note, fill(S.push, { x })); });
    stack.btnOut.addEventListener('click', () => { stop(); const x = stack.take(); if (x) setLines(note, fill(S.pop, { x })); });
    queue.btnIn.addEventListener('click', () => { stop(); const x = queue.put(); if (x) setLines(note, fill(S.enqueue, { x })); });
    queue.btnOut.addEventListener('click', () => { stop(); const x = queue.take(); if (x) setLines(note, fill(S.dequeue, { x })); });

    function reset() {
      stop();
      stack.clear();
      queue.clear();
      setLines(note, S.idle);
    }
    root.querySelector('[data-act="reset"]').addEventListener('click', reset);

    /* 자동 재생: 둘 다 비우고, 넣기 넷과 꺼내기 넷을 한 박자에 하나씩 */
    playBtn.addEventListener('click', () => {
      if (timer) return stop();
      reset();
      const script = ['in', 'in', 'in', 'in', 'out', 'out', 'out', 'out'];
      let k = 0;
      playBtn.textContent = S.stop;
      const tick = () => {
        if (k >= script.length) {
          stop();
          setLines(note, fill(S.done, { in: stack.st.log.join(' '), s: stack.st.out.join(' '), q: queue.st.out.join(' ') }));
          return;
        }
        if (script[k] === 'in') {
          const x = stack.put();
          queue.put();
          setLines(note, `${fill(S.push, { x })} ${fill(S.enqueue, { x })}`);
        } else {
          const a = stack.take();
          const b = queue.take();
          setLines(note, `${fill(S.pop, { x: a })} ${fill(S.dequeue, { x: b })}`);
        }
        k += 1;
      };
      tick();
      timer = setInterval(tick, 1100);
    });

    setLines(note, S.idle);
  })();
</script>

<style is:global>
  .aas-stack-queue-demo {
    /* 안쪽 치수는 모두 이 값에 대한 em이다. 슬라이드는 font-size만 키운다. */
    --sq-item-w: 2.2em;
    --sq-item-h: 1.35em;
    --sq-row: 1.45em;
    --sq-col: 2.45em;
    font-size: 1rem;
    margin: 1.5rem 0;
    padding: 1em;
    border: 1px solid var(--aas-border);
    border-radius: 0.9em;
    background: var(--aas-panel);
  }
  .aas-stack-queue-demo .sq-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75em;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.6em;
  }
  .aas-stack-queue-demo .sq-head {
    font-size: 0.95em;
  }
  .aas-stack-queue-demo .sq-controls,
  .aas-stack-queue-demo .sq-ops {
    display: flex;
    gap: 0.5em;
    align-items: center;
  }
  .aas-stack-queue-demo .sq-btn {
    padding: 0.35em 0.8em;
    font-size: 0.85em;
    border: 1px solid var(--aas-border);
    border-radius: 0.5em;
    background: var(--aas-bg);
    color: var(--aas-text);
    cursor: pointer;
  }
  .aas-stack-queue-demo .sq-ops .sq-btn {
    font-family: var(--aas-mono, monospace);
  }
  .aas-stack-queue-demo .sq-btn:hover:not(:disabled) {
    border-color: var(--aas-accent);
  }
  .aas-stack-queue-demo .sq-btn:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .aas-stack-queue-demo .sq-btn-primary {
    background: var(--aas-accent);
    border-color: var(--aas-accent);
    color: #fff;
  }

  .aas-stack-queue-demo .sq-body {
    display: flex;
    flex-wrap: wrap;
    gap: 1em 3em;
    justify-content: center;
    align-items: stretch;
  }
  .aas-stack-queue-demo .sq-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5em;
  }
  .aas-stack-queue-demo .sq-title {
    margin-right: 0.3em;
    font-weight: 700;
    font-size: 0.9em;
    white-space: nowrap;
  }
  /* 스택은 통이 길쭉해 기록을 옆에, 큐는 관이 납작해 기록을 아래에 둔다. */
  .aas-stack-queue-demo .sq-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 0.6em;
  }
  .aas-stack-queue-demo .sq-main-row {
    flex-direction: row;
    align-items: flex-end;
    gap: 1.2em;
  }
  .aas-stack-queue-demo .sq-stage {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding-top: 0.3em;
  }
  .aas-stack-queue-demo .sq-mark {
    font-size: 0.75em;
    color: var(--aas-muted);
    white-space: nowrap;
  }
  .aas-stack-queue-demo .sq-mark-top {
    margin-bottom: 0.3em;
  }
  /* 스택: 위가 열린 통. 칸 0이 바닥이다. */
  .aas-stack-queue-demo .sq-tube {
    position: relative;
    width: calc(var(--sq-item-w) + 0.8em);
    height: calc(var(--sq-cap) * var(--sq-row) + 0.3em);
    border: 2px solid var(--aas-muted);
    border-top: none;
    border-radius: 0 0 0.5em 0.5em;
  }
  .aas-stack-queue-demo .sq-tube .sq-item {
    left: 0.4em;
    top: calc((var(--sq-cap) - 1 - var(--sq-slot)) * var(--sq-row) + 0.15em);
  }
  .aas-stack-queue-demo .sq-tube .sq-item.is-entering,
  .aas-stack-queue-demo .sq-tube .sq-item.is-leaving {
    top: calc(-1.6 * var(--sq-row));
    opacity: 0;
  }
  /* 큐: 양쪽이 열린 관. 칸 0이 맨 앞(왼쪽)이다. */
  .aas-stack-queue-demo .sq-pipe-wrap {
    display: flex;
    align-items: center;
    gap: 0.5em;
  }
  .aas-stack-queue-demo .sq-pipe {
    position: relative;
    width: calc(var(--sq-cap) * var(--sq-col) + 0.3em);
    height: calc(var(--sq-item-h) + 0.6em);
    border-top: 2px solid var(--aas-muted);
    border-bottom: 2px solid var(--aas-muted);
  }
  .aas-stack-queue-demo .sq-pipe .sq-item {
    top: 0.3em;
    left: calc(var(--sq-slot) * var(--sq-col) + 0.15em + (var(--sq-col) - var(--sq-item-w)) / 2);
  }
  .aas-stack-queue-demo .sq-pipe .sq-item.is-entering {
    left: calc(var(--sq-cap) * var(--sq-col) + 1em);
    opacity: 0;
  }
  .aas-stack-queue-demo .sq-pipe .sq-item.is-leaving {
    left: calc(-1 * var(--sq-col) - 1em);
    opacity: 0;
  }
  .aas-stack-queue-demo .sq-item {
    position: absolute;
    width: var(--sq-item-w);
    height: var(--sq-item-h);
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1.5px solid var(--aas-role-model);
    border-radius: 0.35em;
    background: var(--aas-bg);
    font-family: var(--aas-mono, monospace);
    font-weight: 700;
    color: var(--aas-text);
    transition:
      top 0.4s cubic-bezier(0.65, 0, 0.35, 1),
      left 0.4s cubic-bezier(0.65, 0, 0.35, 1),
      opacity 0.4s;
  }
  .aas-stack-queue-demo .sq-log {
    display: grid;
    grid-template-columns: auto auto;
    gap: 0.15em 0.6em;
    margin: 0.3em 0 0;
    font-size: 0.85em;
  }
  .aas-stack-queue-demo .sq-log dt {
    color: var(--aas-muted);
    text-align: right;
  }
  .aas-stack-queue-demo .sq-log dd {
    margin: 0;
    font-family: var(--aas-mono, monospace);
    font-weight: 700;
    min-width: 8em;
  }
  .aas-stack-queue-demo .sq-note {
    margin: 0.8em 0 0;
    font-size: 0.85em;
    color: var(--aas-muted);
    min-height: 2.4em;
  }

  .aas-stack-queue-demo.is-slide {
    font-size: clamp(1rem, 3.2vh, 2.1rem);
    margin: 0.5rem 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .aas-stack-queue-demo .sq-item {
      transition: none;
    }
  }
</style>
