---
// 같은 일(base62 encode/decode)을 채팅과 에이전트 두 방식으로 하는 과정을 나란히
// 한 줄씩 진행하는 데모. 과제2 1단계에서 쓴다.
//
// 결과는 둘 다 "테스트 통과"로 같다. 데모가 세는 것은 과정이다.
//  - 요청: AI에게 보낸 횟수(무료 한도가 줄어드는 단위)
//  - 옮기기: 내가 손으로 복사·붙여넣기·실행한 것
//  - 확인: 내가 읽고 판단한 것
//  - AI: AI가 한 것
// 채팅은 내 손이 바쁘고, 에이전트는 내 일이 "옮기기"에서 "확인"으로 바뀐다.
import { defaultLang } from 'stack-site-builder/i18n/ui';

interface Props {
  /** 슬라이드용: 글자와 칸을 키운다. */
  slide?: boolean;
}
const { slide = false } = Astro.props;
const id = `al-${Math.random().toString(36).slice(2, 9)}`;

type Row = { k: 'ask' | 'move' | 'check' | 'ai'; t: string; r?: 'fail' | 'pass' };

const STRINGS: Record<string, any> = {
