---
// 키를 직접 쳐서 트라이의 의사코드를 한 줄씩 돌려 보는 데모.
//
// 탭으로 삽입·검색·접두사·삭제를 고르고 키를 치면, 그 입력으로 실제 절차를 돌려 단계를
// 만든다. 한 걸음마다 지금 줄을 칠하고, 변수(i, index, current)와 지금 노드의 링크 배열,
// 키의 글자 띠, 트라이에 든 키 표를 함께 보인다. 끝까지 돌린 삽입과 삭제만 트라이에
// 남는다. 처음 트라이는 실습 코드의 여섯 키이고(접두사와 삭제는 실습 코드처럼 shore=7을
// 더한다), 비우면 빈 트라이에서 시작한다.
//
// 의사코드는 algorithm-code의 topic-10-trie/01_trie/trie.pseudo와 같다.
import { defaultLang } from 'stack-site-builder/i18n/ui';
import algos from './trieAlgos.js?raw';
import TrieKeyTable from './TrieKeyTable.astro';
import TrieKeyTape from './TrieKeyTape.astro';
import TrieLinkStrip from './TrieLinkStrip.astro';

type Op = 'insert' | 'search' | 'prefix' | 'delete';
interface Props {
  /** 처음 고른 연산 */
  op?: Op;
  /** 처음 칠 키 */
  word?: string;
  /** 슬라이드용: 바깥 여백은 줄이고 글자와 칸은 키운다. */
  slide?: boolean;
}
const { op = 'insert', word, slide = false } = Astro.props;
const id = `tw-${Math.random().toString(36).slice(2, 9)}`;

const WORDS: [string, number][] = [
  ['by', 4],
  ['sea', 2],
  ['sells', 1],
  ['she', 0],
  ['shells', 3],
  ['the', 5],
];
const SAMPLES: Record<Op, string[]> = {
  insert: ['shore', 'she', 'sell', 'bye'],
  search: ['shells', 'shell', 'she', 'shore'],
  prefix: ['sh', 'se', 't', 'shx'],
  delete: ['shells', 'she', 'by', 'shell'],
};

const CODE_COMMON = {
  insert: [
    'ALGORITHM Insert(root, word, value)',
    '    current <- root',
    '    for i <- 0 to length(word)-1 do',
    "        index <- word[i] - 'a'",
    '        if current.children[index] = NULL then',
    '            current.children[index] <- CreateTrieNode()',
    '        current <- current.children[index]',
    '    current.hasValue <- true',
    '    current.value <- value',
  ],
  search: [
    'ALGORITHM Search(root, word)',
    '    current <- root',
    '    for i <- 0 to length(word)-1 do',
    "        index <- word[i] - 'a'",
    '        if current.children[index] = NULL then',
    '            return -1',
    '        current <- current.children[index]',
    '    if current.hasValue then',
    '        return current.value',
    '    return -1',
  ],
};
const prefixCode = (empty: string, add: string) => [
  'ALGORITHM GetWordsWithPrefix(root, prefix)',
  '    current <- root',
  '    for i <- 0 to length(prefix)-1 do',
  "        index <- prefix[i] - 'a'",
  `        if current.children[index] = NULL then return ${empty}`,
  '        current <- current.children[index]',
  '    GetAllWordsHelper(current, prefix, results)',
  'ALGORITHM GetAllWordsHelper(node, prefix, results)',
  '    if node = NULL then return',
  `    if node.hasValue then ${add}`,
  '    for i <- 0 to 25 do',
  '        if node.children[i] != NULL then',
  "            GetAllWordsHelper(node.children[i], prefix + ('a' + i), results)",
];
const deleteCode = (noKids: string, free: string) => [
  'ALGORITHM DeleteHelper(node, word, index)',
  '    if index = length(word) then',
  '        if not node.hasValue then return false',
  '        node.hasValue <- false',
  `        return ${noKids}`,
  "    child <- node.children[word[index] - 'a']",
  '    if child = NULL then return false',
  '    if DeleteHelper(child, word, index + 1) then',
  `        ${free}`,
  `        return (not node.hasValue) and ${noKids}`,
  '    return false',
];
const CODE: Record<string, Record<string, string[]>> = {
  ko: {
    ...CODE_COMMON,
    prefix: prefixCode('빈 목록', 'results에 (prefix, node.value) 추가'),
    delete: deleteCode('node에 자식이 하나도 없는가', 'child를 해제하고 그 링크를 NULL로'),
  },
  en: {
    ...CODE_COMMON,
    prefix: prefixCode('empty list', 'append (prefix, node.value) to results'),
    delete: deleteCode('node has no children at all', 'free child and set that link to NULL'),
  },
  zh: {
    ...CODE_COMMON,
    prefix: prefixCode('空列表', '把 (prefix, node.value) 加入 results'),
    delete: deleteCode('node 是否一个子节点也没有', '释放 child，把那个链接设为 NULL'),
  },
};

