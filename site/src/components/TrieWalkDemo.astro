const lang = Astro.currentLocale ?? defaultLang;
const t = STRINGS[lang] ?? STRINGS[defaultLang] ?? STRINGS.ko;
const code = CODE[lang] ?? CODE.ko;
const ops: Op[] = ['insert', 'search', 'prefix', 'delete'];
const start: [string, number][] = op === 'prefix' || op === 'delete' ? [...WORDS, ['shore', 7]] : WORDS;
const config = { op, word: word ?? SAMPLES[op][0], words: start, samples: SAMPLES, code };
---

<script is:inline set:html={algos} />
<div class:list={['aas-trie-walk-demo', slide && 'is-slide']} id={id} data-tw-config={JSON.stringify(config)} data-tw-strings={JSON.stringify(t)}>
  <div class="tw-bar">
    <div class="tw-tabs">
      <span class="tw-head"><strong>{t.title}</strong></span>
      {ops.map((o) => <button type="button" class="tw-tab" data-tw-op={o}>{t[o]}</button>)}
    </div>
    <div class="tw-controls">
      <button type="button" data-act="back" class="tw-btn">{t.back}</button>
      <button type="button" data-act="step" class="tw-btn">{t.step}</button>
      <button type="button" data-act="play" class="tw-btn tw-btn-primary">{t.play}</button>
      <button type="button" data-act="reset" class="tw-btn">{t.reset}</button>
    </div>
  </div>

  <div class="tw-inputs">
    <label class="tw-field"><span data-tw-wordlabel></span><input type="text" data-tw-word maxlength="10" autocomplete="off" spellcheck="false" /></label>
    <label class="tw-field" data-tw-valuebox>{t.valueLabel}<input type="text" inputmode="numeric" data-tw-value value="7" maxlength="3" autocomplete="off" /></label>
    <span class="tw-samples" data-tw-samples></span>
    <span class="tw-gap"></span>
    <button type="button" class="tw-tab" data-tw-keys="restore">{t.restore}</button>
    <button type="button" class="tw-tab" data-tw-keys="clear">{t.clear}</button>
  </div>

  <div class="tw-body">
    <div class="tw-left">
      <div class="tw-code" data-tw-code></div>
      <div class="tw-state">
        <TrieKeyTape />
        <span class="tw-vars" data-tw-vars></span>
      </div>
    </div>
    <div class="tw-right">
      <TrieKeyTable />
      <svg class="tw-svg" data-tw-svg role="img" aria-label={t.title}></svg>
    </div>
  </div>

  <TrieLinkStrip />

  <div class="tw-foot">
    <p class="tw-note" data-tw-note></p>
    <span class="tw-count" data-tw-count></span>
  </div>
</div>

<script is:inline define:vars={{ id }}>
  (() => {
    const root = document.getElementById(id);
    if (!root) return;

    /* 설명은 문장마다 줄을 바꾼다. 마침표 뒤 공백, 또는 중국어 마침표 뒤에서 끊는다. */
    const setLines = (node, text) => {
      const parts = String(text).split(/(?<=[.!?])\s+(?=\S)|(?<=[。！？])(?=\S)/);
      node.replaceChildren(...parts.flatMap((s, i) => (i ? [document.createElement('br'), s] : [s])));
    };
    /* 문장 잇기. 중국어 마침표 뒤에는 공백을 두지 않아야 setLines가 끊는다. */
    const join = (...parts) =>
      parts.filter(Boolean).reduce((a, b) => (/[。！？]$/.test(a) ? a + b : `${a} ${b}`), '');
    const fill = (tpl, vars) => tpl.replace(/\{(\w+)\}/g, (_, k) => vars[k]);
    const cfg = JSON.parse(root.dataset.twConfig);
    const S = JSON.parse(root.dataset.twStrings);
    const { buildTrie, trieInsert, layoutTrie } = globalThis.aasTrieAlgos;
    const R = 26;
    const MAX_KEYS = 10;

    /* 트라이에 남아 있는 키. 끝까지 돌린 삽입과 삭제만 여기에 반영한다. */
    let keys = new Map(cfg.words);
    let op = cfg.op;
    let word = cfg.word;
    let steps = [];
    let at = 0;
    let finalKeys = null;
    let timer = null;

    const clean = (raw) => raw.toLowerCase().replace(/[^a-z]/g, '');
    const parseValue = (raw) => {
      const v = parseInt(raw, 10);
      return Number.isFinite(v) && v >= 0 ? v : 0;
    };

    /* plan:start (의사코드와 같은 절차를 돌려 단계를 만든다) */
    function plan(theOp, w, value) {
      const out = [];
      const pairs = [...keys.entries()];
      const trie = buildTrie(pairs);
      /* 그림은 삽입 뒤의 트라이까지 담는 자리로 한 번 정한다. */
      const layoutT = buildTrie(pairs);
      if (theOp === 'insert' && w) trieInsert(layoutT, w, value);
      const present = new Set(trie.keys());
      const vals = {};
      for (const [nid, n] of trie) if (n.value !== null) vals[nid] = n.value;
      const nextKeys = new Map(keys);

      const kidsOf = (nid) => layoutT.get(nid).kids.filter((k) => present.has(k)).map((k) => layoutT.get(k).ch);
      const snapKeys = () => Object.entries(vals).sort(([a], [b]) => (a < b ? -1 : 1));
      const push = (o) =>
        out.push({
          present: [...present],
          values: { ...vals },
          keyList: snapKeys(),
          mark: {},
          vars: [],
          ...o,
        });
      const marks = (path, last, kind = 'cur') => {
        const m = {};
        path.forEach((n) => (m[n] = 'path'));
        m[last] = kind;
        return m;
      };

      if (!w) return { steps: [{ present: [...present], values: { ...vals }, keyList: snapKeys(), mark: {}, vars: [], lines: [], note: S.empty, nodeCount: present.size, visited: 0 }], layoutT, next: keys };

      if (theOp === 'insert') {
        if (!keys.has(w) && keys.size >= MAX_KEYS) {
          return { steps: [{ present: [...present], values: { ...vals }, keyList: snapKeys(), mark: {}, vars: [], lines: [], note: fill(S.full, { n: keys.size }), nodeCount: present.size, visited: 0 }], layoutT: buildTrie(pairs), next: keys };
        }
        let cur = '';
        const path = [];
        let made = 0;
        let passed = 0;
        const base = () => ({ keyNow: w });
        push({ ...base(), lines: [0, 1], mark: { '': 'cur' }, note: fill(S['insert.start'], { w, v: value }), vars: [['current', S.root]], tape: { w, i: 0 }, link: { node: '', kids: kidsOf('') } });
        [...w].forEach((c, i) => {
          const x = c.charCodeAt(0) - 97;
          const curName = cur === '' ? S.root : `"${cur}"`;
          const vars = [['i', i], ['word[i]', `'${c}'`], ['index', x], ['current', curName]];
          push({ ...base(), lines: [2, 3], mark: marks(path, cur), note: fill(S['insert.index'], { i, c, x }), vars, tape: { w, i }, link: { node: cur, kids: kidsOf(cur), look: c } });
          const next = cur + c;
          const has = present.has(next);
          push({ ...base(), lines: [4], mark: marks(path, cur), note: fill(S[has ? 'insert.linked' : 'insert.null'], { x }), vars, tape: { w, i }, link: { node: cur, kids: kidsOf(cur), look: c, miss: !has } });
          if (!has) {
            present.add(next);
            made += 1;
            push({ ...base(), lines: [5], mark: { ...marks(path, cur), [next]: 'new' }, note: fill(S['insert.make'], { c }), vars, tape: { w, i }, link: { node: cur, kids: kidsOf(cur), look: c }, nodeDelta: true });
          } else {
            passed += 1;
          }
          path.push(cur);
          cur = next;
          push({ ...base(), lines: [6], mark: marks(path, cur), note: fill(S['insert.move'], { c }), vars: [['i', i], ['word[i]', `'${c}'`], ['index', x], ['current', `"${cur}"`]], tape: { w, i }, link: { node: path[path.length - 1], kids: kidsOf(path[path.length - 1]), look: c } });
        });
        const vars = [['current', `"${cur}"`]];
        const old = vals[w];
        push({ ...base(), lines: [7], mark: marks(path, cur), note: S['insert.flag'], vars, tape: { w, i: w.length }, link: { node: cur, kids: kidsOf(cur) } });
        vals[w] = value;
        nextKeys.set(w, value);
        push({
          ...base(),
          lines: [8],
          mark: marks(path, cur, 'hit'),
          note: old === undefined ? fill(S['insert.value'], { v: value }) : fill(S['insert.replace'], { o: old, v: value }),
          vars,
          tape: { w, i: w.length },
          link: { node: cur, kids: kidsOf(cur) },
        });
        push({ ...base(), lines: [], mark: marks(path, cur, 'hit'), note: fill(S['insert.done'], { m: made, k: passed }), vars, tape: { w, i: w.length }, link: { node: cur, kids: kidsOf(cur) }, done: true });
        return { steps: out, layoutT, next: nextKeys };
      }

      if (theOp === 'search') {
        let cur = '';
        const path = [];
        const base = () => ({ keyNow: w });
        push({ ...base(), lines: [0, 1], mark: { '': 'cur' }, note: fill(S['search.start'], { w }), vars: [['current', S.root]], tape: { w, i: 0 }, link: { node: '', kids: kidsOf('') }, visited: 1 });
        for (let i = 0; i < w.length; i++) {
          const c = w[i];
          const x = c.charCodeAt(0) - 97;
          const curName = cur === '' ? S.root : `"${cur}"`;
          const vars = [['i', i], ['word[i]', `'${c}'`], ['index', x], ['current', curName]];
          const vis = path.length + 1;
          push({ ...base(), lines: [2, 3], mark: marks(path, cur), note: fill(S['search.index'], { i, c, x }), vars, tape: { w, i }, link: { node: cur, kids: kidsOf(cur), look: c }, visited: vis });
          const next = cur + c;
          if (!present.has(next)) {
            push({ ...base(), lines: [4], mark: marks(path, cur), note: fill(S['search.null'], { x }), vars, tape: { w, i, st: 'miss' }, link: { node: cur, kids: kidsOf(cur), look: c, miss: true }, visited: vis });
            push({ ...base(), lines: [5], mark: marks(path, cur, 'miss'), note: fill(S['search.null'], { x }), vars: [...vars, ['return', '-1']], tape: { w, i, st: 'miss' }, link: { node: cur, kids: kidsOf(cur), look: c, miss: true }, visited: vis, done: true });
            return { steps: out, layoutT, next: keys };
          }
          push({ ...base(), lines: [4], mark: marks(path, cur), note: fill(S['search.linked'], { x }), vars, tape: { w, i }, link: { node: cur, kids: kidsOf(cur), look: c }, visited: vis });
          path.push(cur);
          const from = cur;
          cur = next;
          push({ ...base(), lines: [6], mark: marks(path, cur), note: fill(S['search.move'], { c }), vars: [['i', i], ['word[i]', `'${c}'`], ['index', x], ['current', `"${cur}"`]], tape: { w, i }, link: { node: from, kids: kidsOf(from), look: c }, visited: path.length + 1 });
        }
        const vis = path.length + 1;
        const vars = [['current', `"${cur}"`], ['hasValue', vals[cur] !== undefined ? 'true' : 'false']];
        push({ ...base(), lines: [7], mark: marks(path, cur), note: S['search.check'], vars, tape: { w, i: w.length }, link: { node: cur, kids: kidsOf(cur) }, visited: vis });
        if (vals[cur] !== undefined) {
          push({ ...base(), lines: [8], mark: marks(path, cur, 'hit'), note: fill(S['search.hit'], { v: vals[cur] }), vars: [...vars, ['return', vals[cur]]], tape: { w, i: w.length - 1, st: 'hit' }, link: { node: cur, kids: kidsOf(cur) }, visited: vis, done: true });
        } else {
          push({ ...base(), lines: [9], mark: marks(path, cur, 'miss'), note: fill(S['search.noValue'], { w }), vars: [...vars, ['return', '-1']], tape: { w, i: w.length - 1, st: 'miss' }, link: { node: cur, kids: kidsOf(cur) }, visited: vis, done: true });
        }
        return { steps: out, layoutT, next: keys };
      }

      if (theOp === 'prefix') {
        let cur = '';
        const path = [];
        const results = [];
        const resVars = () => ['results', results.length ? results.join(' ') : '∅'];
        push({ lines: [0, 1], mark: { '': 'cur' }, note: fill(S['prefix.start'], { w }), vars: [['current', S.root]], tape: { w, i: 0 }, link: { node: '', kids: kidsOf('') }, visited: 1 });
        for (let i = 0; i < w.length; i++) {
          const c = w[i];
          const x = c.charCodeAt(0) - 97;
          const curName = cur === '' ? S.root : `"${cur}"`;
          const vars = [['i', i], ['prefix[i]', `'${c}'`], ['index', x], ['current', curName]];
          push({ lines: [2, 3], mark: marks(path, cur), note: fill(S['prefix.index'], { i, c, x }), vars, tape: { w, i }, link: { node: cur, kids: kidsOf(cur), look: c }, visited: path.length + 1 });
          const next = cur + c;
          if (!present.has(next)) {
            push({ lines: [4], mark: marks(path, cur, 'miss'), note: fill(S['prefix.null'], { x }), vars: [...vars, resVars()], tape: { w, i, st: 'miss' }, link: { node: cur, kids: kidsOf(cur), look: c, miss: true }, visited: path.length + 1, done: true });
            return { steps: out, layoutT, next: keys };
          }
          path.push(cur);
          const from = cur;
          cur = next;
          push({ lines: [4, 5], mark: marks(path, cur), note: fill(S['prefix.move'], { c }), vars, tape: { w, i }, link: { node: from, kids: kidsOf(from), look: c }, visited: path.length + 1 });
        }
        const top = path.length + 1;
        push({ lines: [6], mark: marks(path, cur), note: S['prefix.reach'], vars: [['current', `"${cur}"`], resVars()], tape: { w, i: w.length }, link: { node: cur, kids: kidsOf(cur) }, visited: top });
        const seen = {};
        const take = {};
        const mk = (nid) => {
          const m = marks(path, cur);
          Object.assign(m, seen, take);
          if (nid !== undefined && !take[nid]) m[nid] = 'cur';
          return m;
        };
        (function collect(nid) {
          const n = layoutT.get(nid);
          seen[nid] = 'seen';
          if (vals[nid] !== undefined) {
            take[nid] = 'take';
            results.push(nid);
            push({ lines: [7, 9], mark: mk(nid), note: fill(S['prefix.take'], { s: nid, v: vals[nid] }), vars: [['node', `"${nid}"`], resVars()], tape: { w, i: w.length }, link: { node: nid, kids: kidsOf(nid) }, visited: top, found: [...results] });
          } else {
            push({ lines: [7, 9], mark: mk(nid), note: fill(S['prefix.pass'], { s: nid }), vars: [['node', `"${nid}"`], resVars()], tape: { w, i: w.length }, link: { node: nid, kids: kidsOf(nid) }, visited: top, found: [...results] });
          }
          n.kids.forEach((k) => {
            const ch = layoutT.get(k).ch;
            push({ lines: [10, 11, 12], mark: mk(nid), note: fill(S['prefix.kid'], { c: ch, s: k }), vars: [['i', ch.charCodeAt(0) - 97], ['node', `"${nid}"`], resVars()], tape: { w, i: w.length }, link: { node: nid, kids: kidsOf(nid), look: ch }, visited: top, found: [...results] });
            collect(k);
          });
        })(cur);
        push({ lines: [], mark: mk(), note: fill(S['prefix.done'], { n: results.length, w }), vars: [resVars()], tape: { w, i: w.length }, link: { node: cur, kids: kidsOf(cur) }, visited: top, found: [...results], done: true });
        return { steps: out, layoutT, next: keys };
      }

      /* delete: 실습 코드의 deleteHelper를 그대로 돈다. */
      const before = present.size;
      let removed = 0;
      let foundKey = false;
      const stack = [];
      const name = (n) => (n === '' ? S.root : `"${n}"`);
      const dv = (n, i, more = []) => [['node', name(n)], ['index', i], ...more];
      const base = () => ({ keyNow: w });
      (function helper(nid, index) {
        stack.push(nid);
        const pathNow = stack.slice(0, -1);
        push({ ...base(), lines: [0], mark: marks(pathNow, nid), note: fill(S['delete.call'], { s: name(nid), i: index }), vars: dv(nid, index), tape: { w, i: index }, link: { node: nid, kids: kidsOf(nid) } });
        let ret;
        if (index === w.length) {
          push({ ...base(), lines: [1], mark: marks(pathNow, nid), note: S['delete.arrive'], vars: dv(nid, index), tape: { w, i: index }, link: { node: nid, kids: kidsOf(nid) } });
          if (vals[nid] === undefined) {
            push({ ...base(), lines: [2], mark: marks(pathNow, nid, 'miss'), note: fill(S['delete.noValue'], { w }), vars: dv(nid, index, [['return', 'false']]), tape: { w, i: w.length - 1, st: 'miss' }, link: { node: nid, kids: kidsOf(nid) } });
            ret = false;
          } else {
            foundKey = true;
            delete vals[nid];
            nextKeys.delete(w);
            push({ ...base(), lines: [3], mark: marks(pathNow, nid), note: S['delete.clear'], vars: dv(nid, index), tape: { w, i: index }, link: { node: nid, kids: kidsOf(nid) } });
            const k = kidsOf(nid).length;
            ret = k === 0;
            push({ ...base(), lines: [4], mark: marks(pathNow, nid), note: fill(S['delete.retKids'], { k, r: String(ret) }), vars: dv(nid, index, [['return', String(ret)]]), tape: { w, i: index }, link: { node: nid, kids: kidsOf(nid) } });
          }
        } else {
          const c = w[index];
          push({ ...base(), lines: [5], mark: marks(pathNow, nid), note: fill(S['delete.child'], { i: index, c }), vars: dv(nid, index), tape: { w, i: index }, link: { node: nid, kids: kidsOf(nid), look: c } });
          const child = nid + c;
          if (!present.has(child)) {
            push({ ...base(), lines: [6], mark: marks(pathNow, nid, 'miss'), note: fill(S['delete.noChild'], { c, w }), vars: dv(nid, index, [['return', 'false']]), tape: { w, i: index, st: 'miss' }, link: { node: nid, kids: kidsOf(nid), look: c, miss: true } });
            ret = false;
          } else {
            push({ ...base(), lines: [7], mark: marks(pathNow, nid), note: fill(S['delete.recurse'], { c }), vars: dv(nid, index), tape: { w, i: index }, link: { node: nid, kids: kidsOf(nid), look: c } });
            const sub = helper(child, index + 1);
            if (sub) {
              push({ ...base(), lines: [7], mark: { ...marks(pathNow, nid), [child]: 'del' }, note: fill(S['delete.back'], { s: name(nid), r: 'true' }), vars: dv(nid, index), tape: { w, i: index }, link: { node: nid, kids: kidsOf(nid), look: c } });
              present.delete(child);
              removed += 1;
              push({ ...base(), lines: [8], mark: marks(pathNow, nid), note: fill(S['delete.free'], { c }), vars: dv(nid, index), tape: { w, i: index }, link: { node: nid, kids: kidsOf(nid), look: c, miss: true } });
              const k = kidsOf(nid).length;
              const hv = vals[nid] !== undefined;
              ret = !hv && k === 0;
              push({ ...base(), lines: [9], mark: marks(pathNow, nid, ret ? 'cur' : 'keep'), note: fill(S['delete.retNode'], { hv: S[hv ? 'delete.yes' : 'delete.no'], k, r: String(ret) }), vars: dv(nid, index, [['return', String(ret)]]), tape: { w, i: index }, link: { node: nid, kids: kidsOf(nid) } });
            } else {
              push({ ...base(), lines: [7], mark: marks(pathNow, nid), note: fill(S['delete.back'], { s: name(nid), r: 'false' }), vars: dv(nid, index), tape: { w, i: index }, link: { node: nid, kids: kidsOf(nid), look: c } });
              ret = false;
              push({ ...base(), lines: [10], mark: marks(pathNow, nid), note: S['delete.retFalse'], vars: dv(nid, index, [['return', 'false']]), tape: { w, i: index }, link: { node: nid, kids: kidsOf(nid) } });
            }
          }
        }
        stack.pop();
        return ret;
      })('', 0);
      const doneNote = !foundKey ? fill(S['delete.none'], { w }) : removed === 0 ? S['delete.keep'] : fill(S['delete.done'], { n: removed, a: before, b: present.size });
      push({ lines: [], note: doneNote, vars: [], keyNow: w, done: true, link: { node: '', kids: kidsOf('') } });
      return { steps: out, layoutT, next: nextKeys };
    }
    /* plan:end */

    const NS = 'http://www.w3.org/2000/svg';
    const el = (name, attrs, text) => {
      const node = document.createElementNS(NS, name);
      for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, String(v));
      if (text !== undefined) node.textContent = text;
      return node;
    };
    const svg = root.querySelector('[data-tw-svg]');
    const codeBox = root.querySelector('[data-tw-code]');
    const varsBox = root.querySelector('[data-tw-vars]');
    const noteBox = root.querySelector('[data-tw-note]');
    const countBox = root.querySelector('[data-tw-count]');
    const wordInput = root.querySelector('[data-tw-word]');
    const valueInput = root.querySelector('[data-tw-value]');
    const valueBox = root.querySelector('[data-tw-valuebox]');
    const wordLabel = root.querySelector('[data-tw-wordlabel]');
    const samplesBox = root.querySelector('[data-tw-samples]');
    const keyList = root.querySelector('[data-tk-list]');
    const tapeBox = root.querySelector('[data-tape]');
    const linkCells = [...root.querySelectorAll('[data-ls]')];
    const linkName = root.querySelector('[data-ls-name]');
    const playBtn = root.querySelector('[data-act="play"]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let nodeEls = new Map();
    let edgeEls = new Map();
    function drawTree(t) {
      const UNIT = 44;
      const LEVEL = 44;
      const RAD = 15;
      const { pos, slots, depth } = layoutTrie(t, UNIT, LEVEL);
      const PAD = 30;
      const W = Math.max(1, slots - 1) * UNIT;
      svg.setAttribute('viewBox', `${-PAD} ${-RAD - 16} ${W + 2 * PAD} ${Math.max(depth, 3) * LEVEL + 2 * RAD + 24}`);
      svg.replaceChildren();
      const edges = el('g', {});
      const nodes = el('g', {});
      svg.append(edges, nodes);
      nodeEls = new Map();
      edgeEls = new Map();
      for (const [nid, n] of t) {
        const p = pos.get(nid);
        if (n.parent !== null) {
          const q = pos.get(n.parent);
          const line = el('line', { class: 'tw-edge', x1: q.x, y1: q.y, x2: p.x, y2: p.y });
          edges.appendChild(line);
          edgeEls.set(nid, line);
        }
        const g = el('g', { class: 'tw-nd', transform: `translate(${p.x} ${p.y})` });
        if (nid === '') {
          g.classList.add('is-root');
          g.append(el('circle', { r: RAD * 0.8 }), el('text', { class: 'tw-root', y: -RAD - 3 }, S.root));
        } else {
          g.append(el('circle', { r: RAD }), el('text', { class: 'tw-ch' }, n.ch), el('text', { class: 'tw-val', x: RAD + 3, y: RAD * 0.55 }));
        }
        nodes.appendChild(g);
        nodeEls.set(nid, g);
      }
    }

    const MARKS = ['path', 'cur', 'new', 'hit', 'miss', 'take', 'seen', 'del', 'keep'];
    function render() {
      const st = steps[at];
      const present = new Set(st.present);
      for (const [nid, g] of nodeEls) {
        const mark = st.mark[nid];
        g.classList.toggle('is-off', !present.has(nid));
        for (const m of MARKS) g.classList.toggle(`is-${m}`, mark === m);
        const vt = g.querySelector('.tw-val');
        if (vt) vt.textContent = st.values[nid] === undefined ? '' : String(st.values[nid]);
        const line = edgeEls.get(nid);
        if (line) {
          line.classList.toggle('is-off', !present.has(nid));
          line.classList.toggle('is-path', ['path', 'cur', 'hit', 'miss', 'del', 'keep'].includes(mark));
          line.classList.toggle('is-new', mark === 'new');
          line.classList.toggle('is-take', ['take', 'seen'].includes(mark));
        }
      }
      /* 코드: 지금 줄 칠하기 */
      [...codeBox.children].forEach((ln, i) => ln.classList.toggle('is-now', st.lines.includes(i)));
      varsBox.replaceChildren(
        ...st.vars.map(([k, v]) => {
          const s = document.createElement('span');
          s.append(`${k} = `, Object.assign(document.createElement('b'), { textContent: String(v) }));
          return s;
        }),
      );
      /* 글자 띠 */
      tapeBox.replaceChildren(
        ...(st.tape
          ? [...st.tape.w].map((c, i) => {
              const b = document.createElement('b');
              b.textContent = c;
              b.className = i < st.tape.i ? 'is-past' : i === st.tape.i ? `is-${st.tape.st || 'now'}` : '';
              return b;
            })
          : []),
      );
      /* 링크 배열 */
      const l = st.link;
      linkCells.forEach((c) => {
        const ch = c.dataset.ls;
        c.classList.toggle('is-on', !!l && l.kids.includes(ch));
        c.classList.toggle('is-now', !!l && l.look === ch && !l.miss);
        c.classList.toggle('is-miss', !!l && l.look === ch && !!l.miss);
      });
      linkName.textContent = !l ? '' : l.node === '' ? S.root : `"${l.node}"`;
      /* 든 키 */
      const list = st.keyList;
      keyList.replaceChildren(
        ...list.map(([w, v]) => {
          const cell = document.createElement('span');
          cell.className = 'tk-cell';
          cell.dataset.tkKey = w;
          cell.append(Object.assign(document.createElement('b'), { textContent: w }), Object.assign(document.createElement('i'), { textContent: String(v) }));
          if (w === st.keyNow) cell.classList.add('is-now');
          if (st.found && st.found.includes(w)) cell.classList.add('is-take');
          return cell;
        }),
      );
      setLines(noteBox, st.note);
      const nodes = present.size;
      countBox.replaceChildren();
      const pairs = [];
      if (st.visited !== undefined && op !== 'insert' && op !== 'delete') pairs.push([S.visited, st.visited]);
      pairs.push([S.nodes, nodes], [S.links, nodes * R]);
      pairs.forEach(([k, v], i) => {
        if (i) countBox.append(' · ');
        countBox.append(`${k} `, Object.assign(document.createElement('strong'), { textContent: String(v) }));
      });
    }

    function stop() {
      if (timer) clearInterval(timer);
      timer = null;
      playBtn.textContent = S.play;
    }
    /* 끝까지 돌린 삽입·삭제를 트라이에 남긴다. */
    function commit() {
      if (at === steps.length - 1 && finalKeys) keys = new Map(finalKeys);
    }
    function replan() {
      stop();
      commit();
      const p = plan(op, word, parseValue(valueInput.value));
      steps = p.steps;
      finalKeys = p.next;
      at = 0;
      drawTree(p.layoutT);
      render();
    }
    function setOp(o) {
      stop();
      commit();
      finalKeys = null;
      op = o;
      word = cfg.samples[o][0];
      wordInput.value = word;
      syncChrome();
      replan();
    }
    function syncChrome() {
      root.querySelectorAll('[data-tw-op]').forEach((b) => b.classList.toggle('is-on', b.dataset.twOp === op));
      wordLabel.textContent = op === 'prefix' ? S.prefixLabel : S.wordLabel;
      valueBox.style.visibility = op === 'insert' ? 'visible' : 'hidden';
      root.querySelector('.aas-key-tape .kt2-label').textContent = op === 'prefix' ? 'prefix' : 'word';
      codeBox.replaceChildren(
        ...cfg.code[op].map((ln) => Object.assign(document.createElement('div'), { className: 'tw-line', textContent: ln })),
      );
      samplesBox.replaceChildren(
        ...cfg.samples[op].map((s) => {
          const b = Object.assign(document.createElement('button'), { type: 'button', className: 'tw-sample', textContent: s });
          b.addEventListener('click', () => {
            wordInput.value = s;
            word = s;
            replan();
          });
          return b;
        }),
      );
    }
    function step() {
      if (at >= steps.length - 1) return stop();
      at += 1;
      render();
      if (at >= steps.length - 1) stop();
    }

    root.querySelectorAll('[data-tw-op]').forEach((b) => b.addEventListener('click', () => setOp(b.dataset.twOp)));
    root.querySelector('[data-act="back"]').addEventListener('click', () => {
      stop();
      if (at > 0) at -= 1;
      render();
    });
    root.querySelector('[data-act="step"]').addEventListener('click', () => {
      stop();
      step();
    });
    root.querySelector('[data-act="reset"]').addEventListener('click', () => {
      stop();
      at = 0;
      render();
    });
    playBtn.addEventListener('click', () => {
      if (timer) return stop();
      if (at >= steps.length - 1) {
        at = 0;
        render();
      }
      playBtn.textContent = S.stop;
      timer = setInterval(step, reduceMotion ? 1400 : 900);
    });
    wordInput.addEventListener('input', () => {
      const w = clean(wordInput.value);
      if (w !== wordInput.value) wordInput.value = w;
      word = w;
      replan();
    });
    valueInput.addEventListener('input', () => {
      if (op === 'insert') {
        const keep = at;
        const p = plan(op, word, parseValue(valueInput.value));
        steps = p.steps;
        finalKeys = p.next;
        at = Math.min(keep, steps.length - 1);
        render();
      }
    });
    root.querySelectorAll('[data-tw-keys]').forEach((b) =>
      b.addEventListener('click', () => {
        stop();
        finalKeys = null;
        keys = new Map(b.dataset.twKeys === 'restore' ? cfg.words : []);
        replan();
      }),
    );
    wordInput.value = word;
    syncChrome();
    replan();
  })();
</script>

