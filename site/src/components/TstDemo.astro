    'insert.less': '{c} < {d}：更小，往左。继续在同一个字符位置上找。',
    'insert.greater': '{c} > {d}：更大，往右。继续在同一个字符位置上找。',
    'insert.equal': '{c} = {d}：相等，沿中间往下，看下一个字符。',
