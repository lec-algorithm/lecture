    empty: '空链接',
    visited: '经过的节点',
    keys: '收集的键',
    none: 'NULL',
    'insert.idle': '从空 TST 开始，一个个插入键。',
    'insert.prefilled': '前 {n} 个键已经插好。接下来的键每比较一次走一步。',
    'insert.word': '{w} = {v}：与 {k} 个节点比较，挂上 {m} 个新节点。',
