    'insert.word': '{w} = {v}: 노드 {k}개와 비교하고 새 노드 {m}개를 답니다.',
    'insert.start': '{w} = {v}: 루트에서 첫 문자 {c}부터 비교합니다.',
    'insert.less': '{c} < {d}: 작으니 왼쪽으로 갑니다. 같은 자리의 문자를 계속 찾습니다.',
    'insert.greater': '{c} > {d}: 크니 오른쪽으로 갑니다. 같은 자리의 문자를 계속 찾습니다.',
