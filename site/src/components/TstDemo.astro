---
// TST(ternary search tree)를 한 걸음씩 보는 데모. 모드가 셋이다.
//
// - insert: 키를 넣는다. 기본은 한 걸음에 키 하나다. detail을 주면 비교 한 번이
//   한 걸음이 된다(prefill로 앞의 키 몇 개를 미리 넣어 두고 시작할 수 있다).
//   찾는 문자가 노드의 문자보다 작으면 왼쪽, 크면 오른쪽으로 같은 자리에서
//   옮겨 가고, 같으면 가운데로 내려가 다음 문자를 본다. 자리가 비어 있으면
//   남은 문자를 새 노드로 가운데에 줄줄이 단다.
// - search: 같은 규칙으로 내려간다. 마지막 문자의 노드에 값이 있으면 성공이다.
// - prefix: 접두사의 마지막 문자 노드까지 내려간 뒤, 그 노드의 가운데 아래를
//   왼쪽, 자기, 가운데, 오른쪽 순서로 돌며 키를 모은다(사전 순이 된다).
//
// 노드마다 링크 3개를 그린다. 비어 있는 링크는 짧은 가지 끝의 작은 점이다.
// 그림의 자리는 모든 키를 넣은 트리로 한 번 정하므로 단계가 바뀌어도 노드가
// 움직이지 않는다.
//
// 절차와 숫자는 algorithm-code의 topic-10-trie/02_tst와 같다.
import { defaultLang } from 'stack-site-builder/i18n/ui';

type Mode = 'insert' | 'search' | 'prefix';
interface Props {
  mode?: Mode;
  /** 넣을 키와 값. 기본은 실습 코드와 같다. */
  words?: [string, number][];
  /** insert 모드: 앞의 키 몇 개를 미리 넣어 두고 시작한다. */
  prefill?: number;
  /** insert 모드: 비교 한 번을 한 걸음으로 */
  detail?: boolean;
  /** search 모드에서 찾을 키 */
  queries?: string[];
  /** prefix 모드의 접두사 */
  prefix?: string;
  /** 슬라이드용: 글자와 칸을 키운다. */
  slide?: boolean;
}
const {
  mode = 'insert',
  words = [
    ['apple', 10],
    ['application', 20],
    ['apply', 30],
    ['applaud', 40],
    ['applet', 50],
    ['appliance', 60],
    ['applicable', 70],
  ],
  prefill = 0,
  detail = false,
  queries = ['applaud', 'apply', 'apples'],
  prefix = 'app',
  slide = false,
} = Astro.props;
const id = `ts-${Math.random().toString(36).slice(2, 9)}`;

const STRINGS: Record<string, Record<string, string>> = {
