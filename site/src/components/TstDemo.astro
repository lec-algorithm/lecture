  },
};
const lang = Astro.currentLocale ?? defaultLang;
const t = STRINGS[lang] ?? STRINGS[defaultLang] ?? STRINGS.ko;
const config = { mode, words, prefill, detail, queries, prefix, slide };
const chip =
  mode === 'search'
    ? queries.join(' · ')
    : mode === 'prefix'
      ? `"${prefix}"`
      : words.length - prefill > 3
        ? `${words[prefill][0]} … ${words[words.length - 1][0]}`
        : words.slice(prefill).map(([w]) => w).join(' ');
---

<div
  class:list={['aas-tst-demo', slide && 'is-slide']}
  id={id}
  data-ts-config={JSON.stringify(config)}
  data-ts-strings={JSON.stringify(t)}
>
  <div class="ts-bar">
    <span class="ts-head">
      <strong>{t[`title.${mode}`]}</strong>
      <span class="ts-chip">{chip}</span>
    </span>
    <div class="ts-controls">
      <button type="button" data-act="back" class="ts-btn">{t.back}</button>
      <button type="button" data-act="step" class="ts-btn">{t.step}</button>
      <button type="button" data-act="play" class="ts-btn ts-btn-primary">{t.play}</button>
      <button type="button" data-act="reset" class="ts-btn">{t.reset}</button>
    </div>
  </div>

  <div class="ts-body">
    <svg class="ts-svg" data-ts-svg role="img" aria-label={t[`title.${mode}`]}></svg>
    <table class="ts-table">
      <thead>
        <tr data-ts-head></tr>
      </thead>
      <tbody data-ts-rows></tbody>
    </table>
  </div>

  <div class="ts-foot">
    <p class="ts-note" data-ts-note></p>
    <span class="ts-count" data-ts-count></span>
  </div>
</div>

<script is:inline define:vars={{ id }}>
  (() => {
    const root = document.getElementById(id);
    if (!root) return;

    /* 설명은 문장마다 줄을 바꾼다. 마침표 뒤 공백, 또는 중국어 마침표 뒤에서 끊는다. */
    const setLines = (node, text) => {
      const parts = String(text).split(/(?<=[.!?])\s+(?=\S)|(?<=[。！？])(?=\S)/);
      node.replaceChildren(...parts.flatMap((s, i) => (i ? [document.createElement('br'), s] : [s])));
    };

    const cfg = JSON.parse(root.dataset.tsConfig);
    const S = JSON.parse(root.dataset.tsStrings);
    const fill = (tpl, vars) => tpl.replace(/\{(\w+)\}/g, (_, key) => vars[key]);

    /* plan:start (algorithm-code의 tst와 같은 절차를 돌려 단계를 만든다) */
    /* 노드 id는 루트에서 그 노드까지 간 방향(L·M·R)의 문자열이다. 루트는 ''. */
    function newTst() {
      return new Map();
    }
    /* 키 하나를 넣으며 비교 한 번마다 기록을 남긴다. */
    function insert(tst, word, value) {
      const log = [];
      let nid = '';
      let index = 0;
      while (tst.has(nid)) {
        const n = tst.get(nid);
        const c = word[index];
        if (c < n.ch) {
          log.push({ nid, kind: 'less', c, d: n.ch });
          nid += 'L';
        } else if (c > n.ch) {
          log.push({ nid, kind: 'greater', c, d: n.ch });
          nid += 'R';
        } else if (index < word.length - 1) {
          log.push({ nid, kind: 'equal', c, d: n.ch });
          nid += 'M';
          index += 1;
        } else {
          log.push({ nid, kind: 'last', c, d: n.ch });
          n.value = value;
          return { log, made: [] };
        }
      }
      /* 자리가 비었다: 남은 문자를 가운데로 줄줄이 */
      const made = [];
      for (let i = index; i < word.length; i++) {
        tst.set(nid, { id: nid, ch: word[i], value: null });
        made.push(nid);
        if (i < word.length - 1) nid += 'M';
      }
      tst.get(nid).value = value;
      return { log, made, rest: word.slice(index) };
    }
    /* getNode: 비교 한 번마다 기록. 찾으면 node, 못 찾으면 null */
    function walk(tst, word) {
      const log = [];
      let nid = '';
      let index = 0;
      while (tst.has(nid)) {
        const n = tst.get(nid);
        const c = word[index];
        if (c < n.ch) {
          log.push({ nid, kind: 'less', c, d: n.ch });
          nid += 'L';
        } else if (c > n.ch) {
          log.push({ nid, kind: 'greater', c, d: n.ch });
          nid += 'R';
        } else if (index === word.length - 1) {
          log.push({ nid, kind: 'last', c, d: n.ch });
          return { log, node: nid };
        } else {
          log.push({ nid, kind: 'equal', c, d: n.ch });
          nid += 'M';
          index += 1;
        }
      }
      return { log, node: null };
    }
    const values = (tst) => {
      const out = {};
      for (const [nid, n] of tst) if (n.value !== null) out[nid] = n.value;
      return out;
    };
    const counters = (tst) => [[S.nodes, tst.size], [S.links, tst.size * 3], [S.empty, tst.size === 0 ? 0 : tst.size * 3 - (tst.size - 1)]];

    function plan() {
      const steps = [];
      const tst = newTst();
      const head = [];
      const rows = [];

      if (cfg.mode === 'insert') {
        head.push(S.key, S.value);
        cfg.words.forEach(([w, v]) => rows.push([w, String(v)]));
        const rowState = (i) => rows.map((_, j) => (j < i ? 'done' : j === i ? 'cur' : 'todo'));
        cfg.words.slice(0, cfg.prefill).forEach(([w, v]) => insert(tst, w, v));
        steps.push({
          present: [...tst.keys()], mark: {}, values: values(tst),
          note: cfg.prefill > 0 ? fill(S['insert.prefilled'], { n: cfg.prefill }) : S['insert.idle'],
          rows: rowState(cfg.prefill - 0.5), counters: counters(tst),
        });
        for (let i = cfg.prefill; i < cfg.words.length; i++) {
          const [w, v] = cfg.words[i];
          const { log, made, rest } = insert(tst, w, v);
          const present = [...tst.keys()].filter((k) => !made.includes(k));
          const mark = {};
          if (!cfg.detail) {
            log.forEach((e) => (mark[e.nid] = 'path'));
            made.forEach((k) => (mark[k] = 'new'));
            steps.push({
              present: [...tst.keys()], mark, values: values(tst), fresh: made,
              note: fill(S['insert.word'], { w, v, k: log.length, m: made.length }),
              rows: rowState(i), counters: counters(tst),
            });
            continue;
          }
          const valsBefore = values(tst);
          made.forEach((k) => delete valsBefore[k]);
          if (log.length && log[log.length - 1].kind === 'last') delete valsBefore[log[log.length - 1].nid];
          const partial = (n) => {
            const sz = n;
            return [[S.nodes, sz], [S.links, sz * 3], [S.empty, sz * 3 - (sz - 1)]];
          };
          steps.push({
            present, mark: {}, values: valsBefore,
            note: fill(S['insert.start'], { w, v, c: w[0] }), rows: rowState(i), counters: partial(present.length),
          });
          log.forEach((e, k) => {
            const m = {};
            log.slice(0, k).forEach((p) => (m[p.nid] = 'path'));
            m[e.nid] = 'cur';
            const vals = e.kind === 'last' ? values(tst) : valsBefore;
            steps.push({
              present, mark: m, values: vals, note: fill(S[`insert.${e.kind}`], e),
              rows: rowState(i), counters: partial(present.length),
            });
          });
          if (made.length) {
            log.forEach((p) => (mark[p.nid] = 'path'));
            made.forEach((k) => (mark[k] = 'new'));
            steps.push({
              present: [...tst.keys()], mark, values: values(tst), fresh: made,
              note: fill(S['insert.new'], { rest: rest.split('').join(' ') }),
              rows: rowState(i), counters: counters(tst),
            });
          }
        }
        steps.push({
          present: [...tst.keys()], mark: {}, values: values(tst),
          note: fill(S['insert.done'], { n: cfg.words.length, nodes: tst.size, links: tst.size * 3 }),
          rows: rowState(cfg.words.length), counters: counters(tst), done: true,
        });
        return { steps, head, rows, layoutTst: tst };
      }

      cfg.words.forEach(([w, v]) => insert(tst, w, v));
      const all = [...tst.keys()];
      const vals = values(tst);

      if (cfg.mode === 'search') {
        head.push(S.query, S.result);
        cfg.queries.forEach((q) => rows.push([q, '']));
        const results = cfg.queries.map(() => '');
        const rowState = (i) => rows.map((_, j) => (j < i ? 'done' : j === i ? 'cur' : 'todo'));
        steps.push({
          present: all, mark: {}, values: vals, note: fill(S['search.idle'], { n: cfg.queries.length }),
          rows: rowState(-1), results: results.slice(), counters: [[S.visited, 0]],
        });
        cfg.queries.forEach((q, i) => {
          const { log, node } = walk(tst, q);
          steps.push({
            present: all, mark: {}, values: vals, note: fill(S['search.start'], { w: q, c: q[0] }),
            rows: rowState(i), results: results.slice(), counters: [[S.visited, 0]],
          });
          log.forEach((e, k) => {
            const m = {};
            log.slice(0, k).forEach((p) => (m[p.nid] = 'path'));
            m[e.nid] = 'cur';
            let note = fill(S[`search.${e.kind}`] || '', e);
            if (e.kind === 'last') {
              const v = tst.get(e.nid).value;
              if (v !== null) {
                m[e.nid] = 'hit';
                note = fill(S['search.hit'], { ...e, v });
                results[i] = String(v);
              } else {
                m[e.nid] = 'miss';
                note = fill(S['search.noValue'], e);
                results[i] = S.none;
              }
            }
            steps.push({
              present: all, mark: m, values: vals, note, rows: rowState(i), results: results.slice(),
              counters: [[S.visited, k + 1]],
            });
          });
          if (node === null) {
            const m = {};
            log.forEach((p) => (m[p.nid] = 'path'));
            m[log[log.length - 1].nid] = 'miss';
            results[i] = S.none;
            steps.push({
              present: all, mark: m, values: vals, note: S['search.noLink'], rows: rowState(i),
              results: results.slice(), counters: [[S.visited, log.length]],
            });
          }
        });
        steps.push({
          present: all, mark: {}, values: vals, note: S['search.done'],
          rows: rowState(cfg.queries.length), results: results.slice(), counters: [[S.visited, 0]], done: true,
        });
        return { steps, head, rows, layoutTst: tst };
      }

      /* prefix */
      head.push(S.found, S.value);
      const p = cfg.prefix;
      const found = [];
      const seen = [];
      const { log, node } = walk(tst, p);
      const snap = (extra, note, done) => {
        const m = {};
        log.forEach((e) => (m[e.nid] = 'path'));
        seen.forEach((k) => (m[k] = 'seen'));
        Object.assign(m, extra);
        found.forEach(([, k]) => (m[k] = 'take'));
        return {
          present: all, mark: m, values: vals, note, found: found.map(([w]) => w),
          counters: [[S.keys, found.length]], done,
        };
      };
      steps.push(snap({}, fill(S['prefix.idle'], { p })));
      log.forEach((e, k) => {
        const m = {};
        log.slice(0, k).forEach((q) => (m[q.nid] = 'path'));
        m[e.nid] = 'cur';
        steps.push({ ...snap({}, fill(S[`search.${e.kind === 'last' ? 'equal' : e.kind}`], e)), mark: m });
      });
      if (node === null) {
        steps.push(snap({ [log[log.length - 1].nid]: 'miss' }, S['prefix.noLink']));
        steps.push(snap({}, fill(S['prefix.done'], { p, n: 0 }), true));
      } else {
        steps[steps.length - 1] = snap({ [node]: 'cur' }, fill(S['prefix.reach'], { p }));
        const self = tst.get(node).value;
        if (self !== null) {
          found.push([p, node]);
          rows.push([p, String(self)]);
          steps.push(snap({}, fill(S['prefix.self'], { p, v: self })));
        }
        /* getAllWordsHelper: 왼쪽, 자기, 가운데, 오른쪽 */
        (function collect(nid, pre) {
          if (!tst.has(nid)) return;
          const n = tst.get(nid);
          collect(nid + 'L', pre);
          seen.push(nid);
          const s = pre + n.ch;
          if (n.value !== null) {
            found.push([s, nid]);
            rows.push([s, String(n.value)]);
            steps.push(snap({}, fill(S['prefix.take'], { s, v: n.value })));
          } else {
            steps.push({ ...snap({ [nid]: 'cur' }, fill(S['prefix.visit'], { s })), collect: true });
          }
          collect(nid + 'M', s);
          collect(nid + 'R', pre);
        })(node + 'M', p);
        steps.push(snap({}, fill(S['prefix.done'], { p, n: found.length }), true));
      }
      steps.forEach((s) => (s.rows = rows.map(([w]) => (s.found.includes(w) ? 'done' : 'hidden'))));
      return { steps, head, rows, layoutTst: tst };
    }
    /* plan:end */

    const { steps, head, rows, layoutTst } = plan();

    /* 자리: 왼쪽 서브트리, 자기(가운데 자식 바로 위), 오른쪽 서브트리 순서로 칸을 쓴다. */
    /* 슬라이드에서는 트리가 높이에 맞춰 줄어든다. 레벨 간격을 좁히고 노드를 키워
       트라이 데모의 노드와 비슷한 크기로 읽히게 한다. */
    const UNIT = 36;
    const LEVEL = cfg.slide ? 28 : 32;
    const RAD = cfg.slide ? 13 : 11;
    const pos = new Map();
    let slot = 0;
    let maxDepth = 0;
    (function place(nid, d) {
      if (!layoutTst.has(nid)) return;
      maxDepth = Math.max(maxDepth, d);
      place(nid + 'L', d + 1);
      if (layoutTst.has(nid + 'M')) {
        place(nid + 'M', d + 1);
        pos.set(nid, { x: pos.get(nid + 'M').x, y: d * LEVEL });
      } else {
        pos.set(nid, { x: slot * UNIT, y: d * LEVEL });
        slot += 1;
      }
      place(nid + 'R', d + 1);
    })('', 0);
    const W = (slot - 1) * UNIT;
    const PAD = 26;
    const svg = root.querySelector('[data-ts-svg]');
    svg.setAttribute('viewBox', `${-PAD} ${-RAD - 6} ${W + 2 * PAD} ${maxDepth * LEVEL + 2 * RAD + 22}`);
    const NS = 'http://www.w3.org/2000/svg';
    const el = (name, attrs, text) => {
      const node = document.createElementNS(NS, name);
      for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, String(v));
      if (text !== undefined) node.textContent = text;
      return node;
    };
    const stubLayer = el('g', {});
    const edgeLayer = el('g', {});
    const nodeLayer = el('g', {});
    svg.appendChild(stubLayer);
    svg.appendChild(edgeLayer);
    svg.appendChild(nodeLayer);
    const nodeEls = new Map();
    const edgeEls = new Map();
    const stubEls = new Map(); /* 노드 id + 방향 → 빈 링크 표시 */
    const DIRS = { L: -1, M: 0, R: 1 };
    for (const [nid, n] of layoutTst) {
      const p = pos.get(nid);
      if (nid !== '') {
        const q = pos.get(nid.slice(0, -1));
        const line = el('line', { class: 'ts-edge', x1: q.x, y1: q.y, x2: p.x, y2: p.y });
        edgeLayer.appendChild(line);
        edgeEls.set(nid, line);
      }
      for (const [dir, dx] of Object.entries(DIRS)) {
        const sx = p.x + dx * 9;
        const sy = p.y + RAD + 7;
        const g = el('g', { class: 'ts-stub' });
        g.appendChild(el('line', { x1: p.x + dx * 5, y1: p.y + RAD - 2, x2: sx, y2: sy }));
        g.appendChild(el('circle', { cx: sx, cy: sy, r: 2.2 }));
        stubLayer.appendChild(g);
        stubEls.set(nid + dir, g);
      }
      const g = el('g', { class: 'ts-node', transform: `translate(${p.x} ${p.y})` });
      g.appendChild(el('circle', { r: RAD }));
      g.appendChild(el('text', { class: 'ts-ch' }, n.ch));
      g.appendChild(el('text', { class: 'ts-val', x: RAD + 2, y: -RAD + 2 }));
      nodeLayer.appendChild(g);
      nodeEls.set(nid, g);
    }

    const headRow = root.querySelector('[data-ts-head]');
    head.forEach((h) => headRow.appendChild(Object.assign(document.createElement('th'), { textContent: h })));
    const body = root.querySelector('[data-ts-rows]');
    const rowEls = rows.map(([a, b]) => {
      const tr = document.createElement('tr');
      tr.appendChild(Object.assign(document.createElement('td'), { className: 'ts-key', textContent: a }));
      tr.appendChild(Object.assign(document.createElement('td'), { className: 'ts-v', textContent: b }));
      body.appendChild(tr);
      return tr;
    });

    const MARKS = ['path', 'cur', 'new', 'hit', 'miss', 'take', 'seen'];
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function render(s, animate) {
      const step = steps[s];
      const present = new Set(step.present);
      const fresh = step.fresh || [];
      for (const [nid, g] of nodeEls) {
        const on = present.has(nid);
        const mark = step.mark[nid];
        g.classList.toggle('is-off', !on);
        g.classList.toggle('has-value', step.values[nid] !== undefined);
        for (const m of MARKS) g.classList.toggle(`is-${m}`, mark === m);
        const i = fresh.indexOf(nid);
        const delay = animate && !reduceMotion && i >= 0 ? `${i * 0.1}s` : '0s';
        g.style.transitionDelay = delay;
        const v = step.values[nid];
        g.querySelector('.ts-val').textContent = v === undefined ? '' : String(v);
        const line = edgeEls.get(nid);
        if (line) {
          line.classList.toggle('is-off', !on);
          const curTake = mark === 'cur' && step.collect;
          line.classList.toggle('is-path', ['path', 'cur', 'hit', 'miss'].includes(mark) && !curTake);
          line.classList.toggle('is-new', mark === 'new');
          line.classList.toggle('is-take', ['take', 'seen'].includes(mark) || curTake);
          line.style.transitionDelay = delay;
        }
        for (const dir of Object.keys(DIRS)) {
          const stub = stubEls.get(nid + dir);
          stub.classList.toggle('is-off', !on || present.has(nid + dir));
          stub.style.transitionDelay = delay;
        }
      }
      rowEls.forEach((tr, j) => {
        tr.className = `is-${step.rows[j]}`;
        if (step.results) tr.querySelector('.ts-v').textContent = step.results[j];
      });
      setLines(root.querySelector('[data-ts-note]'), step.note);
      const count = root.querySelector('[data-ts-count]');
      count.textContent = '';
      step.counters.forEach(([label, value], k) => {
        if (k > 0) count.appendChild(document.createTextNode(' · '));
        count.appendChild(document.createTextNode(`${label} `));
        count.appendChild(Object.assign(document.createElement('strong'), { textContent: String(value) }));
      });
      root.classList.toggle('is-done', !!step.done);
    }

    let at = 0;
    let timer = null;
    const playBtn = root.querySelector('[data-act="play"]');
    const stop = () => {
      if (timer) clearInterval(timer);
      timer = null;
      playBtn.textContent = S.play;
    };
    const step = () => {
      if (at >= steps.length - 1) return stop();
      at += 1;
      render(at, true);
      if (at >= steps.length - 1) stop();
    };
    root.querySelector('[data-act="back"]').addEventListener('click', () => {
      stop();
      if (at > 0) at -= 1;
      render(at, false);
    });
    root.querySelector('[data-act="step"]').addEventListener('click', () => {
      stop();
      step();
    });
    root.querySelector('[data-act="reset"]').addEventListener('click', () => {
      stop();
      at = 0;
      render(0, false);
    });
    playBtn.addEventListener('click', () => {
      if (timer) return stop();
      if (at >= steps.length - 1) {
        at = 0;
        render(0, false);
      }
      playBtn.textContent = S.stop;
      timer = setInterval(step, cfg.mode === 'insert' && !cfg.detail ? 1500 : 1000);
    });

    render(0, false);
  })();
</script>

