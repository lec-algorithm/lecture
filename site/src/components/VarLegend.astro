---
// 슬라이드의 오른쪽 위에 붙는 작은 범례. 그 절에서 계속 쓰는 기호가 무엇인지 그림으로 보인다.
//
// set으로 절을 고른다.
// - radix: 기수 정렬. n은 원소 수, d는 원소 하나의 자릿수, k는 한 자리가 가질 수 있는 값의 수다.
//   k는 값 전체의 범위가 아니라 한 자리의 범위라는 점을 칸 하나로 보인다. 예시 값은 교안의 170이다.
// - lrs: 가장 긴 반복 부분 문자열. n은 문자열 길이, D는 가장 긴 일치의 길이, LCP[j]는 정렬에서
//   바로 앞 이웃과의 공통 접두사 길이다.
// - lcs: 가장 긴 공통 부분 문자열. T는 두 문자열을 이은 것, n은 그 길이, 출처는 접미사가 시작한 문자열이다.
//   그림은 교안의 예 mississippi(S₁, 파랑)와 kiss(S₂, 주황)다.
// - kwic: 문맥 속 키워드 검색. n은 텍스트 길이, m은 질의어 길이다.
// 슬라이드에서는 맨 위 줄에 띄우고, 교안 본문에서는 보통 블록으로 둔다.
import { defaultLang } from 'stack-site-builder/i18n/ui';

type Set = 'radix' | 'lrs' | 'lcs' | 'kwic';
interface Props {
  set?: Set;
  /** 교안 본문용: 띄우지 않고 글 흐름에 둔다. */
  inline?: boolean;
}
const { set = 'radix', inline = false } = Astro.props;

/* 그림의 칸. c는 칸 색(m: 파랑, e: 초록, f: 주황), 'more'는 줄임표다. */
type Cell = { t?: string; c?: 'm' | 'e' | 'f' } | 'more';
type Item = { pic: Cell[]; key: string; text: Record<string, string> };

const ITEMS: Record<Set, Item[]> = {
  radix: [
    { pic: [{}, {}, {}, 'more', {}], key: 'n', text: { ko: '원소 수', en: 'number of keys', zh: '元素个数' } },
    { pic: [{ t: '1', c: 'e' }, { t: '7', c: 'e' }, { t: '0', c: 'e' }], key: 'd', text: { ko: '원소 하나의 자릿수', en: 'digits per key', zh: '每个元素的位数' } },
    { pic: [{ t: '7', c: 'f' }], key: 'k', text: { ko: '한 자리의 값 수 (0~9면 10)', en: 'values per digit (0~9 → 10)', zh: '每一位的取值个数（0~9 是 10）' } },
  ],
  lrs: [
    { pic: [{ t: 'b' }, { t: 'a' }, { t: 'n' }, 'more', { t: '$' }], key: 'n', text: { ko: '문자열 길이', en: 'text length', zh: '字符串长度' } },
    { pic: [{ t: 'a', c: 'e' }, { t: 'n', c: 'e' }, { t: 'a', c: 'e' }], key: 'D', text: { ko: '가장 긴 일치의 길이', en: 'longest match length', zh: '最长匹配的长度' } },
    { pic: [{ t: '3', c: 'f' }], key: 'LCP[j]', text: { ko: '앞 이웃과의 공통 접두사 길이', en: 'common prefix with previous neighbor', zh: '与前一个邻居的公共前缀长度' } },
  ],
  lcs: [
    { pic: [{ t: 'm', c: 'm' }, { t: 'i', c: 'm' }, 'more', { t: '#' }, { t: 'k', c: 'f' }, { t: 'i', c: 'f' }, 'more', { t: '$' }], key: 'T', text: { ko: 'S₁ # S₂ $를 이은 문자열', en: 'S₁ # S₂ $ joined', zh: '把 S₁ # S₂ $ 连起来的字符串' } },
    { pic: [], key: 'n', text: { ko: 'T의 길이, |S₁| + |S₂| + 2', en: 'length of T, |S₁| + |S₂| + 2', zh: 'T 的长度，|S₁| + |S₂| + 2' } },
    { pic: [{ t: '1', c: 'm' }, { t: '2', c: 'f' }], key: '', text: { ko: '출처: 접미사가 시작한 문자열', en: 'origin: string a suffix starts in', zh: '来源：后缀起始的字符串' } },
  ],
  kwic: [
    { pic: [{ t: 'i' }, { t: 't' }, 'more', { t: '$' }], key: 'n', text: { ko: '텍스트 길이', en: 'text length', zh: '文本长度' } },
    { pic: [{ t: 's', c: 'f' }, { t: 'e', c: 'f' }, { t: 'a', c: 'f' }], key: 'm', text: { ko: '질의어 길이', en: 'query length', zh: '查询词长度' } },
  ],
};
const lang = Astro.currentLocale ?? defaultLang;
const items = ITEMS[set];
const textOf = (it: Item) => it.text[lang] ?? it.text[defaultLang] ?? it.text.ko;
---

<aside class:list={['aas-var-legend', inline && 'is-inline']} aria-label={items.map((it) => it.key || textOf(it)).join(', ')}>
  {
    items.map((it) => (
      <span class="vl-item">
        {it.pic.length > 0 && (
          <span class="vl-pic" aria-hidden="true">
            {it.pic.map((cell) => (cell === 'more' ? <b>…</b> : <i class:list={[cell.c && `is-${cell.c}`]}>{cell.t ?? ''}</i>))}
          </span>
        )}
        {it.key && <span class="vl-key">{it.key}</span>}
        <span class="vl-text">{textOf(it)}</span>
      </span>
    ))
  }
</aside>

<script>
  /* 슬라이드가 내용을 줄여 맞출 때는 본문(.aas-slide-inner)에 transform이 걸려, 그 안의 절대 위치가
     본문을 따라 내려온다. 범례를 슬라이드 자체로 옮겨 언제나 맨 위 줄에 있게 한다. */
  document.querySelectorAll<HTMLElement>('.aas-var-legend:not(.is-inline)').forEach((el) => {
    const slide = el.closest('section.aas-slide');
    if (slide && el.parentElement !== slide) slide.append(el);
  });
</script>

<style is:global>
  /* 슬라이드 맨 위 줄(뒤로 가기와 목차 버튼 사이)에 한 줄로 둔다. 제목 줄과 겹치지 않는다. */
  .aas-var-legend {
    position: absolute;
    top: 0.75rem;
    right: 4.5rem;
    z-index: 2;
    display: flex;
    gap: 0.35em 1.1em;
    align-items: center;
    padding: 0.25em 0.7em;
    font-size: clamp(0.72rem, 1.85vh, 1.1rem);
    line-height: 1.2;
    border: 1px solid var(--aas-border);
    border-radius: 0.6em;
    background: var(--aas-panel);
    color: var(--aas-muted);
  }
  .aas-var-legend.is-inline {
    position: static;
    flex-wrap: wrap;
    width: fit-content;
    margin: 1rem 0;
    font-size: 0.85rem;
  }
  .aas-var-legend .vl-item {
    display: flex;
    gap: 0.4em;
    align-items: center;
  }
  .aas-var-legend .vl-pic {
    display: flex;
    gap: 0.15em;
    align-items: center;
  }
  .aas-var-legend .vl-pic i {
    display: inline-block;
    width: 1.05em;
    height: 1.05em;
    box-sizing: border-box;
    border: 1.5px solid var(--aas-border);
    border-radius: 0.2em;
    font-style: normal;
    font-family: var(--aas-mono, monospace);
    font-size: 0.85em;
    line-height: calc(1.05em - 2px);
    text-align: center;
    color: var(--aas-text);
  }
  .aas-var-legend .vl-pic b {
    font-weight: 400;
    font-size: 0.8em;
  }
  .aas-var-legend .vl-pic i.is-m {
    border-color: var(--aas-role-model);
  }
  .aas-var-legend .vl-pic i.is-e {
    border-color: var(--aas-role-eval);
  }
  .aas-var-legend .vl-pic i.is-f {
    border-color: var(--aas-role-focus);
    background: color-mix(in srgb, var(--aas-role-focus) 22%, transparent);
    font-weight: 700;
  }
  .aas-var-legend .vl-key {
    font-family: var(--aas-mono, monospace);
    font-weight: 700;
    color: var(--aas-text);
  }
  .aas-var-legend .vl-text {
    font-size: 0.85em;
    white-space: nowrap;
  }
  /* 좁은 화면에서는 맨 위 줄이 모자라므로 그림과 기호만 남긴다. */
  @media (max-width: 1000px) {
    .aas-var-legend:not(.is-inline) .vl-text {
      display: none;
    }
  }
</style>
