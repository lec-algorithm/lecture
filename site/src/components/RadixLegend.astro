---
// 기수 정렬 슬라이드의 오른쪽 위에 붙는 작은 범례. n, d, k가 무엇인지 그림으로 보인다.
//
// n은 정렬할 원소의 수, d는 원소 하나의 자릿수, k는 한 자리가 가질 수 있는 값의 수(기수)다.
// k는 값 전체의 범위가 아니라 한 자리의 범위라는 점을 칸 하나로 보인다. 예시 값은 교안 입력의
// 170이다. 슬라이드에서는 맨 위 줄에 띄우고, 교안 본문에서는 보통 블록으로 둔다.
import { defaultLang } from 'stack-site-builder/i18n/ui';

interface Props {
  /** 교안 본문용: 띄우지 않고 글 흐름에 둔다. */
  inline?: boolean;
}
const { inline = false } = Astro.props;

const STRINGS: Record<string, { n: string; d: string; k: string }> = {
  ko: { n: '원소 수', d: '원소 하나의 자릿수', k: '한 자리의 값 수 (0~9면 10)' },
  en: { n: 'number of keys', d: 'digits per key', k: 'values per digit (0~9 → 10)' },
  zh: { n: '元素个数', d: '每个元素的位数', k: '每一位的取值个数（0~9 是 10）' },
};
const lang = Astro.currentLocale ?? defaultLang;
const t = STRINGS[lang] ?? STRINGS[defaultLang] ?? STRINGS.ko;
---

<aside class:list={['aas-radix-legend', inline && 'is-inline']} aria-label="n, d, k">
  <span class="rl-item">
    <span class="rl-pic" aria-hidden="true"><i></i><i></i><i></i><b>…</b><i></i></span>
    <span class="rl-key">n</span>
    <span class="rl-text">{t.n}</span>
  </span>
  <span class="rl-item">
    <span class="rl-pic" aria-hidden="true"><i class="is-d">1</i><i class="is-d">7</i><i class="is-d">0</i></span>
    <span class="rl-key">d</span>
    <span class="rl-text">{t.d}</span>
  </span>
  <span class="rl-item">
    <span class="rl-pic" aria-hidden="true"><i class="is-k">7</i></span>
    <span class="rl-key">k</span>
    <span class="rl-text">{t.k}</span>
  </span>
</aside>

<script>
  /* 슬라이드가 내용을 줄여 맞출 때는 본문(.aas-slide-inner)에 transform이 걸려, 그 안의 절대 위치가
     본문을 따라 내려온다. 범례를 슬라이드 자체로 옮겨 언제나 맨 위 줄에 있게 한다. */
  document.querySelectorAll<HTMLElement>('.aas-radix-legend:not(.is-inline)').forEach((el) => {
    const slide = el.closest('section.aas-slide');
    if (slide && el.parentElement !== slide) slide.append(el);
  });
</script>

<style is:global>
  /* 슬라이드 맨 위 줄(뒤로 가기와 목차 버튼 사이)에 한 줄로 둔다. 제목 줄과 겹치지 않는다. */
  .aas-radix-legend {
    position: absolute;
    top: 0.75rem;
    right: 4.5rem;
    z-index: 2;
    display: flex;
    gap: 0.35em 1.1em;
    align-items: center;
    padding: 0.25em 0.7em;
    font-size: clamp(0.72rem, 1.85vh, 1.1rem);
    line-height: 1.2;
    border: 1px solid var(--aas-border);
    border-radius: 0.6em;
    background: var(--aas-panel);
    color: var(--aas-muted);
  }
  .aas-radix-legend.is-inline {
    position: static;
    width: fit-content;
    margin: 1rem 0;
    font-size: 0.85rem;
  }
  .aas-radix-legend .rl-item {
    display: flex;
    gap: 0.4em;
    align-items: center;
  }
  .aas-radix-legend.is-inline {
    flex-wrap: wrap;
  }
  .aas-radix-legend .rl-pic {
    display: flex;
    gap: 0.15em;
    justify-content: flex-end;
    align-items: center;
  }
  .aas-radix-legend .rl-pic i {
    display: inline-block;
    width: 1.05em;
    height: 1.05em;
    box-sizing: border-box;
    border: 1.5px solid var(--aas-role-model);
    border-radius: 0.2em;
    font-style: normal;
    font-family: var(--aas-mono, monospace);
    font-size: 0.85em;
    line-height: calc(1.05em - 2px);
    text-align: center;
    color: var(--aas-text);
  }
  .aas-radix-legend .rl-pic b {
    font-weight: 400;
    font-size: 0.8em;
  }
  .aas-radix-legend .rl-pic i.is-d {
    border-color: var(--aas-role-eval);
  }
  .aas-radix-legend .rl-pic i.is-k {
    border-color: var(--aas-role-focus);
    background: color-mix(in srgb, var(--aas-role-focus) 22%, transparent);
    font-weight: 700;
  }
  .aas-radix-legend .rl-key {
    font-family: var(--aas-mono, monospace);
    font-weight: 700;
    color: var(--aas-text);
  }
  .aas-radix-legend .rl-text {
    font-size: 0.85em;
    white-space: nowrap;
  }
  /* 좁은 화면에서는 맨 위 줄이 모자라므로 그림과 기호만 남긴다. */
  @media (max-width: 1000px) {
    .aas-radix-legend:not(.is-inline) .rl-text {
      display: none;
    }
  }
</style>
