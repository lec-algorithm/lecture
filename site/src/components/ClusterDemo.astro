---
// 선형 탐지의 키 무리(cluster)가 키를 넣을수록 자라는 모습을 보는 데모.
//
// ClusterFigure의 움직이는 판이다. 크기 512인 배열을 32칸씩 16줄로 접어
// 그리고(원형 배열이라 줄 끝은 다음 줄 앞으로 이어진다), 키 수 슬라이더로
// 키를 더 넣거나 뺀다. 왼쪽은 선형 탐지(차 있으면 다음 칸), 오른쪽은
// 비교용 "무작위"(차 있으면 아무 빈칸이나 새로 고름)다.
//
// 난수는 ClusterFigure와 같은 mulberry32, 같은 시드(7과 107)다. k번째 키는
// 키 수와 상관없이 늘 같은 칸에 들어가므로, 키 256개와 128개에서 그 그림의
// 두 줄과 똑같은 모양이 나온다.
//
// "실패 탐색 평균"은 512칸 각각을 출발점으로 빈칸을 만날 때까지 들여다보는
// 칸 수의 평균이다. 이론값은 선형 탐지 ½(1 + 1/(1-α)²), 무작위 1/(1-α)이다.
import { defaultLang } from 'stack-site-builder/i18n/ui';

interface Props {
  /** 처음 넣어 둘 키 수(0~480) */
  n?: number;
  /** 슬라이드용: 글자를 키운다. */
  slide?: boolean;
}
const { n = 256, slide = false } = Astro.props;
const id = `cd-${Math.random().toString(36).slice(2, 9)}`;
const M = 512;
const COLS = 32;
const ROWS = M / COLS;
const MAXN = 480;
const LONG = 6;
const CELL = 10;
const GAP = 2;
const W = COLS * (CELL + GAP) - GAP;
const H = ROWS * (CELL + GAP) - GAP;
const cells = Array.from({ length: M }, (_, i) => ({
  x: (i % COLS) * (CELL + GAP),
  y: Math.floor(i / COLS) * (CELL + GAP),
}));

const STRINGS: Record<string, Record<string, string>> = {
  ko: {
    title: '키 무리가 자라는 모습',
    keys: '키 수 N',
    play: '자동 재생',
    stop: '멈춤',
    lp: '선형 탐지',
    uni: '무작위 (비교용)',
    longest: '가장 긴 무리',
    miss: '실패 탐색 평균',
    theory: '이론',
    legend: `주황: 길이 ${LONG} 이상인 무리 · 배열 512칸을 32칸씩 접어 그림`,
    note: '키 {n}개, 적재율 {a}입니다. 가장 긴 무리는 선형 탐지 {l1}칸, 무작위 {l2}칸입니다. 없는 키를 찾으면 평균 {m1}칸과 {m2}칸을 봅니다.',
  },
  en: {
    title: 'Clusters growing',
    keys: 'keys N',
    play: 'Play',
    stop: 'Pause',
    lp: 'Linear probing',
    uni: 'Random (for comparison)',
    longest: 'longest cluster',
    miss: 'avg. miss',
    theory: 'theory',
    legend: `Orange: clusters of length ${LONG} or more · 512 slots folded into rows of 32`,
    note: '{n} keys, load {a}. The longest cluster is {l1} slots with linear probing and {l2} with random probing. A search miss looks at {m1} and {m2} slots on average.',
  },
  zh: {
    title: '簇在变长',
    keys: '键数 N',
    play: '播放',
    stop: '暂停',
    lp: '线性探测',
    uni: '随机（对照）',
    longest: '最长簇',
    miss: '未命中平均',
    theory: '理论',
    legend: `橙色：长度 ${LONG} 以上的簇 · 512 格按每行 32 格折叠绘制`,
    note: '{n} 个键，装载因子 {a}。最长簇在线性探测中是 {l1} 格，随机是 {l2} 格。查找不存在的键平均要看 {m1} 格和 {m2} 格。',
  },
};
const lang = Astro.currentLocale ?? defaultLang;
const t = STRINGS[lang] ?? STRINGS[defaultLang] ?? STRINGS.ko;
const sides = [
  { key: 'lp', name: t.lp },
  { key: 'uni', name: t.uni },
];
---

<div
  class:list={['aas-cluster-demo', slide && 'is-slide']}
  id={id}
  data-cd-n={Math.min(Math.max(0, n), MAXN)}
  data-cd-strings={JSON.stringify(t)}
>
  <div class="cd-bar">
    <span class="cd-head"><strong>{t.title}</strong> · M = {M}</span>
    <label class="cd-count">
      {t.keys} <strong data-cd-nval></strong>
      <span class="cd-alpha">α = <b data-cd-alpha></b></span>
      <input type="range" min="0" max={MAXN} step="8" data-cd-range />
    </label>
    <div class="cd-controls">
      {[128, 256, 384].map((k) => <button type="button" class="cd-btn" data-cd-preset={k}>{k}</button>)}
      <button type="button" class="cd-btn cd-btn-primary" data-cd-play>{t.play}</button>
    </div>
  </div>

  <div class="cd-panels">
    {
      sides.map((side) => (
        <div class="cd-panel" data-cd-side={side.key}>
          <div class="cd-name">{side.name}</div>
          <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={side.name}>
            {cells.map((c) => (
              <rect x={c.x} y={c.y} width={CELL} height={CELL} rx="2" class="cd-empty" />
            ))}
          </svg>
          <div class="cd-stats">
            <span>
              {t.longest} <b data-cd-longest />
            </span>
            <span>
              {t.miss} <b data-cd-miss /> ({t.theory} <span data-cd-theory />)
            </span>
          </div>
        </div>
      ))
    }
  </div>
  <p class="cd-legend">{t.legend}</p>
  <p class="cd-note" data-cd-note></p>
</div>

<script is:inline define:vars={{ id, M, MAXN, LONG }}>
  (() => {
    const root = document.getElementById(id);
    if (!root) return;

    /* 설명은 문장마다 줄을 바꾼다. 마침표 뒤 공백, 또는 중국어 마침표 뒤에서 끊는다. */
    const setLines = (node, text) => {
      const parts = String(text).split(/(?<=[.!?])\s+(?=\S)|(?<=[。！？])(?=\S)/);
      node.replaceChildren(...parts.flatMap((s, i) => (i ? [document.createElement('br'), s] : [s])));
    };
    const S = JSON.parse(root.dataset.cdStrings);
    const fill = (tpl, vars) => tpl.replace(/\{(\w+)\}/g, (_, k) => vars[k]);

    /* ClusterFigure와 같은 난수 */
    function mulberry32(a) {
      return () => {
        a |= 0;
        a = (a + 0x6d2b79f5) | 0;
        let t = Math.imul(a ^ (a >>> 15), 1 | a);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }
    /* k번째 키가 들어간 칸을 차례로 적는다. 선형 탐지는 차 있으면 다음 칸,
       무작위는 차 있으면 새 난수 칸. */
    function order(seed, uniform) {
      const rand = mulberry32(seed);
      const occ = new Array(M).fill(false);
      const at = [];
      for (let k = 0; k < MAXN; k++) {
        let i = Math.floor(rand() * M);
        while (occ[i]) i = uniform ? Math.floor(rand() * M) : (i + 1) % M;
        occ[i] = true;
        at.push(i);
      }
      return at;
    }
    const ORDER = { lp: order(7, false), uni: order(107, true) };

    function measure(at, n) {
      const occ = new Array(M).fill(false);
      for (let k = 0; k < n; k++) occ[at[k]] = true;
      const runLen = new Array(M).fill(0);
      let longest = 0;
      const empty = occ.indexOf(false);
      const start = (empty + 1) % M;
      let members = [];
      for (let c = 0; c <= M; c++) {
        const j = (start + c) % M;
        if (c < M && occ[j]) {
          members.push(j);
        } else {
          members.forEach((x) => (runLen[x] = members.length));
          longest = Math.max(longest, members.length);
          members = [];
        }
      }
      let total = 0;
      for (let s = 0; s < M; s++) {
        let p = 1;
        for (let i = s; occ[i]; i = (i + 1) % M) p += 1;
        total += p;
      }
      return { occ, runLen, longest, miss: total / M };
    }

    const range = root.querySelector('[data-cd-range]');
    const nval = root.querySelector('[data-cd-nval]');
    const alphaEl = root.querySelector('[data-cd-alpha]');
    const note = root.querySelector('[data-cd-note]');
    const playBtn = root.querySelector('[data-cd-play]');
    const presets = [...root.querySelectorAll('[data-cd-preset]')];
    const panels = Object.fromEntries(
      [...root.querySelectorAll('[data-cd-side]')].map((p) => [
        p.dataset.cdSide,
        {
          rects: [...p.querySelectorAll('rect')],
          longest: p.querySelector('[data-cd-longest]'),
          miss: p.querySelector('[data-cd-miss]'),
          theory: p.querySelector('[data-cd-theory]'),
        },
      ]),
    );
    let N = Number(root.dataset.cdN);

    function render() {
      const a = N / M;
      range.value = String(N);
      nval.textContent = String(N);
      alphaEl.textContent = a.toFixed(2);
      presets.forEach((b) => b.classList.toggle('is-on', Number(b.dataset.cdPreset) === N));
      const res = {};
      for (const side of ['lp', 'uni']) {
        const r = measure(ORDER[side], N);
        res[side] = r;
        const P = panels[side];
        P.rects.forEach((rect, i) => {
          rect.setAttribute('class', !r.occ[i] ? 'cd-empty' : r.runLen[i] >= LONG ? 'cd-long' : 'cd-full');
        });
        P.longest.textContent = String(r.longest);
        P.miss.textContent = r.miss.toFixed(2);
        const th = side === 'lp' ? 0.5 * (1 + 1 / (1 - a) ** 2) : 1 / (1 - a);
        P.theory.textContent = th.toFixed(2);
      }
      setLines(
        note,
        fill(S.note, {
          n: N,
          a: a.toFixed(2),
          l1: res.lp.longest,
          l2: res.uni.longest,
          m1: res.lp.miss.toFixed(2),
          m2: res.uni.miss.toFixed(2),
        }),
      );
    }

    let timer = null;
    function stop() {
      if (timer) clearInterval(timer);
      timer = null;
      playBtn.textContent = S.play;
    }
    range.addEventListener('input', () => {
      stop();
      N = Number(range.value);
      render();
    });
    presets.forEach((b) =>
      b.addEventListener('click', () => {
        stop();
        N = Number(b.dataset.cdPreset);
        render();
      }),
    );
    playBtn.addEventListener('click', () => {
      if (timer) return stop();
      if (N >= MAXN) N = 0;
      playBtn.textContent = S.stop;
      render();
      timer = setInterval(() => {
        N = Math.min(MAXN, N + 8);
        render();
        if (N >= MAXN) stop();
      }, 250);
    });
    render();
  })();
</script>

<style is:global>
  .aas-cluster-demo {
    font-size: 1rem;
    margin: 1.5rem 0;
    padding: 1em;
    border: 1px solid var(--aas-border);
    border-radius: 0.9em;
    background: var(--aas-panel);
  }
  .aas-cluster-demo .cd-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6em 1.2em;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.6em;
  }
  .aas-cluster-demo .cd-head {
    font-size: 0.95em;
  }
  .aas-cluster-demo .cd-count {
    display: flex;
    gap: 0.5em;
    align-items: center;
    font-size: 0.85em;
    color: var(--aas-muted);
  }
  .aas-cluster-demo .cd-count strong {
    min-width: 1.9em;
    color: var(--aas-text);
    font-family: var(--aas-mono, monospace);
    font-size: 1.2em;
  }
  .aas-cluster-demo .cd-alpha b {
    color: var(--aas-text);
    font-family: var(--aas-mono, monospace);
  }
  .aas-cluster-demo .cd-count input {
    width: 10em;
    accent-color: var(--aas-accent);
  }
  .aas-cluster-demo .cd-controls {
    display: flex;
    gap: 0.4em;
  }
  .aas-cluster-demo .cd-btn {
    padding: 0.3em 0.7em;
    font-size: 0.85em;
    border: 1px solid var(--aas-border);
    border-radius: 0.5em;
    background: var(--aas-bg);
    color: var(--aas-text);
    cursor: pointer;
    font-family: var(--aas-mono, monospace);
  }
  .aas-cluster-demo .cd-btn:hover {
    border-color: var(--aas-accent);
  }
  .aas-cluster-demo .cd-btn.is-on {
    background: color-mix(in srgb, var(--aas-accent) 18%, var(--aas-bg));
    border-color: var(--aas-accent);
    font-weight: 700;
  }
  .aas-cluster-demo .cd-btn-primary {
    background: var(--aas-accent);
    border-color: var(--aas-accent);
    color: #fff;
    font-family: inherit;
  }
  .aas-cluster-demo .cd-panels {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.2em;
  }
  .aas-cluster-demo .cd-name {
    font-size: 0.85em;
    font-weight: 700;
    margin-bottom: 0.3em;
  }
  .aas-cluster-demo .cd-panel svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .aas-cluster-demo .cd-empty {
    fill: color-mix(in srgb, var(--aas-muted) 12%, transparent);
  }
  .aas-cluster-demo .cd-full {
    fill: var(--aas-role-model);
  }
  .aas-cluster-demo .cd-long {
    fill: var(--aas-role-focus);
  }
  .aas-cluster-demo .cd-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2em 1em;
    margin-top: 0.35em;
    font-size: 0.75em;
    color: var(--aas-muted);
  }
  .aas-cluster-demo .cd-stats b {
    color: var(--aas-text);
    font-family: var(--aas-mono, monospace);
    font-size: 1.15em;
  }
  .aas-cluster-demo .cd-legend {
    margin: 0.5em 0 0;
    font-size: 0.75em;
    color: var(--aas-muted);
    text-align: center;
  }
  .aas-cluster-demo .cd-note {
    margin: 0.4em 0 0;
    font-size: 0.85em;
    color: var(--aas-text);
    min-height: 3.2em;
  }
  @media (max-width: 640px) {
    .aas-cluster-demo .cd-panels {
      grid-template-columns: 1fr;
    }
  }
  /* 슬라이드용. 두 판이 한 화면에 들도록 판의 폭을 높이에 맞춰 묶는다. */
  .aas-cluster-demo.is-slide {
    font-size: clamp(1rem, 2.8vh, 1.8rem);
    margin: 0.5rem 0;
    padding: 0.6em 1em;
  }
  .aas-cluster-demo.is-slide .cd-panels {
    grid-template-columns: repeat(2, minmax(0, 56vh));
    justify-content: center;
    gap: 1.2em 3em;
  }
  @media (prefers-reduced-motion: reduce) {
    .aas-cluster-demo * {
      transition: none !important;
    }
  }
</style>
