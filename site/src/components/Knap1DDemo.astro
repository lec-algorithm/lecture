---
// 0/1 배낭을 한 줄짜리 표로 줄이는 데모. 채우는 방향이 답을 바꾼다.
//
// dp[c] = max(dp[c], dp[c - w] + v). 용량이 큰 칸부터 채우면 dp[c - w]가 아직 이전 물건
// 까지의 값이라 물건을 한 번만 쓴다(0/1). 작은 칸부터 채우면 이번 물건이 이미 든 칸을
// 참조해 같은 물건을 여러 번 쓴다(무한 배낭). 칸 아래에 담긴 물건을 함께 보인다.
import { defaultLang } from 'stack-site-builder/i18n/ui';
import DpKit from './DpKit.astro';
interface Props {
  slide?: boolean;
}
const { slide = false } = Astro.props;
const id = `k1-${Math.random().toString(36).slice(2, 9)}`;
const STRINGS: Record<string, Record<string, string>> = {
  ko: {
    title: '한 줄로 줄인 배낭 표',
    down: '큰 용량부터 ←',
    up: '작은 용량부터 →',
    item: '물건',
    w: '무게',
    v: '가치',
    cap: 'c',
    bag: '담긴 것',
    idle: '물건이 없으면 모든 칸이 0입니다. 물건을 하나씩 늘리며 같은 줄을 고쳐 씁니다.',
    take: '물건 {i}, c = {c}: dp[{c}] = {a}와 dp[{r}] + {v} = {b} 가운데 큰 쪽은 {m}입니다.',
    skip: '물건 {i}, c = {c}: 무게 {w}가 들어가지 않으므로 그대로 둡니다.',
    warn: '참조한 칸에 물건 {i}번이 이미 들어 있습니다. 같은 물건을 또 담습니다.',
    safe: '참조한 칸은 아직 물건 {i}번을 보기 전의 값입니다.',
    doneD: '답은 {m}, 물건을 한 번씩만 쓴 0/1 배낭입니다. 칸 {c}개면 충분하지만, 이 줄만으로는 담은 물건을 복원할 수 없습니다.',
    doneU: '답은 {m}, 같은 물건을 여러 번 쓴 무한 배낭의 답입니다. 0/1 배낭으로는 틀린 값입니다.',
  },
  en: {
    title: 'The knapsack table in one row',
    down: 'large capacities first ←',
    up: 'small capacities first →',
    item: 'item',
    w: 'weight',
    v: 'value',
    cap: 'c',
    bag: 'packed',
    idle: 'With no items every cell is 0. Add items one at a time, rewriting the same row.',
    take: 'Item {i}, c = {c}: the larger of dp[{c}] = {a} and dp[{r}] + {v} = {b} is {m}.',
    skip: 'Item {i}, c = {c}: weight {w} does not fit, so nothing changes.',
    warn: 'The cell referred to already contains item {i}. The same item is packed again.',
    safe: 'The cell referred to still has the value from before item {i}.',
    doneD: 'The answer is {m}: 0/1 knapsack, each item used at most once. {c} cells are enough, but this row alone cannot restore the items.',
    doneU: 'The answer {m} uses an item several times: the unbounded knapsack. For 0/1 knapsack it is wrong.',
  },
  zh: {
    title: '压成一行的背包表',
    down: '先填大容量 ←',
    up: '先填小容量 →',
    item: '物品',
    w: '重量',
    v: '价值',
    cap: 'c',
    bag: '所装',
    idle: '没有物品时所有格都是 0。逐个增加物品，反复改写同一行。',
    take: '物品 {i}，c = {c}：dp[{c}] = {a} 与 dp[{r}] + {v} = {b} 中较大的是 {m}。',
    skip: '物品 {i}，c = {c}：重量 {w} 装不下，保持不变。',
    warn: '所参照的格里已经有物品 {i}。同一件物品又装了一次。',
    safe: '所参照的格还是看物品 {i} 之前的值。',
    doneD: '答案是 {m}，每件只用一次的 0/1 背包。{c} 格就够了，但只凭这一行无法还原装了什么。',
    doneU: '答案 {m} 是同一件用多次的完全背包的答案。作为 0/1 背包是错的。',
  },
};
const lang = Astro.currentLocale ?? defaultLang;
const t = STRINGS[lang] ?? STRINGS.ko;
const ITEMS = [[10, 60], [20, 100], [30, 120]];
const CAP = 50;
const STEP = 10;
---

<DpKit id={id} cls="aas-knap-1d" title={t.title} strings={t} steps slide={slide} size={2.7}>
  <Fragment slot="controls">
    {(['down', 'up'] as const).map((k, i) => <button type="button" class:list={['dx-tab', i === 0 && 'is-on']} data-dx-tab="dir" data-dx-val={k}>{t[k]}</button>)}
    <span class="dx-sep"></span>
  </Fragment>
  <div class="k1-items">
    {ITEMS.map(([w, v], i) => <span class="k1-item" data-k1-item={i}><b>{t.item} {i + 1}</b> {t.w} {w} · {t.v} {v}</span>)}
    <code>dp[c] = max(dp[c], dp[c-w] + v)</code>
  </div>
  <svg viewBox="0 0 760 190" data-dx="svg"></svg>
</DpKit>

<script is:inline define:vars={{ id, ITEMS, CAP, STEP }}>
  (() => {
    const K = aasDp;
    const { root, S, get, note, tabs } = K.root(id);
    const n = CAP / STEP + 1;
    let dir = 'down';
    let ev;
    function build() {
      ev = [];
      let dp = new Array(n).fill(0);
      let bag = Array.from({ length: n }, () => []);
      ITEMS.forEach(([w, v], i) => {
        const order = Array.from({ length: n }, (_, k) => (dir === 'down' ? n - 1 - k : k));
        order.forEach((k) => {
          const r = k - w / STEP;
          const a = dp[k];
          const e = { i, k, r, a, w, v };
          if (r < 0) e.type = 'skip';
          else {
            e.type = 'take';
            e.b = dp[r] + v;
            e.warn = bag[r].includes(i);
            if (e.b > a) {
              dp = dp.map((x, j) => (j === k ? e.b : x));
              bag = bag.map((x, j) => (j === k ? [...bag[r], i] : x));
              e.set = true;
            }
          }
          e.dp = dp;
          e.bag = bag;
          ev.push(e);
        });
      });
      ev.push({ type: 'done', dp, bag, i: ITEMS.length });
    }
    const X = (k) => 110 + k * 110;
    function draw(s) {
      const e = s ? ev[s - 1] : { type: 'idle', dp: new Array(n).fill(0), bag: Array.from({ length: n }, () => []), i: -1 };
      const g = get('svg');
      g.replaceChildren(
        K.svg('text', { x: 30, y: 62, 'font-size': 16, style: 'fill:var(--aas-muted)' }, 'c'),
        K.svg('text', { x: 30, y: 100, 'font-size': 16, style: 'fill:var(--aas-muted)' }, 'dp'),
        K.svg('text', { x: 34, y: 146, 'font-size': 14, style: 'fill:var(--aas-muted);font-family:inherit' }, S.bag),
      );
      const seen = new Set(ev.slice(0, s).filter((q) => q.i === e.i).map((q) => q.k));
      for (let k = 0; k < n; k++) {
        const c = k === e.k ? 'sv-focus' : e.type === 'take' && k === e.r ? (e.warn ? 'sv-guard' : 'sv-model') : e.type === 'done' ? (k === n - 1 ? (dir === 'down' ? 'sv-eval' : 'sv-guard') : '') : seen.has(k) ? 'sv-eval' : '';
        g.append(
          K.svg('text', { x: X(k), y: 62, 'font-size': 16, style: 'fill:var(--aas-muted)' }, String(k * STEP)),
          K.svg('rect', { x: X(k) - 45, y: 76, width: 90, height: 46, rx: 8, cls: `sv-node ${c}` }),
          K.svg('text', { x: X(k), y: 99, 'font-size': 21, 'font-weight': 700 }, String(e.dp[k])),
        );
        const b = e.bag[k];
        const W = 22;
        b.forEach((q, j) =>
          g.append(
            K.svg('rect', { x: X(k) - (b.length * W) / 2 + j * W + 1, y: 135, width: W - 2, height: 22, rx: 4, cls: `sv-node sv-${['model', 'eval', 'trace'][q]}`, style: 'stroke-width:1.5' }),
            K.svg('text', { x: X(k) - (b.length * W) / 2 + j * W + W / 2, y: 146, 'font-size': 13 }, String(q + 1)),
          ),
        );
      }
      if (e.type === 'take') {
        const c = e.warn ? 'sv-guard' : 'sv-model';
        const [a, b] = [X(e.r), X(e.k)];
        g.append(K.svg('path', { cls: `sv-edge ${c} ${e.set ? '' : 'sv-dash'}`, d: `M${a} 74Q${(a + b) / 2} ${10} ${b - 6} 72M${b - 18} 64L${b - 6} 72L${b - 3} 57` }));
      }
      const ar = dir === 'down' ? 'M640 178H130M146 170L130 178L146 186' : 'M130 178H640M624 170L640 178L624 186';
      g.append(K.svg('path', { cls: 'sv-edge sv-focus', d: ar }));
      root.querySelectorAll('[data-k1-item]').forEach((q) => q.classList.toggle('is-now', +q.dataset.k1Item === e.i));
      const m = e.dp[n - 1];
      if (e.type === 'idle') K.lines(note, S.idle);
      else if (e.type === 'done') K.lines(note, K.fill(dir === 'down' ? S.doneD : S.doneU, { m, c: `W + 1` }));
      else if (e.type === 'skip') K.lines(note, K.fill(S.skip, { i: e.i + 1, c: e.k * STEP, w: e.w }));
      else
        K.lines(
          note,
          K.fill(S.take, { i: e.i + 1, c: e.k * STEP, a: e.a, r: e.r * STEP, v: e.v, b: e.b, m: e.dp[e.k] }),
          K.fill(e.warn ? S.warn : S.safe, { i: e.i + 1 }),
        );
    }
    const st = K.stepper(root, { count: () => ev.length, draw, ms: 1000 });
    tabs('dir', (v) => {
      dir = v;
      build();
      st.reset();
    });
    build();
    st.go(0);
  })();
</script>

<style is:global>
  .aas-knap-1d .k1-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em;
    align-items: center;
    font-size: 0.82em;
  }
  .aas-knap-1d .k1-item {
    padding: 0.2em 0.7em;
    border: 1.5px solid var(--dx-line);
    border-radius: 0.5em;
    font-weight: 400;
  }
  .aas-knap-1d code {
    padding: 0.2em 0.7em;
    border: 1px solid var(--dx-line);
    border-radius: 0.5em;
    background: var(--aas-bg);
  }
  .aas-knap-1d svg {
    width: 100%;
    margin: 0 auto;
  }
  .aas-knap-1d.is-slide svg {
    max-height: 34vh;
  }
  .aas-knap-1d .dx-note {
    min-height: 3.2em;
  }
</style>
