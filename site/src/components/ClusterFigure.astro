---
// 선형 탐지의 키 무리(cluster)를 한 장에 보여 주는 정지 그림.
//
// 크기 512인 배열을 32칸씩 16줄로 접어 그린다(원형 배열이라 줄 끝은 다음 줄
// 앞으로 이어진다). 같은 난수 해시값으로 키를 넣되, 왼쪽은 선형 탐지(차 있으면
// 다음 칸), 오른쪽은 비교용 "무작위"(차 있으면 아무 빈칸이나 새로 고름)다.
// 위는 적재율 1/2, 아래는 1/4이다. Sedgewick 교재의 그림을 같은 방식으로
// 다시 그린 것이다.
//
// 칸 하나를 출발점으로 빈칸을 만날 때까지 들여다보는 칸 수를 모든 출발점에
// 대해 평균한 것이 "실패 탐색 평균"이다. 선형 탐지 이론값은
// ½(1 + 1/(1-α)²), 무작위는 1/(1-α)이다.
//
// 전부 서버에서 계산해 그리므로 스크립트가 없다. 난수는 시드를 고정한
// mulberry32라서 빌드할 때마다 같은 그림이 나온다.
import { defaultLang } from 'stack-site-builder/i18n/ui';

interface Props {
  /** 슬라이드용: 글자를 키운다. */
  slide?: boolean;
}
const { slide = false } = Astro.props;

const M = 512;
const COLS = 32;
const ROWS = M / COLS;
const LONG = 6; // 이 길이 이상인 무리를 강조한다
const SEED = 7;

function mulberry32(a: number) {
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

function simulate(n: number, seed: number, uniform: boolean) {
  const rand = mulberry32(seed);
  const occ = new Array<boolean>(M).fill(false);
  for (let k = 0; k < n; k++) {
    let i = Math.floor(rand() * M);
    while (occ[i]) i = uniform ? Math.floor(rand() * M) : (i + 1) % M;
    occ[i] = true;
  }
  // 칸마다 속한 무리의 길이. 원형이므로 빈칸 하나 다음에서 출발해 한 바퀴 돈다.
  const runLen = new Array<number>(M).fill(0);
  const start = (occ.indexOf(false) + 1) % M;
  let longest = 0;
  let members: number[] = [];
  for (let c = 0; c <= M; c++) {
    const j = (start + c) % M;
    if (c < M && occ[j]) {
      members.push(j);
    } else {
      members.forEach((x) => (runLen[x] = members.length));
      longest = Math.max(longest, members.length);
      members = [];
    }
  }
  let total = 0;
  for (let s = 0; s < M; s++) {
    let p = 1;
    for (let i = s; occ[i]; i = (i + 1) % M) p += 1;
    total += p;
  }
  return { occ, runLen, longest, miss: total / M };
}

const loads = [
  { label: '1/2', alpha: 0.5 },
  { label: '1/4', alpha: 0.25 },
];
const panels = loads.map(({ label, alpha }) => ({
  label,
  lp: simulate(M * alpha, SEED, false),
  uni: simulate(M * alpha, SEED + 100, true),
  lpTheory: 0.5 * (1 + 1 / (1 - alpha) ** 2),
  uniTheory: 1 / (1 - alpha),
}));

const STRINGS: Record<string, Record<string, string>> = {
  ko: {
    lp: '선형 탐지',
    uni: '무작위 (비교용)',
    load: '적재율',
    longest: '가장 긴 무리',
    miss: '실패 탐색 평균',
    theory: '이론',
    legend: `주황: 길이 ${LONG} 이상인 무리 · 배열 512칸을 32칸씩 접어 그림`,
  },
  en: {
    lp: 'Linear probing',
    uni: 'Random (for comparison)',
    load: 'load',
    longest: 'longest cluster',
    miss: 'avg. miss',
    theory: 'theory',
    legend: `Orange: clusters of length ${LONG} or more · 512 slots folded into rows of 32`,
  },
  zh: {
    lp: '线性探测',
    uni: '随机（对照）',
    load: '装载因子',
    longest: '最长簇',
    miss: '未命中平均',
    theory: '理论',
    legend: `橙色：长度 ${LONG} 以上的簇 · 512 格按每行 32 格折叠绘制`,
  },
};
const lang = Astro.currentLocale ?? defaultLang;
const t = STRINGS[lang] ?? STRINGS[defaultLang] ?? STRINGS.ko;

const CELL = 10;
const GAP = 2;
const W = COLS * (CELL + GAP) - GAP;
const H = ROWS * (CELL + GAP) - GAP;
const cellsOf = (run: { occ: boolean[]; runLen: number[] }) =>
  run.occ.map((full, i) => ({
    x: (i % COLS) * (CELL + GAP),
    y: Math.floor(i / COLS) * (CELL + GAP),
    cls: !full ? 'cf-empty' : run.runLen[i] >= LONG ? 'cf-long' : 'cf-full',
  }));
---

<figure class:list={['aas-cluster-figure', slide && 'is-slide']}>
  {
    panels.map((p) => (
      <div class="cf-row">
        <div class="cf-alpha">
          α = {p.label}
        </div>
        {[
          { name: t.lp, run: p.lp, theory: p.lpTheory },
          { name: t.uni, run: p.uni, theory: p.uniTheory },
        ].map((side) => (
          <div class="cf-panel">
            <div class="cf-name">{side.name}</div>
            <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${side.name}, α = ${p.label}`}>
              {cellsOf(side.run).map((c) => (
                <rect x={c.x} y={c.y} width={CELL} height={CELL} rx="2" class={c.cls} />
              ))}
            </svg>
            <div class="cf-stats">
              <span>
                {t.longest} <b>{side.run.longest}</b>
              </span>
              <span>
                {t.miss} <b>{side.run.miss.toFixed(2)}</b> ({t.theory} {side.theory.toFixed(2)})
              </span>
            </div>
          </div>
        ))}
      </div>
    ))
  }
  <figcaption>{t.legend}</figcaption>
</figure>

<style>
  .aas-cluster-figure {
    /* 안쪽 치수는 모두 이 값에 대한 em이다. */
    font-size: 1rem;
    margin: 1.5rem 0;
    padding: 1em;
    border: 1px solid var(--aas-border);
    border-radius: 0.9em;
    background: var(--aas-panel);
  }
  .cf-row {
    display: grid;
    grid-template-columns: 3.6em 1fr 1fr;
    gap: 0.8em;
    align-items: center;
  }
  .cf-row + .cf-row {
    margin-top: 1em;
  }
  .cf-alpha {
    font-family: var(--aas-mono, monospace);
    font-size: 0.85em;
    font-weight: 700;
    color: var(--aas-muted);
  }
  .cf-name {
    font-size: 0.85em;
    font-weight: 700;
    margin-bottom: 0.3em;
  }
  .cf-panel svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .cf-empty {
    fill: color-mix(in srgb, var(--aas-muted) 12%, transparent);
  }
  .cf-full {
    fill: var(--aas-role-model);
  }
  .cf-long {
    fill: var(--aas-role-focus);
  }
  .cf-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2em 1em;
    margin-top: 0.35em;
    font-size: 0.75em;
    color: var(--aas-muted);
  }
  .cf-stats b {
    color: var(--aas-text);
    font-family: var(--aas-mono, monospace);
  }
  figcaption {
    margin-top: 0.8em;
    font-size: 0.8em;
    color: var(--aas-muted);
    text-align: center;
  }

  @media (max-width: 640px) {
    .cf-row {
      grid-template-columns: 1fr;
    }
  }

  /* 슬라이드용. 다른 데모와 같은 크기. vh 단위인 이유는 SearchDemo 참고 */
  .aas-cluster-figure.is-slide {
    font-size: clamp(1rem, 2.8vh, 1.8rem);
    margin: 0.5rem 0;
    padding: 0.6em 1em;
  }
</style>
