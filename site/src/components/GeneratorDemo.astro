---
// Python 제너레이터로 lazy와 eager의 차이를 만져 보는 데모.
//
// 왼쪽은 리스트를 다 만들어 돌려주는 함수, 오른쪽은 제너레이터다. n을 바꾸면 왼쪽은 그
// 수만큼 곧바로 계산한 것으로 바뀌지만 오른쪽은 아직 0개다. next()를 누를 때마다 오른쪽만
// 한 값씩 계산하고, yield에서 멈춘 줄이 칠해진다. 값이 다 떨어지면 StopIteration이 나고,
// 무한 피보나치에서는 왼쪽(eager)이 애초에 끝나지 않는다.
//
// 코드는 슬라이드의 squares_eager, squares_lazy, fibonacci_infinite와 같다.
// 피보나치 값은 BigInt로 계산해 아무리 눌러도 정밀도가 깨지지 않는다.
import { defaultLang } from 'stack-site-builder/i18n/ui';

interface Props {
  /** 슬라이드용: 바깥 여백은 줄이고 글자와 칸은 키운다. */
  slide?: boolean;
}
const { slide = false } = Astro.props;
const id = `gn-${Math.random().toString(36).slice(2, 9)}`;
const SIZES = [10, 1000, 1000000];
const STRINGS: Record<string, Record<string, string>> = {
  ko: {
    title: '다 만들어 두기와 그때그때 만들기',
    squares: '제곱수',
    fib: '무한 피보나치',
    eager: 'eager: 리스트',
    lazy: 'lazy: 제너레이터',
    done: '계산한 값',
    cells: '저장한 칸',
    stateOnly: '지금 상태만',
    forever: '끝나지 않음',
    neverLine: '# while True라 여기서 끝나지 않는다',
    next: 'next()',
    again: '처음으로',
    idleSq: '함수를 불렀지만 제너레이터는 아직 한 줄도 돌지 않았습니다. 리스트 쪽은 벌써 {n}개를 계산했습니다.',
    idleFib: '정의만 했을 뿐 아직 아무것도 계산하지 않았습니다. 리스트로 만들려 들면 끝나지 않습니다.',
    firstSq: '첫 next()에서 비로소 몸체가 돌고, yield에서 값 {v} 내주고 멈춥니다.',
    stepSq: '멈춘 자리에서 이어 돌아 i = {i}, yield에서 값 {v} 내주고 다시 멈춥니다.',
    stepFib: '멈춘 자리에서 이어 돌아 a, b를 고치고, yield에서 값 {v} 내주고 다시 멈춥니다.',
    firstFib: '첫 next()에서 a, b = 0, 1이 실행되고, yield에서 0을 내주고 멈춥니다.',
    stop: '값이 떨어져 StopIteration이 납니다. {n}개를 다 썼으니 리스트와 계산량이 같습니다.',
    saved: '{k}개만 쓰고 그만두면 {left}개는 계산하지 않아도 됩니다.',
  },
  en: {
    title: 'Build it all or build on demand',
    squares: 'Squares',
    fib: 'Infinite Fibonacci',
    eager: 'eager: list',
    lazy: 'lazy: generator',
    done: 'values computed',
    cells: 'cells stored',
    stateOnly: 'current state only',
    forever: 'never finishes',
    neverLine: '# while True, so this never returns',
    next: 'next()',
    again: 'Reset',
    idleSq: 'The function was called, but the generator has not run a single line. The list has already computed {n} values.',
    idleFib: 'It is only defined, and nothing has been computed. Making it a list would never finish.',
    firstSq: 'Only the first next() runs the body. It yields {v} and pauses.',
    stepSq: 'It resumes where it paused, reaches i = {i}, yields {v} and pauses again.',
    stepFib: 'It resumes where it paused, updates a and b, yields {v} and pauses again.',
    firstFib: 'The first next() runs a, b = 0, 1, yields 0 and pauses.',
    stop: 'The values run out and StopIteration is raised. All {n} were used, so the work equals the list.',
    saved: 'Stop after {k} and the other {left} never need computing.',
  },
  zh: {
    title: '全部做好还是用时再做',
    squares: '平方数',
    fib: '无穷斐波那契',
    eager: 'eager：列表',
    lazy: 'lazy：生成器',
    done: '已计算的值',
    cells: '已保存的格',
    stateOnly: '只有当前状态',
    forever: '永远结束不了',
    neverLine: '# while True，这一行永远结束不了',
    next: 'next()',
    again: '重置',
    idleSq: '函数调用了，但生成器一行都还没运行。列表那边已经算了 {n} 个。',
    idleFib: '只是定义了，什么都还没算。想做成列表就永远结束不了。',
    firstSq: '第一次 next() 才运行函数体，在 yield 交出 {v} 后暂停。',
    stepSq: '从暂停处继续，到 i = {i}，在 yield 交出 {v} 后再次暂停。',
    stepFib: '从暂停处继续，更新 a、b，在 yield 交出 {v} 后再次暂停。',
    firstFib: '第一次 next() 执行 a, b = 0, 1，在 yield 交出 0 后暂停。',
    stop: '值用完了，抛出 StopIteration。{n} 个都用了，计算量和列表一样。',
    saved: '只用 {k} 个就停下的话，另外 {left} 个不必计算。',
  },
};
const lang = Astro.currentLocale ?? defaultLang;
const t = STRINGS[lang] ?? STRINGS[defaultLang] ?? STRINGS.ko;
const fmt = (x: number) => x.toLocaleString('en-US');
---

<div
  class:list={['aas-generator-demo', slide && 'is-slide']}
  id={id}
  data-gn-strings={JSON.stringify(t)}
>
  <div class="gn-bar">
    <span class="gn-head"><strong>{t.title}</strong></span>
    <div class="gn-tabs">
      <button type="button" class="gn-tab" data-gn-kind="squares">{t.squares}</button>
      <button type="button" class="gn-tab" data-gn-kind="fib">{t.fib}</button>
    </div>
    <div class="gn-tabs" data-gn-sizes>
      <span class="gn-label">n</span>
      {
        SIZES.map((s) => (
          <button type="button" class="gn-tab" data-gn-size={s}>
            {fmt(s)}
          </button>
        ))
      }
    </div>
    <span class="gn-controls">
      <button type="button" class="gn-btn gn-btn-primary" data-gn-next>{t.next}</button>
      <button type="button" class="gn-btn" data-gn-reset>{t.again}</button>
    </span>
  </div>

  <div class="gn-panels">
    <div class="gn-panel">
      <h4>{t.eager}</h4>
      <pre class="gn-code" data-gn-eager-code></pre>
      <dl class="gn-stats">
        <dt>{t.done}</dt>
        <dd data-gn-eager-done></dd>
        <dt>{t.cells}</dt>
        <dd data-gn-eager-cells></dd>
      </dl>
    </div>
    <div class="gn-panel">
      <h4>{t.lazy}</h4>
      <pre class="gn-code" data-gn-lazy-code></pre>
      <dl class="gn-stats">
        <dt>{t.done}</dt>
        <dd data-gn-lazy-done></dd>
        <dt>{t.cells}</dt>
        <dd>{t.stateOnly}</dd>
      </dl>
    </div>
  </div>

  <div class="gn-values" data-gn-values></div>
  <p class="gn-note" data-gn-note></p>
</div>

<script is:inline define:vars={{ id }}>
  (() => {
    const root = document.getElementById(id);
    if (!root) return;

    /* 설명은 문장마다 줄을 바꾼다. 마침표 뒤 공백, 또는 중국어 마침표 뒤에서 끊는다. */
    const setLines = (node, text) => {
      const parts = String(text).split(/(?<=[.!?])\s+(?=\S)|(?<=[。！？])(?=\S)/);
      node.replaceChildren(...parts.flatMap((s, i) => (i ? [document.createElement('br'), s] : [s])));
    };
    /* 문장 잇기. 중국어 마침표 뒤에는 공백을 두지 않아야 setLines가 끊는다. */
    const join = (...parts) =>
      parts.filter(Boolean).reduce((a, b) => (/[。！？]$/.test(a) ? a + b : `${a} ${b}`), '');
    const fill = (tpl, vars) => tpl.replace(/\{(\w+)\}/g, (_, k) => vars[k]);
    const S = JSON.parse(root.dataset.gnStrings);
    const fmt = (x) => x.toLocaleString('en-US');

    const CODE = {
      squaresEager: ['def squares_eager(n):', '    result = []', '    for i in range(n):', '        result.append(i * i)', '    return result'],
      squaresLazy: ['def squares_lazy(n):', '    for i in range(n):', '        yield i * i'],
      fibEager: ['fib = list(fibonacci_infinite())', S.neverLine],
      fibLazy: ['def fibonacci_infinite():', '    a, b = 0, 1', '    while True:', '        yield a', '        a, b = b, a + b'],
    };
    const put = (name, v) => {
      root.querySelector(`[data-gn-${name}]`).textContent = String(v);
    };
    const code = (name, lines, active) => {
      root.querySelector(`[data-gn-${name}-code]`).innerHTML = lines
        .map((l, i) => `<span class="${i === active ? 'is-now' : ''}">${l.replace(/</g, '&lt;')}</span>`)
        .join('\n');
    };

    let kind = 'squares';
    let N = 10;
    let given = [];
    let stopped = false;
    /* 제너레이터의 상태: 제곱수는 i, 피보나치는 a, b */
    let i = 0;
    let a = 0n;
    let b = 1n;

    function reset() {
      given = [];
      stopped = false;
      i = 0;
      a = 0n;
      b = 1n;
    }
    /* next() 한 번. 멈춘 자리에서 다음 yield까지 돈다. */
    function next() {
      if (stopped) return;
      if (kind === 'squares') {
        if (i >= N) {
          stopped = true;
          return;
        }
        given.push(BigInt(i) * BigInt(i));
        i += 1;
      } else {
        if (given.length) [a, b] = [b, a + b];
        given.push(a);
      }
    }

    function draw() {
      const k = given.length;
      const last = k ? String(given[k - 1]) : '';
      root.querySelectorAll('[data-gn-kind]').forEach((el) => el.classList.toggle('is-on', el.dataset.gnKind === kind));
      root.querySelectorAll('[data-gn-size]').forEach((el) => el.classList.toggle('is-on', +el.dataset.gnSize === N));
      root.querySelector('[data-gn-sizes]').classList.toggle('is-off', kind !== 'squares');
      root.querySelector('[data-gn-next]').disabled = stopped;
      if (kind === 'squares') {
        code('eager', CODE.squaresEager, -1);
        code('lazy', CODE.squaresLazy, stopped ? 1 : k ? 2 : -1);
        put('eager-done', fmt(N));
        put('eager-cells', fmt(N));
      } else {
        code('eager', CODE.fibEager, 1);
        code('lazy', CODE.fibLazy, k ? 3 : -1);
        put('eager-done', S.forever);
        put('eager-cells', S.forever);
      }
      put('lazy-done', fmt(k));
      const shown = given.slice(-14);
      root.querySelector('[data-gn-values]').innerHTML =
        (k > shown.length ? '<span class="gn-dots">…</span>' : '') +
        shown.map((v, n) => `<b class="${n === shown.length - 1 ? 'is-now' : ''}">${v}</b>`).join('');

      let text;
      if (kind === 'squares') {
        if (stopped) text = fill(S.stop, { n: fmt(N) });
        else if (k === 0) text = fill(S.idleSq, { n: fmt(N) });
        else {
          const head = k === 1 ? fill(S.firstSq, { v: last }) : fill(S.stepSq, { i: i - 1, v: last });
          text = N - k > 0 ? join(head, fill(S.saved, { k: fmt(k), left: fmt(N - k) })) : head;
        }
      } else if (k === 0) {
        text = S.idleFib;
      } else {
        text = k === 1 ? S.firstFib : fill(S.stepFib, { v: last });
      }
      setLines(root.querySelector('[data-gn-note]'), text);
    }

    root.querySelectorAll('[data-gn-kind]').forEach((el) =>
      el.addEventListener('click', () => {
        kind = el.dataset.gnKind;
        reset();
        draw();
      }),
    );
    root.querySelectorAll('[data-gn-size]').forEach((el) =>
      el.addEventListener('click', () => {
        N = +el.dataset.gnSize;
        reset();
        draw();
      }),
    );
    root.querySelector('[data-gn-next]').addEventListener('click', () => {
      next();
      draw();
    });
    root.querySelector('[data-gn-reset]').addEventListener('click', () => {
      reset();
      draw();
    });
    draw();
  })();
</script>

<style is:global>
  .aas-generator-demo {
    /* 안쪽 치수는 모두 이 값에 대한 em이다(다른 데모들과 같은 방식). */
    font-size: 1rem;
    margin: 1.5rem 0;
    padding: 1em;
    border: 1px solid var(--aas-border);
    border-radius: 0.9em;
    background: var(--aas-panel);
  }
  .aas-generator-demo .gn-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em 0.9em;
    align-items: center;
    justify-content: space-between;
  }
  .aas-generator-demo .gn-head {
    font-size: 0.95em;
  }
  .aas-generator-demo .gn-tabs,
  .aas-generator-demo .gn-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3em;
    align-items: center;
  }
  .aas-generator-demo .gn-tabs.is-off {
    visibility: hidden;
  }
  .aas-generator-demo .gn-label {
    margin-right: 0.2em;
    font-family: var(--aas-mono, monospace);
    font-size: 0.85em;
    color: var(--aas-muted);
  }
  .aas-generator-demo .gn-tab {
    padding: 0.25em 0.75em;
    font-size: 0.85em;
    border: 1px solid var(--aas-border);
    border-radius: 999px;
    background: var(--aas-bg);
    color: var(--aas-text);
    cursor: pointer;
  }
  .aas-generator-demo .gn-tab.is-on {
    background: color-mix(in srgb, var(--aas-accent) 18%, var(--aas-bg));
    border-color: var(--aas-accent);
    font-weight: 700;
  }
  .aas-generator-demo .gn-btn {
    padding: 0.35em 0.8em;
    font-size: 0.85em;
    border: 1px solid var(--aas-border);
    border-radius: 0.5em;
    background: var(--aas-bg);
    color: var(--aas-text);
    cursor: pointer;
  }
  .aas-generator-demo .gn-btn:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .aas-generator-demo .gn-btn-primary {
    background: var(--aas-accent);
    border-color: var(--aas-accent);
    color: #fff;
  }
  .aas-generator-demo .gn-tab:hover,
  .aas-generator-demo .gn-btn:hover:not(:disabled) {
    border-color: var(--aas-accent);
  }
  .aas-generator-demo .gn-panels {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6em;
    margin-top: 0.6em;
  }
  .aas-generator-demo .gn-panel {
    min-width: 0;
    padding: 0.5em 0.7em;
    border: 1px solid var(--aas-border);
    border-radius: 0.6em;
    background: var(--aas-bg);
  }
  .aas-generator-demo h4 {
    margin: 0 0 0.3em;
    font-size: 0.85em;
    font-weight: 600;
    color: var(--aas-text);
  }
  .aas-generator-demo .gn-code {
    margin: 0;
    padding: 0;
    min-height: 7.5em;
    font-family: var(--aas-mono, monospace);
    font-size: 0.78em;
    line-height: 1.5;
    color: var(--aas-text);
    background: transparent;
    border: 0;
    white-space: pre-wrap;
  }
  .aas-generator-demo .gn-code span.is-now {
    background: color-mix(in srgb, var(--aas-role-focus) 30%, var(--aas-bg));
    border-radius: 0.2em;
  }
  .aas-generator-demo .gn-stats {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0 0.7em;
    margin: 0.3em 0 0;
    font-size: 0.82em;
    line-height: 1.4;
  }
  .aas-generator-demo .gn-stats dt {
    margin: 0;
    font-weight: 400;
    color: var(--aas-muted);
  }
  .aas-generator-demo .gn-stats dd {
    margin: 0;
    text-align: right;
    font-family: var(--aas-mono, monospace);
    font-weight: 700;
  }
  .aas-generator-demo .gn-values {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.25em;
    align-items: center;
    min-height: 2em;
    margin-top: 0.5em;
    overflow: hidden;
    font-family: var(--aas-mono, monospace);
    font-size: 0.85em;
  }
  .aas-generator-demo .gn-values b {
    padding: 0.1em 0.5em;
    font-weight: 400;
    border: 1px solid var(--aas-border);
    border-radius: 0.35em;
    background: var(--aas-bg);
    white-space: nowrap;
  }
  .aas-generator-demo .gn-values b.is-now {
    border-color: var(--aas-role-focus);
    background: color-mix(in srgb, var(--aas-role-focus) 22%, var(--aas-bg));
    font-weight: 700;
  }
  .aas-generator-demo .gn-dots {
    color: var(--aas-muted);
  }
  .aas-generator-demo .gn-note {
    margin: 0.4em 0 0;
    font-size: 0.85em;
    min-height: 2.8em;
  }

  /* 슬라이드용. 다른 데모와 같은 방식. vh 단위인 이유는 SearchDemo 참고 */
  .aas-generator-demo.is-slide {
    font-size: clamp(1rem, 2.8vh, 1.9rem);
    margin: 0.5rem 0;
  }

  @media (max-width: 720px) {
    .aas-generator-demo .gn-panels {
      grid-template-columns: 1fr;
    }
  }
</style>
