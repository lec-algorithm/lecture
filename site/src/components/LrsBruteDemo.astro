---
// 가장 긴 반복 부분 문자열을 무차별 대입으로 찾는 과정을 한 쌍씩 보는 데모.
//
// 왼쪽 위 띠가 텍스트이고, 시작 위치 i(주황)와 j(파랑)를 표시한다. 그 아래에
// T[i..]와 T[j..]를 맞대어 공통 접두사(초록)와 처음 갈린 글자(빨강)를 칠한다.
// 오른쪽 삼각형은 쌍 (i, j)마다 한 칸이고, 본 쌍은 공통 접두사 길이를 적어
// 칠한다. 칸을 누르면 그 쌍으로 바로 간다. 칸이 n(n-1)/2개라는 것이 곧 비용이다.
//
// 세는 방법은 05_lrs의 lrs_brute_force와 같다. j + h < n인 동안 글자를 하나
// 비교하고, 다르면 멈춘다. 기본 입력에서 120쌍, 글자 비교 161번, 답 "acaag"는
// 실습 코드의 출력과 같다.
import { defaultLang } from 'stack-site-builder/i18n/ui';

interface Props {
  /** 끝 글자($)를 포함한 텍스트 */
  text?: string;
  /** 슬라이드용: 바깥 여백은 줄이고 글자와 칸은 키운다. */
  slide?: boolean;
}
const { text = 'aacaagtttacaagc$', slide = false } = Astro.props;
const id = `lb-${Math.random().toString(36).slice(2, 9)}`;
const n = text.length;
const chars = [...text];

const STRINGS: Record<string, Record<string, string>> = {
  ko: {
    title: '가장 긴 반복 부분 문자열: 무차별 대입',
    back: '뒤로',
    step: '한 걸음',
    play: '자동 재생',
    stop: '멈춤',
    reset: '처음으로',
    rowI: 'i',
    rowT: 'T',
    gridLabel: '칸 (i, j) = 공통 접두사 길이 · 칸을 누르면 그 쌍으로 갑니다',
    pairsLabel: '본 쌍',
    charLabel: '글자 비교',
    bestLabel: '최댓값',
    idle: '시작 위치 쌍 i < j를 모두 시도합니다. 쌍마다 T[i..]와 T[j..]를 앞에서부터 비교해 공통 접두사 길이를 셉니다.',
    pair: 'i = {i}, j = {j}: 공통 접두사 "{p}", 길이 {h}입니다. 글자를 {c}번 비교했습니다.',
    pairNone: 'i = {i}, j = {j}: 첫 글자부터 다릅니다. 글자를 {c}번 비교했습니다.',
    better: ' 지금까지 가장 깁니다.',
    done: '쌍 {pairs}개를 모두 보고 글자를 {c}번 비교했습니다. 답은 "{ans}" (길이 {h})이고, 위치 {i}, {j}에서 시작합니다. 접미사를 정렬하면 이웃 쌍 {m}개만 보면 됩니다.',
  },
  en: {
    title: 'Longest repeated substring: brute force',
    back: 'Back',
    step: 'Step',
    play: 'Play',
    stop: 'Pause',
    reset: 'Reset',
    rowI: 'i',
    rowT: 'T',
    gridLabel: 'cell (i, j) = common prefix length · click a cell to jump to that pair',
    pairsLabel: 'pairs',
    charLabel: 'char compares',
    bestLabel: 'best',
    idle: 'Try every pair of start positions i < j. For each pair, compare T[i..] and T[j..] from the front and count the common prefix.',
    pair: 'i = {i}, j = {j}: common prefix "{p}", length {h}. {c} char compares.',
    pairNone: 'i = {i}, j = {j}: the first characters differ. {c} char compare.',
    better: ' Longest so far.',
    done: 'Checked {pairs} pairs with {c} char compares. The answer is "{ans}" (length {h}) at positions {i} and {j}. Sorted suffixes need only {m} neighbor pairs.',
  },
  zh: {
    title: '最长重复子串：暴力枚举',
    back: '后退',
    step: '单步',
    play: '播放',
    stop: '暂停',
    reset: '重置',
    rowI: 'i',
    rowT: 'T',
    gridLabel: '格 (i, j) = 公共前缀长度 · 点击格子跳到该对',
    pairsLabel: '已看',
    charLabel: '字符比较',
    bestLabel: '最大值',
    idle: '尝试所有起点对 i < j。对每一对，从头比较 T[i..] 和 T[j..]，数出公共前缀的长度。',
    pair: 'i = {i}, j = {j}：公共前缀 "{p}"，长度 {h}。比较了 {c} 次字符。',
    pairNone: 'i = {i}, j = {j}：第一个字符就不同。比较了 {c} 次字符。',
    better: '是目前最长的。',
    done: '{pairs} 对全部看完。答案是 "{ans}"（长度 {h}），起点为 {i} 和 {j}，共比较字符 {c} 次。若先对后缀排序，只需看 {m} 对相邻后缀。',
  },
};
const lang = Astro.currentLocale ?? defaultLang;
const t = STRINGS[lang] ?? STRINGS[defaultLang] ?? STRINGS.ko;
---

<div
  class:list={['aas-lrs-brute-demo', slide && 'is-slide']}
  id={id}
  data-lb-text={text}
  data-lb-strings={JSON.stringify(t)}
  style={`--lb-n: ${n}; --lb-n1: ${n + 1}`}
>
  <div class="lb-bar">
    <span class="lb-head"><strong>{t.title}</strong></span>
    <div class="lb-controls">
      <button type="button" data-act="back" class="lb-btn">{t.back}</button>
      <button type="button" data-act="step" class="lb-btn">{t.step}</button>
      <button type="button" data-act="play" class="lb-btn lb-btn-primary">{t.play}</button>
      <button type="button" data-act="reset" class="lb-btn">{t.reset}</button>
    </div>
  </div>

  <div class="lb-body">
    <div class="lb-left">
      <div class="lb-band">
        <span class="lb-tag">{t.rowI}</span>
        {chars.map((_, i) => <span class="lb-idx" data-lb-idx={i}>{i}</span>)}
        <span class="lb-tag">{t.rowT}</span>
        {chars.map((ch, i) => <span class="lb-tc" data-lb-tc={i}>{ch}</span>)}
      </div>
      <div class="lb-align">
        <span class="lb-tag lb-tag-i" data-lb-tag="i">i</span>
        <span class="lb-line" data-lb-line="i"></span>
        <span class="lb-tag lb-tag-j" data-lb-tag="j">j</span>
        <span class="lb-line" data-lb-line="j"></span>
      </div>
      <p class="lb-best">{t.bestLabel} <strong data-lb-best>-</strong></p>
      <p class="lb-note" data-lb-note></p>
      <span class="lb-count">
        {t.pairsLabel} <strong data-lb-pairs>0</strong>/{(n * (n - 1)) / 2} · {t.charLabel} <strong data-lb-chars>0</strong>
      </span>
    </div>

    <div class="lb-right">
      <div class="lb-grid" data-lb-grid>
        <span class="lb-corner"></span>
        {chars.map((ch, j) => <span class="lb-gh" data-lb-gh-col={j}>{ch}</span>)}
        {chars.map((chI, i) => [
          <span class="lb-gh" data-lb-gh-row={i}>{chI}</span>,
          ...chars.map((_, j) =>
            j > i ? (
              <button type="button" class="lb-cell" data-lb-cell={`${i},${j}`} aria-label={`(${i}, ${j})`}></button>
            ) : (
              <span class="lb-void"></span>
            ),
          ),
        ])}
      </div>
      <p class="lb-grid-label">{t.gridLabel}</p>
    </div>
  </div>

</div>

<script is:inline define:vars={{ id }}>
  (() => {
    const root = document.getElementById(id);
    if (!root) return;

    /* 설명은 문장마다 줄을 바꾼다. 마침표 뒤 공백, 또는 중국어 마침표 뒤에서 끊는다. */
    const setLines = (node, text) => {
      const parts = String(text).split(/(?<=[.!?])\s+(?=\S)|(?<=[。！？])(?=\S)/);
      node.replaceChildren(...parts.flatMap((s, i) => (i ? [document.createElement('br'), s] : [s])));
    };

    const T = root.dataset.lbText;
    const S = JSON.parse(root.dataset.lbStrings);
    const fill = (tpl, vars) => tpl.replace(/\{(\w+)\}/g, (_, key) => vars[key]);
    const n = T.length;

    /* lrs_brute_force와 같은 순서, 같은 셈. 쌍 하나가 한 걸음이다. */
    function plan() {
      const steps = [];
      let best = 0;
      let bi = -1;
      let bj = -1;
      let total = 0;
      for (let i = 0; i < n; i++) {
        for (let j = i + 1; j < n; j++) {
          let h = 0;
          let c = 0;
          while (j + h < n) {
            c += 1;
            if (T[i + h] !== T[j + h]) break;
            h += 1;
          }
          total += c;
          const better = h > best;
          if (better) {
            best = h;
            bi = i;
            bj = j;
          }
          let note = h > 0 ? fill(S.pair, { i, j, p: T.slice(i, i + h), h, c }) : fill(S.pairNone, { i, j, c });
          if (better) note += S.better;
          steps.push({ i, j, h, c, total, best, bi, bj, note });
        }
      }
      const last = steps[steps.length - 1];
      steps.push({
        ...last, i: -1, j: -1, finished: true,
        note: fill(S.done, { pairs: steps.length, ans: T.slice(bi, bi + best), h: best, i: bi, j: bj, c: total, m: n - 1 }),
      });
      return steps;
    }

    const steps = plan();
    const pairCount = steps.length - 1;
    const cells = new Map();
    root.querySelectorAll('[data-lb-cell]').forEach((el) => cells.set(el.dataset.lbCell, el));
    const idxEls = [...root.querySelectorAll('[data-lb-idx]')];
    const tcEls = [...root.querySelectorAll('[data-lb-tc]')];
    const lineI = root.querySelector('[data-lb-line="i"]');
    const lineJ = root.querySelector('[data-lb-line="j"]');
    const tagI = root.querySelector('[data-lb-tag="i"]');
    const tagJ = root.querySelector('[data-lb-tag="j"]');
    const rowHeads = [...root.querySelectorAll('[data-lb-gh-row]')];
    const colHeads = [...root.querySelectorAll('[data-lb-gh-col]')];
    const note = root.querySelector('[data-lb-note]');
    const pairsEl = root.querySelector('[data-lb-pairs]');
    const charsEl = root.querySelector('[data-lb-chars]');
    const bestEl = root.querySelector('[data-lb-best]');

    /* 맞댄 줄: 위치 start부터 끝까지 글자를 칸으로 늘어놓고, 앞 h글자는 일치,
       h번째는 불일치로 칠한다. */
    function paintLine(line, start, h, c) {
      const parts = [];
      if (start >= 0) {
        for (let k = 0; start + k < n; k++) {
          const s = document.createElement('span');
          s.className = 'lb-ch';
          s.textContent = T[start + k];
          if (k < h) s.classList.add('is-match');
          else if (k === h && k < c) s.classList.add('is-miss');
          parts.push(s);
        }
      }
      line.replaceChildren(...parts);
    }

    function render(s) {
      const st = s >= 0 ? steps[s] : null;
      const live = st && !st.finished;
      const seen = st ? (st.finished ? pairCount : s + 1) : 0;
      /* 본 쌍의 칸에 길이를 적는다. 단계 배열이 쌍 순서와 같으므로 앞 seen개 */
      for (let k = 0; k < pairCount; k++) {
        const p = steps[k];
        const cell = cells.get(`${p.i},${p.j}`);
        const on = k < seen;
        cell.textContent = on && p.h > 0 ? String(p.h) : '';
        cell.classList.toggle('is-seen', on);
        cell.classList.toggle('is-hit', on && p.h > 0);
        cell.style.setProperty('--lb-h', String(on ? p.h : 0));
        cell.classList.toggle('is-now', !!live && k === s);
        cell.classList.toggle('is-best', !!st && st.best > 0 && p.i === st.bi && p.j === st.bj && on);
      }
      const i = live ? st.i : st && st.finished ? st.bi : -1;
      const j = live ? st.j : st && st.finished ? st.bj : -1;
      const h = live ? st.h : st && st.finished ? st.best : 0;
      const c = live ? st.c : st && st.finished ? st.best + 1 : 0;
      idxEls.forEach((el, p) => {
        el.classList.toggle('is-i', p === i);
        el.classList.toggle('is-j', p === j);
      });
      tcEls.forEach((el, p) => {
        el.classList.toggle('is-i', i >= 0 && p >= i && p < i + h);
        el.classList.toggle('is-j', j >= 0 && p >= j && p < j + h);
      });
      rowHeads.forEach((el, p) => el.classList.toggle('is-i', p === i));
      colHeads.forEach((el, p) => el.classList.toggle('is-j', p === j));
      paintLine(lineI, i, h, c);
      paintLine(lineJ, j, h, c);
      tagI.textContent = i >= 0 ? `i = ${i}` : 'i';
      tagJ.textContent = j >= 0 ? `j = ${j}` : 'j';
      pairsEl.textContent = String(seen);
      charsEl.textContent = String(st ? st.total : 0);
      bestEl.textContent = st && st.best > 0 ? `"${T.slice(st.bi, st.bi + st.best)}" (${st.best})` : '-';
      setLines(note, st ? st.note : S.idle);
      root.classList.toggle('is-done', !!(st && st.finished));
    }

    let at = -1;
    let timer = null;
    const playBtn = root.querySelector('[data-act="play"]');

    function stop() {
      if (timer) clearInterval(timer);
      timer = null;
      playBtn.textContent = S.play;
    }

    function step() {
      if (at >= steps.length - 1) return stop();
      at += 1;
      render(at);
      if (at >= steps.length - 1) stop();
    }

    root.querySelector('[data-lb-grid]').addEventListener('click', (ev) => {
      const cell = ev.target.closest('[data-lb-cell]');
      if (!cell) return;
      const [ci, cj] = cell.dataset.lbCell.split(',').map(Number);
      const k = steps.findIndex((p) => p.i === ci && p.j === cj);
      if (k < 0) return;
      stop();
      at = k;
      render(at);
    });
    root.querySelector('[data-act="back"]').addEventListener('click', () => {
      stop();
      if (at > -1) at -= 1;
      render(at);
    });
    root.querySelector('[data-act="step"]').addEventListener('click', () => {
      stop();
      step();
    });
    root.querySelector('[data-act="reset"]').addEventListener('click', () => {
      stop();
      at = -1;
      render(-1);
    });
    playBtn.addEventListener('click', () => {
      if (timer) return stop();
      if (at >= steps.length - 1) {
        at = -1;
        render(-1);
      }
      playBtn.textContent = S.stop;
      timer = setInterval(step, 260);
    });

    render(-1);
  })();
</script>

<style is:global>
  .aas-lrs-brute-demo {
    /* 안쪽 치수는 모두 이 값에 대한 em이다. 슬라이드는 font-size만 키운다. */
    --lb-ch: 1.05em;
    --lb-cell: 0.8em;
    font-size: 1rem;
    margin: 1.5rem 0;
    padding: 1em;
    border: 1px solid var(--aas-border);
    border-radius: 0.9em;
    background: var(--aas-panel);
  }
  .aas-lrs-brute-demo .lb-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75em;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.9em;
  }
  .aas-lrs-brute-demo .lb-head {
    font-size: 0.95em;
  }
  .aas-lrs-brute-demo .lb-controls {
    display: flex;
    gap: 0.5em;
  }
  .aas-lrs-brute-demo .lb-btn {
    padding: 0.35em 0.8em;
    font-size: 0.85em;
    border: 1px solid var(--aas-border);
    border-radius: 0.5em;
    background: var(--aas-bg);
    color: var(--aas-text);
    cursor: pointer;
  }
  .aas-lrs-brute-demo .lb-btn:hover {
    border-color: var(--aas-accent);
  }
  .aas-lrs-brute-demo .lb-btn-primary {
    background: var(--aas-accent);
    border-color: var(--aas-accent);
    color: #fff;
  }

  .aas-lrs-brute-demo .lb-body {
    display: flex;
    flex-wrap: wrap;
    gap: 1em 2.5em;
    align-items: flex-start;
    justify-content: center;
    overflow-x: auto;
  }
  /* 왼쪽 칸: 띠, 맞댄 두 줄, 최댓값, 설명. 폭은 띠에 맞춘다. */
  .aas-lrs-brute-demo .lb-left {
    display: flex;
    flex-direction: column;
    gap: 0.55em;
    width: calc(3.6em + var(--lb-n) * var(--lb-ch));
  }
  /* 텍스트 띠: 첫 칸은 줄 이름, 나머지는 위치마다 한 칸 */
  .aas-lrs-brute-demo .lb-band {
    display: grid;
    grid-template-columns: 3.6em repeat(var(--lb-n), var(--lb-ch));
    row-gap: 0.15em;
    font-family: var(--aas-mono, monospace);
    text-align: center;
  }
  .aas-lrs-brute-demo .lb-tag {
    font-family: var(--aas-sans, inherit);
    font-size: 0.75em;
    font-weight: 600;
    color: var(--aas-muted);
    text-align: right;
    padding-right: 0.6em;
    white-space: nowrap;
    align-self: center;
  }
  .aas-lrs-brute-demo .lb-idx {
    font-size: 0.7em;
    color: var(--aas-muted);
    border-radius: 0.3em;
    align-self: center;
  }
  .aas-lrs-brute-demo .lb-idx.is-i {
    background: var(--aas-role-focus);
    color: #fff;
    font-weight: 700;
  }
  .aas-lrs-brute-demo .lb-idx.is-j {
    background: var(--aas-role-model);
    color: #fff;
    font-weight: 700;
  }
  .aas-lrs-brute-demo .lb-tc {
    font-weight: 700;
    border-radius: 0.2em;
    border-bottom: 3px solid transparent;
    transition: border-color 0.2s;
  }
  .aas-lrs-brute-demo .lb-tc.is-i {
    border-bottom-color: var(--aas-role-focus);
  }
  .aas-lrs-brute-demo .lb-tc.is-j {
    border-bottom-color: var(--aas-role-model);
  }
  /* 맞댄 두 줄: 글자 칸의 폭을 띠와 같게 둔다. */
  .aas-lrs-brute-demo .lb-align {
    display: grid;
    grid-template-columns: 3.6em auto;
    row-gap: 0.25em;
    font-family: var(--aas-mono, monospace);
  }
  .aas-lrs-brute-demo .lb-tag-i {
    color: var(--aas-role-focus);
  }
  .aas-lrs-brute-demo .lb-tag-j {
    color: var(--aas-role-model);
  }
  .aas-lrs-brute-demo .lb-line {
    display: flex;
    min-height: 1.4em;
  }
  .aas-lrs-brute-demo .lb-ch {
    display: inline-block;
    width: var(--lb-ch);
    text-align: center;
    border-radius: 0.15em;
  }
  .aas-lrs-brute-demo .lb-ch.is-match {
    background: var(--aas-role-eval);
    color: #fff;
  }
  .aas-lrs-brute-demo .lb-ch.is-miss {
    background: var(--aas-role-guard);
    color: #fff;
  }
  .aas-lrs-brute-demo .lb-best {
    margin: 0;
    font-size: 0.85em;
    color: var(--aas-muted);
  }
  .aas-lrs-brute-demo .lb-best strong {
    color: var(--aas-text);
    font-family: var(--aas-mono, monospace);
  }

  /* 쌍 삼각형: (n + 1) x (n + 1) 격자. 첫 줄과 첫 칸은 글자 머리 */
  .aas-lrs-brute-demo .lb-grid {
    display: grid;
    grid-template-columns: repeat(var(--lb-n1), var(--lb-cell));
    grid-auto-rows: var(--lb-cell);
    gap: 1px;
    font-family: var(--aas-mono, monospace);
  }
  .aas-lrs-brute-demo .lb-gh {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.6em;
    color: var(--aas-muted);
    border-radius: 0.2em;
  }
  .aas-lrs-brute-demo .lb-gh.is-i {
    background: var(--aas-role-focus);
    color: #fff;
  }
  .aas-lrs-brute-demo .lb-gh.is-j {
    background: var(--aas-role-model);
    color: #fff;
  }
  .aas-lrs-brute-demo .lb-cell {
    margin: 0;
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--aas-border) 80%, transparent);
    border-radius: 0.12em;
    background: var(--aas-bg);
    color: #fff;
    font-family: inherit;
    font-size: 0.6em;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
  }
