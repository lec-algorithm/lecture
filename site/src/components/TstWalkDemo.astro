    'search.less': '{c} < {d}：往左。字符位置不变。',
    'search.greater': '{c} > {d}：往右。字符位置不变。',
    'search.equal': '{c} = {d}：往中间。只有这时才进到下一个字符。',
    'search.last': '{c} = {d}：最后一个字符。返回这个节点。',
