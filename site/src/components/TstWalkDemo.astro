    'insert.start': 'Insert("{w}", {v})：用第一个字符 {c} 从根开始。',
    'insert.new': '这个位置是空的。新建 {c} 节点。',
    'insert.less': '{c} < {d}：往左。字符位置不变。',
    'insert.greater': '{c} > {d}：往右。字符位置不变。',
    'insert.equal': '{c} = {d}：往中间。只有这时才进到下一个字符。',
    'insert.last': '{c} = {d}：最后一个字符。在这个节点存入值 {v}。',
    'insert.replace': '{c} = {d}：最后一个字符。把值 {o} 换成 {v}。',
