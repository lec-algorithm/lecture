---
// 키를 직접 쳐서 TST의 의사코드를 한 줄씩 돌려 보는 데모.
//
// 탭으로 삽입·검색·접두사를 고르고 키를 치면, 그 입력으로 실제 절차를 돌려 단계를
// 만든다. 한 걸음마다 지금 줄을 칠하고, 변수(c, index, 노드의 문자)와 키의 글자 띠, TST에
// 든 키 표를 함께 보인다. 왼쪽·오른쪽으로 가면 글자 띠의 칸이 그대로이고 가운데로 가야
// 다음 칸으로 넘어간다. 끝까지 돌린 삽입만 TST에 남는다.
//
// 의사코드는 algorithm-code의 topic-10-trie/02_tst/tst.pseudo와 같다.
import { defaultLang } from 'stack-site-builder/i18n/ui';
import algos from './trieAlgos.js?raw';
import TrieKeyTable from './TrieKeyTable.astro';
import TrieKeyTape from './TrieKeyTape.astro';

type Op = 'insert' | 'search' | 'prefix';
interface Props {
  /** 처음 고른 연산 */
  op?: Op;
  /** 처음 칠 키 */
  word?: string;
  /** 처음 값 */
  value?: number;
  /** apple 키 일곱 개 중 앞에서 몇 개를 넣어 두고 시작할지 */
  prefill?: number;
  /** 슬라이드용: 바깥 여백은 줄이고 글자와 칸은 키운다. */
  slide?: boolean;
}
const { op = 'insert', word, value = 60, prefill = 7, slide = false } = Astro.props;
const id = `tz-${Math.random().toString(36).slice(2, 9)}`;

const SETS: Record<string, [string, number][]> = {
  apple: [
    ['apple', 10],
    ['application', 20],
    ['apply', 30],
    ['applaud', 40],
    ['applet', 50],
    ['appliance', 60],
    ['applicable', 70],
  ],
  six: [
    ['by', 4],
    ['sea', 2],
    ['sells', 1],
    ['she', 0],
    ['shells', 3],
    ['the', 5],
  ],
};
const SAMPLES: Record<string, Record<Op, string[]>> = {
  apple: {
    insert: ['appliance', 'applicable', 'apple', 'apt'],
    search: ['applaud', 'apply', 'application', 'app', 'apples'],
    prefix: ['app', 'appli', 'apple', 'b'],
  },
  six: {
    insert: ['shore', 'she', 'sell', 'bye'],
    search: ['she', 'shells', 'shell', 'shore'],
    prefix: ['sh', 'se', 't', 'x'],
  },
};
const insertCode = [
  'ALGORITHM Insert(root, word, value, index)',
  '    c <- word[index]',
  '    if root = NULL then',
  '        root <- CreateTSTNode(c)',
  '    if c < root.data then',
  '        root.left <- Insert(root.left, word, value, index)',
  '    else if c > root.data then',
  '        root.right <- Insert(root.right, word, value, index)',
  '    else if index < length(word)-1 then',
  '        root.middle <- Insert(root.middle, word, value, index+1)',
  '    else',
  '        root.hasValue <- true',
  '        root.value <- value',
  '    return root',
];
const searchCode = [
  'ALGORITHM GetNode(root, word)',
  '    node <- root, index <- 0',
  '    while node != NULL do',
  '        c <- word[index]',
  '        if c < node.data then node <- node.left',
  '        else if c > node.data then node <- node.right',
  '        else if index = length(word)-1 then return node',
  '        else',
  '            node <- node.middle',
  '            index <- index + 1',
  '    return NULL',
  'ALGORITHM Search(root, word)',
  '    node <- GetNode(root, word)',
  '    if node != NULL and node.hasValue then return node.value',
  '    return -1',
];
const prefixCode = (empty: string, addSelf: string, addNode: string) => [
  'ALGORITHM GetWordsWithPrefix(root, prefix)',
  `    results <- ${empty}`,
  '    prefixNode <- GetNode(root, prefix)',
  '    if prefixNode = NULL then return results',
  `    if prefixNode.hasValue then ${addSelf}`,
  '    GetAllWordsHelper(prefixNode.middle, prefix, results)',
  '    return results',
  'ALGORITHM GetAllWordsHelper(node, prefix, results)',
  '    if node = NULL then return',
  '    GetAllWordsHelper(node.left, prefix, results)',
  `    if node.hasValue then ${addNode}`,
  '    GetAllWordsHelper(node.middle, prefix + node.data, results)',
  '    GetAllWordsHelper(node.right, prefix, results)',
];
const CODE: Record<string, Record<Op, string[]>> = {
  ko: {
    insert: insertCode,
    search: searchCode,
    prefix: prefixCode('빈 목록', 'results에 (prefix, prefixNode.value) 추가', 'results에 (prefix + node.data, node.value) 추가'),
  },
  en: {
    insert: insertCode,
    search: searchCode,
    prefix: prefixCode('empty list', 'append (prefix, prefixNode.value) to results', 'append (prefix + node.data, node.value) to results'),
  },
  zh: {
    insert: insertCode,
    search: searchCode,
    prefix: prefixCode('空列表', '把 (prefix, prefixNode.value) 加入 results', '把 (prefix + node.data, node.value) 加入 results'),
  },
};

const STRINGS: Record<string, Record<string, string>> = {
