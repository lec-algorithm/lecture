  },
};
const lang = Astro.currentLocale ?? defaultLang;
const t = STRINGS[lang] ?? STRINGS[defaultLang] ?? STRINGS.ko;
const code = CODE[lang] ?? CODE.ko;
const ops: Op[] = ['insert', 'search', 'prefix'];
const config = { op, word: word ?? SAMPLES.apple[op][0], value, prefill, sets: SETS, samples: SAMPLES, code };
---

<script is:inline set:html={algos} />
<div class:list={['aas-tst-walk-demo', slide && 'is-slide']} id={id} data-tz-config={JSON.stringify(config)} data-tz-strings={JSON.stringify(t)}>
  <div class="tz-bar">
    <div class="tz-tabs">
      <span class="tz-head"><strong>{t.title}</strong></span>
      {ops.map((o) => <button type="button" class="tz-tab" data-tz-op={o}>{t[o]}</button>)}
    </div>
    <div class="tz-controls">
      <button type="button" data-act="back" class="tz-btn">{t.back}</button>
      <button type="button" data-act="step" class="tz-btn">{t.step}</button>
      <button type="button" data-act="play" class="tz-btn tz-btn-primary">{t.play}</button>
      <button type="button" data-act="reset" class="tz-btn">{t.reset}</button>
    </div>
  </div>

  <div class="tz-inputs">
    <label class="tz-field"><span data-tz-wordlabel></span><input type="text" data-tz-word maxlength="12" autocomplete="off" spellcheck="false" /></label>
    <label class="tz-field" data-tz-valuebox>{t.valueLabel}<input type="text" inputmode="numeric" data-tz-value maxlength="3" autocomplete="off" /></label>
    <span class="tz-samples" data-tz-samples></span>
    <span class="tz-gap"></span>
    <button type="button" class="tz-tab tz-mono" data-tz-set="apple">apple..</button>
    <button type="button" class="tz-tab tz-mono" data-tz-set="six">by..the</button>
    <button type="button" class="tz-tab" data-tz-set="empty">{t.clear}</button>
  </div>

  <div class="tz-body">
    <div class="tz-left">
      <div class="tz-code" data-tz-code></div>
      <div class="tz-state">
        <TrieKeyTape />
        <span class="tz-vars" data-tz-vars></span>
      </div>
    </div>
    <div class="tz-right">
      <TrieKeyTable />
      <svg class="tz-svg" data-tz-svg role="img" aria-label={t.title}></svg>
    </div>
  </div>

  <div class="tz-foot">
    <p class="tz-note" data-tz-note></p>
    <span class="tz-count" data-tz-count></span>
  </div>
</div>

<script is:inline define:vars={{ id }}>
  (() => {
    const root = document.getElementById(id);
    if (!root) return;

    /* 설명은 문장마다 줄을 바꾼다. 마침표 뒤 공백, 또는 중국어 마침표 뒤에서 끊는다. */
    const setLines = (node, text) => {
      const parts = String(text).split(/(?<=[.!?])\s+(?=\S)|(?<=[。！？])(?=\S)/);
      node.replaceChildren(...parts.flatMap((s, i) => (i ? [document.createElement('br'), s] : [s])));
    };
    const fill = (tpl, vars) => tpl.replace(/\{(\w+)\}/g, (_, k) => vars[k]);
    const cfg = JSON.parse(root.dataset.tzConfig);
    const S = JSON.parse(root.dataset.tzStrings);
    const { buildTst, tstInsert, layoutTst, tstWalk } = globalThis.aasTrieAlgos;
    const MAX_KEYS = 10;

    let setName = 'apple';
    let keys = new Map(cfg.sets.apple.slice(0, cfg.prefill));
    let op = cfg.op;
    let word = cfg.word;
    let steps = [];
    let at = 0;
    let finalKeys = null;
    let timer = null;

    const clean = (raw) => raw.toLowerCase().replace(/[^a-z]/g, '');
    const parseValue = (raw) => {
      const v = parseInt(raw, 10);
      return Number.isFinite(v) && v >= 0 ? v : 0;
    };

    /* plan:start (의사코드와 같은 절차를 돌려 단계를 만든다) */
    function plan(theOp, w, value) {
      const out = [];
      const pairs = [...keys.entries()];
      const tst = buildTst(pairs);
      const layoutT = buildTst(pairs);
      if (theOp === 'insert' && w) tstInsert(layoutT, w, value);
      const present = new Set(tst.keys());
      const vals = {};
      for (const [nid, n] of tst) if (n.value !== null) vals[nid] = n.value;
      const keyPairs = () => [...cfgKeys.entries()].sort(([a], [b]) => (a < b ? -1 : 1));
      const cfgKeys = new Map(keys);
      const nextKeys = new Map(keys);
      const push = (o) => out.push({ present: [...present], values: { ...vals }, keyList: keyPairs(), mark: {}, vars: [], ...o });
      const mk = (path, last, kind = 'cur') => {
        const m = {};
        path.forEach((n) => (m[n] = 'path'));
        if (last !== undefined) m[last] = kind;
        return m;
      };
      const single = (note) => ({ steps: [{ present: [...present], values: { ...vals }, keyList: keyPairs(), mark: {}, vars: [], lines: [], note, compares: 0, sides: 0 }], layoutT: buildTst(pairs), next: keys });
      if (!w) return single(S.empty);

      if (theOp === 'insert') {
        if (!keys.has(w) && keys.size >= MAX_KEYS) return single(fill(S.full, { n: keys.size }));
        let nid = '';
        let index = 0;
        const path = [];
        let compares = 0;
        let sides = 0;
        let made = 0;
        const base = () => ({ keyNow: w, compares, sides });
        push({ ...base(), lines: [0], note: fill(S['insert.start'], { w, v: value, c: w[0] }), vars: [['index', 0], ['c', `'${w[0]}'`]], tape: { w, i: 0 } });
        for (;;) {
          const c = w[index];
          if (!present.has(nid)) {
            present.add(nid);
            made += 1;
            push({ ...base(), lines: [1, 2, 3], mark: { ...mk(path), [nid]: 'new' }, note: fill(S['insert.new'], { c }), vars: [['index', index], ['c', `'${c}'`]], tape: { w, i: index } });
            const last = index === w.length - 1;
            if (last) {
              vals[nid] = value;
              nextKeys.set(w, value);
              cfgKeys.set(w, value);
              push({ ...base(), lines: [10, 11, 12], mark: { ...mk(path), [nid]: 'hit' }, note: fill(S['insert.last'], { c, d: c, v: value }), vars: [['index', index], ['c', `'${c}'`], ['root.data', `'${c}'`]], tape: { w, i: index, st: 'hit' } });
              break;
            }
            path.push(nid);
            nid += 'M';
            index += 1;
            continue;
          }
          const d = layoutT.get(nid).ch;
          const vars = [['index', index], ['c', `'${c}'`], ['root.data', `'${d}'`]];
          compares += 1;
          if (c < d) {
            sides += 1;
            push({ ...base(), lines: [1, 4, 5], mark: mk(path, nid), note: fill(S['insert.less'], { c, d }), vars, tape: { w, i: index } });
            path.push(nid);
            nid += 'L';
          } else if (c > d) {
            sides += 1;
            push({ ...base(), lines: [1, 6, 7], mark: mk(path, nid), note: fill(S['insert.greater'], { c, d }), vars, tape: { w, i: index } });
            path.push(nid);
            nid += 'R';
          } else if (index < w.length - 1) {
            push({ ...base(), lines: [1, 8, 9], mark: mk(path, nid), note: fill(S['insert.equal'], { c, d }), vars, tape: { w, i: index } });
            path.push(nid);
            nid += 'M';
            index += 1;
          } else {
            const old = vals[nid];
            vals[nid] = value;
            nextKeys.set(w, value);
            cfgKeys.set(w, value);
            const note = old === undefined ? fill(S['insert.last'], { c, d, v: value }) : fill(S['insert.replace'], { c, d, o: old, v: value });
            push({ ...base(), lines: [1, 10, 11, 12], mark: mk(path, nid, 'hit'), note, vars, tape: { w, i: index, st: 'hit' } });
            break;
          }
        }
        push({ ...base(), lines: [13], mark: mk(path, nid, 'hit'), note: fill(S['insert.done'], { k: compares, m: made }), vars: [], tape: { w, i: w.length }, done: true });
        return { steps: out, layoutT, next: nextKeys };
      }

      if (theOp === 'search') {
        const { log, node } = tstWalk(tst, w);
        let compares = 0;
        let sides = 0;
        const path = [];
        const base = () => ({ keyNow: w, compares, sides });
        push({ ...base(), lines: [12, 0, 1], note: fill(S['search.start'], { w, c: w[0] }), vars: [['index', 0], ['c', `'${w[0]}'`]], tape: { w, i: 0 } });
        log.forEach((e) => {
          compares += 1;
          const vars = [['index', e.index], ['c', `'${e.c}'`], ['node.data', `'${e.d}'`]];
          if (e.kind === 'less' || e.kind === 'greater') {
            sides += 1;
            push({ ...base(), lines: [2, 3, e.kind === 'less' ? 4 : 5], mark: mk(path, e.nid), note: fill(S[`search.${e.kind}`], e), vars, tape: { w, i: e.index } });
          } else if (e.kind === 'equal') {
            push({ ...base(), lines: [2, 3, 7, 8, 9], mark: mk(path, e.nid), note: fill(S['search.equal'], e), vars, tape: { w, i: e.index } });
          } else {
            push({ ...base(), lines: [2, 3, 6], mark: mk(path, e.nid), note: fill(S['search.last'], e), vars, tape: { w, i: e.index } });
          }
          path.push(e.nid);
        });
        if (node === null) {
          const last = path[path.length - 1];
          const i = log.length ? log[log.length - 1].index : 0;
          push({ ...base(), lines: [10], mark: mk(path.slice(0, -1), last, 'miss'), note: S['search.null'], vars: [['index', i]], tape: { w, i, st: 'miss' } });
          push({ ...base(), lines: [14], mark: mk(path.slice(0, -1), last, 'miss'), note: S['search.null'], vars: [['return', '-1']], tape: { w, i, st: 'miss' }, done: true });
        } else if (vals[node] !== undefined) {
          push({ ...base(), lines: [13], mark: mk(path.slice(0, -1), node, 'hit'), note: fill(S['search.hit'], { v: vals[node], k: compares, s: sides }), vars: [['return', vals[node]]], tape: { w, i: w.length - 1, st: 'hit' }, done: true });
        } else {
          push({ ...base(), lines: [13, 14], mark: mk(path.slice(0, -1), node, 'miss'), note: fill(S['search.noValue'], { w }), vars: [['return', '-1']], tape: { w, i: w.length - 1, st: 'miss' }, done: true });
        }
        return { steps: out, layoutT, next: keys };
      }

      /* prefix */
      const { log, node } = tstWalk(tst, w);
      const path = [];
      const results = [];
      const resVar = () => ['results', results.length ? results.join(' ') : '∅'];
      const base = () => ({ found: [...results] });
      push({ ...base(), lines: [0, 1, 2], note: fill(S['prefix.start'], { w }), vars: [resVar()], tape: { w, i: 0 } });
      log.forEach((e) => {
        const kind = e.kind === 'last' ? 'equal' : e.kind;
        push({ ...base(), lines: [2], mark: mk(path, e.nid), note: fill(S[`search.${kind}`], e), vars: [['index', e.index], ['c', `'${e.c}'`], ['node.data', `'${e.d}'`]], tape: { w, i: e.index } });
        path.push(e.nid);
      });
      if (node === null) {
        const last = path[path.length - 1];
        push({ ...base(), lines: [3], mark: mk(path.slice(0, -1), last, 'miss'), note: S['prefix.null'], vars: [resVar()], tape: { w, i: log.length ? log[log.length - 1].index : 0, st: 'miss' }, done: true });
        return { steps: out, layoutT, next: keys };
      }
      const stem = path.slice(0, -1);
      push({ ...base(), lines: [3], mark: mk(stem, node), note: S['prefix.reach'], vars: [resVar()], tape: { w, i: w.length } });
      const seen = {};
      const took = {};
      const paint = (cur) => {
        const m = mk(stem, node);
        Object.assign(m, seen, took);
        if (cur !== undefined && !took[cur]) m[cur] = 'cur';
        return m;
      };
      if (vals[node] !== undefined) {
        results.push(w);
        took[node] = 'take';
        push({ ...base(), lines: [4], mark: paint(), note: fill(S['prefix.self'], { w, v: vals[node] }), vars: [resVar()], tape: { w, i: w.length } });
      }
      const hasMid = present.has(`${node}M`);
      push({ ...base(), lines: [5], mark: paint(), note: S[hasMid ? 'prefix.middle' : 'prefix.noMiddle'], vars: [['prefix', `"${w}"`], resVar()], tape: { w, i: w.length } });
      (function collect(nid, pre) {
        if (!present.has(nid)) return;
        const n = layoutT.get(nid);
        const s = pre + n.ch;
        if (present.has(`${nid}L`)) {
          push({ ...base(), lines: [9], mark: paint(nid), note: fill(S['prefix.left'], { s }), vars: [['prefix', `"${pre}"`], ['node.data', `'${n.ch}'`], resVar()], tape: { w, i: w.length } });
          collect(`${nid}L`, pre);
        }
        seen[nid] = 'seen';
        if (vals[nid] !== undefined) {
          results.push(s);
          took[nid] = 'take';
          push({ ...base(), lines: [10], mark: paint(nid), note: fill(S['prefix.take'], { s, v: vals[nid] }), vars: [['prefix', `"${pre}"`], ['node.data', `'${n.ch}'`], resVar()], tape: { w, i: w.length } });
        } else {
          push({ ...base(), lines: [10], mark: paint(nid), note: fill(S['prefix.pass'], { s }), vars: [['prefix', `"${pre}"`], ['node.data', `'${n.ch}'`], resVar()], tape: { w, i: w.length } });
        }
        if (present.has(`${nid}M`)) {
          push({ ...base(), lines: [11], mark: paint(nid), note: fill(S['prefix.down'], { c: n.ch }), vars: [['prefix', `"${s}"`], resVar()], tape: { w, i: w.length } });
          collect(`${nid}M`, s);
        }
        if (present.has(`${nid}R`)) {
          push({ ...base(), lines: [12], mark: paint(nid), note: S['prefix.right'], vars: [['prefix', `"${pre}"`], resVar()], tape: { w, i: w.length } });
          collect(`${nid}R`, pre);
        }
      })(`${node}M`, w);
      push({ ...base(), lines: [6], mark: paint(), note: fill(S['prefix.done'], { n: results.length, w }), vars: [resVar()], tape: { w, i: w.length }, done: true });
      return { steps: out, layoutT, next: keys };
    }
    /* plan:end */

    const NS = 'http://www.w3.org/2000/svg';
    const el = (name, attrs, text) => {
      const node = document.createElementNS(NS, name);
      for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, String(v));
      if (text !== undefined) node.textContent = text;
      return node;
    };
    const svg = root.querySelector('[data-tz-svg]');
    const codeBox = root.querySelector('[data-tz-code]');
    const varsBox = root.querySelector('[data-tz-vars]');
    const noteBox = root.querySelector('[data-tz-note]');
    const countBox = root.querySelector('[data-tz-count]');
    const wordInput = root.querySelector('[data-tz-word]');
    const valueInput = root.querySelector('[data-tz-value]');
    const valueBox = root.querySelector('[data-tz-valuebox]');
    const wordLabel = root.querySelector('[data-tz-wordlabel]');
    const samplesBox = root.querySelector('[data-tz-samples]');
    const keyList = root.querySelector('[data-tk-list]');
    const tapeBox = root.querySelector('[data-tape]');
    const playBtn = root.querySelector('[data-act="play"]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let nodeEls = new Map();
    let edgeEls = new Map();
    let stubEls = new Map();
    const DIRS = { L: -1, M: 0, R: 1 };
    function drawTree(t) {
      const UNIT = 36;
      const LEVEL = 28;
      const RAD = 13;
      svg.replaceChildren();
      nodeEls = new Map();
      edgeEls = new Map();
      stubEls = new Map();
      if (t.size === 0) {
        svg.setAttribute('viewBox', '-40 -30 80 60');
        return;
      }
      const { pos, slots, depth } = layoutTst(t, UNIT, LEVEL);
      const PAD = 26;
      const W = Math.max(0, slots - 1) * UNIT;
      svg.setAttribute('viewBox', `${-PAD} ${-RAD - 6} ${W + 2 * PAD} ${Math.max(depth, 6) * LEVEL + 2 * RAD + 22}`);
      const stubs = el('g', {});
      const edges = el('g', {});
      const nodes = el('g', {});
      svg.append(stubs, edges, nodes);
      for (const [nid, n] of t) {
        const p = pos.get(nid);
        if (nid !== '') {
          const q = pos.get(nid.slice(0, -1));
          const line = el('line', { class: 'tz-edge', x1: q.x, y1: q.y, x2: p.x, y2: p.y });
          edges.appendChild(line);
          edgeEls.set(nid, line);
        }
        for (const [dir, dx] of Object.entries(DIRS)) {
          const sx = p.x + dx * 9;
          const sy = p.y + RAD + 7;
          const g = el('g', { class: 'tz-stub' });
          g.append(el('line', { x1: p.x + dx * 5, y1: p.y + RAD - 2, x2: sx, y2: sy }), el('circle', { cx: sx, cy: sy, r: 2.2 }));
          stubs.appendChild(g);
          stubEls.set(nid + dir, g);
        }
        const g = el('g', { class: 'tz-nd', transform: `translate(${p.x} ${p.y})` });
        g.append(el('circle', { r: RAD }), el('text', { class: 'tz-ch' }, n.ch), el('text', { class: 'tz-val', x: RAD + 2, y: -RAD + 2 }));
        nodes.appendChild(g);
        nodeEls.set(nid, g);
      }
    }

    const MARKS = ['path', 'cur', 'new', 'hit', 'miss', 'take', 'seen'];
    function render() {
      const st = steps[at];
      const present = new Set(st.present);
      for (const [nid, g] of nodeEls) {
        const mark = st.mark[nid];
        const on = present.has(nid);
        g.classList.toggle('is-off', !on);
        g.classList.toggle('has-value', st.values[nid] !== undefined);
        for (const m of MARKS) g.classList.toggle(`is-${m}`, mark === m);
        g.querySelector('.tz-val').textContent = st.values[nid] === undefined ? '' : String(st.values[nid]);
        const line = edgeEls.get(nid);
        if (line) {
          line.classList.toggle('is-off', !on);
          line.classList.toggle('is-path', ['path', 'cur', 'hit', 'miss'].includes(mark));
          line.classList.toggle('is-new', mark === 'new');
          line.classList.toggle('is-take', ['take', 'seen'].includes(mark));
        }
        for (const dir of Object.keys(DIRS)) stubEls.get(nid + dir).classList.toggle('is-off', !on || present.has(nid + dir));
      }
      [...codeBox.children].forEach((ln, i) => ln.classList.toggle('is-now', st.lines.includes(i)));
      varsBox.replaceChildren(
        ...st.vars.map(([k, v]) => {
          const s = document.createElement('span');
          s.append(`${k} = `, Object.assign(document.createElement('b'), { textContent: String(v) }));
          return s;
        }),
      );
      tapeBox.replaceChildren(
        ...(st.tape
          ? [...st.tape.w].map((c, i) => {
              const b = document.createElement('b');
              b.textContent = c;
              b.className = i < st.tape.i ? 'is-past' : i === st.tape.i ? `is-${st.tape.st || 'now'}` : '';
              return b;
            })
          : []),
      );
      keyList.replaceChildren(
        ...st.keyList.map(([w, v]) => {
          const cell = document.createElement('span');
          cell.className = 'tk-cell';
          cell.dataset.tkKey = w;
          cell.append(Object.assign(document.createElement('b'), { textContent: w }), Object.assign(document.createElement('i'), { textContent: String(v) }));
          if (w === st.keyNow) cell.classList.add('is-now');
          if (st.found && st.found.includes(w)) cell.classList.add('is-take');
          return cell;
        }),
      );
      setLines(noteBox, st.note);
      const n = present.size;
      countBox.replaceChildren();
      const pairs = [];
      if (st.compares !== undefined) pairs.push([S.compared, st.compares], [S.side, st.sides]);
      pairs.push([S.nodes, n], [S.links, n * 3]);
      pairs.forEach(([k, v], i) => {
        if (i) countBox.append(' · ');
        countBox.append(`${k} `, Object.assign(document.createElement('strong'), { textContent: String(v) }));
      });
    }

    function stop() {
      if (timer) clearInterval(timer);
      timer = null;
      playBtn.textContent = S.play;
    }
    function commit() {
      if (at === steps.length - 1 && finalKeys) keys = new Map(finalKeys);
    }
    function replan() {
      stop();
      commit();
      const p = plan(op, word, parseValue(valueInput.value));
      steps = p.steps;
      finalKeys = p.next;
      at = 0;
      drawTree(p.layoutT);
      render();
    }
    const sampleSet = () => (setName === 'six' ? 'six' : 'apple');
    function setOp(o) {
      stop();
      commit();
      finalKeys = null;
      op = o;
      word = cfg.samples[sampleSet()][o][0];
      wordInput.value = word;
      syncChrome();
      replan();
    }
    function syncChrome() {
      root.querySelectorAll('[data-tz-op]').forEach((b) => b.classList.toggle('is-on', b.dataset.tzOp === op));
      wordLabel.textContent = op === 'prefix' ? S.prefixLabel : S.wordLabel;
      valueBox.style.visibility = op === 'insert' ? 'visible' : 'hidden';
      root.querySelector('.aas-key-tape .kt2-label').textContent = op === 'prefix' ? 'prefix' : 'word';
      codeBox.replaceChildren(
        ...cfg.code[op].map((ln) => Object.assign(document.createElement('div'), { className: 'tz-line', textContent: ln })),
      );
      samplesBox.replaceChildren(
        ...cfg.samples[sampleSet()][op].map((s) => {
          const b = Object.assign(document.createElement('button'), { type: 'button', className: 'tz-sample', textContent: s });
          b.addEventListener('click', () => {
            wordInput.value = s;
            word = s;
            /* 예제 키를 누르면 실습 코드의 값을 함께 넣는다. */
            const known = [...cfg.sets.apple, ...cfg.sets.six].find(([k]) => k === s);
            if (known) valueInput.value = String(known[1]);
            replan();
          });
          return b;
        }),
      );
      root.querySelectorAll('[data-tz-set]').forEach((b) => b.classList.toggle('is-on', b.dataset.tzSet === setName));
    }
    function step() {
      if (at >= steps.length - 1) return stop();
      at += 1;
      render();
      if (at >= steps.length - 1) stop();
    }

    root.querySelectorAll('[data-tz-op]').forEach((b) => b.addEventListener('click', () => setOp(b.dataset.tzOp)));
    root.querySelector('[data-act="back"]').addEventListener('click', () => {
      stop();
      if (at > 0) at -= 1;
      render();
    });
    root.querySelector('[data-act="step"]').addEventListener('click', () => {
      stop();
      step();
    });
    root.querySelector('[data-act="reset"]').addEventListener('click', () => {
      stop();
      at = 0;
      render();
    });
    playBtn.addEventListener('click', () => {
      if (timer) return stop();
      if (at >= steps.length - 1) {
        at = 0;
        render();
      }
      playBtn.textContent = S.stop;
      timer = setInterval(step, reduceMotion ? 1400 : 900);
    });
    wordInput.addEventListener('input', () => {
      const w = clean(wordInput.value);
      if (w !== wordInput.value) wordInput.value = w;
      word = w;
      replan();
    });
    valueInput.addEventListener('input', () => {
      if (op === 'insert') {
        const keep = at;
        const p = plan(op, word, parseValue(valueInput.value));
        steps = p.steps;
        finalKeys = p.next;
        at = Math.min(keep, steps.length - 1);
        render();
      }
    });
    root.querySelectorAll('[data-tz-set]').forEach((b) =>
      b.addEventListener('click', () => {
        stop();
        finalKeys = null;
        setName = b.dataset.tzSet;
        keys = new Map(setName === 'empty' ? [] : cfg.sets[setName]);
        word = cfg.samples[sampleSet()][op][0];
        wordInput.value = word;
        syncChrome();
        replan();
      }),
    );
    wordInput.value = word;
    valueInput.value = String(cfg.value);
    syncChrome();
    replan();
  })();
</script>

<!-- 노드·가지·코드 줄은 스크립트가 만들므로 is:global로 두고 .aas-tst-walk-demo 아래로 한정한다. -->
