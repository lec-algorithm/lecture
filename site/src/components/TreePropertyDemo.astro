---
// 이진 트리의 성질을 손으로 건드려 보는 데모. mode 셋이 한 파일에 있다.
//
// - path (성질 1): 노드를 누르면 루트에서 그 노드까지의 경로가 칠해진다. 경로는
//   언제나 하나다. "링크 하나 더 잇기"로 C에서 E로 가는 링크를 더하면 E와 그
//   아래 노드까지 경로가 둘이 되고, 링크가 돌아 되돌아오는 고리가 생긴다.
// - children (성질 2): 점선 자리를 눌러 자식을 단다. 노드마다 자리는 왼쪽과
//   오른쪽 둘뿐이라, 다 찬 노드에 셋째 자식을 달려 하면 거부된다.
// - count (높이와 노드 수): 높이를 하나씩 늘리며 full tree의 레벨을 채운다.
//   레벨 l에는 2^l개, 높이 h면 모두 2^h − 1개다.
//
// 노드의 자리는 TreeTermsDemo와 같이 힙 번호로 정한다(루트 1, 자식 2i·2i+1).
// 높이는 이 과목의 약속대로 레벨의 수로 센다.
import { defaultLang } from 'stack-site-builder/i18n/ui';

interface Props {
  mode?: 'path' | 'children' | 'count';
  /** 슬라이드용: 바깥 여백은 줄이고 글자와 칸은 키운다. */
  slide?: boolean;
}
const { mode = 'path', slide = false } = Astro.props;
const id = `tp-${Math.random().toString(36).slice(2, 9)}`;

const STRINGS: Record<string, Record<string, string>> = {
