    level: 'level {l}',
    total: 'total',
  },
  zh: {
    titlePath: '性质 1：路径只有一条',
    titleChildren: '性质 2：最多两个子节点',
    titleCount: '高度与节点数',
    back: '后退',
    step: '单步',
    play: '播放',
    stop: '暂停',
    reset: '重置',
    addLink: '再连一条链接（C → E）',
    dropLink: '删掉多连的链接',
    addChild: '再加一个子节点',
    removeLeaf: '摘掉这个叶子',
    paths: '路径',
    pathN: '路径 {i}',
    linksN: '{k} 条链接',
    pathIdle: '点击节点，会涂出从根到该节点的路径。',
    pathOne: '到 {v} 的路径只有一条。再点别的节点试试。',
    pathRoot: '到根自身是一条 0 条链接的路径。',
    pathStill: '到 {v} 仍然只有一条路径。点 E 或它下面的 G、H 试试。',
    pathTwo: '到 {v} 的路径有两条。E 有了 B 和 C 两个父节点，A → B → E 与 A → C → E 围成一个环。这已经不是树了。',
    childIdle: '点击虚线位置（+）就会长出子节点。选中节点后，可以试着再加一个子节点或摘掉叶子。',
    childAdded: '新节点 {c} 成为 {v} 的{side}子节点。',
    childSelected: '{v}：左 {l} · 右 {r}',
    childFull: '{v}：左 {l}、右 {r}，两个位置都满了，没有放第三个子节点的位置。二叉树的节点最多有两个子节点。',
    childDeep: '{v}：这个演示只画到第 3 层。',
    childRemoved: '{v}：摘掉了这个叶子。',
    childNotLeaf: '{v}：有子节点的节点不能摘掉。请先摘叶子。',
    childRoot: '根不能摘掉。',
    childPick: '请先选中一个节点。',
    childStats: '节点 {n} · 高度 {h} · 高度 {h} 最多能放 {max} 个',
    empty: '空',
    left: '左',
    right: '右',
    countIdle: '高度 1：只有根。每一步再填满一层。',
    countStep: '填满第 {l} 层：加上 {c} 个节点。现在高度 {h}，节点 {n} 个。',
    countDone: '高度为 {h} 的 full tree 有 {n} 个节点。把同样 {n} 个节点排成一条链，高度就是 {n}。',
    level: '第 {l} 层',
    total: '合计',
  },
};
const lang = Astro.currentLocale ?? defaultLang;
const t = STRINGS[lang] ?? STRINGS[defaultLang] ?? STRINGS.ko;
const title = mode === 'path' ? t.titlePath : mode === 'children' ? t.titleChildren : t.titleCount;
---

<div
  class:list={['aas-tree-prop-demo', `is-${mode}`, slide && 'is-slide']}
  id={id}
  data-tp-mode={mode}
  data-tp-strings={JSON.stringify(t)}
>
  <div class="tp-bar">
    <span class="tp-head"><strong>{title}</strong></span>
    <div class="tp-controls">
      {mode === 'path' && (
        <>
          <button type="button" data-act="link" class="tp-btn tp-btn-primary">{t.addLink}</button>
          <button type="button" data-act="reset" class="tp-btn">{t.reset}</button>
        </>
      )}
      {mode === 'children' && (
        <>
          <button type="button" data-act="add" class="tp-btn tp-btn-primary">{t.addChild}</button>
          <button type="button" data-act="remove" class="tp-btn">{t.removeLeaf}</button>
          <button type="button" data-act="reset" class="tp-btn">{t.reset}</button>
        </>
      )}
      {mode === 'count' && (
        <>
          <button type="button" data-act="back" class="tp-btn">{t.back}</button>
          <button type="button" data-act="step" class="tp-btn">{t.step}</button>
          <button type="button" data-act="play" class="tp-btn tp-btn-primary">{t.play}</button>
          <button type="button" data-act="reset" class="tp-btn">{t.reset}</button>
        </>
      )}
    </div>
  </div>
  <div class="tp-body">
    <svg class="tp-svg" data-tp-svg role="img" aria-label={title}></svg>
    <div class="tp-side" data-tp-side></div>
  </div>
  <div class="tp-foot">
    <p class="tp-note" data-tp-note></p>
    <span class="tp-stat" data-tp-stat></span>
  </div>
</div>

<script is:inline define:vars={{ id }}>
  (() => {
    const root = document.getElementById(id);
    if (!root) return;

    /* 설명은 문장마다 줄을 바꾼다. 마침표 뒤 공백, 또는 중국어 마침표 뒤에서 끊는다. */
    const setLines = (node, text) => {
      const parts = String(text).split(/(?<=[.!?])\s+(?=\S)|(?<=[。！？])(?=\S)/);
      node.replaceChildren(...parts.flatMap((s, i) => (i ? [document.createElement('br'), s] : [s])));
    };

    const S = JSON.parse(root.dataset.tpStrings);
    const MODE = root.dataset.tpMode;
    const fill = (tpl, vars) => tpl.replace(/\{(\w+)\}/g, (_, key) => vars[key]);
    const levelOf = (i) => Math.floor(Math.log2(i));
    const NS = 'http://www.w3.org/2000/svg';
    const svg = root.querySelector('[data-tp-svg]');
    const side = root.querySelector('[data-tp-side]');
    const note = root.querySelector('[data-tp-note]');
    const stat = root.querySelector('[data-tp-stat]');
    const el = (tag, attrs, parent) => {
      const e = document.createElementNS(NS, tag);
      for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
      if (parent) parent.appendChild(e);
      return e;
    };
    const html = (tag, cls, text) => {
      const e = document.createElement(tag);
      if (cls) e.className = cls;
      if (text !== undefined) e.textContent = text;
      return e;
    };

    /* 힙 번호 i의 좌표. levels는 그림에 쓸 레벨 수 */
    function layout(levels, W, R, gap) {
      const PADX = R + 8;
      const TOP = R + 10;
      const H = TOP + (levels - 1) * gap + R + 12;
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
      return (i) => {
        const l = levelOf(i);
        const k = i - 2 ** l;
        return { x: PADX + ((2 * k + 1) / 2 ** (l + 1)) * (W - 2 * PADX), y: TOP + l * gap };
      };
    }
    function drawNode(parent, p, label, R, cls) {
      const g = el('g', { class: `tp-node ${cls || ''}` }, parent);
      el('circle', { cx: p.x, cy: p.y, r: R }, g);
      const tx = el('text', { x: p.x, y: p.y, class: 'tp-label' }, g);
      tx.textContent = label;
      return g;
    }

    /* ---------- 성질 1: 경로 ---------- */
    function initPath() {
      const TREE = { 1: 'A', 2: 'B', 3: 'C', 4: 'D', 5: 'E', 7: 'F', 10: 'G', 11: 'H', 15: 'I' };
      const ids = Object.keys(TREE).map(Number);
      const R = 20;
      const pos = layout(4, 600, R, 80);
      const EXTRA = [3, 5]; // C → E
      let extra = false;
      let target = null;

      const edgeLayer = el('g', {}, svg);
      const edges = new Map();
      for (const i of ids) {
        if (i === 1) continue;
        const a = pos(Math.floor(i / 2));
        const b = pos(i);
        edges.set(`${Math.floor(i / 2)}-${i}`, el('line', { x1: a.x, y1: a.y, x2: b.x, y2: b.y, class: 'tp-edge' }, edgeLayer));
      }
      const ca = pos(EXTRA[0]);
      const cb = pos(EXTRA[1]);
      const mx = (ca.x + cb.x) / 2;
      const my = (ca.y + cb.y) / 2 + 40;
      const extraEdge = el('path', { d: `M${ca.x},${ca.y} Q${mx},${my} ${cb.x},${cb.y}`, class: 'tp-edge tp-extra' }, edgeLayer);
      edges.set(`${EXTRA[0]}-${EXTRA[1]}`, extraEdge);

      const nodes = new Map();
      for (const i of ids) {
        const g = drawNode(svg, pos(i), TREE[i], R, 'is-click');
        g.setAttribute('tabindex', '0');
        g.setAttribute('role', 'button');
        g.addEventListener('click', () => pick(i));
        g.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            pick(i);
          }
        });
        nodes.set(i, g);
      }

      const parentsOf = (v) => {
        const ps = v === 1 ? [] : [Math.floor(v / 2)];
        if (extra && v === EXTRA[1]) ps.push(EXTRA[0]);
        return ps;
      };
      const pathsTo = (v) => (v === 1 ? [[1]] : parentsOf(v).flatMap((p) => pathsTo(p).map((path) => [...path, v])));

      const linkBtn = root.querySelector('[data-act="link"]');
      function render(msg) {
        const paths = target ? pathsTo(target) : [];
        const onA = new Set();
        const onB = new Set();
        const nodeA = new Set();
        const nodeB = new Set();
        paths.forEach((path, k) => {
          path.forEach((v, j) => {
            (k === 0 ? nodeA : nodeB).add(v);
            if (j > 0) (k === 0 ? onA : onB).add(`${path[j - 1]}-${v}`);
          });
        });
        edges.forEach((line, key) => {
          line.classList.toggle('is-a', onA.has(key));
          line.classList.toggle('is-b', onB.has(key) && !onA.has(key));
        });
        extraEdge.classList.toggle('is-gone', !extra);
        nodes.forEach((g, i) => {
          g.classList.toggle('is-a', nodeA.has(i));
          g.classList.toggle('is-b', nodeB.has(i) && !nodeA.has(i));
          g.classList.toggle('is-target', i === target);
        });
        side.replaceChildren();
        paths.forEach((path, k) => {
          const row = html('div', `tp-path-row ${k === 0 ? 'is-a' : 'is-b'}`);
          row.append(html('span', 'tp-path-label', fill(S.pathN, { i: k + 1 })));
          row.append(html('span', 'tp-path', path.map((v) => TREE[v]).join(' → ')));
          row.append(html('span', 'tp-path-links', fill(S.linksN, { k: path.length - 1 })));
          side.append(row);
        });
        root.classList.toggle('is-broken', paths.length > 1);
        stat.innerHTML = '';
        stat.append(document.createTextNode(`${S.paths} `), html('strong', '', String(paths.length)));
        linkBtn.textContent = extra ? S.dropLink : S.addLink;
        setLines(note, msg);
      }
      function pick(i) {
        target = i;
        const n = pathsTo(i).length;
        let msg;
        if (i === 1) msg = S.pathRoot;
        else if (n > 1) msg = fill(S.pathTwo, { v: TREE[i] });
        else if (extra) msg = fill(S.pathStill, { v: TREE[i] });
        else msg = fill(S.pathOne, { v: TREE[i] });
        render(msg);
      }
      linkBtn.addEventListener('click', () => {
        extra = !extra;
        if (extra) {
          target = 11; // H: 두 경로가 바로 보이게
          render(fill(S.pathTwo, { v: TREE[11] }));
        } else pick(target || 11);
      });
      root.querySelector('[data-act="reset"]').addEventListener('click', () => {
        extra = false;
        target = null;
        render(S.pathIdle);
      });
      target = 11;
      pick(11);
    }

    /* ---------- 성질 2: 자식은 최대 둘 ---------- */
    function initChildren() {
      const START = { 1: 'A', 2: 'B', 3: 'C', 5: 'D' };
      const MAX_LEVEL = 3;
      const R = 20;
      const pos = layout(MAX_LEVEL + 1, 600, R, 74);
      let tree = {};
      let sel = null;
      let reject = false;
      const LETTERS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
      const nextLetter = () => [...LETTERS].find((c) => !Object.values(tree).includes(c)) || '?';
      const has = (i) => tree[i] !== undefined;
      const kidsOf = (i) => [2 * i, 2 * i + 1].filter(has);

      function heightOf() {
        const ids = Object.keys(tree).map(Number);
        return Math.max(...ids.map(levelOf)) + 1;
      }
      function render(msg) {
        svg.replaceChildren();
        const edgeLayer = el('g', {}, svg);
        const ids = Object.keys(tree).map(Number).sort((a, b) => a - b);
        // 빈 자리(점선): 있는 노드의 비어 있는 자식 자리, 레벨 4까지
        for (const i of ids) {
          if (levelOf(i) >= MAX_LEVEL) continue;
          for (const c of [2 * i, 2 * i + 1]) {
            if (has(c)) continue;
            const a = pos(i);
            const b = pos(c);
            el('line', { x1: a.x, y1: a.y, x2: b.x, y2: b.y, class: 'tp-slot-edge' }, edgeLayer);
            const g = el('g', { class: 'tp-slot', tabindex: 0, role: 'button' }, svg);
            el('circle', { cx: b.x, cy: b.y, r: R - 3 }, g);
            const tx = el('text', { x: b.x, y: b.y, class: 'tp-label' }, g);
            tx.textContent = '+';
            const add = () => grow(i, c);
            g.addEventListener('click', add);
            g.addEventListener('keydown', (e) => {
              if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                add();
              }
            });
          }
        }
        for (const i of ids) {
          if (i === 1) continue;
          const a = pos(Math.floor(i / 2));
          const b = pos(i);
          el('line', { x1: a.x, y1: a.y, x2: b.x, y2: b.y, class: 'tp-edge' }, edgeLayer);
        }
        for (const i of ids) {
          const g = drawNode(svg, pos(i), tree[i], R, `is-click ${i === sel ? 'is-a' : ''}`);
          g.setAttribute('tabindex', '0');
          g.setAttribute('role', 'button');
          const choose = () => {
            sel = i;
            reject = false;
            render(fill(S.childSelected, { v: tree[i], l: has(2 * i) ? tree[2 * i] : S.empty, r: has(2 * i + 1) ? tree[2 * i + 1] : S.empty }));
          };
          g.addEventListener('click', choose);
          g.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              choose();
            }
          });
        }
        // 거부된 셋째 자식: 고른 노드 바로 아래 가운데에 빨간 점선 원과 ✕
        if (reject && sel) {
          const p = pos(sel);
          const q = { x: p.x, y: p.y + 74 * 0.95 };
          el('line', { x1: p.x, y1: p.y, x2: q.x, y2: q.y, class: 'tp-reject-edge' }, edgeLayer);
          const g = el('g', { class: 'tp-reject' }, svg);
          el('circle', { cx: q.x, cy: q.y, r: R }, g);
          const tx = el('text', { x: q.x, y: q.y, class: 'tp-label' }, g);
          tx.textContent = '✕';
        }
        const h = heightOf();
        stat.textContent = fill(S.childStats, { n: ids.length, h, max: 2 ** h - 1 });
        side.replaceChildren();
        if (sel && has(sel)) {
          const box = html('div', 'tp-slots');
          [[S.left, 2 * sel], [S.right, 2 * sel + 1]].forEach(([label, c]) => {
            const cell = html('div', `tp-slot-cell ${has(c) ? 'is-full' : ''}`);
            cell.append(html('span', 'tp-slot-label', label), html('strong', '', has(c) ? tree[c] : '–'));
            box.append(cell);
          });
          const third = html('div', `tp-slot-cell is-none ${reject ? 'is-reject' : ''}`);
          third.append(html('span', 'tp-slot-label', '?'), html('strong', '', '✕'));
          box.append(third);
          side.append(html('div', 'tp-side-head', tree[sel]), box);
        }
        setLines(note, msg);
        root.classList.toggle('is-broken', reject);
      }
      function grow(i, c) {
        if (has(c)) return;
        tree[c] = nextLetter();
        sel = i;
        reject = false;
        render(fill(S.childAdded, { c: tree[c], v: tree[i], side: c % 2 === 0 ? S.left : S.right }));
      }
      root.querySelector('[data-act="add"]').addEventListener('click', () => {
        if (!sel) return render(S.childPick);
        const free = [2 * sel, 2 * sel + 1].find((c) => !has(c));
        if (free === undefined) {
          reject = true;
          return render(fill(S.childFull, { v: tree[sel], l: tree[2 * sel], r: tree[2 * sel + 1] }));
        }
        if (levelOf(sel) >= MAX_LEVEL) return render(fill(S.childDeep, { v: tree[sel] }));
        grow(sel, free);
      });
      root.querySelector('[data-act="remove"]').addEventListener('click', () => {
        if (!sel) return render(S.childPick);
        const v = tree[sel];
        if (sel === 1) return render(S.childRoot);
        if (kidsOf(sel).length) return render(fill(S.childNotLeaf, { v }));
        delete tree[sel];
        sel = Math.floor(sel / 2);
        reject = false;
        render(fill(S.childRemoved, { v }));
      });
      const reset = () => {
        tree = { ...START };
        sel = 2; // B: 자식이 하나 있는 노드부터
        reject = false;
        render(S.childIdle);
      };
      root.querySelector('[data-act="reset"]').addEventListener('click', reset);
      reset();
    }

    /* ---------- 높이와 노드 수 ---------- */
    function initCount() {
      const MAXH = 5;
      const R = 15;
      const pos = layout(MAXH, 640, R, 62);
      let h = 1;
      let timer = null;
      const playBtn = root.querySelector('[data-act="play"]');

      const pow = (e, tail) => {
        const span = html('span', 'tp-pow', '2');
        span.append(html('sup', '', String(e)), document.createTextNode(tail));
        return span;
      };
      function render(msg, fresh) {
        svg.replaceChildren();
        const edgeLayer = el('g', {}, svg);
        const last = 2 ** h - 1;
        for (let i = 2; i <= last; i++) {
          const a = pos(Math.floor(i / 2));
          const b = pos(i);
          el('line', { x1: a.x, y1: a.y, x2: b.x, y2: b.y, class: `tp-edge ${fresh && levelOf(i) === h - 1 ? 'is-fresh' : ''}` }, edgeLayer);
        }
        for (let i = 1; i <= last; i++) {
          drawNode(svg, pos(i), '', R, fresh && levelOf(i) === h - 1 ? 'is-fresh' : 'is-full');
        }
        side.replaceChildren();
        const table = html('div', 'tp-count');
        for (let l = 0; l < h; l++) {
          const row = html('div', `tp-count-row ${fresh && l === h - 1 ? 'is-fresh' : ''}`);
          row.append(html('span', '', fill(S.level, { l })), pow(l, ''), html('strong', '', String(2 ** l)));
          table.append(row);
        }
        const sum = html('div', 'tp-count-row is-sum');
        sum.append(html('span', '', S.total), pow(h, ' − 1'), html('strong', '', String(last)));
        table.append(sum);
        side.append(table);
        stat.innerHTML = '';
        stat.append(
          document.createTextNode('h = '), html('strong', '', String(h)),
          document.createTextNode(' · N = '), html('strong', '', String(last)),
          document.createTextNode(` · log₂(N + 1) = ${h}`),
        );
        setLines(note, msg);
        root.classList.toggle('is-done', h === MAXH);
      }
      const show = () => {
        if (h === 1) return render(S.countIdle, false);
        const n = 2 ** h - 1;
        const msg = h === MAXH
          ? `${fill(S.countStep, { l: h - 1, c: 2 ** (h - 1), h, n })} ${fill(S.countDone, { h, n })}`
          : fill(S.countStep, { l: h - 1, c: 2 ** (h - 1), h, n });
        render(msg, true);
      };
      const stop = () => {
        if (timer) clearInterval(timer);
        timer = null;
        playBtn.textContent = S.play;
      };
      const step = () => {
        if (h >= MAXH) return stop();
        h += 1;
        show();
        if (h >= MAXH) stop();
      };
      root.querySelector('[data-act="back"]').addEventListener('click', () => {
        stop();
        if (h > 1) h -= 1;
        show();
      });
      root.querySelector('[data-act="step"]').addEventListener('click', () => {
        stop();
        step();
      });
      root.querySelector('[data-act="reset"]').addEventListener('click', () => {
        stop();
        h = 1;
        show();
      });
      playBtn.addEventListener('click', () => {
        if (timer) return stop();
        if (h >= MAXH) h = 1;
        show();
        playBtn.textContent = S.stop;
        timer = setInterval(step, 1100);
      });
      show();
    }

    if (MODE === 'path') initPath();
    else if (MODE === 'children') initChildren();
    else initCount();
  })();
</script>

