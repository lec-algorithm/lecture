    right: '오른쪽',
    countIdle: '높이 1: 루트 하나뿐입니다. 한 걸음마다 레벨을 하나 더 채웁니다.',
    countStep: '레벨 {l} 채우기: 노드 {c}개를 더합니다. 이제 높이 {h}, 노드 {n}개입니다.',
    countDone: '높이 {h}인 full tree의 노드는 {n}개입니다. 같은 {n}개를 한 줄로 세우면 높이는 {n}입니다.',
    level: '레벨 {l}',
    total: '합계',
  },
  en: {
    titlePath: 'Property 1: one path',
    titleChildren: 'Property 2: at most two children',
