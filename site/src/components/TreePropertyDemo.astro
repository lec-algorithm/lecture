    pathTwo: 'There are two paths to {v}. E now has two parents, B and C, so A → B → E and A → C → E close a loop. This is no longer a tree.',
    childIdle: 'Click a dashed spot (+) to grow a child. Select a node to try one more child or remove a leaf.',
    childAdded: 'New node {c} is the {side} child of {v}.',
    childSelected: '{v}: left {l} · right {r}',
    childFull: '{v}: left {l} and right {r} fill both spots. There is no spot for a third child. A binary tree node has at most two children.',
    childDeep: '{v}: this demo draws only down to level 3.',
    childRemoved: '{v}: leaf removed.',
    childNotLeaf: '{v}: a node with children cannot be removed. Remove leaves first.',
