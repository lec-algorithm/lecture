---
// 접미사 배열 위의 이진 검색으로 질의어의 모든 자리를 찾는 KWIC 데모.
//
// 『두 도시 이야기』의 첫 문단(저작권이 끝난 글) 위에 접미사 배열을 만든다. 질의어로 시작하는
// 접미사들은 한 구간에 모여 있으므로, 이진 검색 두 번으로 구간의 처음과 끝을 찾는다. 한 걸음이
// 비교 한 번이다. 창에는 lo, mid, hi 부근의 접미사가 보이고, 끝나면 찾은 자리를 앞뒤 문맥과 함께
// 나열한다. 문맥의 길이는 슬라이더로 바꾼다. 비교 횟수는 실제로 센 값이다.
import { defaultLang } from 'stack-site-builder/i18n/ui';
import algos from './suffixAlgos.js?raw';

interface Props {
  /** 슬라이드용: 바깥 여백은 줄이고 글자와 칸은 키운다. */
  slide?: boolean;
}
const { slide = false } = Astro.props;
const id = `kw-${Math.random().toString(36).slice(2, 9)}`;

const STRINGS: Record<string, Record<string, string>> = {
  ko: {
    title: 'KWIC: 이진 검색으로 찾기',
    query: '질의어',
    context: '문맥',
    back: '뒤로',
    step: '한 걸음',
    play: '자동 재생',
    stop: '멈춤',
    reset: '처음으로',
    idle: '정렬된 접미사 {n}개에서 찾습니다. 먼저 구간의 처음, 다음으로 구간의 끝을 이진 검색합니다.',
    first: '처음 찾기: SA[{m}]의 접미사 앞 {q}글자 {p}를 질의어와 비교합니다. {why}',
    last: '끝 찾기: SA[{m}]의 접미사 앞 {q}글자 {p}를 질의어와 비교합니다. {why}',
    less: '질의어보다 앞이므로 오른쪽 절반으로 갑니다.',
    geq: '질의어와 같거나 뒤이므로 왼쪽 절반으로 갑니다.',
    leq: '질의어와 같거나 앞이므로 오른쪽 절반으로 갑니다.',
    gt: '질의어보다 뒤이므로 왼쪽 절반으로 갑니다.',
    found: '구간 [{a}, {b})에 {c}개가 모여 있습니다. 비교 {k}번으로 찾았습니다.',
    none: '질의어로 시작하는 접미사가 없습니다. 비교 {k}번으로 알았습니다.',
    colFound: '찾은 자리',
    colWin: '정렬된 접미사',
    cmpLabel: '비교',
    bound: '상한 2⌈log₂ n⌉ = {u}',
    more: '… 외 {c}개',
    empty: '질의어를 입력하세요.',
  },
  en: {
    title: 'KWIC: find it by binary search',
    query: 'Query',
    context: 'Context',
    back: 'Back',
    step: 'Step',
    play: 'Play',
    stop: 'Pause',
    reset: 'Reset',
    idle: 'We search {n} sorted suffixes. First a binary search for the start of the range, then for its end.',
    first: 'Finding the start: compare the first {q} characters of the suffix at SA[{m}], {p}, with the query. {why}',
    last: 'Finding the end: compare the first {q} characters of the suffix at SA[{m}], {p}, with the query. {why}',
    less: 'It comes before the query, so go to the right half.',
    geq: 'It is equal or later, so go to the left half.',
    leq: 'It is equal or earlier, so go to the right half.',
    gt: 'It comes after the query, so go to the left half.',
    found: 'Range [{a}, {b}) holds {c} suffixes, found with {k} compares.',
    none: 'No suffix starts with the query. It took {k} compares to know.',
    colFound: 'Occurrences',
    colWin: 'Sorted suffixes',
    cmpLabel: 'compares',
    bound: 'bound 2⌈log₂ n⌉ = {u}',
    more: '… and {c} more',
    empty: 'Enter a query.',
  },
  zh: {
    title: 'KWIC：用二分查找',
    query: '查询词',
    context: '上下文',
    back: '后退',
    step: '单步',
    play: '播放',
    stop: '暂停',
    reset: '重置',
    idle: '在 {n} 个排好序的后缀中查找。先二分查找区间的开头，再查找区间的结尾。',
    first: '找开头：把 SA[{m}] 的后缀的前 {q} 个字符 {p} 与查询词比较。{why}',
    last: '找结尾：把 SA[{m}] 的后缀的前 {q} 个字符 {p} 与查询词比较。{why}',
    less: '它在查询词之前，所以去右半部分。',
    geq: '它与查询词相同或在其后，所以去左半部分。',
    leq: '它与查询词相同或在其前，所以去右半部分。',
    gt: '它在查询词之后，所以去左半部分。',
    found: '区间 [{a}, {b}) 中有 {c} 个，比较 {k} 次就找到了。',
    none: '没有以查询词开头的后缀。比较 {k} 次就知道了。',
    colFound: '找到的位置',
    colWin: '排好序的后缀',
    cmpLabel: '比较',
    bound: '上界 2⌈log₂ n⌉ = {u}',
    more: '… 还有 {c} 处',
    empty: '请输入查询词。',
  },
};
const lang = Astro.currentLocale ?? defaultLang;
const t = STRINGS[lang] ?? STRINGS[defaultLang] ?? STRINGS.ko;
const TEXT =
  'it was the best of times, it was the worst of times, it was the age of wisdom, ' +
  'it was the age of foolishness, it was the epoch of belief, it was the epoch of incredulity, ' +
  'it was the season of light, it was the season of darkness, it was the spring of hope, ' +
  'it was the winter of despair';
const queries = ['it was', 'the season', 'age', 'of', 'search'];
---

<script is:inline set:html={algos} />
<div class:list={['aas-kwic-demo', slide && 'is-slide']} id={id} data-kw-strings={JSON.stringify(t)} data-kw-text={TEXT}>
  <div class="kw-bar">
    <span class="kw-head"><strong>{t.title}</strong></span>
    <div class="kw-controls">
      <button type="button" data-act="back" class="kw-btn">{t.back}</button>
      <button type="button" data-act="step" class="kw-btn">{t.step}</button>
      <button type="button" data-act="play" class="kw-btn kw-btn-primary">{t.play}</button>
      <button type="button" data-act="reset" class="kw-btn">{t.reset}</button>
    </div>
  </div>
  <div class="kw-inputs">
    <label class="kw-input">
      <span>{t.query}</span>
      <input type="text" data-kw-in value={queries[0]} maxlength="20" spellcheck="false" autocomplete="off" />
    </label>
    <div class="kw-chips">
      {queries.map((q) => <button type="button" class="kw-chip" data-kw-q={q}>{q}</button>)}
    </div>
    <label class="kw-slider">
      <span>{t.context} <b data-kw-cv></b></span>
      <input type="range" min="4" max="18" value="12" data-kw-c aria-label={t.context} />
    </label>
  </div>

  <div class="kw-range"><i data-kw-span></i><u data-kw-mid></u></div>

  <div class="kw-main">
    <div class="kw-col">
      <span class="kw-cap">{t.colWin}</span>
      <div class="kw-win" data-kw-win></div>
    </div>
    <div class="kw-col">
      <span class="kw-cap">{t.colFound}</span>
      <div class="kw-found" data-kw-found></div>
    </div>
  </div>

  <div class="kw-foot">
    <p class="kw-note" data-kw-note></p>
    <span class="kw-stat">
      {t.cmpLabel} <strong data-kw-k>0</strong> · <span data-kw-bound></span>
    </span>
  </div>
</div>

<script is:inline define:vars={{ id }}>
  (() => {
    const root = document.getElementById(id);
    if (!root) return;

    /* 설명은 문장마다 줄을 바꾼다. 마침표 뒤 공백, 또는 중국어 마침표 뒤에서 끊는다. */
    const setLines = (node, text) => {
      const parts = String(text).split(/(?<=[.!?])\s+(?=\S)|(?<=[。！？])(?=\S)/);
      node.replaceChildren(...parts.flatMap((s, i) => (i ? [document.createElement('br'), s] : [s])));
    };
    const S = JSON.parse(root.dataset.kwStrings);
    const fill = (tpl, vars) => tpl.replace(/\{(\w+)\}/g, (_, k) => vars[k]);
    const { buildSA } = globalThis.aasSuffixAlgos;

    const text = root.dataset.kwText;
    const n = text.length;
    const sa = buildSA(text);
    const input = root.querySelector('[data-kw-in]');
    const cIn = root.querySelector('[data-kw-c]');
    const win = root.querySelector('[data-kw-win]');
    const found = root.querySelector('[data-kw-found]');
    const note = root.querySelector('[data-kw-note]');
    const spanEl = root.querySelector('[data-kw-span]');
    const midEl = root.querySelector('[data-kw-mid]');
    const kEl = root.querySelector('[data-kw-k]');
    const playBtn = root.querySelector('[data-act="play"]');
    const upper = 2 * Math.ceil(Math.log2(n));
    root.querySelector('[data-kw-bound]').textContent = fill(S.bound, { u: upper });

    let query = '';
    let steps = [];
    let at = -1;
    let timer = null;

    /* 이진 검색 두 번. 접미사의 앞 |q|글자만 비교한다. */
    function plan(q) {
      const out = [];
      const m = q.length;
      const head = (p) => text.slice(p, p + m);
      let k = 0;
      let lo = 0;
      let hi = n;
      while (lo < hi) {
        const mid = (lo + hi) >> 1;
        const h = head(sa[mid]);
        k += 1;
        const less = h < q;
        out.push({ lo, hi, mid, k, note: fill(S.first, { m: mid, q: m, p: JSON.stringify(h), why: less ? S.less : S.geq }) });
        if (less) lo = mid + 1;
        else hi = mid;
      }
      const a = lo;
      lo = a;
      hi = n;
      while (lo < hi) {
        const mid = (lo + hi) >> 1;
        const h = head(sa[mid]);
        k += 1;
        const leq = h <= q;
        out.push({ lo, hi, mid, k, note: fill(S.last, { m: mid, q: m, p: JSON.stringify(h), why: leq ? S.leq : S.gt }) });
        if (leq) lo = mid + 1;
        else hi = mid;
      }
      const b = lo;
      out.push({
        lo: a, hi: b, mid: a < b ? a : Math.min(a, n - 1), k, a, b, finished: true,
        note: a < b ? fill(S.found, { a, b, c: b - a, k }) : fill(S.none, { k }),
      });
      return out;
    }

    const esc = (s) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');

    function render() {
      const st = at >= 0 ? steps[at] : null;
      const lo = st ? st.lo : 0;
      const hi = st ? st.hi : n;
      const mid = st ? st.mid : 0;
      spanEl.style.left = `${(lo / n) * 100}%`;
      spanEl.style.width = `${(Math.max(hi - lo, 0.4) / n) * 100}%`;
      midEl.style.left = `${(mid / n) * 100}%`;
      midEl.style.opacity = st ? '1' : '0';
      /* 창: mid 위아래 네 줄 */
      const top = Math.min(Math.max(mid - 3, 0), Math.max(n - 7, 0));
      const rows = [];
      for (let j = top; j < Math.min(top + 7, n); j++) {
        const suf = text.slice(sa[j], sa[j] + 26).replace(/ /g, '·');
        const inRange = j >= lo && j < hi;
        const isHit = !!st && st.finished && inRange;
        const m = text.slice(sa[j], sa[j] + query.length) === query ? query.length : 0;
        rows.push(`<div class="kw-row${j === mid && st && !st.finished ? ' is-mid' : ''}${inRange && st ? ' is-range' : ''}${isHit ? ' is-hit' : ''}"><i>${j}</i><span><b>${esc(suf.slice(0, m))}</b>${esc(suf.slice(m))}</span></div>`);
      }
      win.innerHTML = rows.join('');

      if (st && st.finished && st.a < st.b) {
        const c = Number(cIn.value);
        const m = query.length;
        const list = sa.slice(st.a, st.b).sort((x, y) => x - y);
        const shown = list.slice(0, 6);
        found.innerHTML =
          shown
            .map((p) => {
              const before = text.slice(Math.max(0, p - c), p).padStart(c, ' ');
              const after = text.slice(p + m, p + m + c);
              return `<div class="kw-line"><span>${esc(before)}</span><b>${esc(text.slice(p, p + m))}</b><span>${esc(after)}</span></div>`;
            })
            .join('') + (list.length > 6 ? `<div class="kw-more">${fill(S.more, { c: list.length - 6 })}</div>` : '');
      } else {
        found.innerHTML = '';
      }
      kEl.textContent = String(st ? st.k : 0);
      root.querySelector('[data-kw-cv]').textContent = cIn.value;
      setLines(note, st ? st.note : query ? fill(S.idle, { n }) : S.empty);
      root.querySelectorAll('[data-kw-q]').forEach((b) => b.classList.toggle('is-on', b.dataset.kwQ === query));
    }

    function stop() {
      if (timer) clearInterval(timer);
      timer = null;
      playBtn.textContent = S.play;
    }
    function step() {
      if (at >= steps.length - 1) return stop();
      at += 1;
      render();
      if (at >= steps.length - 1) stop();
    }
    function rebuild() {
      stop();
      query = input.value.toLowerCase();
      steps = query ? plan(query) : [];
      at = -1;
      render();
    }
    input.addEventListener('input', rebuild);
    cIn.addEventListener('input', render);
    root.querySelectorAll('[data-kw-q]').forEach((b) =>
      b.addEventListener('click', () => {
        input.value = b.dataset.kwQ;
        rebuild();
      }),
    );
    root.querySelector('[data-act="back"]').addEventListener('click', () => {
      stop();
      if (at > -1) at -= 1;
      render();
    });
    root.querySelector('[data-act="step"]').addEventListener('click', () => {
      stop();
      step();
    });
    root.querySelector('[data-act="reset"]').addEventListener('click', () => {
      stop();
      at = -1;
      render();
    });
    playBtn.addEventListener('click', () => {
      if (timer) return stop();
      if (at >= steps.length - 1) at = -1;
      render();
      playBtn.textContent = S.stop;
      timer = setInterval(step, 1300);
    });
    rebuild();
  })();
</script>

<style is:global>
  .aas-kwic-demo {
    /* 안쪽 치수는 모두 이 값에 대한 em이다(다른 데모들과 같은 방식). */
    font-size: 1rem;
    margin: 1.5rem 0;
    padding: 1em;
    border: 1px solid var(--aas-border);
    border-radius: 0.9em;
    background: var(--aas-panel);
  }
  .aas-kwic-demo .kw-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em 0.9em;
    align-items: center;
    justify-content: space-between;
  }
  .aas-kwic-demo .kw-head {
    font-size: 0.95em;
  }
  .aas-kwic-demo .kw-controls,
  .aas-kwic-demo .kw-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35em;
  }
  .aas-kwic-demo .kw-btn {
    padding: 0.3em 0.75em;
    font-size: 0.85em;
    border: 1px solid var(--aas-border);
    border-radius: 0.5em;
    background: var(--aas-bg);
    color: var(--aas-text);
    cursor: pointer;
  }
  .aas-kwic-demo .kw-btn:hover,
  .aas-kwic-demo .kw-chip:hover {
    border-color: var(--aas-accent);
  }
  .aas-kwic-demo .kw-btn-primary {
    background: var(--aas-accent);
    border-color: var(--aas-accent);
    color: #fff;
  }
  .aas-kwic-demo .kw-chip {
    padding: 0.2em 0.65em;
    font-family: var(--aas-mono, monospace);
    font-size: 0.78em;
    border: 1px solid var(--aas-border);
    border-radius: 999px;
    background: var(--aas-bg);
    color: var(--aas-text);
    cursor: pointer;
  }
  .aas-kwic-demo .kw-chip.is-on {
    background: color-mix(in srgb, var(--aas-accent) 18%, var(--aas-bg));
    border-color: var(--aas-accent);
    font-weight: 700;
  }
  .aas-kwic-demo .kw-inputs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35em 0.9em;
    align-items: center;
    margin: 0.4em 0;
  }
  .aas-kwic-demo .kw-input {
    display: inline-flex;
    gap: 0.45em;
    align-items: center;
    font-size: 0.85em;
    font-weight: 700;
  }
  .aas-kwic-demo .kw-input input {
    width: 8em;
    padding: 0.18em 0.5em;
    font: inherit;
    font-family: var(--aas-mono, monospace);
    font-weight: 400;
    border: 1px solid var(--aas-border);
    border-radius: 0.45em;
    background: var(--aas-bg);
    color: var(--aas-text);
  }
  .aas-kwic-demo .kw-input input:focus {
    outline: 2px solid var(--aas-accent);
    outline-offset: 1px;
  }
  .aas-kwic-demo .kw-slider {
    display: inline-flex;
    flex: 1 1 9em;
    gap: 0.45em;
    align-items: center;
    font-size: 0.82em;
    white-space: nowrap;
  }
  .aas-kwic-demo .kw-slider b {
    font-family: var(--aas-mono, monospace);
  }
  .aas-kwic-demo .kw-slider input {
    flex: 1 1 auto;
    min-width: 4em;
    accent-color: var(--aas-accent);
  }
  .aas-kwic-demo .kw-range {
    position: relative;
    height: 0.8em;
    border-radius: 0.2em;
    background: color-mix(in srgb, var(--aas-muted) 14%, var(--aas-bg));
    overflow: hidden;
  }
  .aas-kwic-demo .kw-range i {
    position: absolute;
    top: 0;
    bottom: 0;
    background: color-mix(in srgb, var(--aas-role-model) 50%, var(--aas-bg));
    transition:
      left 0.3s,
      width 0.3s;
  }
  .aas-kwic-demo .kw-range u {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--aas-role-focus);
    transition: left 0.3s;
  }
  .aas-kwic-demo .kw-main {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19em), 1fr));
    gap: 0.4em 1.1em;
    margin-top: 0.4em;
    font-family: var(--aas-mono, monospace);
  }
  .aas-kwic-demo .kw-cap {
    display: block;
    font-family: var(--aas-sans, inherit);
    font-size: 0.72em;
    color: var(--aas-muted);
    border-bottom: 1px solid var(--aas-border);
  }
  .aas-kwic-demo .kw-win,
  .aas-kwic-demo .kw-found {
    min-height: calc(7 * 1.32em);
    font-size: 0.78em;
    line-height: 1.32;
  }
  .aas-kwic-demo .kw-row {
    display: flex;
    gap: 0.5em;
    padding: 0 0.25em;
    white-space: pre;
    overflow: hidden;
    border-radius: 0.2em;
  }
  .aas-kwic-demo .kw-row i {
    min-width: 2em;
    font-style: normal;
    text-align: right;
    color: var(--aas-muted);
  }
  .aas-kwic-demo .kw-row b {
    font-weight: 700;
  }
  .aas-kwic-demo .kw-row.is-range {
    background: color-mix(in srgb, var(--aas-role-model) 12%, transparent);
  }
  .aas-kwic-demo .kw-row.is-mid {
    background: color-mix(in srgb, var(--aas-role-focus) 28%, transparent);
  }
  .aas-kwic-demo .kw-row.is-hit {
    background: color-mix(in srgb, var(--aas-role-eval) 22%, transparent);
  }
  .aas-kwic-demo .kw-line {
    white-space: pre;
    overflow: hidden;
  }
  .aas-kwic-demo .kw-line b {
    color: var(--aas-role-focus);
  }
  .aas-kwic-demo .kw-more {
    font-family: var(--aas-sans, inherit);
    color: var(--aas-muted);
  }
  .aas-kwic-demo .kw-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2em 1em;
    align-items: baseline;
    justify-content: space-between;
    margin-top: 0.3em;
  }
  .aas-kwic-demo .kw-note {
    flex: 1 1 22em;
    margin: 0;
    font-size: 0.85em;
    min-height: 3em;
  }
  .aas-kwic-demo .kw-stat {
    font-size: 0.85em;
    color: var(--aas-muted);
    white-space: nowrap;
  }
  .aas-kwic-demo .kw-stat strong {
    font-family: var(--aas-mono, monospace);
    color: var(--aas-text);
  }

  /* 슬라이드용. 다른 데모와 같은 방식. vh 단위인 이유는 SearchDemo 참고 */
  .aas-kwic-demo.is-slide {
    font-size: clamp(1rem, 2.6vh, 1.75rem);
    margin: 0.5rem 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .aas-kwic-demo .kw-range i,
    .aas-kwic-demo .kw-range u {
      transition: none;
    }
  }
</style>
