---
// 피보나치 재귀를 한 걸음씩 돌려 보는 데모.
//
// 호출 트리 그림만으로는 "중복이 많다"까지는 보여도 재귀가 실제로 어떻게 도는지는
// 보이지 않는다. 여기서는 호출 스택이 쌓였다 빠지는 것을 주인공으로 둔다.
// 스택 깊이는 재귀의 공간 O(n)이고, 호출 수는 시간 O(2^n)이다. 두 숫자가 화면에서
// 함께 움직이는 것이 이 데모의 요점이다.
//
// 트리와 스택 칸은 전부 서버에서 그린다. 스크립트는 만들어진 요소의 class와
// textContent만 바꾼다. 그래서 Astro의 scoped 스타일이 그대로 먹는다
// (SearchDemo가 is:global을 써야 했던 것은 셀을 JS로 만들기 때문이다).
//
// 표식은 전부 `data-rd-*`다. 테마의 덱 크롬이 `document.querySelector('[data-total]')`
// 처럼 문서 전체에서 짧은 이름을 찾기 때문에, 슬라이드 안에서 같은 이름을 쓰면
// 크롬이 이 컴포넌트를 자기 것으로 알고 내용을 덮어쓴다.
//
// 색은 테마의 --aas-role-* 팔레트를 쓴다. SearchDemo·SearchTrace와 같은 뜻에
// 같은 색을 쓴다.
import { defaultLang } from 'stack-site-builder/i18n/ui';

interface Props {
  /** 펼칠 항. 5면 호출 15번, 최대 깊이 5칸이다. */
  n?: number;
  /** 슬라이드용: 글자와 칸을 슬라이드 크기에 맞춘다. */
  slide?: boolean;
}
const { n = 5, slide = false } = Astro.props;
const id = `rd-${Math.random().toString(36).slice(2, 9)}`;

type Node = {
  id: number;
  n: number;
  depth: number;
  value: number;
  children: Node[];
  x: number;
};

let nextId = 0;
const fib = (k: number): number => (k <= 1 ? k : fib(k - 1) + fib(k - 2));
const build = (k: number, depth: number): Node => {
  const node: Node = { id: nextId++, n: k, depth, value: fib(k), children: [], x: 0 };
  if (k > 1) {
    node.children.push(build(k - 1, depth + 1));
    node.children.push(build(k - 2, depth + 1));
  }
  return node;
};
const root = build(n, 0);

// 잎을 왼쪽부터 한 칸씩 놓고, 부모는 자식들의 가운데에 둔다.
let leafSlot = 0;
const layout = (node: Node): number => {
  if (node.children.length === 0) {
    node.x = leafSlot++;
  } else {
    const xs = node.children.map(layout);
    node.x = (xs[0] + xs[xs.length - 1]) / 2;
  }
  return node.x;
};
layout(root);

const flat: Node[] = [];
const walk = (node: Node) => {
  flat.push(node);
  node.children.forEach(walk);
};
walk(root);

const leaves = leafSlot;
const levels = Math.max(...flat.map((d) => d.depth)) + 1;
const COL = 64;
const ROW = 62;
const NW = 46;
const NH = 28;
const cx = (d: Node) => (d.x + 0.5) * COL;
const cy = (d: Node) => d.depth * ROW + NH / 2 + 4;
const viewW = leaves * COL;
const viewH = levels * ROW;

// 호출 순서. call은 스택에 쌓는 것이고 return은 빼는 것이다.
type Ev = { type: 'call' | 'return'; id: number; n: number; value: number; ord: number };
const events: Ev[] = [];
const computed = new Map<number, number>();
const run = (node: Node) => {
  events.push({ type: 'call', id: node.id, n: node.n, value: node.value, ord: 0 });
  node.children.forEach(run);
  const ord = (computed.get(node.n) ?? 0) + 1;
  computed.set(node.n, ord);
  events.push({ type: 'return', id: node.id, n: node.n, value: node.value, ord });
};
run(root);

const maxDepth = levels;
const totalCalls = flat.length;

const STRINGS: Record<string, Record<string, string>> = {
  ko: {
    stack: '호출 스택',
    tree: '호출 트리',
    step: '한 걸음',
    play: '자동 재생',
    stop: '멈춤',
    reset: '처음으로',
    calls: '호출',
    callsUnit: '회',
    depth: '깊이',
    depthUnit: '칸',
    empty: '비어 있음',
    start: '{f}를 구하려고 합니다. 한 걸음씩 눌러 보세요.',
    call: '{f}를 호출합니다. 스택이 한 칸 깊어집니다.',
    base: '{f}는 더 쪼갤 것이 없습니다. 바로 {v}입니다.',
    ret: '{f} = {v}. 스택에서 빠집니다.',
    again: '{f} = {v}. 이 값을 구하는 것이 {o}번째입니다.',
    done: '호출 {c}회, 가장 깊었을 때 {d}칸. 서로 다른 값은 {u}개뿐입니다.',
  },
  en: {
    stack: 'Call stack',
    tree: 'Call tree',
    step: 'Step',
    play: 'Play',
    stop: 'Pause',
    reset: 'Reset',
    calls: 'calls',
    callsUnit: '',
    depth: 'depth',
    depthUnit: '',
    empty: 'empty',
    start: 'Computing {f}. Press step to follow along.',
    call: 'Call {f}. The stack grows by one frame.',
    base: '{f} splits no further. It is {v}.',
    ret: '{f} = {v}. The frame pops.',
    again: '{f} = {v}. That is the {o} time this value is computed.',
    done: '{c} calls, {d} frames at the deepest point, and only {u} distinct values.',
  },
  zh: {
    stack: '调用栈',
    tree: '调用树',
    step: '单步',
    play: '播放',
    stop: '暂停',
    reset: '重置',
    calls: '调用',
    callsUnit: '次',
    depth: '深度',
    depthUnit: '层',
    empty: '空',
    start: '要计算 {f}。请逐步查看。',
    call: '调用 {f}。栈加深一层。',
    base: '{f} 无法再拆分，直接是 {v}。',
    ret: '{f} = {v}。该帧出栈。',
    again: '{f} = {v}。这已是第 {o} 次计算该值。',
    done: '共调用 {c} 次，最深 {d} 层，而不同的值只有 {u} 个。',
  },
};
const lang = Astro.currentLocale ?? defaultLang;
const t = STRINGS[lang] ?? STRINGS[defaultLang] ?? STRINGS.ko;
const uniqueValues = computed.size;
---

<div
  class:list={['aas-recursion-demo', slide && 'is-slide']}
  id={id}
  data-rd-strings={JSON.stringify(t)}
  data-rd-events={JSON.stringify(events)}
  data-rd-total={totalCalls}
  data-rd-unique={uniqueValues}
>
  <div class="rd-bar">
    <span class="rd-counts">
      <span class="rd-count">{t.calls} <strong data-rd-calls>0</strong>{t.callsUnit}</span>
      <span class="rd-count">{t.depth} <strong data-rd-depth>0</strong>{t.depthUnit}</span>
    </span>
    <span class="rd-controls">
      <button type="button" class="rd-btn" data-rd-step>{t.step}</button>
      <button type="button" class="rd-btn rd-btn-primary" data-rd-play>{t.play}</button>
      <button type="button" class="rd-btn" data-rd-reset>{t.reset}</button>
    </span>
  </div>

  <div class="rd-body">
    <div class="rd-stack-col">
      <h4>{t.stack}</h4>
      <div class="rd-stack">
        {
          Array.from({ length: maxDepth }, (_, i) => (
            <div class="rd-frame" data-rd-frame={i}>
              <span class="rd-frame-label"></span>
            </div>
          ))
        }
      </div>
    </div>

    <div class="rd-tree-col">
      <h4>{t.tree}</h4>
      <svg class="rd-tree" viewBox={`0 0 ${viewW} ${viewH}`} role="img" aria-label={t.tree}>
        {
          flat.flatMap((p) =>
            p.children.map((c) => (
              <path
                class="rd-edge"
                data-rd-edge={c.id}
                d={`M ${cx(p)} ${cy(p) + NH / 2} C ${cx(p)} ${cy(p) + ROW / 2}, ${cx(c)} ${cy(c) - ROW / 2}, ${cx(c)} ${cy(c) - NH / 2}`}
              />
            )),
          )
        }
        {
          flat.map((d) => (
            <g class="rd-node" data-rd-node={d.id}>
              <rect x={cx(d) - NW / 2} y={cy(d) - NH / 2} width={NW} height={NH} rx="6" />
              <text x={cx(d)} y={cy(d)} text-anchor="middle" dominant-baseline="central">
                {`F(${d.n})`}
              </text>
            </g>
          ))
        }
      </svg>
    </div>
  </div>

  <p class="rd-note" data-rd-note></p>
</div>

<script>
  (() => {
    const fill = (tpl: string, vars: Record<string, string | number>) =>
      tpl.replace(/\{(\w+)\}/g, (_, k) => String(vars[k] ?? ''));

    document.querySelectorAll<HTMLElement>('.aas-recursion-demo').forEach((root) => {
      if (root.dataset.rdWired) return;
      root.dataset.rdWired = '1';

      const t = JSON.parse(root.dataset.rdStrings || '{}');
      type Ev = { type: 'call' | 'return'; id: number; n: number; value: number; ord: number };
      const events: Ev[] = JSON.parse(root.dataset.rdEvents || '[]');
      const total = Number(root.dataset.rdTotal || 0);
      const unique = Number(root.dataset.rdUnique || 0);

      const frames = [...root.querySelectorAll<HTMLElement>('.rd-frame')];
      const nodes = new Map<number, SVGGElement>();
      root.querySelectorAll<SVGGElement>('[data-rd-node]').forEach((el) =>
        nodes.set(Number(el.dataset.rdNode), el),
      );
      const edges = new Map<number, SVGPathElement>();
      root.querySelectorAll<SVGPathElement>('[data-rd-edge]').forEach((el) =>
        edges.set(Number(el.dataset.rdEdge), el),
      );
      const noteEl = root.querySelector<HTMLElement>('[data-rd-note]')!;
      const callsEl = root.querySelector<HTMLElement>('[data-rd-calls]')!;
      const depthEl = root.querySelector<HTMLElement>('[data-rd-depth]')!;
      const stepBtn = root.querySelector<HTMLButtonElement>('[data-rd-step]')!;
      const playBtn = root.querySelector<HTMLButtonElement>('[data-rd-play]')!;
      const resetBtn = root.querySelector<HTMLButtonElement>('[data-rd-reset]')!;

      let at = -1;
      let timer: number | null = null;

      // 상태는 들고 다니지 않고 매번 처음부터 다시 센다. 되감기가 공짜가 되고,
      // 스택·트리·카운터가 서로 어긋날 여지가 없다.
      const render = () => {
        const stack: Ev[] = [];
        const seen = new Set<number>();
        const done = new Map<number, Ev>();
        let calls = 0;
        for (let i = 0; i <= at; i++) {
          const e = events[i];
          if (e.type === 'call') {
            stack.push(e);
            seen.add(e.id);
            calls++;
          } else {
            stack.pop();
            done.set(e.id, e);
          }
        }
        const top = stack[stack.length - 1];

        frames.forEach((f, i) => {
          const e = stack[i];
          const label = f.querySelector('.rd-frame-label')!;
          label.textContent = e ? `F(${e.n})` : '';
          f.classList.toggle('is-on', Boolean(e));
          f.classList.toggle('is-top', Boolean(e) && i === stack.length - 1);
        });

        nodes.forEach((el, nodeId) => {
          const ret = done.get(nodeId);
          el.classList.toggle('is-seen', seen.has(nodeId));
          el.classList.toggle('is-live', Boolean(top) && nodeId === top.id);
          el.classList.toggle('is-done', Boolean(ret));
          el.classList.toggle('is-again', ret !== undefined && ret.ord > 1);
          const text = el.querySelector('text')!;
          const ev = ret ?? events.find((x) => x.id === nodeId)!;
          text.textContent = ret ? `${ret.value}` : `F(${ev.n})`;
        });
        edges.forEach((el, childId) => el.classList.toggle('is-seen', seen.has(childId)));

        callsEl.textContent = String(calls);
        depthEl.textContent = String(stack.length);

        const e = at >= 0 ? events[at] : null;
        if (!e) {
          noteEl.textContent = fill(t.start, { f: `F(${events[0].n})` });
        } else if (e.type === 'call') {
          const key = e.n <= 1 ? 'base' : 'call';
          noteEl.textContent = fill(t[key], { f: `F(${e.n})`, v: e.value });
        } else {
          const key = e.ord > 1 ? 'again' : 'ret';
          noteEl.textContent = fill(t[key], { f: `F(${e.n})`, v: e.value, o: e.ord });
        }
        if (at === events.length - 1) {
          noteEl.textContent = fill(t.done, { c: total, d: frames.length, u: unique });
        }
        noteEl.classList.toggle('is-done', at === events.length - 1);

        const finished = at >= events.length - 1;
        stepBtn.disabled = finished;
        if (finished) stop();
      };

      const stop = () => {
        if (timer !== null) {
          clearInterval(timer);
          timer = null;
          playBtn.textContent = t.play;
        }
      };
      const step = () => {
        if (at < events.length - 1) at++;
        render();
      };

      stepBtn.addEventListener('click', () => {
        stop();
        step();
      });
      playBtn.addEventListener('click', () => {
        if (timer !== null) {
          stop();
          return;
        }
        if (at >= events.length - 1) at = -1;
        playBtn.textContent = t.stop;
        timer = window.setInterval(step, 550);
      });
      resetBtn.addEventListener('click', () => {
        stop();
        at = -1;
        render();
      });

      render();
    });
  })();
</script>

<style>
  .aas-recursion-demo {
    /* 안쪽 치수는 모두 이 값에 대한 em이다. 루트 하나로 전체가 함께 커진다. */
    font-size: 1rem;
    margin: 1.5rem 0;
    padding: 1em;
    border: 1px solid var(--aas-border);
    border-radius: 0.9em;
    background: var(--aas-panel);
  }
  .rd-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75em;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.8em;
  }
  .rd-counts {
    display: flex;
    gap: 1em;
    font-size: 0.9em;
    color: var(--aas-muted);
  }
  .rd-count strong {
    color: var(--aas-text);
    font-family: var(--aas-mono, monospace);
  }
  .rd-controls {
    display: flex;
    gap: 0.5em;
  }
  .rd-btn {
    padding: 0.35em 0.8em;
    font-size: 0.85em;
    border: 1px solid var(--aas-border);
    border-radius: 0.5em;
    background: var(--aas-bg);
    color: var(--aas-text);
    cursor: pointer;
  }
  .rd-btn:hover:not(:disabled) {
    border-color: var(--aas-accent);
  }
  .rd-btn:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .rd-btn-primary {
    background: var(--aas-accent);
    border-color: var(--aas-accent);
    color: #fff;
  }

  .rd-body {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25em;
    align-items: start;
  }
  .rd-body h4 {
    margin: 0 0 0.4em;
    font-size: 0.9em;
    font-weight: 600;
    color: var(--aas-muted);
  }

  /* 스택은 아래에서 위로 쌓인다. column-reverse가 그 방향을 만든다. */
  .rd-stack {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-start;
    gap: 0.2em;
  }
  .rd-frame {
    min-width: 5em;
    padding: 0.3em 0.6em;
    text-align: center;
    font-family: var(--aas-mono, monospace);
    font-size: 0.85em;
    line-height: 1.3;
    border: 1px dashed var(--aas-border);
    border-radius: 0.35em;
    color: transparent;
    transition:
      background-color 0.18s,
      border-color 0.18s;
  }
  .rd-frame::after {
    /* 빈 칸도 자리를 지켜야 스택이 자랄 때 그림이 흔들리지 않는다. */
    content: '\00a0';
  }
  .rd-frame.is-on {
    border-style: solid;
    border-color: var(--aas-border);
    background: var(--aas-bg);
    color: var(--aas-text);
  }
  .rd-frame.is-top {
    border-color: var(--aas-role-focus);
    background: color-mix(in srgb, var(--aas-role-focus) 22%, transparent);
    font-weight: 700;
  }

  .rd-tree {
    display: block;
    width: 100%;
    height: auto;
  }
  .rd-edge {
    fill: none;
    stroke: var(--aas-border);
    stroke-width: 1.5;
    opacity: 0.25;
    transition: opacity 0.18s;
  }
  .rd-edge.is-seen {
    opacity: 1;
  }
  .rd-node rect {
    fill: var(--aas-bg);
    stroke: var(--aas-border);
    stroke-width: 1;
    transition:
      fill 0.18s,
      stroke 0.18s;
  }
  .rd-node text {
    fill: var(--aas-text);
    font-family: var(--aas-mono, monospace);
    font-size: 13px;
  }
  /* 아직 부르지 않은 가지는 흐리게. 앞으로 무엇이 남았는지는 보이되 주인공은
     아니게 둔다. */
  .rd-node:not(.is-seen) {
    opacity: 0.28;
  }
  .rd-node.is-live rect {
    fill: color-mix(in srgb, var(--aas-role-focus) 22%, var(--aas-bg));
    stroke: var(--aas-role-focus);
  }
  .rd-node.is-done rect {
    fill: color-mix(in srgb, var(--aas-role-eval) 26%, var(--aas-bg));
    stroke: var(--aas-role-eval);
  }
  /* 같은 값을 다시 구한 노드. 이 데모가 말하려는 것이 바로 이 색이다. */
  .rd-node.is-again rect {
    fill: color-mix(in srgb, var(--aas-role-guard) 26%, var(--aas-bg));
    stroke: var(--aas-role-guard);
  }

  .rd-note {
    margin: 0.8em 0 0;
    font-size: 0.85em;
    color: var(--aas-muted);
    min-height: 2.4em;
  }
  .rd-note.is-done {
    color: var(--aas-text);
    font-weight: 600;
  }

  /* 슬라이드용. 근거는 SearchDemo의 같은 규칙과 같다: 슬라이드 폭은 뷰포트
     높이가 정하므로 vw가 아니라 vh로 잡는다. */
  .aas-recursion-demo.is-slide {
    font-size: clamp(1rem, 2.6vh, 1.7rem);
    margin: 0.5rem 0;
  }
  .aas-recursion-demo.is-slide .rd-note {
    min-height: 1.6em;
  }

  @media (prefers-reduced-motion: reduce) {
    .rd-frame,
    .rd-edge,
    .rd-node rect {
      transition: none;
    }
  }
</style>
