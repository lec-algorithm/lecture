---
// 예측 식의 가중 평균을 저울처럼 보는 데모.
//
// 수직선 1부터 5 위에 이웃이 준 평점을 놓고, 유사도만큼 무거운 추로 그린다. 예측은 추들의 무게중심이다.
// 슬라이더로 유사도를 바꾸거나, 프리셋으로 코사인 k = 3, 코사인 k = 2, 피어슨, 같은 무게를 고른다.
// 예측은 언제나 이웃 평점의 최솟값과 최댓값 사이에 있고, 평점이 가장 높은 이웃을 빼면 얼마가 되는지도
// 함께 적는다.
//
// 유사도는 평점 행렬에서 직접 계산하고, 절차는 algorithm-code의 predictUserBased와 같다.
// 코사인 k = 3이면 M3 4.354, M6 2.542, k = 2면 M6 1.495, 피어슨이면 M3 4.464, M6 1.536이다.
import { defaultLang } from 'stack-site-builder/i18n/ui';
import { MOVIE_TITLES, RATINGS, USERS } from './recData';

interface Props {
  /** 슬라이드용: 바깥 여백은 줄이고 글자와 칸은 키운다. */
  slide?: boolean;
}
const { slide = false } = Astro.props;
const id = `wa-${Math.random().toString(36).slice(2, 9)}`;

const STRINGS: Record<string, Record<string, string>> = {
  ko: {
    title: '가중 평균은 무게중심',
    blank: '채울 칸',
    preset: '유사도',
    cos3: '코사인 k = 3',
    cos2: '코사인 k = 2',
    pear: '피어슨',
    equal: '모두 같게',
    user: '사용자',
    rating: '평점',
    weight: '유사도 (무게)',
    predict: '예측',
    between: '가중 평균은 언제나 이웃 평점의 최솟값 {lo}, 최댓값 {hi} 사이에 놓입니다.',
    drop: '평점이 가장 높은 {u}를 빼면 {q}입니다.',
    alone: '이웃이 {u} 하나뿐이면 예측은 그 평점 {q} 그대로입니다.',
    none: '무게가 있는 이웃이 없어 예측할 수 없습니다.',
    negative: '피어슨에서 음수인 사용자는 무게를 0으로 둡니다.',
  },
  en: {
    title: 'A weighted mean is a center of mass',
    blank: 'blank',
    preset: 'similarity',
    cos3: 'cosine k = 3',
    cos2: 'cosine k = 2',
    pear: 'Pearson',
    equal: 'all equal',
    user: 'user',
    rating: 'rating',
    weight: 'similarity (weight)',
    predict: 'predicted',
    between: 'A weighted mean always lies between the lowest neighbor rating, {lo}, and the highest, {hi}.',
    drop: 'Without {u}, the highest rater, it becomes {q}.',
    alone: 'With {u} as the only neighbor, the prediction is simply that rating, {q}.',
    none: 'No neighbor has any weight, so nothing can be predicted.',
    negative: 'Users with a negative Pearson get weight 0.',
  },
  zh: {
    title: '加权平均就是重心',
    blank: '要填的格子',
    preset: '相似度',
    cos3: '余弦 k = 3',
    cos2: '余弦 k = 2',
    pear: '皮尔逊',
    equal: '全部相同',
    user: '用户',
    rating: '评分',
    weight: '相似度（重量）',
    predict: '预测',
    between: '加权平均总是落在邻居评分的最小值 {lo} 和最大值 {hi} 之间。',
    drop: '去掉评分最高的 {u}，就变成 {q}。',
    alone: '邻居只有 {u} 一人时，预测就是那个评分 {q}。',
    none: '没有带重量的邻居，无法预测。',
    negative: '皮尔逊为负的用户，重量取 0。',
  },
};
const lang = Astro.currentLocale ?? defaultLang;
const t = STRINGS[lang] ?? STRINGS[defaultLang] ?? STRINGS.ko;
const titles = MOVIE_TITLES[lang] ?? MOVIE_TITLES.ko;
const blanks = [2, 5];
const others = [1, 2, 3, 4];
const presets = [
  ['cos3', t.cos3],
  ['cos2', t.cos2],
  ['pear', t.pear],
  ['equal', t.equal],
];
/* 수직선 좌표 */
const W = 640;
const LINE = 96;
const H = LINE + 48;
const X = (v: number) => 40 + (v - 1) * 140;
---

<div
  class:list={['aas-wavg-demo', slide && 'is-slide']}
  id={id}
  data-wa-ratings={JSON.stringify(RATINGS)}
  data-wa-users={JSON.stringify(USERS)}
  data-wa-strings={JSON.stringify(t)}
>
  <div class="wa-bar">
    <span class="wa-head"><strong>{t.title}</strong></span>
    <span class="wa-group">
      <span class="wa-label">{t.preset}</span>
      {presets.map(([k, label]) => <button type="button" class="wa-btn" data-wa-preset={k}>{label}</button>)}
    </span>
  </div>
  <div class="wa-bar wa-bar2">
    <span class="wa-group">
      <span class="wa-label">{t.blank}</span>
      {blanks.map((b) => <button type="button" class="wa-btn" data-wa-blank={b}>M{b + 1} {titles[b]}</button>)}
    </span>
  </div>

  <svg class="wa-svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={t.title} data-wa-svg>
    <line class="wa-line" x1={X(1)} y1={LINE} x2={X(5)} y2={LINE} />
    {
      [1, 2, 3, 4, 5].map((v) => (
        <>
          <line class="wa-tickline" x1={X(v)} y1={LINE} x2={X(v)} y2={LINE + 6} />
          <text class="wa-tick" x={X(v)} y={LINE + 22}>{v}</text>
        </>
      ))
    }
    {
      others.map((u) => (
        <g class="wa-weight" data-wa-dot={u}>
          <circle />
          <text class="wa-dname" />
        </g>
      ))
    }
    <g class="wa-marker" data-wa-marker>
      <path d={`M0 ${LINE + 27} L-9 ${LINE + 42} L9 ${LINE + 42} Z`} />
      <text class="wa-mval" x="16" y={LINE + 43}></text>
    </g>
  </svg>

  <div class="wa-rows">
    <span class="wa-hd">{t.user}</span>
    <span class="wa-hd">{t.rating}</span>
    <span class="wa-hd">{t.weight}</span>
    <span class="wa-hd"></span>
    {
      others.map((u) => (
        <>
          <span class="wa-name">{USERS[u]}</span>
          <span class="wa-rate" data-wa-rate={u} />
          <input type="range" min="0" max="1" step="0.001" data-wa-range={u} aria-label={USERS[u]} />
          <span class="wa-sim" data-wa-sim={u} />
        </>
      ))
    }
  </div>

  <p class="wa-formula" data-wa-formula></p>
  <p class="wa-note" data-wa-note></p>
</div>

<script is:inline define:vars={{ id }}>
  (() => {
    const root = document.getElementById(id);
    if (!root) return;

    /* 설명은 문장마다 줄을 바꾼다. 마침표 뒤 공백, 또는 중국어 마침표 뒤에서 끊는다. */
    const setLines = (node, text) => {
      const parts = String(text).split(/(?<=[.!?])\s+(?=\S)|(?<=[。！？])(?=\S)/);
      node.replaceChildren(...parts.flatMap((s, i) => (i ? [document.createElement('br'), s] : [s])));
    };
    /* 문장 잇기. 중국어 마침표 뒤에는 공백을 두지 않아야 setLines가 끊는다. */
    const join = (...parts) =>
      parts.filter(Boolean).reduce((a, b) => (/[。！？]$/.test(a) ? a + b : `${a} ${b}`), '');
    const fill = (tpl, vars) => tpl.replace(/\{(\w+)\}/g, (_, k) => vars[k]);

    const R = JSON.parse(root.dataset.waRatings);
    const users = JSON.parse(root.dataset.waUsers);
    const S = JSON.parse(root.dataset.waStrings);
    const f3 = (x) => x.toFixed(3);
    const X = (v) => 40 + (v - 1) * 140;
    const LINE = Number(root.querySelector('.wa-line').getAttribute('y1'));

    /* 실습 코드와 같은 함수들. 0은 안 본 칸이다. */
    function cosine(a, b) {
      let dot = 0, na = 0, nb = 0;
      for (let i = 0; i < a.length; i++) {
        dot += a[i] * b[i];
        na += a[i] * a[i];
        nb += b[i] * b[i];
      }
      return na === 0 || nb === 0 ? 0 : dot / Math.sqrt(na * nb);
    }
    function pearson(a, b) {
      const common = [];
      for (let i = 0; i < a.length; i++) if (a[i] > 0 && b[i] > 0) common.push(i);
      if (!common.length) return 0;
      let sa = 0, sb = 0;
      for (const i of common) {
        sa += a[i];
        sb += b[i];
      }
      const ma = sa / common.length, mb = sb / common.length;
      let num = 0, da = 0, db = 0;
      for (const i of common) {
        num += (a[i] - ma) * (b[i] - mb);
        da += (a[i] - ma) * (a[i] - ma);
        db += (b[i] - mb) * (b[i] - mb);
      }
      return da === 0 || db === 0 ? 0 : num / Math.sqrt(da * db);
    }

    const others = [1, 2, 3, 4];
    const cos = Object.fromEntries(others.map((u) => [u, cosine(R[0], R[u])]));
    const pear = Object.fromEntries(others.map((u) => [u, pearson(R[0], R[u])]));
    /* 유사도 순으로 k명만 무게를 남긴다. 나머지와 0 이하는 무게 0 */
    const topK = (sim, k) => {
      const order = others.filter((u) => sim[u] > 0).sort((p, q) => sim[q] - sim[p]).slice(0, k);
      return Object.fromEntries(others.map((u) => [u, order.includes(u) ? sim[u] : 0]));
    };
    const PRESETS = {
      cos3: topK(cos, 3),
      cos2: topK(cos, 2),
      pear: topK(pear, 3),
      equal: { 1: 1, 2: 1, 3: 1, 4: 1 },
    };

    let blank = 5;
    let preset = 'cos3';
    let w = { ...PRESETS.cos3 };

    const dots = [...root.querySelectorAll('[data-wa-dot]')];
    const marker = root.querySelector('[data-wa-marker]');
    const formula = root.querySelector('[data-wa-formula]');
    const note = root.querySelector('[data-wa-note]');

    function predict(weights, b) {
      let num = 0, den = 0;
      for (const u of others) {
        if (weights[u] > 0 && R[u][b] > 0) {
          num += weights[u] * R[u][b];
          den += weights[u];
        }
      }
      return den === 0 ? null : num / den;
    }

    function render() {
      const p = predict(w, blank);
      const used = others.filter((u) => w[u] > 0);
      /* 같은 평점의 추는 수직선 위에 쌓는다. */
      const stack = {};
      dots.forEach((g) => {
        const u = Number(g.dataset.waDot);
        const r = R[u][blank];
        const x = X(r);
        const on = w[u] > 0;
        const rad = on ? 7 + 14 * Math.sqrt(w[u]) : 6;
        const cy = LINE - (stack[r] ?? 0) - rad;
        stack[r] = (stack[r] ?? 0) + rad * 2;
        const circle = g.querySelector('circle');
        circle.setAttribute('r', String(rad));
        circle.setAttribute('cy', String(cy));
        circle.setAttribute('cx', String(x));
        const label = g.querySelector('text');
        label.setAttribute('x', String(x));
        label.setAttribute('y', String(cy + 5));
        label.textContent = users[u];
        g.classList.toggle('is-off', !on);
      });
      marker.style.visibility = p === null ? 'hidden' : 'visible';
      if (p !== null) {
        marker.setAttribute('transform', `translate(${X(p)} 0)`);
        marker.querySelector('text').textContent = f3(p);
      }
      root.querySelectorAll('[data-wa-rate]').forEach((el) => {
        el.textContent = String(R[Number(el.dataset.waRate)][blank]);
      });
      root.querySelectorAll('[data-wa-range]').forEach((el) => {
        const u = Number(el.dataset.waRange);
        el.value = String(w[u]);
        const sim = root.querySelector(`[data-wa-sim="${u}"]`);
        sim.textContent = f3(w[u]);
        sim.classList.toggle('is-off', w[u] === 0);
      });
      root.querySelectorAll('[data-wa-blank]').forEach((b) => b.classList.toggle('is-on', Number(b.dataset.waBlank) === blank));
      root.querySelectorAll('[data-wa-preset]').forEach((b) => b.classList.toggle('is-on', b.dataset.waPreset === preset));

      const m = `M${blank + 1}`;
      if (p === null) {
        formula.textContent = `${m} = ?`;
        setLines(note, S.none);
        return;
      }
      const terms = used.map((u) => `${f3(w[u])}×${R[u][blank]}`).join(' + ');
      const den = used.map((u) => f3(w[u])).join(' + ');
      formula.textContent = `${m} = (${terms}) / (${den}) = ${f3(p)}`;

      const rates = used.map((u) => R[u][blank]);
      const lo = Math.min(...rates), hi = Math.max(...rates);
      const parts = [];
      if (used.length === 1) {
        parts.push(fill(S.alone, { u: users[used[0]], q: rates[0] }));
      } else {
        parts.push(fill(S.between, { lo, hi }));
        if (lo < hi) {
          const top = used.find((u) => R[u][blank] === hi);
          const rest = { ...w, [top]: 0 };
          parts.push(fill(S.drop, { u: users[top], q: f3(predict(rest, blank)) }));
        }
      }
      if (preset === 'pear') parts.push(S.negative);
      setLines(note, join(...parts));
    }

    root.querySelectorAll('[data-wa-range]').forEach((el) =>
      el.addEventListener('input', () => {
        w = { ...w, [Number(el.dataset.waRange)]: Number(el.value) };
        preset = null;
        render();
      }),
    );
    root.querySelectorAll('[data-wa-preset]').forEach((b) =>
      b.addEventListener('click', () => {
        preset = b.dataset.waPreset;
        w = { ...PRESETS[preset] };
        render();
      }),
    );
    root.querySelectorAll('[data-wa-blank]').forEach((b) =>
      b.addEventListener('click', () => {
        blank = Number(b.dataset.waBlank);
        render();
      }),
    );
    render();
  })();
</script>

<style is:global>
  .aas-wavg-demo {
    font-size: 1rem;
    margin: 1.5rem 0;
    padding: 1em;
    border: 1px solid var(--aas-border);
    border-radius: 0.9em;
    background: var(--aas-panel);
  }
  .aas-wavg-demo .wa-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em 1.2em;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.4em;
  }
  .aas-wavg-demo .wa-bar2 {
    justify-content: flex-start;
  }
  .aas-wavg-demo .wa-head {
    font-size: 0.95em;
  }
  .aas-wavg-demo .wa-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3em;
    align-items: center;
  }
  .aas-wavg-demo .wa-label {
    margin-right: 0.2em;
    font-size: 0.8em;
    color: var(--aas-muted);
  }
  .aas-wavg-demo .wa-btn {
    padding: 0.3em 0.7em;
    font-size: 0.8em;
    border: 1px solid var(--aas-border);
    border-radius: 0.5em;
    background: var(--aas-bg);
    color: var(--aas-text);
    cursor: pointer;
  }
  .aas-wavg-demo .wa-btn:hover {
    border-color: var(--aas-accent);
  }
  .aas-wavg-demo .wa-btn.is-on {
    background: var(--aas-accent);
    border-color: var(--aas-accent);
    color: #fff;
  }
  .aas-wavg-demo .wa-svg {
    display: block;
    width: 100%;
    max-width: 40em;
    margin: 0 auto;
  }
  .aas-wavg-demo .wa-line {
    stroke: var(--aas-muted);
    stroke-width: 2;
  }
  .aas-wavg-demo .wa-tickline {
    stroke: var(--aas-muted);
    stroke-width: 2;
  }
  .aas-wavg-demo .wa-tick {
    font-size: 15px;
    fill: var(--aas-muted);
    text-anchor: middle;
    font-family: var(--aas-mono, monospace);
  }
  .aas-wavg-demo .wa-weight circle {
    fill: color-mix(in srgb, var(--aas-role-source) 65%, var(--aas-bg));
    stroke: var(--aas-role-source);
    stroke-width: 1.5;
  }
  .aas-wavg-demo .wa-dname {
    font-size: 15px;
    font-weight: 700;
    fill: var(--aas-text);
    text-anchor: middle;
    font-family: var(--aas-mono, monospace);
  }
  .aas-wavg-demo .wa-weight.is-off circle {
    fill: var(--aas-bg);
    stroke: var(--aas-border);
  }
  .aas-wavg-demo .wa-weight.is-off .wa-dname {
    fill: var(--aas-muted);
    font-size: 12px;
  }
  .aas-wavg-demo .wa-marker path {
    fill: var(--aas-role-focus);
  }
  .aas-wavg-demo .wa-mval {
    font-size: 18px;
    font-weight: 700;
    fill: var(--aas-role-focus);
    font-family: var(--aas-mono, monospace);
  }
  .aas-wavg-demo .wa-rows {
    display: grid;
    grid-template-columns: auto auto minmax(8em, 26em) 4em;
    gap: 0.1em 1em;
    align-items: center;
    justify-content: center;
    font-family: var(--aas-mono, monospace);
    font-size: 0.92em;
  }
  .aas-wavg-demo .wa-hd {
    font-family: var(--aas-sans, inherit);
    font-size: 0.8em;
    color: var(--aas-muted);
    text-align: center;
  }
  .aas-wavg-demo .wa-name,
  .aas-wavg-demo .wa-rate {
    font-weight: 700;
    text-align: center;
  }
  .aas-wavg-demo .wa-rows input {
    width: 100%;
    accent-color: var(--aas-accent);
  }
  .aas-wavg-demo .wa-sim {
    text-align: right;
    font-weight: 700;
  }
  .aas-wavg-demo .wa-sim.is-off {
    color: var(--aas-muted);
    font-weight: 400;
  }
  .aas-wavg-demo .wa-formula {
    margin: 0.5em 0 0;
    font-family: var(--aas-mono, monospace);
    font-size: 0.8em;
    font-weight: 700;
    min-height: 1.4em;
  }
  .aas-wavg-demo .wa-note {
    margin: 0.3em 0 0;
    font-size: 0.85em;
    color: var(--aas-text);
    min-height: 2.6em;
  }

  /* 슬라이드용. vh 단위인 이유는 SearchDemo 참고 */
  .aas-wavg-demo.is-slide {
    font-size: clamp(1rem, 2.35vh, 1.75rem);
    margin: 0.5rem 0;
  }
  .aas-wavg-demo.is-slide .wa-svg {
    max-height: 19vh;
  }
</style>
