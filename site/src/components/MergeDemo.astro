---
// 병합 정렬을 한 걸음씩 돌려 보는 데모.
//
// 두 줄을 보여준다. 위가 배열, 아래가 임시 배열(temp)이다. 병합 중에는
// 두 구간의 맨 앞끼리 비교해서 작은 쪽이 temp로 내려가고, 구간이 끝나면
// 통째로 제자리로 돌아온다. "temp로 갔다가 돌아온다"가 이동 횟수가 입력과
// 무관하게 정해지는 이유이므로, 그 왕복을 눈에 보이게 두 줄로 그린다.
//
// mode="sort"는 전체 병합 정렬(재귀 포함), mode="merge"는 이미 정렬된
// 두 절반을 합치는 마지막 병합 하나만 보여준다. 병합이 엔진이고 재귀는
// 그 반복이므로, 가르칠 때는 merge를 먼저 보여주고 sort로 간다.
//
// 비교·이동을 세는 규칙은 algorithm-code의 구현과 같다. temp에 적을 때
// 이동 1회, 제자리로 돌아올 때 원소마다 이동 1회. 데모의 카운터가 코드
// 실행 결과와 같은 숫자에 도착하는 것이 이 데모의 요점이다.
//
// 색은 테마의 --aas-role-* 팔레트(라이트·다크 공통 고정값)를 쓴다.
// 스크립트는 이 컴포넌트 안에서만 도는 IIFE라 한 페이지에 여러 개 놓아도 된다.
import { defaultLang } from 'stack-site-builder/i18n/ui';

interface Props {
  /** 전체 정렬(sort)인지, 마지막 병합 하나(merge)인지 */
  mode?: 'sort' | 'merge';
  /** 정렬할 배열. merge 모드에서는 앞·뒤 절반이 각각 정렬되어 있어야 한다. */
  values?: number[];
  /** 슬라이드용: 바깥 여백은 줄이고 글자와 칸은 키운다. */
  slide?: boolean;
}
const {
  mode = 'sort',
  values = mode === 'merge'
    ? [1, 2, 5, 8, 9, 3, 4, 6, 7, 10]
    : [2, 8, 5, 9, 1, 10, 7, 6, 4, 3],
  slide = false,
} = Astro.props;
const id = `md-${Math.random().toString(36).slice(2, 9)}`;

/* 문구는 로케일별로. 테마가 en·ko만 갖고 있으므로 zh는 여기서 채운다.
   본문 텍스트가 아니라 스크립트가 찍는 문장까지 포함해야 한다. */
const STRINGS: Record<string, Record<string, string>> = {
  ko: {
    step: '한 걸음',
    play: '자동 재생',
    stop: '멈춤',
    reset: '처음으로',
    sort: '병합 정렬',
    merge: '병합',
    arrayRow: '배열',
    tempRow: '임시',
    compPre: '비교 ',
    compPost: '회',
    movePre: '이동 ',
    movePost: '회',
    sortIdle: '반으로 나눠 각각 정렬하고, 정렬된 두 절반을 합칩니다.',
    mergeIdle: '앞 절반과 뒤 절반은 각각 정렬되어 있습니다. 합쳐 봅니다.',
    divide: 'ms({lo}, {hi}) — [{lo}..{mid}]와 [{mid1}..{hi}]로 나눕니다.',
    leaf: 'ms({i}, {i}) — 원소 하나는 이미 정렬입니다.',
    takeLeft: '{v} ≤ {w} — 왼쪽 {v}가 temp로. 이동 1회.',
    takeRight: '{v} > {w} — 오른쪽 {w}가 temp로. 이동 1회.',
    drain: '한쪽이 끝났습니다 — {v}를 temp로. 이동 1회.',
    copyBack: '구간이 다 합쳐졌습니다 — 제자리로. 이동 {len}회.',
    done: '정렬 끝 — 비교 {c}회, 이동 {m}회.',
  },
  en: {
    step: 'Step',
    play: 'Play',
    stop: 'Pause',
    reset: 'Reset',
    sort: 'Merge sort',
    merge: 'Merge',
    arrayRow: 'array',
    tempRow: 'temp',
    compPre: 'comparisons ',
    compPost: '',
    movePre: 'moves ',
    movePost: '',
    sortIdle: 'Split in half, sort each, then merge the sorted halves.',
    mergeIdle: 'Each half is already sorted. Watch them merge.',
    divide: 'ms({lo}, {hi}) — split into [{lo}..{mid}] and [{mid1}..{hi}].',
    leaf: 'ms({i}, {i}) — one element is already sorted.',
    takeLeft: '{v} ≤ {w} — left {v} goes to temp. 1 move.',
    takeRight: '{v} > {w} — right {w} goes to temp. 1 move.',
    drain: 'One side is done — {v} goes to temp. 1 move.',
    copyBack: 'The range is merged — copy it back. {len} moves.',
    done: 'Sorted — {c} comparisons, {m} moves.',
  },
  zh: {
    step: '单步',
    play: '播放',
    stop: '暂停',
    reset: '重置',
    sort: '归并排序',
    merge: '归并',
    arrayRow: '数组',
    tempRow: '临时',
    compPre: '比较 ',
    compPost: ' 次',
    movePre: '移动 ',
    movePost: ' 次',
    sortIdle: '对半分开各自排序，再把两个有序的半段合起来。',
    mergeIdle: '前后两半各自已经有序。看它们合并。',
    divide: 'ms({lo}, {hi}) — 分成 [{lo}..{mid}] 和 [{mid1}..{hi}]。',
    leaf: 'ms({i}, {i}) — 单个元素本来就有序。',
    takeLeft: '{v} ≤ {w} — 左边的 {v} 进 temp。移动 1 次。',
    takeRight: '{v} > {w} — 右边的 {w} 进 temp。移动 1 次。',
    drain: '一边取完了 — {v} 进 temp。移动 1 次。',
    copyBack: '这段合并完了 — 抄回原位。移动 {len} 次。',
    done: '排序完成 — 比较 {c} 次，移动 {m} 次。',
  },
};
const lang = Astro.currentLocale ?? defaultLang;
const t = STRINGS[lang] ?? STRINGS[defaultLang] ?? STRINGS.ko;
---

<div
  class:list={['aas-merge-demo', slide && 'is-slide']}
  id={id}
  data-values={JSON.stringify(values)}
  data-merge-mode={mode}
  data-strings={JSON.stringify(t)}
>
  <div class="md-bar">
    <span class="md-head">
      <strong>{t[mode]}</strong>
      <span class="md-callchip is-off" data-callchip>
        <strong data-callval></strong>
      </span>
    </span>
    <div class="md-controls">
      <button type="button" data-act="step" class="md-btn">{t.step}</button>
      <button type="button" data-act="play" class="md-btn md-btn-primary">{t.play}</button>
      <button type="button" data-act="reset" class="md-btn">{t.reset}</button>
    </div>
  </div>

  <div class="md-rows">
    <div class="md-row">
      <span class="md-rowlabel">{t.arrayRow}</span>
      <div class="md-cells" data-main></div>
    </div>
    <div class="md-row">
      <span class="md-rowlabel">{t.tempRow}</span>
      <div class="md-cells" data-temp></div>
    </div>
  </div>

  <div class="md-foot">
    <p class="md-note" data-note></p>
    <span class="md-count">
      {t.compPre}<strong data-comp>0</strong>{t.compPost}
      · {t.movePre}<strong data-mvs>0</strong>{t.movePost}
    </span>
  </div>
</div>

<script is:inline define:vars={{ id }}>
  (() => {
    const root = document.getElementById(id);
    if (!root) return;

    const values = JSON.parse(root.dataset.values);
    const mode = root.dataset.mergeMode;
    const S = JSON.parse(root.dataset.strings);
    const n = values.length;

    /* "{v} ≤ {w}" 같은 자리표시자를 채운다. */
    const fill = (tpl, vars) => tpl.replace(/\{(\w+)\}/g, (_, k) => vars[k]);
    const snap = (a) => a.slice();
    const range = (k) => Array.from({ length: k }, (_, x) => x);

    /* 전체 과정을 미리 단계 배열로 만들어 둔다. 각 단계는 배열과 temp의
       스냅샷, 누적 비교·이동 횟수를 갖는다. 숫자를 세는 규칙은
       algorithm-code의 구현과 같다. */
    function plan() {
      const a = snap(values);
      const tmp = Array(n).fill(null);
      const steps = [];
      let c = 0;
      let m = 0;

      function doMerge(lo, mid, hi) {
        const call = `ms(${lo}, ${hi})`;
        let i = lo;
        let j = mid + 1;
        let k = lo;
        while (i <= mid && j <= hi) {
          c++;
          const takeLeft = a[i] <= a[j];
          const note = takeLeft
            ? fill(S.takeLeft, { v: a[i], w: a[j] })
            : fill(S.takeRight, { v: a[i], w: a[j] });
          const look = [i, j];
          tmp[k] = takeLeft ? a[i] : a[j];
          m++;
          steps.push({ a: snap(a), t: snap(tmp), range: [lo, hi], call, look, tlook: k, c, m, note });
          if (takeLeft) i++;
          else j++;
          k++;
        }
        while (i <= mid) {
          tmp[k] = a[i];
          m++;
          steps.push({
            a: snap(a), t: snap(tmp), range: [lo, hi], call, look: [i], tlook: k, c, m,
            note: fill(S.drain, { v: a[i] }),
          });
          i++;
          k++;
        }
        while (j <= hi) {
          tmp[k] = a[j];
          m++;
          steps.push({
            a: snap(a), t: snap(tmp), range: [lo, hi], call, look: [j], tlook: k, c, m,
            note: fill(S.drain, { v: a[j] }),
          });
          j++;
          k++;
        }
        for (let x = lo; x <= hi; x++) {
          a[x] = tmp[x];
          tmp[x] = null;
        }
        m += hi - lo + 1;
        steps.push({
          a: snap(a), t: snap(tmp), range: [lo, hi], call, look: [], flash: [lo, hi], c, m,
          note: fill(S.copyBack, { len: hi - lo + 1 }),
        });
      }

      function ms(lo, hi) {
        const call = `ms(${lo}, ${hi})`;
        if (lo >= hi) {
          steps.push({
            a: snap(a), t: snap(tmp), range: [lo, hi], call, look: [], c, m,
            note: fill(S.leaf, { i: lo }),
          });
          return;
        }
        const mid = lo + Math.floor((hi - lo) / 2);
        steps.push({
          a: snap(a), t: snap(tmp), range: [lo, hi], call, look: [], c, m,
          note: fill(S.divide, { lo, hi, mid, mid1: mid + 1 }),
        });
        ms(lo, mid);
        ms(mid + 1, hi);
        doMerge(lo, mid, hi);
      }

      if (mode === 'merge') {
        doMerge(0, Math.floor(n / 2) - 1, n - 1);
      } else {
        ms(0, n - 1);
      }
      steps.push({
        a: snap(a), t: snap(tmp), range: null, call: null, look: [], done: range(n), c, m,
        note: fill(S.done, { c, m }),
      });
      return steps;
    }

    const steps = plan();

    /* 칸을 한 번만 만들고 이후에는 클래스와 글자만 바꾼다. */
    const buildCells = (wrap, subs) =>
      values.map((_, i) => {
        const cell = document.createElement('div');
        cell.className = 'md-cell';
        cell.innerHTML = `<span class="md-val"></span>${subs ? `<span class="md-idx">${i}</span>` : ''}`;
        wrap.appendChild(cell);
        return cell;
      });
    const mainCells = buildCells(root.querySelector('[data-main]'), true);
    const tempCells = buildCells(root.querySelector('[data-temp]'), false);
    const mainVals = mainCells.map((cell) => cell.querySelector('.md-val'));
    const tempVals = tempCells.map((cell) => cell.querySelector('.md-val'));
    const comp = root.querySelector('[data-comp]');
    const mvs = root.querySelector('[data-mvs]');
    const note = root.querySelector('[data-note]');
    const callchip = root.querySelector('[data-callchip]');
    const callval = root.querySelector('[data-callval]');
    const idle = mode === 'merge' ? S.mergeIdle : S.sortIdle;
    const mid0 = Math.floor(n / 2) - 1;

    /* k번째 단계까지 진행한 모습을 그린다. k = -1이면 시작 상태. */
    function render(k) {
      const step = k >= 0 ? steps[Math.min(k, steps.length - 1)] : null;
      const a = step ? step.a : values;
      const tm = step ? step.t : Array(n).fill(null);

      mainCells.forEach((cell, idx) => {
        cell.className = 'md-cell';
        mainVals[idx].textContent = String(a[idx]);
        if (!step) {
          /* merge 모드의 시작 상태: 두 절반을 경계로 보여준다. */
          if (mode === 'merge' && idx === mid0) cell.classList.add('is-split');
          return;
        }
        if (step.range && (idx < step.range[0] || idx > step.range[1])) cell.classList.add('is-out');
        if (step.done && step.done.includes(idx)) cell.classList.add('is-done');
        if (step.look.includes(idx)) cell.classList.add('is-look');
        if (step.flash && idx >= step.flash[0] && idx <= step.flash[1]) cell.classList.add('is-swap');
      });

      tempCells.forEach((cell, idx) => {
        cell.className = 'md-cell is-slot';
        tempVals[idx].textContent = tm[idx] === null ? '' : String(tm[idx]);
        if (tm[idx] !== null) cell.classList.remove('is-slot');
        if (step && step.range && (idx < step.range[0] || idx > step.range[1])) cell.classList.add('is-out');
        if (step && step.tlook === idx) cell.classList.add('is-swap');
      });

      comp.textContent = String(step ? step.c : 0);
      mvs.textContent = String(step ? step.m : 0);
      note.textContent = step ? step.note : idle;
      const call = step ? step.call : null;
      callchip.classList.toggle('is-off', call === null);
      if (call !== null) callval.textContent = call;
    }

    let at = -1;
    let timer = null;

    function stop() {
      if (timer) clearInterval(timer);
      timer = null;
      root.querySelector('[data-act="play"]').textContent = S.play;
    }

    function step() {
      if (at >= steps.length - 1) return stop();
      at += 1;
      render(at);
      if (at >= steps.length - 1) stop();
    }

    root.querySelector('[data-act="step"]').addEventListener('click', () => {
      stop();
      step();
    });
    root.querySelector('[data-act="reset"]').addEventListener('click', () => {
      stop();
      at = -1;
      render(-1);
    });
    root.querySelector('[data-act="play"]').addEventListener('click', (e) => {
      if (timer) return stop();
      if (at >= steps.length - 1) {
        at = -1;
        render(-1);
      }
      e.currentTarget.textContent = S.stop;
      timer = setInterval(step, 600);
    });

    render(-1);
  })();
</script>

<!-- 셀은 스크립트가 만들기 때문에 Astro의 scoped 스타일 속성이 붙지 않는다.
     그래서 is:global로 두고, 선택자를 .aas-merge-demo 아래로 한정한다. -->
<style is:global>
  .aas-merge-demo {
    /* 안쪽 치수는 모두 이 값에 대한 em이다(SortDemo와 같은 방식). */
    font-size: 1rem;
    margin: 1.5rem 0;
    padding: 1em;
    border: 1px solid var(--aas-border);
    border-radius: 0.9em;
    background: var(--aas-panel);
  }
  .aas-merge-demo .md-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75em;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.9em;
  }
  .aas-merge-demo .md-head {
    display: inline-flex;
    align-items: baseline;
    gap: 0.7em;
    font-size: 0.95em;
  }
  .aas-merge-demo .md-callchip {
    font-size: 0.85em;
    color: var(--aas-muted);
    border: 1px solid color-mix(in srgb, var(--aas-role-model) 55%, transparent);
    background: color-mix(in srgb, var(--aas-role-model) 14%, transparent);
    border-radius: 0.5em;
    padding: 0.1em 0.5em;
  }
  .aas-merge-demo .md-callchip strong {
    font-family: var(--aas-mono, monospace);
    color: var(--aas-text);
  }
  .aas-merge-demo .md-callchip.is-off {
    visibility: hidden;
  }
  .aas-merge-demo .md-controls {
    display: flex;
    gap: 0.5em;
  }
  .aas-merge-demo .md-btn {
    padding: 0.35em 0.8em;
    font-size: 0.85em;
    border: 1px solid var(--aas-border);
    border-radius: 0.5em;
    background: var(--aas-bg);
    color: var(--aas-text);
    cursor: pointer;
  }
  .aas-merge-demo .md-btn:hover {
    border-color: var(--aas-accent);
  }
  .aas-merge-demo .md-btn-primary {
    background: var(--aas-accent);
    border-color: var(--aas-accent);
    color: #fff;
  }

  .aas-merge-demo .md-rows {
    display: grid;
    gap: 0.5em;
  }
  .aas-merge-demo .md-row {
    display: flex;
    align-items: center;
    gap: 0.6em;
  }
  .aas-merge-demo .md-rowlabel {
    flex: 0 0 2.6em;
    font-size: 0.7em;
    color: var(--aas-muted);
    text-align: right;
  }
  .aas-merge-demo .md-cells {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25em;
  }
  .aas-merge-demo .md-cell {
    flex: 0 0 auto;
    min-width: 2.2em;
    padding: 0.3em 0.2em;
    text-align: center;
    border: 1px solid var(--aas-border);
    border-radius: 0.35em;
    background: var(--aas-bg);
    transition:
      background-color 0.18s,
      border-color 0.18s,
      opacity 0.18s;
  }
  .aas-merge-demo .md-val {
    display: block;
    font-family: var(--aas-mono, monospace);
    font-size: 0.8em;
    line-height: 1.3;
    min-height: 1.3em;
  }
  .aas-merge-demo .md-idx {
    display: block;
    font-size: 0.6em;
    color: var(--aas-muted);
  }

  /* 지금 다루는 구간 밖은 흐리게. 비교 중인 두 칸은 주황, temp에 방금
     적힌 칸과 제자리로 돌아온 구간은 호박색, 끝난 배열은 초록. 빈 temp
     칸은 점선이다. merge 모드의 시작 상태는 두 절반의 경계를 보여준다. */
  .aas-merge-demo .md-cell.is-out {
    opacity: 0.28;
  }
  .aas-merge-demo .md-cell.is-look {
    border-color: var(--aas-role-focus);
    background: color-mix(in srgb, var(--aas-role-focus) 22%, transparent);
  }
  .aas-merge-demo .md-cell.is-swap {
    border-color: var(--aas-role-trace);
    background: color-mix(in srgb, var(--aas-role-trace) 26%, transparent);
    font-weight: 700;
  }
  .aas-merge-demo .md-cell.is-done {
    border-color: var(--aas-role-eval);
    background: color-mix(in srgb, var(--aas-role-eval) 18%, transparent);
  }
  .aas-merge-demo .md-cell.is-slot {
    border-style: dashed;
    background: transparent;
  }
  .aas-merge-demo .md-cell.is-split {
    box-shadow: 2px 0 0 0 color-mix(in srgb, var(--aas-role-model) 60%, transparent);
  }

  .aas-merge-demo .md-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em 1em;
    align-items: baseline;
    justify-content: space-between;
  }
  .aas-merge-demo .md-note {
    margin: 0.6em 0 0;
    font-size: 0.85em;
    color: var(--aas-muted);
    min-height: 2.4em;
  }
  .aas-merge-demo .md-count {
    font-size: 0.85em;
    color: var(--aas-muted);
    white-space: nowrap;
  }
  .aas-merge-demo .md-count strong {
    color: var(--aas-text);
    font-family: var(--aas-mono, monospace);
  }

  /* 슬라이드용. 두 줄이라 SortDemo보다 조금 작게 잡는다.
     vh 단위인 이유는 SearchDemo 참고: 슬라이드 폭은 뷰포트 높이가 정한다. */
  .aas-merge-demo.is-slide {
    font-size: clamp(1rem, 3.2vh, 2rem);
    margin: 0.5rem 0;
  }
  .aas-merge-demo.is-slide .md-note {
    min-height: 1.6em;
  }

  @media (prefers-reduced-motion: reduce) {
    .aas-merge-demo .md-cell {
      transition: none;
    }
  }
</style>
