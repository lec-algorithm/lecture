---
// 그림 패널을 한 칸씩 보여 주는 이야기 띠. 글 대신 그림과 짧은 한 줄로 장면을 넘긴다.
//
// 패널마다 아이콘 하나, 짧은 설명 한 줄, 색(tone)을 준다. 패널과 화살표에 테마의 단계 공개 클래스
// (aas-step)를 붙여, 슬라이드에서 → 키나 스페이스를 누를 때마다 다음 패널이 나타난다. 패널이 다
// 보이면 다음 키에서 다음 슬라이드로 넘어간다. 맨 끝의 punch는 장면의 요점 한 줄이다.
// layout="grid"이면 화살표 없이 격자로 놓는다(숫자 카드, 체크리스트). head는 패널 위의 큰 글씨다.
// 아이콘은 이 파일에 직접 그린 단순한 선 그림이다.
interface Panel {
  icon: string;
  head?: string;
  label: string;
  /** neutral: 회색, bad: 공격·피해(빨강), good: 방어(초록), warn: 주의(주황) */
  tone?: 'neutral' | 'bad' | 'good' | 'warn';
}
interface Props {
  panels: Panel[];
  punch?: string;
  layout?: 'flow' | 'grid';
  /** 격자의 열 수. 기본은 패널 수와 3 중 작은 쪽 */
  cols?: number;
}
const { panels, punch, layout = 'flow', cols } = Astro.props;
const grid = layout === 'grid';
const n = grid ? (cols ?? Math.min(panels.length, 3)) : panels.length;

/* 24×24 선 아이콘. 모두 stroke로 그린다. */
const ICONS: Record<string, string> = {
  laptop: '<rect x="4" y="5" width="16" height="11" rx="1.5"/><path d="M2 19h20"/>',
  search: '<circle cx="10.5" cy="10.5" r="6"/><path d="M15 15l5 5"/>',
  package: '<path d="M3 7.5L12 3l9 4.5v9L12 21l-9-4.5z"/><path d="M3 7.5l9 4.5 9-4.5M12 12v9"/>',
  shield: '<path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/>',
  users: '<circle cx="9" cy="8" r="3.2"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><circle cx="17" cy="9" r="2.5"/><path d="M16 14.2c2.9.4 5 2.8 5 5.8"/>',
  leak: '<path d="M4 6h10v12H4z"/><path d="M7 10h4M7 13h4"/><path d="M15 12h6M18 9l3 3-3 3"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="1.5"/><path d="M3 7l9 6 9-6"/>',
  video: '<rect x="3" y="6" width="13" height="12" rx="1.5"/><path d="M16 10l5-3v10l-5-3z"/>',
  code: '<path d="M9 7l-5 5 5 5M15 7l5 5-5 5"/>',
  bug: '<rect x="7" y="8" width="10" height="12" rx="5"/><path d="M12 8v12M4 12h3M17 12h3M5 18l2.5-1.5M19 18l-2.5-1.5M9 5l1.5 2M15 5l-1.5 2"/>',
  key: '<circle cx="7.5" cy="14.5" r="3.5"/><path d="M10 12l9-9M15 7l2 2M17.5 4.5l2 2"/>',
  server: '<rect x="4" y="4" width="16" height="7" rx="1.2"/><rect x="4" y="13" width="16" height="7" rx="1.2"/><path d="M8 7.5h.01M8 16.5h.01"/>',
  wallet: '<rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 9h18M16 14h2"/>',
  bot: '<rect x="5" y="8" width="14" height="11" rx="2"/><path d="M12 4v4M9 13h.01M15 13h.01M9 16.5h6"/>',
  eye: '<path d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6S2 12 2 12z"/><circle cx="12" cy="12" r="2.8"/>',
  person: '<circle cx="12" cy="8" r="3.5"/><path d="M5 20c0-3.9 3.1-7 7-7s7 3.1 7 7"/>',
  mask: '<path d="M4 8c2.5-1.5 5.2-2 8-2s5.5.5 8 2c0 6-3.5 10-8 10S4 14 4 8z"/><path d="M8 11h2.5M13.5 11H16"/>',
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7v5l3.5 2"/>',
  link: '<path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1.3 1.3"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1.3-1.3"/>',
  coins: '<ellipse cx="9" cy="7" rx="5.5" ry="2.5"/><path d="M3.5 7v4c0 1.4 2.5 2.5 5.5 2.5s5.5-1.1 5.5-2.5V7"/><path d="M9.5 15.5c.9 1.3 3.2 2 5.5 2 3 0 5.5-1.1 5.5-2.5v-4c0-1.2-1.8-2.2-4.3-2.4"/>',
  calendar: '<rect x="4" y="5" width="16" height="15" rx="1.5"/><path d="M4 10h16M9 3v4M15 3v4"/>',
  snowflake: '<path d="M12 3v18M4.2 7.5l15.6 9M4.2 16.5l15.6-9"/><path d="M9.5 4.5L12 7l2.5-2.5M9.5 19.5L12 17l2.5 2.5"/>',
  swap: '<path d="M4 8h14M14 4l4 4-4 4"/><path d="M20 16H6M10 12l-4 4 4 4"/>',
  bank: '<path d="M3 9l9-5 9 5z"/><path d="M5 9v8M9.5 9v8M14.5 9v8M19 9v8M3 20h18"/>',
  bell: '<path d="M6 16V11a6 6 0 0 1 12 0v5l1.5 2h-15z"/><path d="M10 20a2 2 0 0 0 4 0"/>',
};
const toneOf = (p: Panel) => p.tone ?? 'neutral';
---

<div class:list={['aas-story-strip', grid && 'is-grid']}>
  <ol class="ss-row" style={`--ss-n: ${n}`}>
    {panels.map((p, i) => (
      <li class:list={['ss-panel', 'aas-step', `is-${toneOf(p)}`]}>
        {!grid && i > 0 && <span class="ss-arrow" aria-hidden="true">→</span>}
        <span class="ss-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[p.icon] ?? ICONS.package} />
        </span>
        {p.head && <span class="ss-headline">{p.head}</span>}
        <span class="ss-label">{p.label}</span>
      </li>
    ))}
  </ol>
  {punch && <p class="ss-punch aas-step">{punch}</p>}
</div>

<style is:global>
  .aas-story-strip {
    margin: 0.6em 0 0;
  }
  /* 슬라이드에서는 화면을 채우도록 키운다. 세로로 긴 창에서는 너비도 본다. */
  .aas-slide-inner .aas-story-strip {
    margin-top: 1.2em;
    font-size: clamp(1rem, min(3vh, 2.1vw), 2rem);
  }
  .aas-story-strip .ss-row {
    display: grid;
    grid-template-columns: repeat(var(--ss-n), minmax(0, 1fr));
    gap: 1.4em;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .aas-story-strip .ss-panel {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5em;
    margin: 0;
    padding: 1em 0.6em 0.9em;
    border: 1.5px solid var(--ss-c);
    border-radius: 0.9em;
    background: color-mix(in srgb, var(--ss-c) 9%, var(--aas-panel));
    text-align: center;
  }
  .aas-story-strip .ss-panel.is-neutral { --ss-c: var(--aas-border); }
  .aas-story-strip .ss-panel.is-bad { --ss-c: var(--aas-role-guard); }
  .aas-story-strip .ss-panel.is-good { --ss-c: var(--aas-role-eval); }
  .aas-story-strip .ss-panel.is-warn { --ss-c: var(--aas-role-trace); }
  .aas-story-strip .ss-arrow {
    position: absolute;
    left: -1.25em;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.1em;
    color: var(--aas-muted);
  }
  .aas-story-strip .ss-icon {
    display: grid;
    place-items: center;
    width: 3.6em;
    height: 3.6em;
    border-radius: 50%;
    background: var(--aas-bg);
    color: var(--ss-c);
  }
  .aas-story-strip .ss-panel.is-neutral .ss-icon {
    color: var(--aas-muted);
  }
  .aas-story-strip .ss-icon svg {
    width: 2.2em;
    height: 2.2em;
  }
  .aas-story-strip.is-grid .ss-row {
    gap: 0.8em;
  }
  .aas-story-strip.is-grid .ss-panel {
    padding: 0.7em 0.6em 0.75em;
    gap: 0.35em;
  }
  .aas-story-strip.is-grid .ss-icon {
    width: 2.8em;
    height: 2.8em;
  }
  .aas-story-strip.is-grid .ss-icon svg {
    width: 1.7em;
    height: 1.7em;
  }
  .aas-story-strip .ss-headline {
    font-size: 1.3em;
    font-weight: 800;
    line-height: 1.15;
    color: var(--aas-text);
  }
  /* 라벨의 \n은 줄바꿈이다. 콜론이나 괄호 앞처럼 끊을 자리를 직접 정한다. */
  .aas-story-strip .ss-label {
    white-space: pre-line;
    font-size: 0.85em;
    font-weight: 600;
    line-height: 1.35;
  }
  .aas-story-strip .ss-punch {
    margin: 1.4em 0 0;
    font-size: 1.1em;
    font-weight: 700;
    text-align: center;
  }
  @media (max-width: 700px) {
    .aas-story-strip .ss-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .aas-story-strip .ss-arrow {
      display: none;
    }
  }
</style>
