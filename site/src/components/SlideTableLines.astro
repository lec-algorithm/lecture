---
// 슬라이드 안 표의 가로줄을 조금 진하게. 테마 기본값(--aas-border)은 밝은 바탕에서
// 대비가 1.05라 강의실에서 보이지 않는다. 덱에 한 번만 놓는다.
---

<style is:global>
  .aas-slide-inner > table :is(th, td),
  .aas-slide-inner > .aas-table-scroll :is(th, td) {
    border-bottom-color: color-mix(in srgb, var(--aas-text) 22%, var(--aas-bg));
  }
</style>
