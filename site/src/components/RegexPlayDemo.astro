---
// 정규식과 텍스트를 직접 적어 보는 놀이터. 판정은 이 주제의 NFA로 한다.
//
// 정규식을 nfaRegex의 BuildNFA로 그래프로 만들고, 텍스트를 한 글자씩 읽으며
// 상태 집합을 들고 간다(Recognizes). 두 가지를 묻는다.
//   - 찾기(mode="search"): 텍스트 안 어딘가에 맞는 부분이 있는가. 정규식 .*pat 처럼
//     자리마다 시작 상태를 집합에 다시 넣는다. 읽은 직후 집합에 수락 상태가 있으면
//     그 글자에서 끝나는 매치가 있다는 뜻이고, 그 칸 아래에 점을 찍는다.
//     처음 끝나는 매치는 가장 먼저 시작하는 자리를 찾아 칸을 칠한다.
//   - 전체(mode="full"): 텍스트 전체가 언어에 속하는가. 시작 상태는 처음에 한 번만
//     넣는다. 점은 "여기까지 읽은 앞부분이 언어에 속한다"는 뜻이다.
// 칸 아래 숫자는 그 글자를 읽은 뒤 집합의 크기다.
//
// 문법은 글자(영문·숫자·공백), '.', '*', '|', 괄호로 제한한다. 이 범위에서는
// "어디서 매치가 끝나는가"와 "전체가 속하는가"가 언어만으로 정해지므로 브라우저의
// RegExp와 답이 같아야 한다. 화면에서도 RegExp로 한 번 더 물어 같은지 보여 준다.
// 괄호 한 쌍에 '|'가 여럿이어도 되도록 ')'에서 '|'를 모두 꺼낸다. '|'가 하나면
// 실습 코드와 같은 그래프다.
import { defaultLang } from 'stack-site-builder/i18n/ui';

interface Props {
  regex?: string;
  text?: string;
  /** 'search': 텍스트 안에서 찾기, 'full': 텍스트 전체가 속하는지 */
  mode?: 'search' | 'full';
  /** 눌러 볼 [정규식, 텍스트] 묶음 */
  presets?: [string, string][];
  /** 전체 판정을 한꺼번에 보여 줄 텍스트 목록 */
  list?: string[];
  /** 목록의 텍스트를 이진수로 읽어 십진값을 덧붙인다. */
  binary?: boolean;
  /** 슬라이드용: 글자와 칸을 키운다. */
  slide?: boolean;
}
const {
  regex = 'gcg(cgg)*ctg',
  text = 'atgcgcggcggctga',
  mode = 'search',
  presets = [
    ['gcg(cgg)*ctg', 'atgcgcggcggctga'],
    ['ab*c', 'aabbc'],
    ['(a|b)*abb', 'babaabb'],
    ['(0|1(01*0)*1)*', '1001'],
  ],
  list = [],
  binary = false,
  slide = false,
} = Astro.props;
const id = `rp-${Math.random().toString(36).slice(2, 9)}`;

const STRINGS: Record<string, Record<string, string>> = {
  ko: {
    title: '정규식 놀이터',
    titleFull: '전체가 속하는가',
    titleSearch: '텍스트 안에서 찾기',
    regexLabel: '정규식',
    textLabel: '텍스트',
    start: '시작',
    setRow: '집합',
    errChar: "쓸 수 있는 것은 글자, '.', '*', '|', 괄호뿐입니다.",
    errParen: '괄호 짝이 맞지 않습니다.',
    errStar: "'*' 앞에 반복할 덩어리가 없습니다.",
    errLen: '정규식은 40글자, 텍스트는 24글자까지입니다.',
    full: '전체',
    yes: '✓ 속함',
    no: '✕ 속하지 않음',
    found: '✓ 찾음',
    none: '✕ 없음',
    same: 'RegExp도 같은 답',
    differ: 'RegExp와 다름',
    work: '작업량',
    noteSearch: '{n}곳에서 매치가 끝납니다. 처음 끝나는 매치는 위치 {s}부터 {e}까지 "{m}"입니다.',
    noteSearchEmpty: '{n}곳에서 매치가 끝납니다. 이 정규식은 빈 문자열에도 맞으므로 위치 0에서 이미 빈 매치가 끝납니다.',
    noteNone: '어느 자리에서도 수락 상태에 닿지 않습니다. 텍스트 안에 맞는 부분이 없습니다.',
    noteFullYes: '텍스트를 다 읽었을 때 집합에 수락 상태가 있습니다. 점은 거기까지 읽은 앞부분도 속한다는 표시입니다.',
    noteFullNo: '텍스트를 다 읽었을 때 집합에 수락 상태가 없습니다. 점은 거기까지 읽은 앞부분은 속한다는 표시입니다.',
    noteFullDead: '{k}번째 글자에서 집합이 비었습니다. 그 뒤로는 무엇을 읽어도 수락할 수 없습니다.',
  },
  en: {
    title: 'Regex playground',
    titleFull: 'Does the whole text belong?',
    titleSearch: 'Find in text',
    regexLabel: 'regex',
    textLabel: 'text',
    start: 'start',
    setRow: 'set',
    errChar: "Only letters, '.', '*', '|' and parentheses are allowed.",
    errParen: 'The parentheses do not match.',
    errStar: "There is nothing before '*' to repeat.",
    errLen: 'Up to 40 characters for the regex and 24 for the text.',
    full: 'whole',
    yes: '✓ belongs',
    no: '✕ does not belong',
    found: '✓ found',
    none: '✕ none',
    same: 'RegExp agrees',
    differ: 'RegExp differs',
    work: 'work',
    noteSearch: 'A match ends at {n} places. The first one to end is "{m}" from position {s} to {e}.',
    noteSearchEmpty: 'A match ends at {n} places. This regex also matches the empty string, so an empty match already ends at position 0.',
    noteNone: 'No position ever reaches the accept state. Nothing in the text matches.',
    noteFullYes: 'After the whole text the set holds the accept state. A dot marks a prefix that belongs too.',
    noteFullNo: 'After the whole text the set lacks the accept state. A dot marks a prefix that belongs.',
    noteFullDead: 'The set became empty at character {k}. Nothing read after that can be accepted.',
  },
  zh: {
    title: '正则表达式练习场',
    titleFull: '整个文本是否属于',
    titleSearch: '在文本中查找',
    regexLabel: '正则',
    textLabel: '文本',
    start: '开始',
    setRow: '集合',
    errChar: "只能使用字母、'.'、'*'、'|' 和括号。",
    errParen: '括号不配对。',
    errStar: "'*' 前面没有可重复的部分。",
    errLen: '正则最多 40 个字符，文本最多 24 个字符。',
    full: '整体',
    yes: '✓ 属于',
    no: '✕ 不属于',
    found: '✓ 找到',
    none: '✕ 没有',
    same: 'RegExp 答案相同',
    differ: 'RegExp 答案不同',
    work: '工作量',
    noteSearch: '有 {n} 处是匹配的结束位置。最先结束的匹配是从位置 {s} 到 {e} 的 "{m}"。',
    noteSearchEmpty: '有 {n} 处是匹配的结束位置。这个正则也匹配空字符串，所以在位置 0 就已经有空匹配结束。',
    noteNone: '任何位置都到不了接受状态。文本中没有匹配的部分。',
    noteFullYes: '读完整个文本时，集合中有接受状态。圆点表示读到那里为止的前缀也属于该语言。',
    noteFullNo: '读完整个文本时，集合中没有接受状态。圆点表示读到那里为止的前缀属于该语言。',
    noteFullDead: '读到第 {k} 个字符时集合变空。之后无论读什么都不能接受。',
  },
};
const lang = Astro.currentLocale ?? defaultLang;
const t = STRINGS[lang] ?? STRINGS[defaultLang] ?? STRINGS.ko;
---

<div
  class:list={['aas-regex-play-demo', slide && 'is-slide']}
  id={id}
  data-rp-regex={regex}
  data-rp-text={text}
  data-rp-mode={mode}
  data-rp-list={JSON.stringify(list)}
  data-rp-binary={binary ? '1' : ''}
  data-rp-strings={JSON.stringify(t)}
>
  <div class="rp-bar">
    <span class="rp-head"><strong>{t.title}</strong> · {mode === 'full' ? t.titleFull : t.titleSearch}</span>
    {presets.length > 0 && (
      <div class="rp-presets">
        {presets.map(([r, x]) => (
          <button type="button" class="rp-chip" data-rp-preset={JSON.stringify([r, x])}><code>{r}</code></button>
        ))}
      </div>
    )}
  </div>

  <div class="rp-fields">
    <label class="rp-field">
      <span>{t.regexLabel}</span>
      <input type="text" maxlength="40" spellcheck="false" autocomplete="off" data-rp-re />
    </label>
    <label class="rp-field">
      <span>{t.textLabel}</span>
      <input type="text" maxlength="24" spellcheck="false" autocomplete="off" data-rp-tx />
    </label>
  </div>

  <p class="rp-error" data-rp-error hidden></p>

  <div class="rp-tape" data-rp-tape></div>

  <div class="rp-verdicts" data-rp-verdicts>
    <span class="rp-verdict" data-rp-main></span>
    <span class="rp-js" data-rp-js></span>
    <span class="rp-work">{t.work} <strong data-rp-work></strong></span>
  </div>

  {list.length > 0 && <div class="rp-list" data-rp-listbox></div>}

  <p class="rp-note" data-rp-note></p>
</div>

<script is:inline define:vars={{ id }}>
  (() => {
    const root = document.getElementById(id);
    if (!root) return;

    /* 설명은 문장마다 줄을 바꾼다. 마침표 뒤 공백, 또는 중국어 마침표 뒤에서 끊는다. */
    const setLines = (node, text) => {
      const parts = String(text).split(/(?<=[.!?])\s+(?=\S)|(?<=[。！？])(?=\S)/);
      node.replaceChildren(...parts.flatMap((s, i) => (i ? [document.createElement('br'), s] : [s])));
    };
    const S = JSON.parse(root.dataset.rpStrings);
    const fill = (tpl, vars) => tpl.replace(/\{(\w+)\}/g, (_, key) => vars[key]);
    const mode = root.dataset.rpMode;
    const list = JSON.parse(root.dataset.rpList);
    const binary = !!root.dataset.rpBinary;

    /* 이 데모가 받는 문법인지 본다. 아니면 오류 문구의 열쇠를 돌려준다. */
    function validate(re, tx) {
      if (re.length > 40 || tx.length > 24) return 'errLen';
      if (!/^[A-Za-z0-9 .*|()]*$/.test(re)) return 'errChar';
      let depth = 0;
      for (let i = 0; i < re.length; i++) {
        const c = re[i];
        if (c === '(') depth += 1;
        else if (c === ')') {
          depth -= 1;
          if (depth < 0) return 'errParen';
        } else if (c === '*' && (i === 0 || '(|*'.includes(re[i - 1]))) return 'errStar';
      }
      return depth === 0 ? null : 'errParen';
    }

    /* BuildNFA. ')'에서 '|'를 모두 꺼내는 것만 실습 코드와 다르다. */
    function build(regex) {
      const re = `(${regex})`;
      const M = re.length;
      const eps = [];
      const ops = [];
      for (let i = 0; i < M; i++) {
        let lp = i;
        if (re[i] === '(' || re[i] === '|') ops.push(i);
        else if (re[i] === ')') {
          const ors = [];
          let top = ops.pop();
          while (re[top] === '|') {
            ors.push(top);
            top = ops.pop();
          }
          lp = top;
          for (const or of ors) eps.push([lp, or + 1], [or, i]);
        }
        if (i < M - 1 && re[i + 1] === '*') eps.push([lp, i + 1], [i + 1, lp]);
        if (re[i] === '(' || re[i] === '*' || re[i] === ')') eps.push([i, i + 1]);
      }
      const adj = Array.from({ length: M + 1 }, () => []);
      for (const [a, b] of eps) adj[a].push(b);
      return { re, M, adj };
    }

    /* Recognizes. restart면 자리마다 시작 상태를 다시 넣는다(.*pat).
       돌려주는 것: 글자마다 집합 크기와 수락 여부, 작업량(DFS가 표시한 수) */
    function run(g, text, restart) {
      let work = 0;
      const closure = (set) => {
        const out = new Set();
        const dfs = (v) => {
          out.add(v);
          work += 1;
          for (const w of g.adj[v]) if (!out.has(w)) dfs(w);
        };
        for (let v = 0; v <= g.M; v++) if (set.has(v) && !out.has(v)) dfs(v);
        return out;
      };
      const isLiteral = (c) => !'()*|'.includes(c);
      let pc = closure(new Set([0]));
      const sizes = [pc.size];
      const acc = [pc.has(g.M)];
      for (const ch of text) {
        const match = new Set();
        for (let i = 0; i < g.M; i++) {
          if (pc.has(i) && isLiteral(g.re[i]) && (g.re[i] === ch || g.re[i] === '.')) match.add(i + 1);
        }
        if (restart) match.add(0);
        pc = closure(match);
        sizes.push(pc.size);
        acc.push(pc.has(g.M));
      }
      return { sizes, acc, work };
    }
    const whole = (g, s) => run(g, s, false).acc[s.length];

    const reIn = root.querySelector('[data-rp-re]');
    const txIn = root.querySelector('[data-rp-tx]');
    const errEl = root.querySelector('[data-rp-error]');
    const tape = root.querySelector('[data-rp-tape]');
    const verdicts = root.querySelector('[data-rp-verdicts]');
    const mainEl = root.querySelector('[data-rp-main]');
    const jsEl = root.querySelector('[data-rp-js]');
    const workEl = root.querySelector('[data-rp-work]');
    const listbox = root.querySelector('[data-rp-listbox]');
    const note = root.querySelector('[data-rp-note]');
    const presetBtns = [...root.querySelectorAll('[data-rp-preset]')];
    reIn.value = root.dataset.rpRegex;
    txIn.value = root.dataset.rpText;

    const col = (top, mid, bottom, cls) => {
      const c = document.createElement('div');
      c.className = `rp-col ${cls}`;
      for (const [txt, k] of [[top, 'rp-ch'], [mid, 'rp-mark'], [bottom, 'rp-size']]) {
        const s = document.createElement('span');
        s.className = k;
        s.textContent = txt;
        c.appendChild(s);
      }
      return c;
    };

    function render() {
      const re = reIn.value;
      const tx = txIn.value;
      presetBtns.forEach((b) => {
        const [r, x] = JSON.parse(b.dataset.rpPreset);
        b.classList.toggle('is-on', r === re && x === tx);
      });
      const err = validate(re, tx);
      errEl.hidden = !err;
      tape.hidden = !!err;
      verdicts.hidden = !!err;
      if (listbox) listbox.hidden = !!err;
      if (err) {
        errEl.textContent = S[err];
        setLines(note, '');
        return;
      }
      const g = build(re);
      const r = run(g, tx, mode === 'search');
      const N = tx.length;

      /* 찾기: 끝나는 자리들, 그리고 처음 끝나는 매치의 가장 이른 시작 */
      const ends = [];
      r.acc.forEach((a, k) => a && ends.push(k));
      let span = null;
      if (mode === 'search' && ends.length) {
        const e = ends[0];
        for (let s = 0; s <= e; s++) {
          if (whole(g, tx.slice(s, e))) {
            span = [s, e];
            break;
          }
        }
      }

      /* 브라우저 RegExp로 같은 질문을 다시 해 본다. */
      let agree = true;
      try {
        if (mode === 'search') {
          const tail = new RegExp(`(?:${re})$`);
          for (let k = 0; k <= N; k++) if (tail.test(tx.slice(0, k)) !== r.acc[k]) agree = false;
        } else {
          const all = new RegExp(`^(?:${re})$`);
          for (let k = 0; k <= N; k++) if (all.test(tx.slice(0, k)) !== r.acc[k]) agree = false;
        }
      } catch {
        agree = false;
      }

      const cols = [col('', r.acc[0] ? '●' : '', String(r.sizes[0]), 'is-start')];
      cols[0].querySelector('.rp-ch').textContent = S.start;
      for (let k = 0; k < N; k++) {
        const inSpan = span && k >= span[0] && k < span[1];
        const cls = [inSpan ? 'is-span' : '', r.acc[k + 1] ? 'is-end' : '', r.sizes[k + 1] === 0 ? 'is-dead' : '']
          .filter(Boolean).join(' ');
        cols.push(col(tx[k] === ' ' ? '␣' : tx[k], r.acc[k + 1] ? '●' : '', String(r.sizes[k + 1]), cls));
      }
      const head = col('', '', S.setRow, 'is-head');
      tape.replaceChildren(head, ...cols);

      const okMain = mode === 'search' ? ends.length > 0 : r.acc[N];
      mainEl.textContent = mode === 'search' ? (okMain ? S.found : S.none) : (okMain ? S.yes : S.no);
      mainEl.className = `rp-verdict ${okMain ? 'is-yes' : 'is-no'}`;
      jsEl.textContent = agree ? S.same : S.differ;
      jsEl.className = `rp-js ${agree ? 'is-same' : 'is-differ'}`;
      workEl.textContent = String(r.work);

      if (listbox) {
        listbox.replaceChildren(...list.map((w) => {
          const b = document.createElement('button');
          b.type = 'button';
          const ok = whole(g, w);
          b.className = `rp-item ${ok ? 'is-yes' : 'is-no'}${w === tx ? ' is-picked' : ''}`;
          b.textContent = binary ? `${w} (${parseInt(w, 2)})` : w;
          b.addEventListener('click', () => {
            txIn.value = w;
            render();
          });
          return b;
        }));
      }

      let msg;
      if (mode === 'search') {
        if (!ends.length) msg = S.noteNone;
        else if (span && span[1] === 0) msg = fill(S.noteSearchEmpty, { n: ends.length });
        else msg = fill(S.noteSearch, { n: ends.length, s: span[0], e: span[1] - 1, m: tx.slice(span[0], span[1]) });
      } else {
        const dead = r.sizes.indexOf(0);
        if (dead > 0) msg = fill(S.noteFullDead, { k: dead });
        else msg = r.acc[N] ? S.noteFullYes : S.noteFullNo;
      }
      setLines(note, msg);
    }

    presetBtns.forEach((b) =>
      b.addEventListener('click', () => {
        const [r, x] = JSON.parse(b.dataset.rpPreset);
        reIn.value = r;
        txIn.value = x;
        render();
      }),
    );
    reIn.addEventListener('input', render);
    txIn.addEventListener('input', render);
    render();
  })();
</script>

<style is:global>
  .aas-regex-play-demo {
    font-size: 1rem;
    margin: 1.5rem 0;
    padding: 1em;
    border: 1px solid var(--aas-border);
    border-radius: 0.9em;
    background: var(--aas-panel);
  }
  .aas-regex-play-demo .rp-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6em 1.2em;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.6em;
  }
  .aas-regex-play-demo .rp-head {
    font-size: 0.95em;
  }
  .aas-regex-play-demo .rp-presets {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em;
  }
  .aas-regex-play-demo .rp-chip {
    padding: 0.25em 0.7em;
    font-size: 0.8em;
    border: 1px solid var(--aas-border);
    border-radius: 999px;
    background: var(--aas-bg);
    color: var(--aas-text);
    cursor: pointer;
  }
  .aas-regex-play-demo .rp-chip code {
    background: none;
    padding: 0;
    color: inherit;
  }
  .aas-regex-play-demo .rp-chip:hover {
    border-color: var(--aas-accent);
  }
  .aas-regex-play-demo .rp-chip.is-on {
    background: var(--aas-accent);
    border-color: var(--aas-accent);
    color: #fff;
  }
  .aas-regex-play-demo .rp-fields {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em 1.2em;
  }
  .aas-regex-play-demo .rp-field {
    flex: 1 1 14em;
    display: flex;
    gap: 0.5em;
    align-items: center;
    font-size: 0.85em;
    color: var(--aas-muted);
  }
  .aas-regex-play-demo .rp-field span {
    flex: 0 0 auto;
  }
  .aas-regex-play-demo .rp-field input {
    flex: 1;
    min-width: 0;
    padding: 0.25em 0.5em;
    font: inherit;
    font-size: 1.1em;
    font-family: var(--aas-mono, monospace);
    font-weight: 700;
    color: var(--aas-text);
    background: var(--aas-bg);
    border: 1px solid var(--aas-border);
    border-radius: 0.4em;
  }
  .aas-regex-play-demo .rp-error {
    margin: 0.6em 0 0;
    font-size: 0.85em;
