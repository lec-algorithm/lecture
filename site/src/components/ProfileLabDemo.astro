---
// 콘텐츠 기반 필터링의 재료를 직접 바꿔 보는 데모.
//
// 영화 일곱 편의 장르 칸과 A의 평점 칸을 누르면 프로필과 순위가 바로 다시 계산된다. 칩으로는 가중치의
// 기준(평점 - 기준의 그 기준값)을 고른다. 기준이 3이면 실습 코드와 같고, 낮추면 싫어한 영화도 프로필에
// 더해지고, 기준을 0으로 두면 새 영화 M7이 M3를 앞선다. 점수를 줄 세운 순위를 줄 오른쪽에 적는다.
//
// 절차는 algorithm-code의 buildProfile · rankByContent와 같다. 기준 3이면 프로필 (5 1 1 1), 순위 M3 0.802,
// M7 0.764, M6 0.189이고, 기준 0이면 프로필 (14 7 7 4), 순위 M7 0.820, M3 0.723, M6 0.398이다.
import { defaultLang } from 'stack-site-builder/i18n/ui';
import { FEATURES, GENRE_NAMES, MOVIE_TITLES } from './recData';

interface Props {
  /** 슬라이드용: 바깥 여백은 줄이고 글자와 칸은 키운다. */
  slide?: boolean;
}
const { slide = false } = Astro.props;
const id = `pl-${Math.random().toString(36).slice(2, 9)}`;
const START = [5, 5, 0, 4, 2, 0, 0];
const BASES = [0, 1, 2, 3, 4];

const STRINGS: Record<string, Record<string, string>> = {
  ko: {
    title: '프로필 실험실',
    base: '기준 점수',
    restore: '원래대로',
    movie: '영화',
    rating: 'A 평점',
    weight: '가중치',
    score: '점수',
    profile: '프로필',
    order: '프로필 ({p}). 순위는 {list}입니다.',
    hint: '장르 칸과 평점 칸을 눌러 보세요. 기준 점수도 바꿔 보세요.',
    baseNote: '기준을 {b}로 두면 {b}점보다 높게 준 영화만 +가 됩니다.',
    allPlus: '이 기준에서는 A가 준 평점이 모두 +라 낮게 준 영화의 장르까지 더해집니다.',
    zero: '프로필이 0벡터입니다. 모든 점수가 0이라 순위가 의미 없습니다.',
    noCand: 'A가 모든 영화를 봐서 점수를 매길 영화가 없습니다.',
    flat: '이 영화는 장르가 없어 점수가 0입니다.',
  },
  en: {
    title: 'Profile lab',
    base: 'baseline',
    restore: 'Restore',
    movie: 'movie',
    rating: 'A rating',
    weight: 'weight',
    score: 'score',
    profile: 'profile',
    order: 'Profile ({p}). The ranking is {list}.',
    hint: 'Click genre cells and rating cells. Try another baseline too.',
    baseNote: 'With baseline {b}, only movies rated above {b} count as +.',
    allPlus: 'At this baseline every rating A gave is +, so even the genres of low-rated movies get added.',
    zero: 'The profile is the zero vector. Every score is 0, so the ranking means nothing.',
    noCand: 'A has rated every movie, so there is nothing to score.',
    flat: 'A movie with no genres scores 0.',
  },
  zh: {
    title: '画像实验室',
    base: '基准分',
    restore: '还原',
    movie: '电影',
    rating: 'A 评分',
    weight: '权重',
    score: '分数',
    profile: '画像',
    order: '画像 ({p})。排名是 {list}。',
    hint: '点击类型格子和评分格子试试。也换一个基准分试试。',
    baseNote: '基准取 {b} 时，只有评分高于 {b} 的电影才是 +。',
    allPlus: '在这个基准下，A 打的分全是 +，所以连低分电影的类型也被加上。',
    zero: '画像是零向量。分数全是 0，排名没有意义。',
    noCand: 'A 看过了所有电影，没有可打分的电影。',
    flat: '没有类型的电影，分数是 0。',
  },
};
const lang = Astro.currentLocale ?? defaultLang;
const t = STRINGS[lang] ?? STRINGS[defaultLang] ?? STRINGS.ko;
const titles = MOVIE_TITLES[lang] ?? MOVIE_TITLES.ko;
const genres = GENRE_NAMES[lang] ?? GENRE_NAMES.ko;
---

<div
  class:list={['aas-proflab-demo', slide && 'is-slide']}
  id={id}
  data-pl-features={JSON.stringify(FEATURES)}
  data-pl-ratings={JSON.stringify(START)}
  data-pl-strings={JSON.stringify(t)}
  style={`--pl-g: ${genres.length}`}
>
  <div class="pl-bar">
    <span class="pl-head"><strong>{t.title}</strong></span>
    <span class="pl-group">
      <span class="pl-label">{t.base}</span>
      {BASES.map((b) => <button type="button" class="pl-btn" data-pl-base={b}>{b}</button>)}
    </span>
    <button type="button" class="pl-btn" data-pl-restore>{t.restore}</button>
  </div>

  <div class="pl-grid">
    <span class="pl-hd">{t.movie}</span>
    {genres.map((g) => <span class="pl-hd">{g}</span>)}
    <span class="pl-hd">{t.rating}</span>
    <span class="pl-hd">{t.weight}</span>
    <span class="pl-hd">{t.score}</span>
    {
      FEATURES.map((row, i) => (
        <>
          <span class="pl-name">
            M{i + 1}
            <span class="pl-title">{titles[i]}</span>
          </span>
          {row.map((_, j) => <button type="button" class="pl-genre" data-pl-genre={`${i}-${j}`} />)}
          <button type="button" class="pl-rate" data-pl-rate={i} />
          <span class="pl-weight" data-pl-weight={i} />
          <span class="pl-score" data-pl-score={i} />
        </>
      ))
    }
    <span class="pl-name pl-profhead">{t.profile}</span>
    {genres.map((_, j) => <span class="pl-prof" data-pl-prof={j} />)}
    <span></span>
    <span></span>
    <span></span>
  </div>

  <p class="pl-note" data-pl-note></p>
</div>

<script is:inline define:vars={{ id }}>
  (() => {
    const root = document.getElementById(id);
    if (!root) return;

    /* 설명은 문장마다 줄을 바꾼다. 마침표 뒤 공백, 또는 중국어 마침표 뒤에서 끊는다. */
    const setLines = (node, text) => {
      const parts = String(text).split(/(?<=[.!?])\s+(?=\S)|(?<=[。！？])(?=\S)/);
      node.replaceChildren(...parts.flatMap((s, i) => (i ? [document.createElement('br'), s] : [s])));
    };
    /* 문장 잇기. 중국어 마침표 뒤에는 공백을 두지 않아야 setLines가 끊는다. */
    const join = (...parts) =>
      parts.filter(Boolean).reduce((a, b) => (/[。！？]$/.test(a) ? a + b : `${a} ${b}`), '');
    const fill = (tpl, vars) => tpl.replace(/\{(\w+)\}/g, (_, k) => vars[k]);

    const F0 = JSON.parse(root.dataset.plFeatures);
    const r0 = JSON.parse(root.dataset.plRatings);
    const S = JSON.parse(root.dataset.plStrings);
    const signed = (w) => (w > 0 ? `+${w}` : String(w));
    const BASE0 = 3;
    let F = F0.map((row) => row.slice());
    let r = r0.slice();
    let base = BASE0;

    function cosine(a, b) {
      let dot = 0, na = 0, nb = 0;
      for (let i = 0; i < a.length; i++) {
        dot += a[i] * b[i];
        na += a[i] * a[i];
        nb += b[i] * b[i];
      }
      return na === 0 || nb === 0 ? 0 : dot / Math.sqrt(na * nb);
    }

    const genreEls = [...root.querySelectorAll('[data-pl-genre]')];
    const rateEls = [...root.querySelectorAll('[data-pl-rate]')];
    const note = root.querySelector('[data-pl-note]');

    function render() {
      const g = F[0].length;
      /* BuildProfile: 본 영화마다 (평점 - 기준)만큼 장르를 더한다. */
      const profile = new Array(g).fill(0);
      r.forEach((x, i) => {
        if (x > 0) for (let j = 0; j < g; j++) profile[j] += (x - base) * F[i][j];
      });
      /* RankByContent: 안 본 영화의 코사인. 같은 점수면 번호가 작은 쪽이 먼저 */
      const cands = r.map((_, i) => i).filter((i) => r[i] === 0);
      const score = {};
      for (const i of cands) score[i] = cosine(profile, F[i]);
      const order = cands.slice().sort((p, q) => score[q] - score[p]);
      const rank = Object.fromEntries(order.map((i, k) => [i, k + 1]));

      genreEls.forEach((el) => {
        const [i, j] = el.dataset.plGenre.split('-').map(Number);
        const on = F[i][j] === 1;
        el.textContent = on ? '●' : '·';
        el.classList.toggle('is-yes', on);
        const w = r[i] > 0 ? r[i] - base : 0;
        el.classList.toggle('is-plus', on && w > 0);
        el.classList.toggle('is-minus', on && w < 0);
        el.classList.toggle('is-changed', F[i][j] !== F0[i][j]);
      });
      rateEls.forEach((el) => {
        const i = Number(el.dataset.plRate);
        el.textContent = r[i] === 0 ? '-' : String(r[i]);
        el.classList.toggle('is-none', r[i] === 0);
        el.classList.toggle('is-changed', r[i] !== r0[i]);
        const weight = root.querySelector(`[data-pl-weight="${i}"]`);
        const w = r[i] - base;
        weight.textContent = r[i] === 0 ? '' : signed(w);
        weight.classList.toggle('is-neg', r[i] > 0 && w < 0);
        weight.classList.toggle('is-pos', r[i] > 0 && w > 0);
        const sc = root.querySelector(`[data-pl-score="${i}"]`);
        sc.textContent = r[i] === 0 ? `#${rank[i]} ${score[i].toFixed(3)}` : '';
        sc.classList.toggle('is-on', r[i] === 0);
        sc.classList.toggle('is-top', r[i] === 0 && rank[i] === 1 && score[i] > 0);
        sc.classList.toggle('is-neg', r[i] === 0 && score[i] < 0);
      });
      root.querySelectorAll('[data-pl-prof]').forEach((el) => {
        const v = profile[Number(el.dataset.plProf)];
        el.textContent = String(v);
        el.classList.toggle('is-neg', v < 0);
      });
      root.querySelectorAll('[data-pl-base]').forEach((b) => b.classList.toggle('is-on', Number(b.dataset.plBase) === base));

      const parts = [];
      const zero = profile.every((v) => v === 0);
      if (!cands.length) parts.push(S.noCand);
      else if (zero) parts.push(S.zero);
      else parts.push(fill(S.order, { p: profile.join(' '), list: order.map((i) => `M${i + 1} ${score[i].toFixed(3)}`).join(', ') }));
      if (base !== BASE0) {
        const rated = r.filter((x) => x > 0);
        parts.push(rated.length && rated.every((x) => x > base) ? S.allPlus : fill(S.baseNote, { b: base }));
      } else if (F.every((row, i) => row.every((x, j) => x === F0[i][j])) && r.every((x, i) => x === r0[i])) {
        parts.push(S.hint);
      }
      if (cands.some((i) => F[i].every((x) => x === 0))) parts.push(S.flat);
      setLines(note, join(...parts));
    }

    genreEls.forEach((el) =>
      el.addEventListener('click', () => {
        const [i, j] = el.dataset.plGenre.split('-').map(Number);
        F[i][j] = F[i][j] ? 0 : 1;
        render();
      }),
    );
    rateEls.forEach((el) =>
      el.addEventListener('click', () => {
        const i = Number(el.dataset.plRate);
        r[i] = (r[i] + 1) % 6;
        render();
      }),
    );
    root.querySelectorAll('[data-pl-base]').forEach((b) =>
      b.addEventListener('click', () => {
        base = Number(b.dataset.plBase);
        render();
      }),
    );
    root.querySelector('[data-pl-restore]').addEventListener('click', () => {
      F = F0.map((row) => row.slice());
      r = r0.slice();
      base = BASE0;
      render();
    });
    render();
  })();
</script>

<style is:global>
  .aas-proflab-demo {
    font-size: 1rem;
    margin: 1.5rem 0;
    padding: 1em;
    border: 1px solid var(--aas-border);
    border-radius: 0.9em;
    background: var(--aas-panel);
  }
  .aas-proflab-demo .pl-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em 1.2em;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5em;
  }
  .aas-proflab-demo .pl-head {
    font-size: 0.95em;
  }
  .aas-proflab-demo .pl-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3em;
    align-items: center;
  }
  .aas-proflab-demo .pl-label {
    margin-right: 0.2em;
    font-size: 0.8em;
    color: var(--aas-muted);
  }
  .aas-proflab-demo .pl-btn {
    min-width: 2.2em;
    padding: 0.3em 0.7em;
    font-size: 0.8em;
    border: 1px solid var(--aas-border);
    border-radius: 0.5em;
    background: var(--aas-bg);
    color: var(--aas-text);
    cursor: pointer;
  }
  .aas-proflab-demo .pl-btn:hover {
    border-color: var(--aas-accent);
  }
  .aas-proflab-demo .pl-btn.is-on {
    background: var(--aas-accent);
    border-color: var(--aas-accent);
    color: #fff;
  }
  .aas-proflab-demo .pl-grid {
    display: grid;
    grid-template-columns: auto repeat(var(--pl-g), minmax(2.6em, 4em)) 3.6em 3.6em 5.8em;
    gap: 0.2em 0.3em;
    justify-content: center;
    align-items: center;
  }
  .aas-proflab-demo .pl-hd {
    font-size: 0.75em;
    font-weight: 700;
    color: var(--aas-muted);
    text-align: center;
    white-space: nowrap;
  }
  .aas-proflab-demo .pl-name {
    display: flex;
    gap: 0.35em;
    align-items: center;
    font-family: var(--aas-mono, monospace);
    font-size: 0.9em;
    font-weight: 700;
  }
  .aas-proflab-demo .pl-title {
    font-family: var(--aas-sans, inherit);
    font-size: 0.78em;
    font-weight: 400;
    white-space: nowrap;
  }
  .aas-proflab-demo .pl-genre,
  .aas-proflab-demo .pl-rate,
  .aas-proflab-demo .pl-weight,
  .aas-proflab-demo .pl-score,
  .aas-proflab-demo .pl-prof {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 1.6em;
    padding: 0;
    border-radius: 0.4em;
    font-family: var(--aas-mono, monospace);
    font-size: 1em;
  }
  .aas-proflab-demo .pl-genre,
  .aas-proflab-demo .pl-rate {
    border: 1px solid var(--aas-border);
    background: var(--aas-bg);
    color: var(--aas-muted);
    cursor: pointer;
    transition: background-color 0.2s;
  }
  .aas-proflab-demo .pl-genre:hover,
  .aas-proflab-demo .pl-rate:hover {
    border-color: var(--aas-accent);
  }
  .aas-proflab-demo .pl-genre.is-yes {
    color: var(--aas-role-model);
  }
  .aas-proflab-demo .pl-genre.is-plus {
    background: color-mix(in srgb, var(--aas-role-eval) 22%, var(--aas-bg));
    color: var(--aas-text);
  }
  .aas-proflab-demo .pl-genre.is-minus {
    background: color-mix(in srgb, var(--aas-role-guard) 22%, var(--aas-bg));
    color: var(--aas-text);
  }
  .aas-proflab-demo .pl-genre.is-changed,
  .aas-proflab-demo .pl-rate.is-changed {
    border-color: var(--aas-role-focus);
    border-width: 2px;
  }
  .aas-proflab-demo .pl-rate {
    color: var(--aas-text);
    font-weight: 700;
  }
  .aas-proflab-demo .pl-rate.is-none {
    color: var(--aas-muted);
    font-weight: 400;
  }
  .aas-proflab-demo .pl-weight {
    font-size: 0.85em;
    color: var(--aas-muted);
  }
  .aas-proflab-demo .pl-weight.is-pos {
    color: var(--aas-role-eval);
    font-weight: 700;
  }
  .aas-proflab-demo .pl-weight.is-neg {
    color: var(--aas-role-guard);
    font-weight: 700;
  }
  .aas-proflab-demo .pl-score {
    font-size: 0.85em;
    font-weight: 700;
  }
  .aas-proflab-demo .pl-score.is-on {
    background: color-mix(in srgb, var(--aas-role-focus) 14%, var(--aas-bg));
  }
  .aas-proflab-demo .pl-score.is-top {
    background: var(--aas-role-focus);
    color: #fff;
  }
  .aas-proflab-demo .pl-score.is-neg {
    color: var(--aas-role-guard);
  }
  .aas-proflab-demo .pl-profhead {
    margin-top: 0.3em;
    font-family: inherit;
    color: var(--aas-role-eval);
  }
  .aas-proflab-demo .pl-prof {
    margin-top: 0.3em;
    border: 2px solid var(--aas-text);
    font-weight: 700;
  }
  .aas-proflab-demo .pl-prof.is-neg {
    color: var(--aas-role-guard);
    border-color: var(--aas-role-guard);
  }
  .aas-proflab-demo .pl-note {
    margin: 0.5em 0 0;
    font-size: 0.85em;
    color: var(--aas-text);
    min-height: 2.6em;
  }

  /* 슬라이드용. vh 단위인 이유는 SearchDemo 참고 */
  .aas-proflab-demo.is-slide {
    font-size: clamp(1rem, 2.45vh, 1.8rem);
    margin: 0.5rem 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .aas-proflab-demo .pl-genre,
    .aas-proflab-demo .pl-rate {
      transition: none;
    }
  }
</style>
