---
// 분할 정복과 동적 계획법을 가르는 "하위 문제가 겹치는가"를 호출 트리로 보는 데모.
//
// 같은 n으로 머지 정렬과 피보나치 재귀의 호출 트리를 나란히 그린다. 머지 정렬은 구간이
// 모두 달라 빨강(같은 문제를 다시 푸는 호출)이 하나도 없고, 피보나치는 금세 빨강으로
// 덮인다. 메모를 켜면 피보나치는 호출이 2n - 1번으로 줄지만 머지 정렬은 한 번도 줄지 않는다.
// 노드를 누르면 그 트리에서 같은 문제가 모두 칠해지고 몇 번 불렸는지 나온다.
//
// 메모는 fibMemo와 같이 기저(n <= 1)를 표보다 먼저 돌려준다(algorithm-code topic-14
// 01_fibonacci). 머지 정렬 구간은 [l, r)를 가운데에서 나누고, 노드에는 l-(r-1)로 적는다.
import { defaultLang } from 'stack-site-builder/i18n/ui';

interface Props {
  /** 처음 n */
  n?: number;
  /** 슬라이드용: 바깥 여백은 줄이고 글자와 칸은 키운다. */
  slide?: boolean;
}
const { n = 5, slide = false } = Astro.props;
const id = `ov-${Math.random().toString(36).slice(2, 9)}`;

const STRINGS: Record<string, Record<string, string>> = {
  ko: {
    title: '겹치는가, 겹치지 않는가',
    size: 'n',
    memoOff: '메모 켜기',
    memoOn: '메모 끄기',
    merge: '머지 정렬: 원소 {n}개',
    fib: '피보나치: F({n})',
    calls: '호출',
    distinct: '서로 다른 문제',
    again: '다시 푼 횟수',
    tree: '호출 트리',
    off: '머지 정렬은 호출 {a}번이 모두 다른 구간입니다. 피보나치는 호출 {b}번에 서로 다른 문제가 {c}개뿐입니다.',
    on: '메모를 켜면 피보나치 호출은 {b0}번에서 {b}번으로 줄지만, 머지 정렬은 {a}번 그대로입니다. 꺼낼 답이 없기 때문입니다.',
    picked: '{label}: 이 트리에서 {k}번 불립니다.',
    pickedOn: '{label}: 메모가 있어도 {k}번 불리고, 그중 {h}번은 표에서 꺼냅니다.',
  },
  en: {
    title: 'Overlapping or not',
    size: 'n',
    memoOff: 'Turn memo on',
    memoOn: 'Turn memo off',
    merge: 'Merge sort: {n} elements',
    fib: 'Fibonacci: F({n})',
    calls: 'calls',
    distinct: 'distinct problems',
    again: 'solved again',
    tree: 'call tree',
    off: 'All {a} merge sort calls are different ranges. Fibonacci makes {b} calls for only {c} distinct problems.',
    on: 'With a memo, Fibonacci drops from {b0} calls to {b}, but merge sort stays at {a}. It has no answers to reuse.',
    picked: '{label}: called {k} times in this tree.',
    pickedOn: '{label}: still called {k} times with a memo, and {h} of them come from the table.',
  },
  zh: {
    title: '重叠还是不重叠',
    size: 'n',
    memoOff: '打开记忆',
    memoOn: '关闭记忆',
    merge: '归并排序：{n} 个元素',
    fib: '斐波那契：F({n})',
    calls: '调用',
    distinct: '不同的问题',
    again: '重算次数',
    tree: '调用树',
    off: '归并排序的 {a} 次调用都是不同的区间。斐波那契调用 {b} 次，不同的问题只有 {c} 个。',
    on: '打开记忆后斐波那契从 {b0} 次降到 {b} 次，归并排序仍是 {a} 次。因为没有可以取出的答案。',
    picked: '{label}：在这棵树里被调用 {k} 次。',
    pickedOn: '{label}：有记忆时仍被调用 {k} 次，其中 {h} 次从表中取出。',
  },
};
const lang = Astro.currentLocale ?? defaultLang;
const t = STRINGS[lang] ?? STRINGS[defaultLang] ?? STRINGS.ko;
---

<div
  class:list={['aas-overlap-demo', slide && 'is-slide']}
  id={id}
  data-ov-strings={JSON.stringify(t)}
  data-ov-n={n}
>
  <div class="ov-bar">
    <span class="ov-head"><strong>{t.title}</strong></span>
    <label class="ov-slider">
      <span>{t.size} = <b data-ov-size></b></span>
      <input type="range" min="2" max="7" step="1" value={n} data-ov-range />
    </label>
    <button type="button" class="ov-btn" data-ov-memo>{t.memoOff}</button>
  </div>

  <div class="ov-panels">
    {
      ['merge', 'fib'].map((p) => (
        <div class="ov-panel" data-ov-panel={p}>
          <h4 data-ov-name />
          <svg class="ov-tree" data-ov-svg role="img" aria-label={t.tree} />
          <dl class="ov-stats">
            <dt>{t.calls}</dt>
            <dd data-ov-calls />
            <dt>{t.distinct}</dt>
            <dd data-ov-distinct />
            <dt>{t.again}</dt>
            <dd data-ov-again />
          </dl>
        </div>
      ))
    }
  </div>

  <p class="ov-note" data-ov-note></p>
</div>

<script is:inline define:vars={{ id }}>
  (() => {
    const root = document.getElementById(id);
    if (!root) return;

    /* 설명은 문장마다 줄을 바꾼다. 마침표 뒤 공백, 또는 중국어 마침표 뒤에서 끊는다. */
    const setLines = (node, text) => {
      const parts = String(text).split(/(?<=[.!?])\s+(?=\S)|(?<=[。！？])(?=\S)/);
      node.replaceChildren(...parts.flatMap((s, i) => (i ? [document.createElement('br'), s] : [s])));
    };
    const fill = (tpl, vars) => tpl.replace(/\{(\w+)\}/g, (_, k) => vars[k]);
    const S = JSON.parse(root.dataset.ovStrings);
    const SVG = 'http://www.w3.org/2000/svg';
    const ROW = 42;
    const H = 7 * ROW;

    /* 두 호출 트리를 왼쪽 자식부터 만든다. 실제 호출 순서와 같다. */
    const fibTree = (k, depth = 0) => ({
      label: String(k),
      base: k <= 1,
      depth,
      kids: k <= 1 ? [] : [fibTree(k - 1, depth + 1), fibTree(k - 2, depth + 1)],
    });
    const mergeTree = (l, r, depth = 0) => {
      const base = r - l <= 1;
      const m = (l + r) >> 1;
      return {
        label: base ? String(l) : `${l}-${r - 1}`,
        base,
        depth,
        kids: base ? [] : [mergeTree(l, m, depth + 1), mergeTree(m, r, depth + 1)],
      };
    };

    /* 잎 순서로 x를 매기고, 안쪽 노드는 자식의 가운데에 둔다. */
    function layout(node, unit, state) {
      if (!node.kids.length) {
        node.x = state.next * unit + unit / 2;
        state.next += 1;
      } else {
        node.kids.forEach((c) => layout(c, unit, state));
        node.x = (node.kids[0].x + node.kids[node.kids.length - 1].x) / 2;
      }
    }
    /* 호출 순서대로 돌며 표시를 붙인다. 메모가 켜져 있으면 표에서 꺼낸 노드 아래는 불리지 않는다. */
    function mark(tree, memoOn) {
      const seen = new Set();
      const list = [];
      const walk = (node, cut) => {
        list.push(node);
        node.cut = cut;
        node.hit = false;
        node.again = false;
        if (!cut) {
          if (seen.has(node.label)) {
            if (memoOn && !node.base) node.hit = true;
            else node.again = true;
          }
          seen.add(node.label);
        }
        node.kids.forEach((c) => walk(c, cut || node.hit));
      };
      walk(tree, false);
      return { list, distinct: seen.size };
    }

    let n = +root.dataset.ovN;
    let memoOn = false;
    let picked = null;
    const range = root.querySelector('[data-ov-range]');
    const memoBtn = root.querySelector('[data-ov-memo]');
    const note = root.querySelector('[data-ov-note]');
    const panels = { merge: root.querySelector('[data-ov-panel="merge"]'), fib: root.querySelector('[data-ov-panel="fib"]') };

    function drawTree(panel, tree, unit, boxW, pickedLabel) {
      const svg = panel.querySelector('[data-ov-svg]');
      const state = { next: 0 };
      layout(tree, unit, state);
      const W = Math.max(state.next * unit, 360);
      const shift = (W - state.next * unit) / 2;
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
      svg.setAttribute('preserveAspectRatio', 'xMidYMin meet');
      svg.replaceChildren();
      const y = (d) => d * ROW + 20;
      const add = (node) => {
        for (const c of node.kids) {
          const line = document.createElementNS(SVG, 'line');
          line.setAttribute('x1', node.x + shift);
          line.setAttribute('y1', y(node.depth));
          line.setAttribute('x2', c.x + shift);
          line.setAttribute('y2', y(c.depth));
          line.setAttribute('class', `ov-link${c.cut || c.hit ? ' is-cut' : ''}`);
          svg.appendChild(line);
          add(c);
        }
      };
      add(tree);
      const nodes = (node) => {
        const g = document.createElementNS(SVG, 'g');
        const cls = ['ov-node'];
        if (node.cut) cls.push('is-cut');
        else if (node.hit) cls.push('is-hit');
        else if (node.again) cls.push('is-again');
        if (pickedLabel === node.label) cls.push('is-pick');
        g.setAttribute('class', cls.join(' '));
        g.dataset.ovLabel = node.label;
        const r = document.createElementNS(SVG, 'rect');
        r.setAttribute('x', node.x + shift - boxW / 2);
        r.setAttribute('y', y(node.depth) - 15);
        r.setAttribute('width', boxW);
        r.setAttribute('height', 30);
        r.setAttribute('rx', 6);
        const text = document.createElementNS(SVG, 'text');
        text.setAttribute('x', node.x + shift);
        text.setAttribute('y', y(node.depth));
        text.setAttribute('text-anchor', 'middle');
        text.setAttribute('dominant-baseline', 'central');
        text.textContent = node.label;
        g.append(r, text);
        svg.appendChild(g);
        node.kids.forEach(nodes);
      };
      nodes(tree);
    }

    function stat(panel, name, v) {
      panel.querySelector(`[data-ov-${name}]`).textContent = String(v);
    }

    function draw() {
      const merge = mergeTree(0, n);
      const fib = fibTree(n);
      const mergeInfo = mark(merge, memoOn);
      const fibInfo = mark(fib, memoOn);
      const fibPlain = mark(fibTree(n), false);
      const callsOf = (info) => info.list.filter((x) => !x.cut).length;
      const againOf = (info) => info.list.filter((x) => x.again).length;
      const pickLabel = picked ? picked.label : null;
      drawTree(panels.merge, merge, 60, 50, picked && picked.side === 'merge' ? pickLabel : null);
      drawTree(panels.fib, fib, 30, 26, picked && picked.side === 'fib' ? pickLabel : null);

      panels.merge.querySelector('[data-ov-name]').textContent = fill(S.merge, { n });
      panels.fib.querySelector('[data-ov-name]').textContent = fill(S.fib, { n });
      stat(panels.merge, 'calls', callsOf(mergeInfo));
      stat(panels.merge, 'distinct', mergeInfo.distinct);
      stat(panels.merge, 'again', againOf(mergeInfo));
      stat(panels.fib, 'calls', callsOf(fibInfo));
      stat(panels.fib, 'distinct', fibInfo.distinct);
      stat(panels.fib, 'again', againOf(fibInfo));
      root.querySelector('[data-ov-size]').textContent = String(n);
      memoBtn.textContent = memoOn ? S.memoOn : S.memoOff;
      memoBtn.classList.toggle('is-on', memoOn);

      if (picked) {
        const info = picked.side === 'merge' ? mergeInfo : fibInfo;
        const same = info.list.filter((x) => x.label === picked.label && !x.cut);
        if (same.length) {
          const name = picked.side === 'merge' ? `[${picked.label}]` : `F(${picked.label})`;
          const h = same.filter((x) => x.hit).length;
          setLines(
            note,
            memoOn
              ? fill(S.pickedOn, { label: name, k: same.length, h })
              : fill(S.picked, { label: name, k: same.length }),
          );
          return;
        }
        picked = null;
      }
      setLines(
        note,
        memoOn
          ? fill(S.on, { a: callsOf(mergeInfo), b: callsOf(fibInfo), b0: callsOf(fibPlain) })
          : fill(S.off, { a: callsOf(mergeInfo), b: callsOf(fibInfo), c: fibInfo.distinct }),
      );
    }

    range.addEventListener('input', () => {
      n = +range.value;
      picked = null;
      draw();
    });
    memoBtn.addEventListener('click', () => {
      memoOn = !memoOn;
      draw();
    });
    root.querySelectorAll('[data-ov-svg]').forEach((svg) =>
      svg.addEventListener('click', (ev) => {
        const g = ev.target.closest('[data-ov-label]');
        if (!g) return;
        const side = svg.closest('[data-ov-panel]').dataset.ovPanel;
        const same = picked && picked.side === side && picked.label === g.dataset.ovLabel;
        picked = same ? null : { side, label: g.dataset.ovLabel };
        draw();
      }),
    );
    draw();
  })();
</script>

<style is:global>
  .aas-overlap-demo {
    /* 안쪽 치수는 모두 이 값에 대한 em이다(다른 데모들과 같은 방식). */
    font-size: 1rem;
    margin: 1.5rem 0;
    padding: 1em;
    border: 1px solid var(--aas-border);
    border-radius: 0.9em;
    background: var(--aas-panel);
  }
  .aas-overlap-demo .ov-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em 1.2em;
    align-items: center;
    justify-content: space-between;
  }
  .aas-overlap-demo .ov-head {
    font-size: 0.95em;
  }
  .aas-overlap-demo .ov-slider {
    display: flex;
    flex: 1 1 10em;
    gap: 0.7em;
    align-items: center;
    max-width: 22em;
    font-size: 0.88em;
    white-space: nowrap;
  }
  .aas-overlap-demo .ov-slider input {
    flex: 1 1 auto;
    min-width: 0;
    accent-color: var(--aas-accent);
  }
  .aas-overlap-demo .ov-slider b {
    font-family: var(--aas-mono, monospace);
  }
  .aas-overlap-demo .ov-btn {
    padding: 0.35em 0.8em;
    font-size: 0.85em;
    border: 1px solid var(--aas-border);
    border-radius: 0.5em;
    background: var(--aas-bg);
    color: var(--aas-text);
    cursor: pointer;
  }
  .aas-overlap-demo .ov-btn:hover {
    border-color: var(--aas-accent);
  }
  .aas-overlap-demo .ov-btn.is-on {
    background: color-mix(in srgb, var(--aas-accent) 18%, var(--aas-bg));
    border-color: var(--aas-accent);
    font-weight: 700;
  }
  .aas-overlap-demo .ov-panels {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6em;
    margin-top: 0.5em;
  }
  .aas-overlap-demo .ov-panel {
    min-width: 0;
    padding: 0.45em 0.6em;
    border: 1px solid var(--aas-border);
    border-radius: 0.6em;
    background: var(--aas-bg);
  }
  .aas-overlap-demo h4 {
    margin: 0 0 0.2em;
    font-size: 0.85em;
    font-weight: 600;
    color: var(--aas-text);
  }
  .aas-overlap-demo .ov-tree {
    display: block;
    width: 100%;
    height: 13.5em;
  }
  .aas-overlap-demo .ov-link {
    stroke: var(--aas-muted);
    stroke-width: 1.5;
    opacity: 0.6;
  }
  .aas-overlap-demo .ov-link.is-cut {
    stroke-dasharray: 4 4;
    opacity: 0.35;
  }
  .aas-overlap-demo .ov-node {
    cursor: pointer;
  }
  .aas-overlap-demo .ov-node rect {
    fill: color-mix(in srgb, var(--aas-role-eval) 22%, var(--aas-bg));
    stroke: var(--aas-role-eval);
    stroke-width: 1.5;
  }
  .aas-overlap-demo .ov-node text {
    fill: var(--aas-text);
    font-size: 15px;
    font-weight: 600;
    font-family: var(--aas-mono, monospace);
  }
  .aas-overlap-demo .ov-node.is-again rect {
    fill: color-mix(in srgb, var(--aas-role-guard) 28%, var(--aas-bg));
    stroke: var(--aas-role-guard);
  }
  .aas-overlap-demo .ov-node.is-hit rect {
    fill: color-mix(in srgb, var(--aas-role-focus) 40%, var(--aas-bg));
    stroke: var(--aas-role-focus);
  }
  .aas-overlap-demo .ov-node.is-cut {
    opacity: 0.4;
  }
  .aas-overlap-demo .ov-node.is-cut rect {
    fill: var(--aas-bg);
    stroke: var(--aas-muted);
    stroke-dasharray: 4 3;
  }
  .aas-overlap-demo .ov-node.is-pick rect {
    stroke: var(--aas-accent);
    stroke-width: 4;
  }
  .aas-overlap-demo .ov-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.45em;
    margin: 0.2em 0 0;
    font-size: 0.8em;
    line-height: 1.35;
  }
  .aas-overlap-demo .ov-stats dt {
    margin: 0;
    font-weight: 400;
    color: var(--aas-muted);
  }
  .aas-overlap-demo .ov-stats dd {
    margin: 0 0.9em 0 0;
    font-family: var(--aas-mono, monospace);
    font-weight: 700;
  }
  .aas-overlap-demo .ov-note {
    margin: 0.5em 0 0;
    font-size: 0.85em;
    min-height: 2.8em;
  }

  /* 슬라이드용. 다른 데모와 같은 방식. vh 단위인 이유는 SearchDemo 참고 */
  .aas-overlap-demo.is-slide {
    font-size: clamp(1rem, 2.6vh, 1.8rem);
    margin: 0.5rem 0;
  }

  @media (max-width: 720px) {
    .aas-overlap-demo .ov-panels {
      grid-template-columns: 1fr;
    }
  }
</style>
