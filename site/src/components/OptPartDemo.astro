---
// 최적 부분 구조가 성립하는 예와 성립하지 않는 예를 나란히 보이는 데모.
//
// 같은 마름모 그래프(정점 4개, 간선 4개)에서 왼쪽은 가장 짧은 길, 오른쪽은 가장 긴
// 단순 경로를 묻는다. 네 걸음으로 같은 질문을 던진다.
//   1. 전체의 최적  2. 그 안의 S → M 부분  3. S에서 M까지만 본 최적  4. 바꿔 끼우기
// 짧은 길은 3에서 부분과 같고, 긴 길은 3이 더 길지만 바꿔 끼우면 정점이 겹친다.
// 길은 단순 경로를 모두 만들어 견주어 구한다.
import { defaultLang } from 'stack-site-builder/i18n/ui';
import DpKit from './DpKit.astro';
interface Props {
  slide?: boolean;
}
const { slide = false } = Astro.props;
const id = `sp-${Math.random().toString(36).slice(2, 9)}`;
const STRINGS: Record<string, any> = {
  ko: {
    title: '부분도 최적인가',
    short: '성립: 가장 짧은 길',
    long: '성립하지 않음: 가장 긴 단순 경로',
    step0: ['S에서 T로 가는 가장 짧은 길을 찾습니다.', 'S에서 T로 가는 가장 긴 단순 경로를 찾습니다. 단순 경로는 같은 정점을 두 번 지나지 않는 길입니다.'],
    step1: ['가장 짧은 길은 {p}, 길이 {v}입니다.', '가장 긴 단순 경로는 {p}, 길이 {v}입니다.'],
    step2: ['그 안의 S → {m} 부분은 {p}, 길이 {v}입니다.', '그 안의 S → {m} 부분은 {p}, 길이 {v}입니다.'],
    step3same: 'S에서 {m}까지만 보면 가장 짧은 길도 {p}입니다. 부분이 그 구간의 최적입니다.',
    step3diff: 'S에서 {m}까지만 보면 가장 긴 단순 경로는 {p}, 길이 {v}입니다. 부분보다 깁니다.',
    step4same: '바꿔 끼울 것이 없습니다. 더 짧은 S → {m}가 있었다면 전체도 더 짧아졌을 것입니다. 최적 부분 구조가 있습니다.',
    step4diff: '바꿔 끼우면 {p}가 되어 {r}를 두 번 지납니다. 단순 경로가 아닙니다. 부분의 최적으로는 전체를 만들 수 없습니다.',
    len: '길이',
  },
  en: {
    title: 'Is the part optimal too?',
    short: 'Holds: shortest path',
    long: 'Does not hold: longest simple path',
    step0: ['Find the shortest path from S to T.', 'Find the longest simple path from S to T. A simple path never visits a vertex twice.'],
    step1: ['The shortest path is {p}, length {v}.', 'The longest simple path is {p}, length {v}.'],
    step2: ['Its S → {m} part is {p}, length {v}.', 'Its S → {m} part is {p}, length {v}.'],
    step3same: 'Looking only from S to {m}, the shortest path is also {p}. The part is optimal for that stretch.',
    step3diff: 'Looking only from S to {m}, the longest simple path is {p}, length {v}. It is longer than the part.',
    step4same: 'There is nothing to swap. A shorter S → {m} would have made the whole shorter. There is optimal substructure.',
    step4diff: 'Swapping it in gives {p}, which visits {r} twice. That is not a simple path. The optimal part cannot build the whole.',
    len: 'length',
  },
  zh: {
    title: '部分也是最优吗',
    short: '成立：最短路径',
    long: '不成立：最长简单路径',
    step0: ['找从 S 到 T 的最短路径。', '找从 S 到 T 的最长简单路径。简单路径是不重复经过同一顶点的路。'],
    step1: ['最短路径是 {p}，长度 {v}。', '最长简单路径是 {p}，长度 {v}。'],
    step2: ['其中 S → {m} 这一段是 {p}，长度 {v}。', '其中 S → {m} 这一段是 {p}，长度 {v}。'],
    step3same: '只看从 S 到 {m}，最短路径也是 {p}。这一段就是该段的最优。',
    step3diff: '只看从 S 到 {m}，最长简单路径是 {p}，长度 {v}。比这一段更长。',
    step4same: '没有可替换的。若有更短的 S → {m}，整体也会更短。有最优子结构。',
    step4diff: '换上去就成了 {p}，经过 {r} 两次。不是简单路径。用部分的最优拼不出整体。',
    len: '长度',
  },
};
const lang = Astro.currentLocale ?? defaultLang;
const t = STRINGS[lang] ?? STRINGS.ko;
const POS: Record<string, [number, number]> = { S: [40, 120], A: [180, 35], B: [180, 205], T: [320, 120] };
const EDGES: [string, string, number][] = [['S', 'A', 1], ['A', 'T', 2], ['S', 'B', 3], ['B', 'T', 3]];
---

<DpKit id={id} cls="aas-opt-part" title={t.title} strings={t} steps slide={slide} size={2.75} note={false}>
  <div class="sp-panels">
    {(['short', 'long'] as const).map((k, i) => (
      <div class="sp-panel" data-sp-panel={i}>
        <h4>{t[k]}</h4>
        <svg viewBox="0 -8 360 256">
          <g data-sp-under></g>
          {EDGES.map(([u, v, c]) => {
            const [a, b] = [POS[u], POS[v]];
            const [cx, cy] = [(a[0] + b[0]) / 2, (a[1] + b[1]) / 2];
            const d = Math.hypot(cx - 180, cy - 120);
            const [mx, my] = [cx + ((cx - 180) / d) * 24, cy + ((cy - 120) / d) * 24];
            return (
              <Fragment>
                <line class="sv-edge" x1={a[0]} y1={a[1]} x2={b[0]} y2={b[1]} />
                <text x={mx} y={my} font-size="19" font-weight="700" class="sp-w">{c}</text>
              </Fragment>
            );
          })}
          <g data-sp-over></g>
          {Object.entries(POS).map(([v, [x, y]]) => (
            <Fragment>
              <circle class="sv-node" data-sp-v={v} cx={x} cy={y} r="22" />
              <text x={x} y={y} font-size="20" font-weight="700">{v}</text>
            </Fragment>
          ))}
        </svg>
        <p class="sp-say" data-sp-say></p>
      </div>
    ))}
  </div>
</DpKit>

<script is:inline define:vars={{ id, POS, EDGES }}>
  (() => {
    const K = aasDp;
    const { root, S } = K.root(id);
    const W = {};
    EDGES.forEach(([u, v, c]) => (W[u + v] = W[v + u] = c));
    const len = (p) => [...p].slice(1).reduce((s, v, i) => s + W[p[i] + v], 0);
    /* src에서 dst까지 단순 경로를 모두 만들어 가장 짧은(긴) 것을 고른다. */
    const best = (longest, src, dst) => {
      let top = null;
      const go = (p) => {
        const u = p[p.length - 1];
        if (u === dst) {
          if (!top || (longest ? len(p) > len(top) : len(p) < len(top))) top = p;
          return;
        }
        Object.keys(POS).forEach((x) => W[u + x] && !p.includes(x) && go(p + x));
      };
      go(src);
      return top;
    };
    const arrow = (p) => [...p].join(' → ');
    const panels = [...root.querySelectorAll('[data-sp-panel]')].map((el, i) => {
      const longest = i === 1;
      const whole = best(longest, 'S', 'T');
      const m = whole[1];
      const part = whole.slice(0, 2);
      const q = best(longest, 'S', m);
      const swapped = q + whole.slice(2);
      const rep = [...whole.slice(2)].find((v) => q.includes(v));
      return { el, longest, whole, m, part, q, swapped, rep };
    });
    const poly = (p, cls, off = 0) =>
      K.svg('polyline', { cls, points: [...p].map((v) => POS[v].map((c) => c + off).join(',')).join(' ') });
    function draw(s) {
      panels.forEach(({ el, longest, whole, m, part, q, swapped, rep }, i) => {
        const under = [];
        const over = [];
        if (s >= 1) under.push(poly(whole, 'sp-whole'));
        if (s >= 2) over.push(poly(part, 'sp-part'));
        if (s >= 3 && q !== part) over.push(poly(q, 'sp-best', 7));
        el.querySelector('[data-sp-under]').replaceChildren(...under);
        el.querySelector('[data-sp-over]').replaceChildren(...over);
        el.querySelectorAll('[data-sp-v]').forEach((c) => {
          const v = c.dataset.spV;
          const k = s >= 4 && rep === v ? 'sv-guard' : s >= 2 && v === m ? 'sv-focus' : '';
          c.setAttribute('class', `sv-node ${k}`);
        });
        const say = [];
        if (s === 0) say.push(S.step0[i]);
        if (s >= 1) say.push(K.fill(S.step1[i], { p: arrow(whole), v: len(whole) }));
        if (s >= 2) say.push(K.fill(S.step2[i], { m, p: arrow(part), v: len(part) }));
        if (s >= 3) say.push(K.fill(q === part ? S.step3same : S.step3diff, { m, p: arrow(q), v: len(q) }));
        if (s >= 4) say.push(K.fill(q === part ? S.step4same : S.step4diff, { m, p: arrow(swapped), r: rep }));
        K.lines(el.querySelector('[data-sp-say]'), ...say.slice(-1));
        el.classList.toggle('is-bad', s >= 4 && longest);
        el.classList.toggle('is-good', s >= 4 && !longest);
      });
    }
    K.stepper(root, { count: () => 4, draw, ms: 1800 }).go(0);
  })();
</script>

<style is:global>
  .aas-opt-part .sp-panels {
    display: flex;
    flex-wrap: wrap;
    gap: 1em;
  }
  .aas-opt-part .sp-panel {
    flex: 1 1 18em;
    min-width: 0;
    padding: 0.6em 0.8em;
    border: 2px solid var(--dx-line);
    border-radius: 0.8em;
    transition:
      border-color 0.2s,
      background-color 0.2s;
  }
  .aas-opt-part .sp-panel.is-good {
    border-color: var(--aas-role-eval);
    background: color-mix(in srgb, var(--aas-role-eval) 7%, var(--aas-bg));
  }
  .aas-opt-part .sp-panel.is-bad {
    border-color: var(--aas-role-guard);
    background: color-mix(in srgb, var(--aas-role-guard) 7%, var(--aas-bg));
  }
  .aas-opt-part h4 {
    margin: 0;
    font-size: 0.95em;
    color: var(--aas-text);
  }
  .aas-opt-part .sp-panel svg {
    width: 100%;
    max-height: 13em;
    margin: 0.2em auto;
  }
  .aas-opt-part.is-slide .sp-panel svg {
    max-height: 34vh;
  }
  .aas-opt-part .sp-w {
    fill: var(--aas-muted);
  }
  .aas-opt-part polyline {
    fill: none;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .aas-opt-part .sp-whole {
    stroke: color-mix(in srgb, var(--aas-role-guard) 40%, var(--aas-bg));
    stroke-width: 18;
  }
  .aas-opt-part .sp-part {
    stroke: var(--aas-role-focus);
    stroke-width: 6;
  }
  .aas-opt-part .sp-best {
    stroke: var(--aas-role-model);
    stroke-width: 4;
    stroke-dasharray: 9 6;
  }
  .aas-opt-part .sp-say {
    min-height: 3.2em;
    margin: 0;
    font-size: 0.85em;
    line-height: 1.5;
  }
  .aas-opt-part .dx-note {
    min-height: 0;
  }
</style>
