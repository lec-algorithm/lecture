---
// 주제 09의 참조 띠. 문자열의 위치, 글자, 그리고 데모가 고른 값(문자 코드, 순위 등)을
// 데모 안에서 바로 보게 한다. 지금 쓰는 칸이 칠해지므로 값을 찾으러 슬라이드를 오가지
// 않아도 된다.
//
// 내용은 데모의 스크립트가 suffixAlgos.js의 drawStrip으로 채우고 markStrip으로 칠한다.
// 입력이 바뀌는 데모도 같은 띠를 쓴다. 주제 08의 HashKeyTable과 같은 역할이다.
import { defaultLang } from 'stack-site-builder/i18n/ui';

const LABELS: Record<string, { pos: string; char: string }> = {
  ko: { pos: '위치', char: '글자' },
  en: { pos: 'pos', char: 'char' },
  zh: { pos: '位置', char: '字符' },
};
const lang = Astro.currentLocale ?? defaultLang;
const l = LABELS[lang] ?? LABELS.ko;
---

<div class="aas-suf-strip" data-ss data-ss-pos={l.pos} data-ss-char={l.char}></div>

<style is:global>
  .aas-suf-strip {
    display: grid;
    grid-template-columns: auto repeat(var(--ss-cols, 1), minmax(1.5em, 2.4em));
    width: fit-content;
    max-width: 100%;
    align-self: start;
    font-family: var(--aas-mono, monospace);
    font-size: 0.72em;
    line-height: 1.3;
    border: 1px solid var(--aas-border);
    border-radius: 0.5em;
    background: var(--aas-bg);
    overflow: hidden;
  }
  .aas-suf-strip .ss-label {
    padding: 0 0.6em;
    font-family: var(--aas-sans, inherit);
    color: var(--aas-muted);
    white-space: nowrap;
  }
  .aas-suf-strip .ss-cell {
    min-width: 0;
    text-align: center;
    transition: background-color 0.2s;
  }
  .aas-suf-strip .ss-pos {
    color: var(--aas-muted);
  }
  .aas-suf-strip .ss-ch {
    font-weight: 700;
  }
  .aas-suf-strip .ss-next {
    font-weight: 700;
    color: var(--aas-role-eval);
  }
  .aas-suf-strip .ss-cell.is-now {
    background: color-mix(in srgb, var(--aas-role-focus) 30%, var(--aas-bg));
  }
  .aas-suf-strip .ss-cell.is-a {
    background: color-mix(in srgb, var(--aas-role-model) 28%, var(--aas-bg));
  }
  .aas-suf-strip .ss-cell.is-b {
    background: color-mix(in srgb, var(--aas-role-trace) 28%, var(--aas-bg));
  }
  .aas-suf-strip .ss-cell.is-hit {
    background: color-mix(in srgb, var(--aas-role-eval) 30%, var(--aas-bg));
  }
  @media (prefers-reduced-motion: reduce) {
    .aas-suf-strip .ss-cell {
      transition: none;
    }
  }
</style>
